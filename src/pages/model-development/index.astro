---
// The model-development material is a blog series; this page only forwards
// links to the old hub.
const target = "/blog/?series=model-development#blog-filters";
const absolute = `https://richardcheam.github.io${target}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Model development</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absolute} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body>
    <p>The model-development posts are now a <a href={target}>blog series</a>.</p>
  </body>
</html>
