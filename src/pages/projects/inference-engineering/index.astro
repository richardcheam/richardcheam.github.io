---
// The project moved to its own site; this page only forwards old links.
const target = "https://richardcheam.github.io/inference-engineering/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Inference Engineering</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body>
    <p>Inference Engineering has moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
