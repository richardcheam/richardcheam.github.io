---
// Course navigation for a page in the model-development course. `place="top"`
// shows where the page sits; `place="end"` offers "mark complete" and the next
// lesson. Renders nothing for pages outside the course.
import { courseStep } from "../lib/course";
import { publishedUnits, unitKindLabel } from "../data/model-development.ts";
interface Props { href: string; place: "top" | "end" }
const { href, place } = Astro.props;
const step = courseStep(href);
const kind = (k: keyof typeof unitKindLabel) => unitKindLabel[k];
---
{step && place === "top" && (
  <nav class="course-bar" aria-label="Course: model development">
    <p class="course-bar__where">
      <a href="/model-development/">Model development course</a>
      <span aria-hidden="true">·</span>
      <span>Part {step.partNumber}: {step.part.title}</span>
    </p>
    <div class="course-bar__row">
      <p class="course-bar__step">Lesson {step.number} of {step.total} <span>· {kind(step.unit.kind)}</span></p>
      <ol class="course-bar__dots">
        {publishedUnits.map((u, i) => (
          <li>
            <a href={u.href} data-course-dot={u.href} class:list={["course-dot", { "is-current": u.href === href }]} aria-current={u.href === href ? "page" : undefined} title={`Lesson ${i + 1}: ${u.title}`}>
              <span class="sr-only">Lesson {i + 1}: {u.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}
{step && place === "end" && (
  <section class="course-end" aria-label="Continue the course" data-course-end={href}>
    <div class="course-end__complete" data-course-complete-wrap hidden>
      <button type="button" class="course-end__button" data-course-complete aria-pressed="false">Mark lesson {step.number} complete</button>
      <p class="course-end__note">Progress is saved only in this browser.</p>
    </div>
    {step.next ? (
      <a class="course-end__next" href={step.next.href}>
        <span class="course-end__label">Next · Lesson {step.number + 1} · {kind(step.next.kind)}</span>
        <span class="course-end__title">{step.next.title}</span>
        <span class="course-end__task">{step.next.task}</span>
      </a>
    ) : (
      <a class="course-end__next" href="/model-development/#coming-next">
        <span class="course-end__label">End of the published course</span>
        <span class="course-end__title">See what comes next</span>
        <span class="course-end__task">The next parts are in preparation; the syllabus lists them in order.</span>
      </a>
    )}
    <p class="course-end__links">
      {step.prev && <a href={step.prev.href}>← Lesson {step.number - 1}: {step.prev.title}</a>}
      <a href="/model-development/">Course syllabus</a>
    </p>
  </section>
)}

<script>
  import { completed, setCompleted, paintDots } from "../lib/course-progress";
  paintDots();
  document.querySelectorAll<HTMLElement>("[data-course-end]").forEach((end) => {
    const href = end.dataset.courseEnd!;
    const wrap = end.querySelector<HTMLElement>("[data-course-complete-wrap]")!;
    const button = end.querySelector<HTMLButtonElement>("[data-course-complete]")!;
    const label = button.textContent!;
    const show = () => { const done = completed().has(href); button.setAttribute("aria-pressed", String(done)); button.textContent = done ? "Completed ✓ (undo)" : label; };
    button.addEventListener("click", () => { setCompleted(href, button.getAttribute("aria-pressed") !== "true"); show(); paintDots(); });
    wrap.hidden = false;
    show();
  });
  window.addEventListener("course-progress", () => paintDots());
</script>

<style>
  .course-bar { margin: 0 0 1.4rem; padding: .8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); font-size: .82rem; }
  .course-bar__where { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; color: var(--text-secondary); }
  .course-bar__where a { color: var(--text); font-weight: 600; }
  .course-bar__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; margin-top: .45rem; }
  .course-bar__step { margin: 0; font-family: var(--font-mono); font-size: .78rem; color: var(--text); }
  .course-bar__step span { color: var(--text-secondary); }
  .course-bar__dots { display: flex; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .course-dot { display: block; width: 1.6rem; height: .5rem; border-radius: 999px; background: var(--border-strong); }
  .course-dot.is-done { background: var(--blog-orientation); }
  .course-dot.is-current { outline: 2px solid var(--text); outline-offset: 2px; }
  .course-dot:focus-visible { outline: 2px solid var(--blog-orientation); outline-offset: 3px; }
  .course-end { margin: 3rem 0 1rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .course-end__complete { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin-bottom: 1.2rem; }
  .course-end__button { padding: .55rem 1rem; border: 1px solid var(--text); border-radius: 999px; background: var(--text); color: var(--bg); font: inherit; font-size: .88rem; font-weight: 600; cursor: pointer; }
  .course-end__button[aria-pressed="true"] { background: transparent; color: var(--text); }
  .course-end__button:focus-visible { outline: 2px solid var(--blog-orientation); outline-offset: 3px; }
  .course-end__note { margin: 0; font-size: .78rem; color: var(--text-secondary); }
  .course-end__next { display: grid; gap: .25rem; padding: 1rem 1.2rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface); text-decoration: none; color: var(--text); }
  .course-end__next:hover .course-end__title { text-decoration: underline; }
  .course-end__label { font-family: var(--font-mono); font-size: .74rem; color: var(--text-secondary); }
  .course-end__title { font-size: 1.08rem; font-weight: 700; }
  .course-end__task { font-size: .88rem; color: var(--text-secondary); }
  .course-end__links { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; margin-top: .9rem; font-size: .84rem; }
</style>
