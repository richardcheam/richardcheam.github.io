---
// Moshi review, Figure 5: aligning text to 80 ms steps with PAD and EPAD
// (Eq 5, p. 16). A word starting at s seconds lands in step t = round(12.5 s), counting from 1;
// EPAD goes in the step before it unless that step holds the previous word.
// Word times are illustrative; the toy tokenizer gives words longer than six
// letters two tokens.
const { alt } = Astro.props;
---
<div class="blog-diagram pw" role="region" aria-label={alt} data-pw>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 300" role="img" aria-labelledby="pw-title" class="blog-diagram-svg" font-family="Inter, sans-serif" style="touch-action: none">
    <title id="pw-title">Words placed on a row of 80 ms text slots, with padding tokens filling the gaps</title>
    <text x="20" y="22" font-size="11.5" font-weight="700" fill="#2b2b30">When each word starts (drag a word)</text>
    <line x1="40" x2="744" y1="88" y2="88" stroke="#2b2b30" />
    <g data-ticks></g>
    <g data-words></g>
    <text x="20" y="140" font-size="11.5" font-weight="700" fill="#2b2b30">Moshi's text floor, one slot per 80 ms</text>
    <g data-slots></g>
    <text data-r1 x="20" y="250" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="272" font-size="11.5" fill="#5f5f66"></text>
    <text data-r3 x="20" y="290" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Phrase</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-ph="0" aria-pressed="true">hi there</button>
      <button type="button" class="fig-chip" data-ph="1" aria-pressed="false">I am Moshi</button>
      <button type="button" class="fig-chip" data-ph="2" aria-pressed="false">an unbelievable story</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-pw]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const N = 16, SW = 44, X0 = 40, T = (s: number) => X0 + (s * 12.5 - 1) * SW + SW / 2;
    const phrases = [
      [["hi", 0.4], ["there", 0.72]],
      [["I", 0.08], ["am", 0.24], ["Moshi", 0.4]],
      [["an", 0.16], ["unbelievable", 0.32], ["story", 0.8]],
    ] as [string, number][][];
    let words = phrases[0].map(([w, s]) => ({ w, s })), shown = N;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    for (let i = 0; i < N; i++) mk($("[data-ticks]"), "line", { x1: T((i + 1) * 0.08), x2: T((i + 1) * 0.08), y1: 84, y2: 92, stroke: "#2b2b30" });
    for (let i = 0; i < N; i += 3) mk($("[data-ticks]"), "text", { x: T((i + 1) * 0.08), y: 106, "font-size": 10, "text-anchor": "middle", fill: "#5f5f66" }, `${((i + 1) * 0.08).toFixed(2)} s`);
    const pieces = (w: string) => (w.length > 6 ? [w.slice(0, Math.ceil(w.length / 2)), w.slice(Math.ceil(w.length / 2))] : [w]);
    // Eq 5 with the paper's two edge rules.
    function align() {
      const W: { kind: "PAD" | "EPAD" | "tok"; txt: string; word: number }[] = Array.from({ length: N }, () => ({ kind: "PAD", txt: "PAD", word: -1 }));
      let free = 0;
      [...words].map((w, i) => ({ ...w, i })).sort((a, b) => a.s - b.s).forEach(({ w, s, i }) => {
        let t = Math.round(s * 12.5) - 1;
        if (t <= 0) { W[0] = { kind: "EPAD", txt: "EPAD", word: i }; t = 1; }
        t = Math.max(t, free);
        if (t - 1 >= 0 && W[t - 1].kind === "PAD") W[t - 1] = { kind: "EPAD", txt: "EPAD", word: i };
        pieces(w).forEach((p, j) => { if (t + j < N) W[t + j] = { kind: "tok", txt: p, word: i }; });
        free = t + pieces(w).length;
      });
      return W;
    }
    function draw() {
      const gw = $("[data-words]"); gw.replaceChildren();
      words.forEach((w, i) => {
        const g = mk(gw, "g", { "data-i": i, style: "cursor: ew-resize" });
        mk(g, "rect", { x: T(w.s) - 2, y: 40, width: Math.max(34, w.w.length * 7.5 + 12), height: 26, rx: 3, fill: "#594578" });
        mk(g, "text", { x: T(w.s) + 6, y: 58, "font-size": 12, fill: "#fff", "font-weight": 600 }, w.w);
        mk(g, "line", { x1: T(w.s), x2: T(w.s), y1: 66, y2: 88, stroke: "#594578", "stroke-width": 2 });
      });
      const W = align(), gs = $("[data-slots]"); gs.replaceChildren();
      W.forEach((c, i) => {
        const on = i < shown, x = X0 + i * SW + 2;
        mk(gs, "rect", { x, y: 152, width: SW - 4, height: 40, rx: 3, fill: !on ? "#f5f5f8" : c.kind === "tok" ? "#4F5D3A" : c.kind === "EPAD" ? "#b8722c" : "#ececf1" });
        if (on) mk(gs, "text", { x: x + (SW - 4) / 2, y: 176, "font-size": c.kind === "tok" ? 11 : 9, "text-anchor": "middle", fill: c.kind === "PAD" ? "#8a8a94" : "#fff", "font-weight": c.kind === "tok" ? 700 : 400 }, c.txt);
        mk(gs, "text", { x: x + (SW - 4) / 2, y: 208, "font-size": 9.5, "text-anchor": "middle", fill: "#b9b9c2" }, String(i + 1));
      });
      const pads = W.filter((c) => c.kind === "PAD").length;
      $("[data-r1]").textContent = `PAD fills ${pads} of ${N} slots: ${Math.round((100 * pads) / N)}%. The paper measures about 65% on English conversation (Sec 3.4.4, p. 16).`;
      $("[data-r2]").textContent = "A word starting at s seconds goes in slot round(12.5 × s); the orange EPAD in the slot before says “a word starts next”.";
      $("[data-r3]").textContent = "Edge rules: a word at the very start gets EPAD in slot 1 and moves right; EPAD never overwrites the previous word.";
    }
    const svg = root.querySelector("svg")!;
    let drag = -1, off = 0;
    const sx = (e: PointerEvent) => { const r = svg.getBoundingClientRect(); return ((e.clientX - r.left) / r.width) * 780; };
    svg.addEventListener("pointerdown", (e) => { const g = (e.target as Element).closest("[data-i]"); if (!g) return; drag = +g.getAttribute("data-i")!; off = sx(e) - T(words[drag].s); svg.setPointerCapture(e.pointerId); });
    svg.addEventListener("pointermove", (e) => { if (drag < 0) return; const s = ((sx(e) - off - X0 - SW / 2) / SW + 1) / 12.5; words[drag].s = Math.max(0, Math.min(N * 0.08, Math.round(s * 50) / 50)); draw(); });
    svg.addEventListener("pointerup", () => { drag = -1; });
    root.querySelectorAll<HTMLButtonElement>("[data-ph]").forEach((b) => b.addEventListener("click", () => {
      words = phrases[+b.dataset.ph!].map(([w, s]) => ({ w, s })); root.querySelectorAll("[data-ph]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); draw();
    }));
    draw();
    setupFigure(root, () => { shown = 0; draw(); }, async (alive) => { for (let i = 1; i <= N; i++) { await wait(0.14); if (!alive()) return; shown = i; draw(); } });
  });
</script>
