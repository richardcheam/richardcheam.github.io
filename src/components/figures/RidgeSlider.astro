---
// Foundations, regularisation post: the degree 7 fit with an L2 penalty
// (λ/2) Σ_{j≥1} w_j² on the weights. Training / validation MSE: λ 0 →
// 0.000/0.090; 0.0002 → 0.057/0.041; 1 → 0.513/0.374 (src/lib/poly.ts).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-ridge>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="rs-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rs-title">A degree 7 fit smoothed by a weight penalty, with its weights shrinking</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Strength λ <strong data-vl></strong></span><input class="scrub" data-l type="range" min="-7.25" max="0" step="0.05" value="-3.7" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, NEG, GOLD } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  import { fit, mse, predict, TRAIN_X, TRAIN_Y, VAL_X, VAL_Y } from "../../lib/poly";
  const VISIT = [[0, "No penalty: the curve threads every training point and swings wildly between them."], [1e-5, "A tiny penalty already tames the biggest swings."], [1e-4, "The weights have shrunk from thousands to tens."], [2e-4, "Near the best validation error: a smooth wave that beats the plain cubic."], [1e-3, "Stronger: the wave starts to flatten."], [1e-2, "Too strong: the curve is underfitting."], [1e-1, "Most weights are near zero."], [1, "Every weight crushed: almost a flat line at the average."]] as const;
  document.querySelectorAll<HTMLElement>("[data-ridge]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let lam = 2e-4;
    const setLam = (v: number) => { lam = v; $<HTMLInputElement>("[data-l]").value = String(v === 0 ? -7.25 : Math.log10(v)); };
    const stats = (l: number) => { const w = fit(7, l); return { w, tr: mse(w, TRAIN_X, TRAIN_Y), va: mse(w, VAL_X, VAL_Y) }; };
    const steps = () => VISIT.map(([l, say]) => { const s = stats(l); return { say, math: `λ = ${l === 0 ? "0" : fmt(l, 6)}: training MSE ${fmt(s.tr, 4)}, validation MSE ${fmt(s.va, 4)}\nweights w₁ to w₇: ${s.w.slice(1).map((x) => fmt(x, 2)).join(", ")}`, enter: () => setLam(l) }; });
    function draw() {
      const st = stats(lam), F = frame({ l: 40, t: 30, w: 400, h: 240, x0: 0, x1: 1, y0: -2, y1: 2 });
      let s = `<clipPath id="rs-clip"><rect x="40" y="30" width="400" height="240"/></clipPath>` + F.grid([0, 0.5, 1], [-2, -1, 0, 1, 2], 1);
      s += txt(40, 18, `Degree 7 fit with penalty strength λ = ${lam === 0 ? "0" : fmt(lam, 6)}`, `font-size="12" font-weight="700" fill="${INK}"`);
      s += `<g clip-path="url(#rs-clip)">` + F.curve((x) => Math.sin(2 * Math.PI * x), `stroke="#cfd5d4" stroke-width="2" stroke-dasharray="5 4"`) + F.curve((x) => predict(st.w, x), `stroke="${JADE}" stroke-width="2.8"`, 300) + `</g>`;
      TRAIN_X.forEach((x, i) => (s += `<circle cx="${F.X(x)}" cy="${F.Y(TRAIN_Y[i])}" r="5.5" fill="${INK}"/>`));
      VAL_X.forEach((x, i) => (s += `<circle cx="${F.X(x)}" cy="${F.Y(VAL_Y[i])}" r="5" fill="#fff" stroke="${NEG}" stroke-width="2"/>`));
      // Weight sizes on a log scale, since they span thousands to hundredths.
      s += txt(490, 18, "Size of each weight (log scale)", `font-size="12" font-weight="700" fill="${INK}"`);
      const by = (v: number) => Math.max(0, Math.min(1, (Math.log10(Math.max(Math.abs(v), 0.01)) + 2) / 6)) * 150;
      [0.01, 1, 100, 10000].forEach((v) => { const y = 200 - by(v); s += `<line x1="490" x2="740" y1="${y}" y2="${y}" stroke="#eef0f0"/>` + txt(486, y + 4, fmt(v, 2), `font-size="10" text-anchor="end" fill="${MUTED}"`); });
      st.w.slice(1).forEach((v, j) => { const h = by(v), x = 500 + j * 34; s += `<rect x="${x}" y="${200 - h}" width="22" height="${h}" fill="${v >= 0 ? JADE : NEG}" fill-opacity="0.8"/>` + txt(x + 11, 216, `w${"₁₂₃₄₅₆₇"[j]}`, `font-size="10.5" text-anchor="middle" fill="${MUTED}"`); });
      s += txt(490, 246, `training ${fmt(st.tr, 4)}`, `font-size="12.5" font-weight="700" fill="${INK}"`) + txt(610, 246, `validation ${fmt(st.va, 4)}`, `font-size="12.5" font-weight="700" fill="${NEG}"`);
      s += txt(490, 266, "green positive, red negative; best validation near λ = 0.0002", `font-size="11" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vl]").textContent = lam === 0 ? "0" : fmt(lam, 6);
    }
    const redraw = stepper(root, steps, draw, { delay: 2.2 });
    $<HTMLInputElement>("[data-l]").addEventListener("input", (e) => { const v = +(e.target as HTMLInputElement).value; lam = v <= -7.2 ? 0 : Math.round(10 ** v * 1e7) / 1e7; redraw(); });
  });
</script>
