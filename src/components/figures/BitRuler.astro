---
// Figure 4: bit depth as a ruler. 48 samples (2 ms at 24 kHz) of a 1 kHz wave
// snap to the nearest of 2^bits heights; red bars are the rounding error.
const { alt } = Astro.props;
---
<div class="blog-diagram br" role="region" aria-label={alt} data-br>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 330" role="img" aria-labelledby="br-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="br-title">Samples rounded to the nearest mark of a ruler with 2 to the power bits marks</title>
    <g data-ticks></g>
    <path data-true d="" fill="none" stroke="#b9b9c2" stroke-width="1.5" />
    <g data-dots></g>
    <text x="70" y="262" font-size="10.5" fill="#5f5f66">0 ms</text>
    <text x="740" y="262" font-size="10.5" text-anchor="end" fill="#5f5f66">2 ms (48 samples at 24 kHz)</text>
    <text data-r1 x="70" y="290" font-size="12.5" fill="#2b2b30"></text>
    <text data-r2 x="70" y="312" font-size="12" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Bits per sample<strong data-vb></strong></span><input class="scrub" data-bits type="range" min="1" max="16" step="1" value="3" /></label>
    <div><span class="fig-panel__name">Hear it</span><div class="fig-chips"><button type="button" class="fig-chip" data-listen>▶ Listen (1 s, 440 Hz)</button></div></div>
  </div>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-br]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const bits = $<HTMLInputElement>("[data-bits]");
    const X = (i: number) => 70 + (i / 48) * 670, Y = (v: number) => 130 - v * 100;
    const sig = (t: number) => 0.85 * Math.sin(2 * Math.PI * 1000 * t);
    const q = (v: number, b: number) => { const L = 2 ** b, step = 2 / L; return Math.min(L - 1, Math.max(0, Math.floor((v + 1) / step))) * step - 1 + step / 2; };
    let d = "";
    for (let px = 0; px <= 670; px += 2) d += `${px ? "L" : "M"}${70 + px} ${Y(sig(px / 670 * 0.002)).toFixed(1)}`;
    $("[data-true]").setAttribute("d", d);
    const mk = (tag: string, attrs: Record<string, string | number>) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, String(attrs[k])); return e; };
    function draw() {
      const b = +bits.value, L = 2 ** b, step = 2 / L;
      bits.style.setProperty("--p", `${((b - 1) / 15) * 100}%`);
      const ticks = $("[data-ticks]"); ticks.replaceChildren();
      if (b <= 6) for (let k = 0; k < L; k++) {
        const y = Y(-1 + step / 2 + k * step);
        ticks.append(mk("line", { x1: 60, x2: 740, y1: y, y2: y, stroke: "#594578", "stroke-opacity": b <= 4 ? 0.35 : 0.15 }));
        if (b <= 4) { const tx = mk("text", { x: 54, y: y + 3.5, "font-size": 9.5, "text-anchor": "end", fill: "#594578", "font-family": "ui-monospace, Menlo, monospace" }); tx.textContent = String(k); ticks.append(tx); }
      }
      else ticks.append(mk("rect", { x: 60, y: Y(1), width: 680, height: 200, fill: "#594578", "fill-opacity": 0.05 }));
      const g = $("[data-dots]"); g.replaceChildren();
      for (let i = 0; i < 48; i++) {
        const v = sig(i / 24000), qv = q(v, b);
        g.append(mk("line", { x1: X(i), x2: X(i), y1: Y(v), y2: Y(qv), stroke: "#a33b3b", "stroke-width": 3 }));
        g.append(mk("circle", { cx: X(i), cy: Y(qv), r: 3.2, fill: "#594578" }));
      }
      $("[data-vb]").textContent = `${b} bit${b > 1 ? "s" : ""}`;
      $("[data-r1]").innerHTML = `<tspan font-weight="700">${b}</tspan> bits = <tspan font-weight="700">${L.toLocaleString("en")}</tspan> possible heights. Largest rounding error: half a step.`;
      $("[data-r2]").textContent = `Rounding hiss sits about 6 × ${b} = ${6 * b} dB below the loudest sound${b === 16 ? " (CD quality: 96 dB)" : ""}.`;
    }
    let ctx: AudioContext | null = null;
    $("[data-listen]").addEventListener("click", () => {
      ctx ??= new AudioContext();
      const sr = ctx.sampleRate, buf = ctx.createBuffer(1, sr, sr), ch = buf.getChannelData(0), b = +bits.value;
      for (let i = 0; i < sr; i++) { const fade = Math.min(1, i / 800, (sr - i) / 800); ch[i] = 0.25 * q(0.9 * Math.sin(2 * Math.PI * 440 * i / sr), b) * fade; }
      const src = ctx.createBufferSource(); src.buffer = buf; src.connect(ctx.destination); src.start();
    });
    bits.addEventListener("input", draw);
    draw();
  });
</script>
