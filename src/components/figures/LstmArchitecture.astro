---
// Foundations, LSTM and GRU post: the whole LSTM from input to output on the
// same character task as the RNN post, "hell" → "ello", with a trained
// 2-unit cell (src/lib/charseq.ts). Each step: four gates, the cell belt
// update, the hidden state, and next-character probabilities.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-lstm-arch>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 420" role="img" aria-labelledby="la-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="la-title">An LSTM unrolled over four characters: gates, cell belt, hidden state and next-character probabilities</title>
    <g data-draw></g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, NEG, JADE, GOLD, TINT } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { VOCAB, INPUT, TARGET, lstmRun } from "../../lib/charseq";
  const v2 = (v: number[], d = 3) => `(${v.map((x) => fmt(x, d)).join(", ")})`;
  const RUN = lstmRun();
  const GEN = (() => { let s = "h"; for (let t = 0; t < 4; t++) { const r = lstmRun(s, s); const p = r[r.length - 1].p; s += VOCAB[p.indexOf(Math.max(...p))]; } return s; })();
  const COLX = (t: number) => 196 + t * 150;
  const GATE_COL: Record<string, string> = { f: NEG, i: JADE, g: "#3E6E9E", o: GOLD };
  document.querySelectorAll<HTMLElement>("[data-lstm-arch]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const steps = () => [
      { say: "Same task as the RNN post: read \"hell\" one character at a time and predict the next one. The LSTM carries two memories: the cell belt c (long-term) and the hidden state h (what it shows the outside). Both have 2 numbers here and start at zero.", math: `inputs: one-hot h, e, l, l;  targets: ${[...TARGET].join(", ")}` },
      ...RUN.flatMap((s, t) => [
        { say: `Step ${t + 1} reads "${INPUT[t]}". Four small layers look at the input and the previous h, each giving 2 numbers: three gates between 0 and 1 (sigmoid), and a candidate memory between −1 and 1 (tanh).`,
          math: `forget f = ${v2(s.f)}   input i = ${v2(s.i)}\noutput o = ${v2(s.o)}   candidate g = ${v2(s.g)}` },
        { say: t === 0 ? "Update the belt: keep f of the old memory and add i of the candidate. Then show part of it: h = o × tanh(c)." : t === 3 ? "The belt still carries what the earlier letters wrote, so this second \"l\" ends with a different h from the first one." : "Update the belt, then read h out of it.",
          math: `c = f × c_prev + i × g = ${s.c.map((_, k) => `${fmt(s.f[k], 3)} × ${par(s.cPrev[k], 3)} + ${fmt(s.i[k], 3)} × ${par(s.g[k], 3)}`).join(";  ")}\n  = ${v2(s.c)}\nh = o × tanh(c) = ${v2(s.h)}` },
        { say: t === 3 ? `Same input as step 3, different prediction: "o" instead of "l". The memory made the difference.` : `Read h out as one score per character, softmax, and score the target "${TARGET[t]}".`,
          math: `softmax = ${VOCAB.map((c, i) => `${c} ${fmt(s.p[i], 3)}`).join(", ")}\nloss = −ln p(${TARGET[t]}) = ${fmt(s.loss, 4)}` },
      ]),
      { say: "Training: average the four losses and backpropagate through time. The gradient can travel back along the belt, scaled only by the forget gates, which is why LSTMs remember longer.", math: `L = (${RUN.map((s) => fmt(s.loss, 4)).join(" + ")}) / 4 = ${fmt(RUN.reduce((a, s) => a + s.loss, 0) / 4, 4)}` },
      { say: `Generating: start from "h" and feed each most likely character back in. The model writes "${GEN}".`, math: `h → ${[...GEN.slice(1)].join(" → ")}` },
    ];
    function draw(k: number) {
      const done = (t: number, part: number) => k >= 1 + 3 * t + part, cur = k >= 1 && k <= 12 ? Math.floor((k - 1) / 3) : -1;
      let s = "";
      [["next character", "probabilities", 70], ["cell belt c", "long-term", 166], ["gates", "f, i, g, o", 230], ["hidden h", "short-term", 288], ["input x", "one-hot", 352]].forEach(([a, b, y]) => (s += txt(10, y as number, a as string, `font-size="10.5" font-weight="700" fill="${MUTED}"`) + txt(10, (y as number) + 14, b as string, `font-size="10" fill="${MUTED}"`)));
      const cell = (x: number, y: number, v: number, show: boolean) => `<rect x="${x}" y="${y}" width="40" height="26" rx="4" fill="${show ? (v >= 0 ? JADE : NEG) : "#fff"}" fill-opacity="${show ? 0.15 + 0.6 * Math.min(1, Math.abs(v)) : 1}" stroke="${INK}"/>` + txt(x + 20, y + 17, show ? fmt(v, 2) : "", `font-size="10.5" font-weight="700" text-anchor="middle" fill="${INK}"`);
      RUN.forEach((st, t) => {
        const cx = COLX(t);
        if (t === cur) s += `<rect x="${cx - 68}" y="16" width="136" height="392" rx="10" fill="${TINT}" fill-opacity="0.55"/>`;
        // Input.
        s += txt(cx, 336, `"${INPUT[t]}"`, `font-size="14" font-weight="700" text-anchor="middle" fill="${INK}"`);
        VOCAB.forEach((c, i) => (s += `<rect x="${cx - 46 + i * 23}" y="344" width="21" height="21" rx="3" fill="${i === st.x ? INK : "#fff"}" stroke="#cfd5d4"/>` + txt(cx - 35.5 + i * 23, 380, c, `font-size="9.5" text-anchor="middle" fill="${MUTED}"`)));
        // Gates: four pairs of thin bars.
        (["f", "i", "g", "o"] as const).forEach((gn, gi) => { const vals = st[gn], gx = cx - 60 + gi * 31; s += txt(gx + 13, 214, gn, `font-size="10.5" font-weight="700" text-anchor="middle" fill="${GATE_COL[gn]}"`); vals.forEach((v, j) => { const h = done(t, 0) ? Math.abs(v) * 26 : 0; s += `<rect x="${gx + j * 13}" y="220" width="11" height="28" fill="#f1f3f3"/><rect x="${gx + j * 13}" y="${248 - h}" width="11" height="${h}" fill="${GATE_COL[gn]}" fill-opacity="0.8"/>`; }); });
        // Belt and hidden.
        st.c.forEach((v, j) => (s += cell(cx - 42 + j * 44, 156, v, done(t, 1))));
        st.h.forEach((v, j) => (s += cell(cx - 42 + j * 44, 278, v, done(t, 1))));
        if (t > 0) { s += arrow(COLX(t - 1) + 50, 169, cx - 46, 169, done(t, 1) ? NEG : "#cfd5d4", 2.5) + arrow(COLX(t - 1) + 50, 291, cx - 46, 291, done(t, 1) ? GOLD : "#cfd5d4", 1.5); }
        s += arrow(cx, 276, cx, 252, done(t, 1) ? INK : "#cfd5d4", 1) + arrow(cx, 154, cx, 136, done(t, 2) ? INK : "#cfd5d4", 1.2);
        // Output.
        VOCAB.forEach((c, i) => { const y = 34 + i * 24, w = done(t, 2) ? st.p[i] * 70 : 0, tgt = i === st.y; s += txt(cx - 50, y + 12, c, `font-size="11" font-weight="${tgt ? 700 : 400}" text-anchor="end" fill="${tgt ? GOLD : INK}"`) + `<rect x="${cx - 44}" y="${y + 1}" width="70" height="15" fill="#f1f3f3"/><rect x="${cx - 44}" y="${y + 1}" width="${w}" height="15" fill="${tgt ? GOLD : JADE}" fill-opacity="0.85"/>` + (done(t, 2) ? txt(cx + 30, y + 12, fmt(st.p[i], 3), `font-size="9.5" fill="${INK}"`) : ""); });
        s += txt(cx, 24, `target "${TARGET[t]}"`, `font-size="10.5" text-anchor="middle" fill="${GOLD}"`);
      });
      if (k >= 13) s += txt(380, 404, `average loss ${fmt(RUN.reduce((a, q) => a + q.loss, 0) / 4, 4)}`, `font-size="12" font-weight="700" text-anchor="middle" fill="${GOLD}"`);
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2.6 });
  });
</script>
