---
// Model development, "Building a pre-training corpus": how deduplicating
// across crawls changes the mixture, in a toy where the pages repeated across
// crawls are good (as FineWeb found for its 2013 snapshot, §3.4, Fig. 4; not a
// general rule). Three crawls of 10 pages, 6 repeated good pages, 4 seen once
// (1 good, 3 spam). Global: 18 pages, 50% good; per crawl: 30 pages, 70% good. Matches
// scripts/course/p2_corpus.py.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-snapshot-dedup>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 370" role="img" aria-labelledby="sd-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="sd-title">Three crawls of ten pages deduplicated globally, newest first, and then each crawl on its own</title>
    <g data-draw></g>
  </svg>
  <noscript><p>A toy: three crawls each hold the same six good pages plus four pages seen only once: one good and three spam. Deduplicating across all crawls, newest first, removes the six recrawled pages from the two older crawls, so each older crawl keeps one good page and three spam pages: 18 pages remain, half of them good. Deduplicating each crawl on its own removes nothing here: 30 pages remain, 70% good, with each stable page repeated three times.</p></noscript>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { INK, MUTED, JADE, NEG, TINT, DEAD } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const YEARS = ["2013", "2018", "2023"];
  type Page = { label: string; good: boolean; stable: boolean };
  const crawl = (): Page[] => [
    ...Array.from({ length: 6 }, (_, i) => ({ label: `page ${i + 1}`, good: true, stable: true })),
    { label: "new, good", good: true, stable: false },
    ...Array.from({ length: 3 }, () => ({ label: "spam", good: false, stable: false })),
  ];
  const CRAWLS = YEARS.map(crawl);
  const COLX = (c: number) => 40 + c * 240, TW = 96, TH = 26;
  const tileXY = (c: number, i: number) => ({ x: COLX(c) + (i % 2) * (TW + 8), y: 50 + Math.floor(i / 2) * (TH + 8) });
  document.querySelectorAll<HTMLElement>("[data-snapshot-dedup]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const steps = () => [
      { say: "A toy: three crawls of ten pages each. In this toy, the six pages repeated in every crawl are good, and of the four pages seen only once, one is good and three are spam.", math: "each crawl: 6 recrawled good + 1 new good + 3 spam" },
      { say: "Deduplicate across all crawls, newest first. The 2023 crawl is processed first, so it keeps all ten pages.", math: "2023: keep 10" },
      { say: "In 2018 the six recrawled pages were already kept from 2023, so they are removed. Only the four pages seen once survive.", math: "2018: keep 4" },
      { say: "The same happens to 2013. What survives in the old crawl is what appeared only once, and in this toy that is mostly spam.", math: "2013: keep 1 good + 3 spam" },
      { say: "Across all crawls, 18 pages remain, and only half of them are good. Here deduplication removed the good pages' extra copies, so spam's share rose. With different data, where the repeated pages were junk, the same step would have helped.", math: "global: 9 good of 18 = 50%" },
      { say: "Deduplicate each crawl on its own instead. Nothing is removed in this toy, because no crawl repeats a page within itself. The repeated pages now appear three times each, and in this toy the mixture is better.", math: "per crawl: 21 good of 30 = 70%" },
    ];
    function removed(c: number, p: Page, k: number) { return k >= 1 && k <= 4 && p.stable && ((c === 1 && k >= 2) || (c === 0 && k >= 3)); }
    function draw(k: number) {
      let s = "";
      CRAWLS.forEach((pages, c) => {
        const active = (k === 1 && c === 2) || (k === 2 && c === 1) || (k === 3 && c === 0);
        s += `<rect x="${COLX(c) - 10}" y="16" width="${2 * TW + 28}" height="${5 * (TH + 8) + 46}" rx="10" fill="none" stroke="${active ? INK : "#D9DEDD"}" stroke-width="${active ? 2 : 1}"/>`;
        s += txt(COLX(c), 38, `crawl ${YEARS[c]}`, `font-size="12.5" font-weight="700" fill="${INK}"`);
        pages.forEach((p, i) => {
          const { x, y } = tileXY(c, i), gone = removed(c, p, k);
          const fill = gone ? DEAD : p.good ? TINT : "#F6DCD5", stroke = gone ? "#C8CFCE" : p.good ? JADE : NEG;
          s += `<rect x="${x}" y="${y}" width="${TW}" height="${TH}" rx="5" fill="${fill}" stroke="${stroke}" stroke-dasharray="${p.stable ? "" : "4 3"}"/>`;
          s += txt(x + TW / 2, y + 17, gone ? "removed" : p.label, `font-size="11" text-anchor="middle" fill="${gone ? "#A9B1B0" : INK}"`);
        });
        if (k >= 1 && k <= 4) {
          const kept = pages.filter((p) => !removed(c, p, k));
          const done = (c === 2 && k >= 1) || (c === 1 && k >= 2) || (c === 0 && k >= 3);
          if (done) s += txt(COLX(c), 5 * (TH + 8) + 72, `keeps ${kept.length}: ${kept.filter((p) => p.good).length} good`, `font-size="11.5" font-weight="700" fill="${kept.filter((p) => p.good).length * 2 > kept.length ? JADE : NEG}"`);
        }
        if (k >= 5) s += txt(COLX(c), 5 * (TH + 8) + 72, "keeps 10: 7 good", `font-size="11.5" font-weight="700" fill="${JADE}"`);
      });
      // Share of good pages in what remains.
      if (k >= 4) {
        const share = k >= 5 ? 0.7 : 0.5, n = k >= 5 ? 30 : 18, good = k >= 5 ? 21 : 9;
        const bx = 40, by = 300, bw = 680;
        s += `<rect x="${bx}" y="${by}" width="${bw}" height="20" rx="4" fill="#F6DCD5" stroke="${NEG}" stroke-opacity="0.5"/>`;
        s += `<rect x="${bx}" y="${by}" width="${bw * share}" height="20" rx="4" fill="${JADE}" fill-opacity="0.85"/>`;
        s += txt(bx + 8, by + 14, `${good} good`, `font-size="11.5" font-weight="700" fill="#fff"`);
        s += txt(bx + bw - 8, by + 14, `${n - good} spam`, `font-size="11.5" font-weight="700" text-anchor="end" fill="${NEG}"`);
        s += txt(bx, by + 40, k >= 5 ? `per-crawl deduplication: ${n} pages, ${Math.round(share * 100)}% good` : `global deduplication: ${n} pages, ${Math.round(share * 100)}% good`, `font-size="12" font-weight="700" fill="${INK}"`);
        s += txt(bx + bw, by + 40, "illustrative numbers", `font-size="10.5" text-anchor="end" fill="${MUTED}"`);
      }
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2.8 });
  });
</script>
