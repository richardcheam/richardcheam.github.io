---
// Foundations, LSTM and GRU post: the gradient along the plain RNN's road
// (w_h × tanh slope per step) against the LSTM belt (forget gate per step).
// At 20 steps back: RNN (w_h 0.5, slopes on) 7.9 × 10^−7; LSTM b_f 3
// (f 0.9526) 0.3784; b_f 2 0.0790; b_f 1 0.0019.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-conveyor>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 270" role="img" aria-labelledby="cg2-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="cg2-title">Gradient size against steps back for a plain RNN and an LSTM belt</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">RNN w_h <strong data-v="wh"></strong></span><input class="scrub" data-k="wh" type="range" min="0.1" max="1.5" step="0.05" value="0.5" /></label>
    <label><span class="fig-panel__name">LSTM forget bias b_f <strong data-v="bf"></strong></span><input class="scrub" data-k="bf" type="range" min="-2" max="6" step="0.1" value="3" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { sig } from "../../lib/lstm";
  const K = 30, BLUE = "#3E6E9E";
  const show = (v: number) => (v >= 0.001 ? fmt(v, 4) : v.toExponential(1).replace("e-", " × 10^−"));
  document.querySelectorAll<HTMLElement>("[data-conveyor]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { wh: 0.5, bf: 3 };
    const setBf = (v: number) => { p.bf = v; $<HTMLInputElement>('[data-k="bf"]').value = String(v); };
    const rnn = () => { const hs = [Math.tanh(1)]; for (let t = 1; t <= K; t++) hs.push(Math.tanh(p.wh * hs[t - 1])); const out = [1]; let q = 1; for (let k = 1; k <= K; k++) { q *= p.wh * (1 - hs[k] ** 2); out.push(q); } return out; };
    const lstm = () => Array.from({ length: K + 1 }, (_, k) => sig(p.bf) ** k);
    const steps = () => [0, 1, 2, 3].map((b) => { const f = sig(b); return { say: b === 0 ? "Forget bias 0 gives f = 0.5: the belt is no better than the plain RNN's road." : b === 3 ? "Forget bias 3 gives f = 0.9526: over a third of the gradient survives twenty steps." : `Forget bias ${b}: f = ${fmt(f, 4)} per step.`, math: `belt: ${fmt(f, 4)}^20 = ${show(f ** 20)};   plain RNN at 20 steps: ${show(rnn()[20])}`, enter: () => setBf(b) }; });
    function draw() {
      const a = rnn(), b = lstm(), lx = (k: number) => 70 + (k / K) * 430, ly = (v: number) => 30 + ((1 - Math.log10(Math.max(1e-10, Math.min(10, v)))) / 11) * 210;
      let s = txt(70, 18, "Gradient that survives k steps back (log scale)", `font-size="12" font-weight="700" fill="${INK}"`);
      [10, 1, 1e-3, 1e-6, 1e-10].forEach((v) => (s += `<line x1="70" x2="500" y1="${ly(v)}" y2="${ly(v)}" stroke="${v === 1 ? INK : "#eef0f0"}"/>` + txt(64, ly(v) + 4, v >= 1 ? fmt(v) : `10^${Math.round(Math.log10(v))}`, `font-size="10" text-anchor="end" fill="${MUTED}"`)));
      [0, 10, 20, 30].forEach((k) => (s += txt(lx(k), 256, String(k), `font-size="10.5" text-anchor="middle" fill="${MUTED}"`)));
      s += `<polyline fill="none" stroke="${BLUE}" stroke-width="2.5" points="${a.map((v, k) => `${lx(k).toFixed(1)},${ly(v).toFixed(1)}`).join(" ")}"/><polyline fill="none" stroke="${GOLD}" stroke-width="2.8" points="${b.map((v, k) => `${lx(k).toFixed(1)},${ly(v).toFixed(1)}`).join(" ")}"/>`;
      s += `<rect x="530" y="40" width="14" height="4" fill="${BLUE}"/>` + txt(552, 46, `plain RNN, w_h = ${fmt(p.wh, 2)}`, `font-size="12" font-weight="700" fill="${INK}"`) + `<rect x="530" y="140" width="14" height="4" fill="${GOLD}"/>` + txt(552, 146, `LSTM belt, f = σ(${fmt(p.bf, 1)}) = ${fmt(sig(p.bf), 4)}`, `font-size="12" font-weight="700" fill="${INK}"`);
      [10, 20, 30].forEach((k, i) => (s += txt(552, 68 + i * 20, `${k} back: ${show(a[k])}`, `font-size="11.5" fill="${INK}"`) + txt(552, 168 + i * 20, `${k} back: ${show(b[k])}`, `font-size="11.5" fill="${INK}"`)));
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[el.dataset.v!], 2)));
    }
    const redraw = stepper(root, steps, draw, { delay: 2 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
  });
</script>
