---
// Foundations, Transformer post: one pre-norm block on "the cat sat" with
// d = 2 and hand-picked weights (src/lib/transformer.ts). "the": (1, 0) →
// (2.066, 0.606) after attention → (2.745, −0.272). "sat" ends at
// (2.284, 1.611).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-toytf>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="tt-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="tt-title">Three token vectors passing through every operation of one Transformer block</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Show the arithmetic for</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-t="0" aria-pressed="true">the</button><button type="button" class="fig-chip" data-t="1" aria-pressed="false">cat</button><button type="button" class="fig-chip" data-t="2" aria-pressed="false">sat</button>
    </div></div>
    <div><span class="fig-panel__name">Mask</span><div class="fig-chips"><button type="button" class="fig-chip" data-c aria-pressed="false">Causal</button></div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { toyBlock, TOK, POS, rms } from "../../lib/transformer";
  const NAMES = ["the", "cat", "sat"], STAGES = ["embedding + position", "norm", "attention", "add (residual)", "norm", "feed-forward", "add (residual)"];
  document.querySelectorAll<HTMLElement>("[data-toytf]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let t = 0, causal = false;
    const v2 = (v: number[]) => `(${v.map((x) => fmt(x, 3)).join(", ")})`;
    const steps = () => { const b = toyBlock(causal), n = NAMES[t]; return [
      { say: "Look up each token's embedding and add its position vector.", math: `${n}: ${v2(TOK[t])} + ${v2(POS[t])} = ${v2(b.x[t])}` },
      { say: "RMSNorm a copy of each vector: divide by its root mean square.", math: `${n}: rms = ${fmt(rms(b.x[t]), 4)}, so ${v2(b.x[t])} / ${fmt(rms(b.x[t]), 4)} = ${v2(b.n1[t])}` },
      { say: `Attention: scores are dot products ÷ √2, softmaxed per row, then the normalised vectors are blended.${causal ? " The causal mask hides later tokens." : ""}`, math: `${n} scores ${b.scores[t].map((v) => (Number.isFinite(v) ? fmt(v, 3) : "−∞")).join(", ")} → weights ${b.w[t].map((v) => fmt(v, 3)).join(", ")}\nblend = ${v2(b.attn[t])}` },
      { say: "Add attention's output back onto the highway.", math: `${n}: ${v2(b.x[t])} + ${v2(b.attn[t])} = ${v2(b.h[t])}` },
      { say: "Normalise a copy again for the feed-forward branch.", math: `${n}: rms ${fmt(rms(b.h[t]), 4)} → ${v2(b.n2[t])}` },
      { say: "Feed-forward: widen to 4, ReLU, narrow back to 2.", math: `${n}: hidden ${b.hid[t].map((v) => fmt(v, 3)).join(", ")} → ReLU ${b.act[t].map((v) => fmt(v, 3)).join(", ")} → ${v2(b.ffn[t])}` },
      { say: "Add it onto the highway. Three tokens of width 2 in, three out, ready for the next block.", math: `${n}: ${v2(b.h[t])} + ${v2(b.ffn[t])} = ${v2(b.y[t])}` },
    ]; };
    function draw(k: number) {
      const b = toyBlock(causal), rows = [b.x, b.n1, b.attn, b.h, b.n2, b.ffn, b.y];
      let s = "";
      NAMES.forEach((n, i) => (s += txt(220 + i * 170, 22, n, `font-size="13" font-weight="700" text-anchor="middle" fill="${i === t ? GOLD : INK}"`)));
      STAGES.forEach((st, r) => {
        const y = 44 + r * 36, on = r === k;
        s += txt(30, y + 18, st, `font-size="11.5" font-weight="${on ? 700 : 400}" fill="${r <= k ? INK : "#B9C0BF"}"`);
        rows[r].forEach((v, i) => (s += `<rect x="${160 + i * 170}" y="${y}" width="120" height="28" rx="5" fill="${on && i === t ? TINT : "#fff"}" stroke="${on ? (i === t ? GOLD : JADE) : "#e3e7e6"}" stroke-width="${on && i === t ? 2.5 : 1}"/>` + txt(220 + i * 170, y + 19, r <= k ? v2(v) : "", `font-size="11.5" font-weight="700" text-anchor="middle" fill="${INK}"`)));
      });
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    root.querySelectorAll<HTMLButtonElement>("[data-t]").forEach((bt) => bt.addEventListener("click", () => { t = +bt.dataset.t!; root.querySelectorAll("[data-t]").forEach((o) => o.setAttribute("aria-pressed", String(o === bt))); redraw(); }));
    $<HTMLButtonElement>("[data-c]").addEventListener("click", (e) => { causal = !causal; (e.currentTarget as HTMLElement).setAttribute("aria-pressed", String(causal)); redraw(); });
  });
</script>
