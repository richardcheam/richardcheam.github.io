---
// Euler integration on a curved (circular) velocity field against a learned
// one-step flow map. Play animates the Euler steps one by one so the drift from
// the true trajectory visibly accumulates; the slider redraws instantly.
const { alt } = Astro.props;
---
<div class="blog-diagram osd" role="region" aria-label={alt} data-osd>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 250" role="img" aria-labelledby="osd-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="osd-title">Euler integration error against a learned one-step jump</title>
    <defs><marker id="osd-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="#4F5D3A" stroke-width="1.6" /></marker></defs>
    <path data-true fill="none" stroke="#d5d5dc" stroke-width="2" stroke-dasharray="5 4" />
    <g data-ghosts fill="none" stroke="#594578" stroke-opacity="0.25" stroke-width="1"></g>
    <g data-segments stroke="#594578" stroke-width="2" stroke-linecap="round"></g>
    <g data-dots fill="#594578"></g>
    <line data-jump stroke="#4F5D3A" stroke-width="2.4" marker-end="url(#osd-a)" pathLength="1" />
    <circle data-start r="7" fill="#d5d5dc" stroke="#5f5f66" />
    <circle data-end r="7" fill="#4F5D3A" />
    <text data-readout x="470" y="60" font-size="14" fill="#2b2b30"></text>
    <text data-readout2 x="470" y="86" font-size="14" fill="#5f5f66"></text>
    <text x="470" y="128" font-size="13" fill="#594578">purple · Euler on the velocity field</text>
    <text x="470" y="150" font-size="13" fill="#4F5D3A">green · one call to the flow map</text>
    <text x="470" y="172" font-size="13" fill="#5f5f66">dashed · exact trajectory</text>
    <text x="470" y="194" font-size="13" fill="#594578" fill-opacity="0.6">faint · how far each step lands from it</text>
  </svg>
  <div class="osd__controls">
    <button type="button" data-play>Play</button>
    <label class="osd__range"><span>Euler steps <strong data-n>4</strong></span><span class="osd__scrub"><input class="scrub" data-range type="range" min="1" max="32" value="4" style="--n: 31" /><span class="scrub-scale" aria-hidden="true"><span>1</span><span>8</span><span>16</span><span>24</span><span>32</span></span></span></label>
  </div>
</div>

<style>
  .osd__controls { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .osd__controls button {
    min-height: 36px;
    padding: 0 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .osd__controls button:hover { border-color: var(--text); }
  .osd__range { display: flex; align-items: center; gap: 1rem; flex: 1 1 20rem; font-size: 0.9rem; color: var(--text-secondary); }
  .osd__range strong { display: inline-block; min-width: 2ch; color: var(--text); font-family: var(--font-mono); }
  .osd__scrub { flex: 1; max-width: 460px; }
</style>

<script>
  import { animate } from "motion/mini";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const NS = "http://www.w3.org/2000/svg";

  document.querySelectorAll<HTMLElement>("[data-osd]").forEach((root) => {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    // A quarter-ish arc around (cx, cy): the exact solution of a rotating field. Sized so
    // even the 1-step Euler overshoot stays inside the 780x250 frame.
    const cx = 230, cy = 238, r = 105, a0 = Math.PI * 0.95, a1 = Math.PI * 0.3;
    const w = a1 - a0;
    const pt = (a: number) => [cx + r * Math.cos(a), cy - r * Math.sin(a)];
    const s = pt(a0), e = pt(a1);
    let d = `M${s[0]} ${s[1]}`;
    for (let i = 1; i <= 60; i++) { const p = pt(a0 + (w * i) / 60); d += ` L${p[0].toFixed(1)} ${p[1].toFixed(1)}`; }
    $("[data-true]").setAttribute("d", d);
    $("[data-start]").setAttribute("cx", String(s[0])); $("[data-start]").setAttribute("cy", String(s[1]));
    $("[data-end]").setAttribute("cx", String(e[0])); $("[data-end]").setAttribute("cy", String(e[1]));
    const jump = $<SVGLineElement>("[data-jump]");
    jump.setAttribute("x1", String(s[0])); jump.setAttribute("y1", String(s[1]));
    jump.setAttribute("x2", String(e[0] - 6)); jump.setAttribute("y2", String(e[1] + 4));

    const segs = $<SVGGElement>("[data-segments]"), dots = $<SVGGElement>("[data-dots]"), ghosts = $<SVGGElement>("[data-ghosts]");
    const range = $<HTMLInputElement>("[data-range]"), play = $<HTMLButtonElement>("[data-play]");
    const readout = $("[data-readout]"), readout2 = $("[data-readout2]");
    let token = 0;

    // Euler with n equal steps; returns every point and its miss from the exact point at the same time.
    function euler(n: number) {
      let x = s[0], y = s[1];
      const pts = [{ x, y, miss: 0, tx: s[0], ty: s[1] }];
      for (let k = 1; k <= n; k++) {
        const vx = w * (y - cy), vy = -w * (x - cx);
        x += vx / n; y += vy / n;
        const t = pt(a0 + (w * k) / n);
        pts.push({ x, y, miss: Math.hypot(x - t[0], y - t[1]) / r, tx: t[0], ty: t[1] });
      }
      return pts;
    }

    function el(tag: string, attrs: Record<string, string | number>) {
      const node = document.createElementNS(NS, tag);
      for (const k in attrs) node.setAttribute(k, String(attrs[k]));
      return node;
    }

    // Build all elements for n steps; `hidden` leaves them invisible for the animation to reveal.
    function build(n: number, hidden: boolean) {
      segs.replaceChildren(); dots.replaceChildren(); ghosts.replaceChildren();
      const pts = euler(n);
      for (let k = 1; k <= n; k++) {
        const a = pts[k - 1], b = pts[k];
        const seg = el("line", { x1: a.x, y1: a.y, x2: b.x, y2: b.y, pathLength: 1, "stroke-dasharray": 1, "stroke-dashoffset": hidden ? 1 : 0 });
        segs.append(seg);
        const dot = el("circle", { cx: b.x, cy: b.y, r: 2.5 });
        if (hidden) dot.style.opacity = "0";
        dots.append(dot);
        const ghost = el("line", { x1: b.tx, y1: b.ty, x2: b.x, y2: b.y });
        if (hidden) ghost.style.opacity = "0";
        ghosts.append(ghost);
      }
      jump.style.strokeDasharray = "1";
      jump.style.strokeDashoffset = hidden ? "1" : "0";
      $("[data-n]").textContent = String(n);
      range.style.setProperty("--p", `${((n - 1) / 31) * 100}%`);
      return pts;
    }

    const final = (pts: ReturnType<typeof euler>, n: number) => {
      readout.textContent = `Euler: ${n} head call${n > 1 ? "s" : ""}, miss ${(100 * pts[n].miss).toFixed(1)}% of radius`;
      readout2.textContent = "Flow map: 1 head call, lands on the endpoint";
    };

    function drawStatic(n: number) {
      token++;
      const pts = build(n, false);
      final(pts, n);
      play.textContent = "Play";
    }

    async function run() {
      const my = ++token;
      const n = +range.value;
      const pts = build(n, true);
      play.textContent = "Replay";
      readout2.textContent = "";
      const per = Math.max(0.08, Math.min(0.45, 2.4 / n));
      const segEls = Array.from(segs.children) as SVGElement[], dotEls = Array.from(dots.children) as SVGElement[], ghostEls = Array.from(ghosts.children) as SVGElement[];
      for (let k = 1; k <= n; k++) {
        if (my !== token) return;
        readout.textContent = `Euler step ${k} of ${n}: ${(100 * pts[k].miss).toFixed(1)}% off the true path`;
        await animate(segEls[k - 1], { strokeDashoffset: [1, 0] }, { duration: reduce ? 0 : per, ease: "linear" });
        if (my !== token) return;
        animate(dotEls[k - 1], { opacity: [0, 1] }, { duration: reduce ? 0 : 0.15 });
        animate(ghostEls[k - 1], { opacity: [0, 1] }, { duration: reduce ? 0 : 0.2 });
      }
      if (my !== token) return;
      await new Promise((res) => setTimeout(res, reduce ? 0 : 350));
      if (my !== token) return;
      readout2.textContent = "Flow map: one call…";
      await animate(jump, { strokeDashoffset: [1, 0] }, { duration: reduce ? 0 : 0.5, ease: [0.22, 1, 0.36, 1] });
      if (my !== token) return;
      final(pts, n);
    }

    range.addEventListener("input", () => drawStatic(+range.value));
    play.addEventListener("click", () => run());
    drawStatic(+range.value);

    if (!reduce && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((x) => x.isIntersecting)) { io.disconnect(); run(); }
      }, { threshold: 0.6 });
      io.observe(root);
    }
  });
</script>
