---
// Foundations, attention post: the causal mask on the three-token example.
// Row 1 → 1, 0, 0 (output (2, 0)); row 2 → 0.670, 0.330, 0 (output
// (1.340, 0.660)); row 3 unchanged 0.306, 0.074, 0.620 (output (1.851, 1.389)).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-causal>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 230" role="img" aria-labelledby="cm-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="cm-title">Scores with future positions masked out, then softmaxed row by row</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Causal mask</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-m="1" aria-pressed="true">On</button>
      <button type="button" class="fig-chip" data-m="0" aria-pressed="false">Off</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { attend } from "../../lib/attention";
  const Q = [[1, 0], [1, 1], [2, 1]], K = [[1, 1], [0, 1], [1, 2]], V = [[2, 0], [0, 2], [2, 2]];
  const f3 = (v: number) => fmt(v, 3);
  document.querySelectorAll<HTMLElement>("[data-causal]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let causal = true;
    const A = () => attend(Q, K, V, { causal });
    const steps = () => { const a = A(); return [
      { say: causal ? "The mask: 0 where the key is at or before the query, minus infinity where the key is in the future." : "Mask off: every token may look at every other, including later ones.", math: causal ? "row 1: 0, −∞, −∞\nrow 2: 0, 0, −∞\nrow 3: 0, 0, 0" : "no mask" },
      { say: "Add the mask to the scaled scores.", math: a.scaled.map((r) => r.map((v) => (Number.isFinite(v) ? f3(v) : "−∞")).join(", ")).join("\n") },
      ...[0, 1, 2].map((i) => { const fin = a.scaled[i].filter(Number.isFinite), e = fin.map(Math.exp), t = e.reduce((x, y) => x + y, 0); return { say: i === 0 && causal ? "Row 1 can only see itself, so its single weight is 1." : `Softmax row ${i + 1}. e^(−∞) = 0, so masked positions get exactly 0 and the rest still add up to 1.`, math: `${fin.map((v, j) => `e^${f3(v)} = ${f3(e[j])}`).join(", ")};  total ${f3(t)}\nweights ${a.w[i].map(f3).join(", ")}` }; }),
      { say: "Blend the values with the masked weights.", math: a.out.map((r, i) => `token ${i + 1}: (${r.map(f3).join(", ")})`).join("\n") },
    ]; };
    function draw(k: number) {
      const a = A();
      let s = "";
      const cell = (x: number, y: number, v: string, on: boolean, masked: boolean) => `<rect x="${x}" y="${y}" width="74" height="32" rx="4" fill="${masked ? "#eef0f0" : on ? TINT : "#fff"}" stroke="${on ? GOLD : "#cfd5d4"}" stroke-width="${on ? 2.5 : 1}"/>` + txt(x + 37, y + 21, v, `font-size="12.5" font-weight="700" text-anchor="middle" fill="${masked ? NEG : INK}"`);
      s += txt(30, 22, "scaled scores + mask", `font-size="11.5" font-weight="700" fill="${INK}"`) + txt(320, 22, "weights", `font-size="11.5" font-weight="700" fill="${INK}"`) + txt(590, 22, "output", `font-size="11.5" font-weight="700" fill="${INK}"`);
      a.scaled.forEach((r, i) => r.forEach((v, j) => { const masked = !Number.isFinite(v) && k >= 0; s += cell(30 + j * 80, 34 + i * 40, masked ? (k >= 1 ? "−∞" : "masked") : f3(Number.isFinite(v) ? v : attend(Q, K, V).scaled[i][j]), k === 2 + i, masked); }));
      a.w.forEach((r, i) => r.forEach((v, j) => (s += cell(320 + j * 80, 34 + i * 40, k >= 2 + i ? f3(v) : "", k === 2 + i, false))));
      a.out.forEach((r, i) => (s += txt(590, 56 + i * 40, k >= 5 ? `(${r.map(f3).join(", ")})` : "", `font-size="12.5" font-weight="700" fill="${INK}"`)));
      s += txt(30, 210, causal ? "Each token sees only itself and earlier tokens: generation cannot peek at the future." : "Unmasked: row 2 puts 0.576 on token 3, which would not exist yet during generation.", `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    root.querySelectorAll<HTMLButtonElement>("[data-m]").forEach((b) => b.addEventListener("click", () => { causal = b.dataset.m === "1"; root.querySelectorAll("[data-m]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
