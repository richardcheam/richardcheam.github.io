---
// Foundations, attention post: one query against three keys. q = (1, 1),
// keys (2, 0), (0, 1), (1, 1), values (10, 0), (0, 10), (5, 5): scores 2,
// 1, 2; weights 0.422, 0.155, 0.422; output (6.335, 3.665). Query (1, 0):
// scores 2, 0, 1, output (7.876, 2.124).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-softlookup>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="sl-title" class="blog-diagram-svg" font-family="Inter, sans-serif" style="touch-action: none">
    <title id="sl-title">A query compared with three keys, the softmax weights, and the blended value</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Query presets (or drag the arrows)</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-q="1,1">(1, 1)</button>
      <button type="button" class="fig-chip" data-q="1,0">(1, 0)</button>
      <button type="button" class="fig-chip" data-q="0,2">(0, 2)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { dot, softmax } from "../../lib/attention";
  const VALS = [[10, 0], [0, 10], [5, 5]], KC = [JADE, "#3E6E9E", NEG];
  document.querySelectorAll<HTMLElement>("[data-softlookup]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let q = [1, 1];
    const K = [[2, 0], [0, 1], [1, 1]];
    const calc = () => { const s = K.map((k) => dot(q, k)), e = s.map(Math.exp), t = e.reduce((a, b) => a + b, 0), w = softmax(s); return { s, e, t, w, o: [0, 1].map((c) => w.reduce((a, x, j) => a + x * VALS[j][c], 0)) }; };
    const f3 = (v: number) => fmt(v, 3);
    const steps = () => { const c = calc(); return [
      ...K.map((k, j) => ({ say: `Score key ${j + 1}: the dot product of the query with it. Bigger when they point the same way (and when they are long).`, math: `dot(q, k${j + 1}) = ${par(q[0])} × ${par(k[0])} + ${par(q[1])} × ${par(k[1])} = ${fmt(c.s[j])}` })),
      { say: "Make every score positive with e to the power of it.", math: c.s.map((s) => `e^${fmt(s)} = ${f3(Math.exp(s))}`).join(",  ") },
      { say: "Add them up.", math: `total = ${c.e.map(f3).join(" + ")} = ${f3(c.t)}` },
      { say: "Divide each by the total: the attention weights, which add up to 1.", math: c.e.map((e, j) => `${f3(e)} / ${f3(c.t)} = ${f3(c.w[j])}`).join(",  ") },
      { say: "Blend the values, first number.", math: `${c.w.map((w, j) => `${f3(w)} × ${VALS[j][0]}`).join(" + ")} = ${f3(c.o[0])}` },
      { say: "Second number. The output always lies inside the triangle of the three values.", math: `${c.w.map((w, j) => `${f3(w)} × ${VALS[j][1]}`).join(" + ")} = ${f3(c.o[1])}` },
    ]; };
    const S = 38, cx = 140, cy = 160;
    function draw(k: number) {
      const c = calc();
      let s = txt(30, 22, "Query (gold) and keys (drag the tips)", `font-size="12" font-weight="700" fill="${INK}"`) + `<line x1="${cx - 114}" x2="${cx + 114}" y1="${cy}" y2="${cy}" stroke="#eef0f0"/><line x1="${cx}" x2="${cx}" y1="${cy - 114}" y2="${cy + 114}" stroke="#eef0f0"/>`;
      K.forEach((kk, j) => (s += arrow(cx, cy, cx + kk[0] * S, cy - kk[1] * S, KC[j], k === j ? 3.5 : 2) + `<circle data-h="${j}" cx="${cx + kk[0] * S}" cy="${cy - kk[1] * S}" r="10" fill="${KC[j]}" fill-opacity="0.2" style="cursor:grab"/>` + txt(cx + kk[0] * S + 8, cy - kk[1] * S - 8, `k${j + 1}`, `font-size="11" font-weight="700" fill="${KC[j]}"`)));
      s += arrow(cx, cy, cx + q[0] * S, cy - q[1] * S, GOLD, 3.2) + `<circle data-h="q" cx="${cx + q[0] * S}" cy="${cy - q[1] * S}" r="11" fill="${GOLD}" fill-opacity="0.25" style="cursor:grab"/>` + txt(cx + q[0] * S + 10, cy - q[1] * S + 16, `q (${fmt(q[0])}, ${fmt(q[1])})`, `font-size="11" font-weight="700" fill="${GOLD}"`);
      // Weights as bars.
      s += txt(300, 40, "score", `font-size="11" fill="${MUTED}"`) + txt(360, 40, "weight", `font-size="11" fill="${MUTED}"`);
      K.forEach((_, j) => { const y = 64 + j * 34; s += txt(300, y, k >= j ? fmt(c.s[j]) : "?", `font-size="13" font-weight="700" fill="${KC[j]}"`); if (k >= 5) s += `<rect x="360" y="${y - 13}" width="${c.w[j] * 120}" height="16" fill="${KC[j]}" fill-opacity="0.8"/>` + txt(366 + c.w[j] * 120, y, f3(c.w[j]), `font-size="12" font-weight="700" fill="${INK}"`); });
      // Value plane with the triangle and the output point.
      const vx = (v: number) => 560 + v * 17, vy = (v: number) => 220 - v * 17;
      s += txt(560, 40, "values and the blended output", `font-size="11.5" font-weight="700" fill="${INK}"`) + `<polygon points="${VALS.map((v) => `${vx(v[0])},${vy(v[1])}`).join(" ")}" fill="${GOLD}" fill-opacity="0.08" stroke="#cfd5d4"/>`;
      VALS.forEach((v, j) => (s += `<circle cx="${vx(v[0])}" cy="${vy(v[1])}" r="6" fill="${KC[j]}"/>` + txt(vx(v[0]) + 8, vy(v[1]) + (j === 1 ? 12 : -6), `v${j + 1} (${v.join(", ")})`, `font-size="10.5" fill="${KC[j]}"`)));
      if (k >= 7) s += `<circle cx="${vx(c.o[0])}" cy="${vy(c.o[1])}" r="7" fill="${GOLD}" stroke="#fff" stroke-width="2"/>` + txt(vx(c.o[0]) + 10, vy(c.o[1]) + 4, `(${f3(c.o[0])}, ${f3(c.o[1])})`, `font-size="12" font-weight="700" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 1.3 });
    root.querySelectorAll<HTMLButtonElement>("[data-q]").forEach((b) => b.addEventListener("click", () => { q = b.dataset.q!.split(",").map(Number); redraw(); }));
    const svg = root.querySelector("svg")!; let drag: string | null = null;
    svg.addEventListener("pointerdown", (e) => { const h = (e.target as Element).getAttribute("data-h"); if (h) { drag = h; svg.setPointerCapture(e.pointerId); } });
    svg.addEventListener("pointermove", (e) => { if (!drag) return; const r = svg.getBoundingClientRect(), px = ((e.clientX - r.left) / r.width) * 760, py = ((e.clientY - r.top) / r.height) * 300; const p = [Math.round(((px - cx) / S) * 2) / 2, Math.round(((cy - py) / S) * 2) / 2].map((v) => Math.max(-3, Math.min(3, v))); if (drag === "q") q = p; else K[+drag] = p; redraw(); });
    svg.addEventListener("pointerup", () => (drag = null));
  });
</script>
