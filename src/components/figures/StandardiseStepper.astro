---
// Foundations, normalisation post: standardising three numbers by hand.
// Defaults 3, 4, 5: mean 4, variance 0.667, standard deviation 0.816,
// outputs −1.22, 0, 1.22.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-standard>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 200" role="img" aria-labelledby="st-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="st-title">Three numbers on a line before and after standardising</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">First number <strong data-v="0"></strong></span><input class="scrub" data-i="0" type="range" min="0" max="10" step="1" value="3" /></label>
    <label><span class="fig-panel__name">Second number <strong data-v="1"></strong></span><input class="scrub" data-i="1" type="range" min="0" max="10" step="1" value="4" /></label>
    <label><span class="fig-panel__name">Third number <strong data-v="2"></strong></span><input class="scrub" data-i="2" type="range" min="0" max="10" step="1" value="5" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, GOLD, NEG } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  import { mean, variance } from "../../lib/norms";
  const COL = [JADE, "#3E6E9E", NEG];
  document.querySelectorAll<HTMLElement>("[data-standard]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const x = [3, 4, 5];
    const calc = () => { const m = mean(x), v = variance(x), s = Math.sqrt(v); return { m, v, s, d: x.map((a) => a - m), z: x.map((a) => (s ? (a - m) / s : 0)) }; };
    const steps = () => {
      const c = calc(), r = (v: number) => fmt(v, 3);
      return [
        { say: "Find where the numbers sit: add them up and divide by how many.", math: `mean = (${x.join(" + ")}) / 3 = ${r(c.m)}` },
        { say: "Measure how far each number is from the mean.", math: `distances: ${c.d.map((d) => r(d)).join(", ")}` },
        { say: "Square the distances, so numbers below and above the mean do not cancel.", math: `squares: ${c.d.map((d) => r(d * d)).join(", ")}` },
        { say: "Average the squares: that is the variance.", math: `variance = (${c.d.map((d) => r(d * d)).join(" + ")}) / 3 = ${r(c.v)}` },
        { say: "Take the square root to get back to the original units: the standard deviation.", math: `standard deviation = √${r(c.v)} = ${r(c.s)}` },
        c.s ? { say: "Subtract the mean and divide by the standard deviation. The result always has mean 0 and standard deviation 1.", math: x.map((a, i) => `(${a} − ${r(c.m)}) / ${r(c.s)} = ${fmt(c.z[i], 2)}`).join("\n") }
          : { say: "All three numbers are equal, so the standard deviation is 0 and we would divide by zero. This is why real layers add a tiny ε under the square root.", math: "standard deviation = 0: division by zero" },
      ];
    };
    function draw(k: number) {
      const c = calc(), A = frame({ l: 60, t: 40, w: 640, h: 10, x0: 0, x1: 10, y0: 0, y1: 1 }), B = frame({ l: 60, t: 130, w: 640, h: 10, x0: -2, x1: 2, y0: 0, y1: 1 });
      let s = txt(60, 24, "Original numbers", `font-size="12" font-weight="700" fill="${INK}"`) + `<line x1="60" x2="700" y1="60" y2="60" stroke="#cfd5d4"/>`;
      for (let v = 0; v <= 10; v++) s += txt(A.X(v), 78, String(v), `font-size="10.5" text-anchor="middle" fill="${MUTED}"`);
      x.forEach((a, i) => (s += `<circle cx="${A.X(a)}" cy="${60 - i * 0}" r="${9 - i * 1.5}" fill="${COL[i]}" fill-opacity="0.85"/>`));
      if (k >= 0) s += `<line x1="${A.X(c.m)}" x2="${A.X(c.m)}" y1="44" y2="70" stroke="${GOLD}" stroke-width="2.5"/>` + txt(A.X(c.m), 40, `mean ${fmt(c.m, 2)}`, `font-size="11" text-anchor="middle" font-weight="700" fill="${GOLD}"`);
      if (k >= 4 && c.s) s += `<rect x="${A.X(c.m - c.s)}" y="52" width="${A.X(c.m + c.s) - A.X(c.m - c.s)}" height="16" fill="${GOLD}" fill-opacity="0.15"/>`;
      s += txt(60, 114, "Standardised", `font-size="12" font-weight="700" fill="${k >= 5 ? INK : "#B9C0BF"}"`) + `<line x1="60" x2="700" y1="150" y2="150" stroke="#cfd5d4"/>`;
      for (let v = -2; v <= 2; v++) s += txt(B.X(v), 168, fmt(v), `font-size="10.5" text-anchor="middle" fill="${MUTED}"`);
      if (k >= 5 && c.s) {
        s += `<rect x="${B.X(-1)}" y="142" width="${B.X(1) - B.X(-1)}" height="16" fill="${GOLD}" fill-opacity="0.15"/>`;
        c.z.forEach((z, i) => (s += `<circle cx="${B.X(z)}" cy="150" r="${9 - i * 1.5}" fill="${COL[i]}" fill-opacity="0.85"/>`));
      }
      s += txt(60, 192, "The shaded band is one standard deviation either side of the mean.", `font-size="11" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = String(x[+el.dataset.v!])));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.6 });
    root.querySelectorAll<HTMLInputElement>("[data-i]").forEach((inp) => inp.addEventListener("input", () => { x[+inp.dataset.i!] = +inp.value; redraw(); }));
  });
</script>
