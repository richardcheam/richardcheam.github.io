---
// Whisper review, Figure 3: Toy 4, the walking window (Sec 3.8, p. 9; Sec 2.3,
// p. 3). A 100 s recording of 14 scripted captions. Each 30 s window returns
// the captions fully inside it, plus the start time of the one it cuts off;
// the next window starts there. "Drift" adds a seeded random error of up to
// +/- delta seconds to that start time, which can skip or repeat captions.
const { alt } = Astro.props;
---
<div class="blog-diagram tss" role="region" aria-label={alt} data-tss>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 330" role="img" aria-labelledby="tss-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="tss-title">A 30-second window walking along a long recording, moved to the start of the caption it cut off</title>
    <g data-tl></g>
    <text data-r1 x="20" y="270" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="292" font-size="12" fill="#2b2b30"></text>
    <text data-r3 x="20" y="316" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Timestamp drift ±δ<strong data-vd></strong></span><input class="scrub" data-d type="range" min="0" max="3" step="0.25" value="0" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait } from "../../lib/figure-motion";
  import { rng } from "../../lib/flow-math";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-tss]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const dIn = $<HTMLInputElement>("[data-d]");
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const LEN = [6.2, 5.1, 7.4, 4.8, 6.9, 5.6, 8.1, 4.4, 6.3, 7.7, 5.2, 6.8, 4.9, 6.0];
    const CAP: [number, number][] = []; { let t = 0.6; LEN.forEach((l) => { CAP.push([t, t + l]); t += l + 0.7; }); }
    function walk(delta: number) {
      const r = rng(1), wins: { o: number; got: number[]; cut: number | null }[] = [], seen = new Map<number, number>();
      let o = 0;
      for (let guard = 0; guard < 20 && o < 100; guard++) {
        const got = CAP.map((c, i) => [c, i] as const).filter(([c]) => c[0] >= o - 1e-9 && c[1] <= o + 30).map(([, i]) => i);
        const cutIdx = CAP.findIndex((c) => c[0] < o + 30 && c[1] > o + 30);
        got.forEach((i) => seen.set(i, (seen.get(i) ?? 0) + 1));
        wins.push({ o, got, cut: cutIdx >= 0 ? cutIdx : null });
        if (cutIdx < 0) break;
        const next = CAP[cutIdx][0] + (r() * 2 - 1) * delta;
        o = Math.max(o + 1, next);
      }
      const skipped = CAP.map((_, i) => i).filter((i) => !seen.has(i)), repeated = [...seen].filter(([, n]) => n > 1).map(([i]) => i);
      return { wins, skipped, repeated };
    }
    let step = 99;
    function draw() {
      const { wins, skipped, repeated } = walk(+dIn.value), g = $("[data-tl]"); g.replaceChildren();
      const X = (t: number) => 20 + (t / 100) * 740;
      for (let t = 0; t <= 100; t += 10) mk(g, "text", { x: X(t), y: 22, "font-size": 10, "text-anchor": "middle", fill: "#5f5f66" }, `${t} s`);
      const done = new Set(wins.slice(0, step).flatMap((w) => w.got));
      CAP.forEach(([a, b], i) => {
        const col = skipped.includes(i) && step >= wins.length ? "#a33b3b" : repeated.includes(i) && step >= wins.length ? "#b8722c" : done.has(i) ? "#4F5D3A" : "#d5d5dc";
        mk(g, "rect", { x: X(a), y: 34, width: X(b) - X(a), height: 22, rx: 3, fill: col, "fill-opacity": 0.85 });
        mk(g, "text", { x: (X(a) + X(b)) / 2, y: 49, "font-size": 9.5, "text-anchor": "middle", fill: "#fff" }, String(i + 1));
      });
      wins.slice(0, step).forEach((w, k) => {
        const y = 70 + k * 30;
        mk(g, "rect", { x: X(w.o), y, width: X(Math.min(100, w.o + 30)) - X(w.o), height: 20, rx: 3, fill: "#594578", "fill-opacity": 0.12, stroke: "#594578" });
        mk(g, "text", { x: X(w.o) + 6, y: y + 14, "font-size": 10, fill: "#594578" }, `window ${k + 1} from ${w.o.toFixed(1)} s: captions ${w.got.map((i) => i + 1).join(", ") || "none"}${w.cut !== null ? `, cut ${w.cut + 1}` : ""}`);
        if (w.cut !== null) mk(g, "line", { x1: X(CAP[w.cut][0]), x2: X(CAP[w.cut][0]), y1: y, y2: y + 20, stroke: "#a33b3b", "stroke-width": 2 });
      });
      const fin = step >= wins.length;
      $("[data-r1]").textContent = `${wins.length} windows for 100 s of audio.`;
      $("[data-r2]").textContent = fin ? (skipped.length || repeated.length ? `Drift ±${dIn.value} s: ${skipped.length} caption${skipped.length === 1 ? "" : "s"} never fully heard (red), ${repeated.length} written twice (orange).` : "Every caption heard exactly once.") : "";
      $("[data-r3]").textContent = "The red tick is the start time the model wrote for the caption it could not finish: the next window begins there. A wrong tick moves every later window.";
      $("[data-vd]").textContent = `${dIn.value} s`; dIn.style.setProperty("--p", `${(+dIn.value / 3) * 100}%`);
    }
    dIn.addEventListener("input", () => { step = 99; draw(); });
    draw();
    setupFigure(root, () => { step = 0; draw(); }, async (alive) => { const n = walk(+dIn.value).wins.length; for (step = 0; step <= n; step++) { if (!alive()) return; draw(); await wait(0.9); } step = 99; draw(); });
  });
</script>
