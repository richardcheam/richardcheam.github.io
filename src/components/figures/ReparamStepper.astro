---
// Foundations, autoencoders post: the reparameterisation trick. μ = 0.8,
// σ = 0.5, ε = −0.6: z = 0.5, loss slope −1, slope for μ −1, for σ 0.6;
// one step at η 0.1 gives μ = 0.9, σ = 0.44. With ε = 0.6 the σ slope is 0.12.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-reparam>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 270" role="img" aria-labelledby="rp2-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rp2-title">A small computation graph where a random draw is scaled and shifted, and gradients flow back to the centre and spread</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Centre μ <strong data-v="mu"></strong></span><input class="scrub" data-k="mu" type="range" min="-2" max="2" step="0.1" value="0.8" /></label>
    <label><span class="fig-panel__name">Spread σ <strong data-v="sg"></strong></span><input class="scrub" data-k="sg" type="range" min="0.05" max="2" step="0.01" value="0.5" /></label>
    <label><span class="fig-panel__name">Random draw ε <strong data-v="ep"></strong></span><input class="scrub" data-k="ep" type="range" min="-3" max="3" step="0.1" value="-0.6" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  const X = 1, ETA = 0.1;
  document.querySelectorAll<HTMLElement>("[data-reparam]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { mu: 0.8, sg: 0.5, ep: -0.6 };
    const calc = () => { const se = p.sg * p.ep, z = p.mu + se, L = (z - X) ** 2, dz = 2 * (z - X); return { se, z, L, dz, dmu: dz, dsg: dz * p.ep, mu2: p.mu - ETA * dz, sg2: p.sg - ETA * dz * p.ep }; };
    const f3 = (v: number) => fmt(v, 3);
    const steps = () => { const c = calc(); return [
      { say: "Draw plain noise ε from the standard bell curve. It is treated as a fixed input, like data.", math: `ε = ${fmt(p.ep)}` },
      { say: "Stretch it by the spread.", math: `σ × ε = ${fmt(p.sg)} × ${par(p.ep)} = ${f3(c.se)}` },
      { say: "Slide it to the centre: this is the sample z.", math: `z = ${fmt(p.mu)} + ${par(c.se, 3)} = ${f3(c.z)}` },
      { say: "Decode (here simply x̂ = z) and score against the target 1.", math: `loss = (${f3(c.z)} − 1)² = ${f3(c.L)}` },
      { say: "Backward: the loss's slope at z.", math: `dL/dz = 2 × (${f3(c.z)} − 1) = ${f3(c.dz)}` },
      { say: "z = μ + σε, so nudging μ moves z one for one.", math: `dL/dμ = ${f3(c.dz)} × 1 = ${f3(c.dmu)}` },
      { say: "Nudging σ moves z by ε times as much. The gradient never has to pass through the random draw itself.", math: `dL/dσ = ${f3(c.dz)} × ε = ${f3(c.dz)} × ${par(p.ep)} = ${f3(c.dsg)}` },
      { say: "One gradient step on both.", math: `μ = ${fmt(p.mu)} − ${ETA} × ${par(c.dmu, 3)} = ${f3(c.mu2)},   σ = ${fmt(p.sg)} − ${ETA} × ${par(c.dsg, 3)} = ${f3(c.sg2)}` },
    ]; };
    function draw(k: number) {
      const c = calc(), back = k >= 4;
      const node = (x: number, y: number, label: string, val: string, on: boolean, col = INK) => `<rect x="${x - 45}" y="${y - 20}" width="90" height="40" rx="8" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : col}" stroke-width="${on ? 2.5 : 1.3}"/>` + txt(x, y - 4, label, `font-size="10.5" text-anchor="middle" fill="${MUTED}"`) + txt(x, y + 13, val, `font-size="13" font-weight="700" text-anchor="middle" fill="${INK}"`);
      let s = "";
      s += node(80, 60, "μ (centre)", fmt(p.mu), k === 5 || k === 7) + node(80, 140, "σ (spread)", fmt(p.sg), k === 6 || k === 7) + node(80, 220, "ε (dice)", k >= 0 ? fmt(p.ep) : "?", k === 0, MUTED);
      s += node(260, 180, "× : σε", k >= 1 ? f3(c.se) : "?", k === 1) + node(420, 100, "+ : z", k >= 2 ? f3(c.z) : "?", k === 2) + node(600, 100, "loss (z − 1)²", k >= 3 ? f3(c.L) : "?", k === 3);
      const fw = (x1: number, y1: number, x2: number, y2: number, on: boolean, dead = false) => arrow(x1, y1, x2, y2, dead ? "#d5d9d8" : on ? NEG : MUTED, on ? 2.5 : 1.3);
      s += fw(125, 140, 215, 175, back && k >= 6) + fw(125, 220, 215, 185, false, back) + fw(305, 180, 375, 110, back && k >= 6) + fw(125, 60, 375, 95, back && k >= 5) + fw(465, 100, 555, 100, back);
      if (back) s += txt(510, 86, `dL/dz ${f3(c.dz)}`, `font-size="11" font-weight="700" text-anchor="middle" fill="${NEG}"`);
      if (k >= 5) s += txt(250, 66, `dL/dμ ${f3(c.dmu)}`, `font-size="11" font-weight="700" fill="${NEG}"`);
      if (k >= 6) s += txt(140, 196, `dL/dσ ${f3(c.dsg)}`, `font-size="11" font-weight="700" fill="${NEG}"`) + txt(140, 250, "no gradient needed through ε", `font-size="10.5" fill="${MUTED}"`);
      if (k >= 7) s += txt(560, 180, `new μ ${f3(c.mu2)}, new σ ${f3(c.sg2)}`, `font-size="13" font-weight="700" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[el.dataset.v!], 2)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.5 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
  });
</script>
