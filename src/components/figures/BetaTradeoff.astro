---
// Foundations, autoencoders post: the best cloud's reconstruction against
// KL as β runs from 0.05 to 20 (toy: decoder x̂ = z, target 1). β 0.5:
// (KL 0.725, rec 0.24); β 1: (0.438, 0.444); β 4: (0.092, 1.111); β 20:
// (0.006, 1.736).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-beta>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 260" role="img" aria-labelledby="bt-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="bt-title">The trade-off curve between reconstruction loss and KL as beta changes</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">β <strong data-vb></strong></span><input class="scrub" data-b type="range" min="-1.3" max="1.3" step="0.01" value="0" /></label>
  </div>
</div>

<script>
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  const pt = (b: number) => { const mu = 2 / (2 + b), s2 = b / (2 + b); return { mu, s: Math.sqrt(s2), rec: (mu - 1) ** 2 + s2, kl: 0.5 * (mu * mu + s2 - Math.log(s2) - 1) }; };
  document.querySelectorAll<HTMLElement>("[data-beta]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let b = 1;
    function draw() {
      const F = frame({ l: 60, t: 30, w: 380, h: 190, x0: 0, x1: 1.2, y0: 0, y1: 2 });
      let s = F.grid([0, 0.4, 0.8, 1.2], [0, 0.5, 1, 1.5, 2], 1) + txt(60, 18, "best reconstruction against KL, one point per β", `font-size="12" font-weight="700" fill="${INK}"`) + txt(250, 250, "KL (how far the cloud is from N(0, 1))", `font-size="10.5" text-anchor="middle" fill="${MUTED}"`);
      const pts = Array.from({ length: 200 }, (_, i) => pt(10 ** (-1.3 + (2.6 * i) / 199)));
      s += `<polyline fill="none" stroke="${JADE}" stroke-width="2.5" points="${pts.filter((q) => q.kl <= 1.2).map((q) => `${F.X(q.kl).toFixed(1)},${F.Y(q.rec).toFixed(1)}`).join(" ")}"/>`;
      [0.5, 1, 4, 20].forEach((bb) => { const q = pt(bb); s += `<circle cx="${F.X(q.kl)}" cy="${F.Y(q.rec)}" r="3.5" fill="${MUTED}"/>` + txt(F.X(q.kl) + 6, F.Y(q.rec) - 4, `β ${bb}`, `font-size="10" fill="${MUTED}"`); });
      const q = pt(b);
      s += `<circle cx="${F.X(Math.min(1.2, q.kl))}" cy="${F.Y(q.rec)}" r="7" fill="${GOLD}" stroke="#fff" stroke-width="2"/>`;
      s += txt(480, 60, `β = ${fmt(b, 2)}`, `font-size="15" font-weight="700" fill="${INK}"`) + txt(480, 88, `best μ ${fmt(q.mu, 3)}, σ ${fmt(q.s, 3)}`, `font-size="12.5" fill="${INK}"`) + txt(480, 112, `reconstruction ${fmt(q.rec, 3)}`, `font-size="12.5" fill="${INK}"`) + txt(480, 136, `KL ${fmt(q.kl, 3)}`, `font-size="12.5" fill="${INK}"`);
      s += txt(480, 180, "The lower left is out of reach:", `font-size="11" fill="${MUTED}"`) + txt(480, 196, "no cloud rebuilds perfectly at zero KL.", `font-size="11" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vb]").textContent = fmt(b, 2);
    }
    $<HTMLInputElement>("[data-b]").addEventListener("input", (e) => { b = 10 ** +(e.target as HTMLInputElement).value; draw(); });
    draw();
  });
</script>
