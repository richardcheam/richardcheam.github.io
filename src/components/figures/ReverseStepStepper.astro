---
// Foundations, diffusion post: one reverse step from x_t = −0.354 at t = 0.5
// to s = 0.25. DDPM mean −0.433, spread 0.348, with z = 0.3 → −0.329. DDIM
// → −0.441.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-revstep>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 220" role="img" aria-labelledby="rs2-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rs2-title">One step backwards from a noisy point, by DDPM with fresh noise and by DDIM without</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Fresh noise z for DDPM <strong data-vz></strong></span><input class="scrub" data-z type="range" min="-2" max="2" step="0.1" value="0.3" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, NEG, JADE, GOLD } from "../../lib/net-diagram";
  import { frame, txt, arrow } from "../../lib/plot";
  import { reverseStep } from "../../lib/diffusion";
  document.querySelectorAll<HTMLElement>("[data-revstep]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const x = Math.SQRT1_2 * 1 + Math.SQRT1_2 * -1.5; // −0.354, the post's noisy point
    let z = 0.3;
    const f3 = (v: number) => fmt(v, 3);
    const steps = () => { const d = reverseStep(x, 0.5, 0.25, z, false), dd = reverseStep(x, 0.5, 0.25, z, true); return [
      { say: "Ask the denoiser for its clean guess.", math: `x̂₀ = ${f3(d.x0)}` },
      { say: "Schedule numbers for going from t = 0.5 to s = 0.25.", math: `r = ${f3(d.r!)},  b_t² = 0.5,  b_s² = 0.146,  b_t² − r² b_s² = ${f3(d.gap!)}` },
      { say: "DDPM mean: a weighted average of where we are and where the clean guess is.", math: `${f3(d.w1!)} × ${par(x, 3)} + ${f3(d.w2!)} × ${par(d.x0, 3)} = ${f3(d.mean)}` },
      { say: "Add a little fresh noise: DDPM is random, so two runs from here differ.", math: `${f3(d.mean)} + ${f3(d.spread)} × ${par(z)} = ${f3(d.next)}` },
      { say: "DDIM drops the fresh noise: rebuild the point at s from the clean and noise guesses.", math: `0.924 × ${par(dd.x0, 3)} + 0.383 × ${par(dd.eps, 3)} = ${f3(dd.next)}` },
    ]; };
    function draw(k: number) {
      const d = reverseStep(x, 0.5, 0.25, z, false), dd = reverseStep(x, 0.5, 0.25, z, true), F = frame({ l: 40, t: 60, w: 680, h: 20, x0: -1.5, x1: 1.5, y0: 0, y1: 1 });
      let s = `<line x1="40" x2="720" y1="100" y2="100" stroke="#cfd5d4" stroke-width="2"/>`;
      [-1.5, -1, -0.5, 0, 0.5, 1, 1.5].forEach((v) => (s += txt(F.X(v), 120, fmt(v), `font-size="10.5" text-anchor="middle" fill="${MUTED}"`)));
      s += `<circle cx="${F.X(-1)}" cy="100" r="5" fill="${JADE}"/><circle cx="${F.X(1)}" cy="100" r="5" fill="${JADE}"/>` + `<circle cx="${F.X(x)}" cy="100" r="8" fill="${INK}"/>` + txt(F.X(x), 86, `x_t = ${f3(x)}`, `font-size="11.5" font-weight="700" text-anchor="middle" fill="${INK}"`);
      if (k >= 0) s += `<circle cx="${F.X(d.x0)}" cy="100" r="5" fill="none" stroke="${GOLD}" stroke-width="2"/>` + txt(F.X(d.x0), 146, `x̂₀ ${f3(d.x0)}`, `font-size="10.5" text-anchor="middle" fill="${GOLD}"`);
      if (k >= 2) s += `<line x1="${F.X(d.mean)}" x2="${F.X(d.mean)}" y1="92" y2="108" stroke="${NEG}" stroke-width="2"/>` + txt(F.X(d.mean), 166, `mean ${f3(d.mean)}`, `font-size="10.5" text-anchor="middle" fill="${NEG}"`);
      if (k >= 3) s += arrow(F.X(x), 60, F.X(d.next), 60, NEG, 2.2) + txt(F.X(d.next), 46, `DDPM ${f3(d.next)}`, `font-size="12" font-weight="700" text-anchor="middle" fill="${NEG}"`);
      if (k >= 4) s += arrow(F.X(x), 190, F.X(dd.next), 190, "#3E6E9E", 2.2) + txt(F.X(dd.next), 210, `DDIM ${f3(dd.next)}`, `font-size="12" font-weight="700" text-anchor="middle" fill="#3E6E9E"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vz]").textContent = fmt(z);
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    $<HTMLInputElement>("[data-z]").addEventListener("input", (e) => { z = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
