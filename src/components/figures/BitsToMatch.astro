---
// SoundStream review, Figure 6: how many bits the classic codecs need to match
// SoundStream in the listening test (Sec V-A, p. 7). Low: EVS 9.6 kbps and
// Opus 12 kbps against 3 kbps (3.2x to 4x). Medium and high: the text gives
// only ranges, 2.2x to 2.6x and 1.3x to 1.6x, drawn as bands.
const { alt } = Astro.props;
---
<div class="blog-diagram btm" role="region" aria-label={alt} data-btm>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 300" role="img" aria-labelledby="btm-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="btm-title">Bitrates the classic codecs need to sound as good as SoundStream</title>
    <g data-axis></g>
    <g data-rows></g>
    <text data-r1 x="20" y="262" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="284" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-btm]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const X = (k: number) => 150 + (k / 20) * 600;
    const ax = $("[data-axis]");
    for (let k = 0; k <= 20; k += 2) { mk(ax, "line", { x1: X(k), x2: X(k), y1: 30, y2: 220, stroke: "#f2f2f5" }); mk(ax, "text", { x: X(k), y: 236, "font-size": 10.5, "text-anchor": "middle", fill: "#2b2b30" }, String(k)); }
    mk(ax, "text", { x: 750, y: 22, "font-size": 10.5, "text-anchor": "end", fill: "#5f5f66" }, "kbps");
    const rows = [
      { name: "Low", ss: 3, exact: [["EVS", 9.6], ["Opus", 12]] as [string, number][], band: null as null | [number, number] },
      { name: "Medium", ss: 6, exact: [], band: [2.2, 2.6] as [number, number] },
      { name: "High", ss: 12, exact: [], band: [1.3, 1.6] as [number, number] },
    ];
    function draw(p: number) {
      const g = $("[data-rows]"); g.replaceChildren();
      rows.forEach((r, i) => {
        const y = 60 + i * 62;
        mk(g, "text", { x: 20, y: y + 5, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, `${r.name}`);
        mk(g, "text", { x: 20, y: y + 21, "font-size": 10.5, fill: "#5f5f66" }, `SoundStream ${r.ss} kbps`);
        if (r.band) {
          const a = r.ss * r.band[0], b = r.ss * r.band[1], reach = r.ss + (b - r.ss) * p;
          mk(g, "line", { x1: X(r.ss), x2: X(Math.min(reach, a)), y1: y, y2: y, stroke: "#b9b9c2", "stroke-width": 3 });
          if (reach > a) mk(g, "rect", { x: X(a), y: y - 10, width: X(Math.min(reach, b)) - X(a), height: 20, fill: "#594578", "fill-opacity": 0.3 });
          if (p >= 1) mk(g, "text", { x: (X(a) + X(b)) / 2, y: y - 16, "font-size": 10.5, "text-anchor": "middle", fill: "#594578" }, `EVS and Opus: ${a.toFixed(1)} to ${b.toFixed(1)} (${r.band[0]}× to ${r.band[1]}×)`);
        } else r.exact.forEach(([n, k], j) => {
          const reach = r.ss + (k - r.ss) * p, yy = y + (j ? 8 : -8);
          mk(g, "line", { x1: X(r.ss), x2: X(reach), y1: yy, y2: yy, stroke: "#b9b9c2", "stroke-width": 3 });
          if (p >= 1) { mk(g, "circle", { cx: X(k), cy: yy, r: 6, fill: "#594578" }); mk(g, "text", { x: X(k) + 10, y: yy + 4, "font-size": 10.5, fill: "#594578" }, `${n} ${k} (${(k / r.ss).toFixed(1)}×)`); }
        });
        mk(g, "circle", { cx: X(r.ss), cy: y, r: 7, fill: "#4F5D3A" });
      });
      $("[data-r1]").textContent = "At 3 kbps, EVS needs 9.6 kbps and Opus 12 kbps to sound as good: 3.2× to 4× the bits.";
      $("[data-r2]").textContent = "Medium and high rows are bands: the text gives only the ratio ranges, not which codec needs which bitrate (Sec V-A, p. 7).";
    }
    draw(1);
    setupFigure(root, () => draw(0), async (alive) => { await tween(2, (e) => { if (alive()) draw(e); }); draw(1); });
  });
</script>
