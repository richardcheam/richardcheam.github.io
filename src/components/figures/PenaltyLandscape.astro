---
// Foundations, regularisation post: data loss (w₁ − 1)² + (w₂ − 0.3)² plus an
// L2 penalty (λ/2)|w|² or an L1 penalty λ(|w₁| + |w₂|). At λ = 0.8 the L2
// minimum is (0.714, 0.214) and the L1 minimum is (0.6, 0); at λ = 0.5 the
// L1 minimum is (0.75, 0.05).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-penalty>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="pl-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="pl-title">Two maps of the same data loss, one with a circular L2 penalty and one with a diamond L1 penalty</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Strength λ <strong data-vl></strong></span><input class="scrub" data-l type="range" min="0" max="2" step="0.05" value="0.8" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, NEG, GOLD } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  const C = [1, 0.3];
  document.querySelectorAll<HTMLElement>("[data-penalty]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let lam = 0.8;
    const l2 = () => C.map((c) => (2 * c) / (2 + lam)), l1 = () => C.map((c) => Math.sign(c) * Math.max(Math.abs(c) - lam / 2, 0));
    const steps = () => {
      const a = l2(), b = l1();
      return [
        { say: "Without any penalty, the data loss is lowest at its centre, (1, 0.3). The rings are places of equal data loss.", math: "data loss = (w₁ − 1)² + (w₂ − 0.3)², lowest at (1, 0.3)" },
        { say: "Add a penalty. L2 grows with the squared distance from zero (circles); L1 grows with |w₁| + |w₂| (diamonds, with corners on the axes).", math: `L2 penalty = (${fmt(lam)} / 2)(w₁² + w₂²)     L1 penalty = ${fmt(lam)}(|w₁| + |w₂|)` },
        { say: "Find the lowest total. L2 shrinks both weights by the same fraction. L1 subtracts a fixed amount, λ/2, from each, and a weight smaller than that lands exactly on zero.", math: `L2: w = 2c / (2 + λ): (2 × 1 / ${fmt(2 + lam)}, 2 × 0.3 / ${fmt(2 + lam)}) = (${fmt(a[0], 3)}, ${fmt(a[1], 3)})\nL1: w = max(c − λ/2, 0): (max(1 − ${fmt(lam / 2)}, 0), max(0.3 − ${fmt(lam / 2)}, 0)) = (${fmt(b[0], 3)}, ${fmt(b[1], 3)})` },
      ];
    };
    function draw(k: number) {
      let s = "";
      [0, 1].forEach((j) => {
        const l = 30 + j * 380, F = frame({ l, t: 36, w: 300, h: 225, x0: -0.5, x1: 1.5, y0: -0.5, y1: 1 }), m = j ? l1() : l2();
        s += `<clipPath id="pl-c${j}"><rect x="${l}" y="36" width="300" height="225"/></clipPath>` + F.grid([-0.5, 0, 0.5, 1, 1.5], [-0.5, 0, 0.5, 1], 1);
        s += txt(l, 22, j ? "L1 penalty (diamonds)" : "L2 penalty (circles)", `font-size="12.5" font-weight="700" fill="${INK}"`);
        s += `<g clip-path="url(#pl-c${j})">`;
        const sc = F.X(1) - F.X(0);
        for (const r of [0.15, 0.3, 0.5, 0.75]) s += `<circle cx="${F.X(1)}" cy="${F.Y(0.3)}" r="${r * sc}" fill="none" stroke="${JADE}" stroke-opacity="0.45"/>`;
        if (k >= 1) for (const r of [0.25, 0.5, 0.75, 1]) s += j
          ? `<polygon points="${F.X(r)},${F.Y(0)} ${F.X(0)},${F.Y(r)} ${F.X(-r)},${F.Y(0)} ${F.X(0)},${F.Y(-r)}" fill="none" stroke="${GOLD}" stroke-opacity="0.7"/>`
          : `<circle cx="${F.X(0)}" cy="${F.Y(0)}" r="${r * sc}" fill="none" stroke="${GOLD}" stroke-opacity="0.7"/>`;
        s += `</g><circle cx="${F.X(1)}" cy="${F.Y(0.3)}" r="5" fill="${JADE}"/>` + txt(F.X(1) + 8, F.Y(0.3) - 8, "data best (1, 0.3)", `font-size="10.5" fill="${JADE}"`);
        if (k >= 2) s += `<line x1="${F.X(1)}" y1="${F.Y(0.3)}" x2="${F.X(m[0])}" y2="${F.Y(m[1])}" stroke="${NEG}" stroke-dasharray="3 3"/><circle cx="${F.X(m[0])}" cy="${F.Y(m[1])}" r="7" fill="${NEG}" stroke="#fff" stroke-width="2"/>` + txt(F.X(m[0]) - 8, F.Y(m[1]) + 22, `(${fmt(m[0], 3)}, ${fmt(m[1], 3)})`, `font-size="12" font-weight="700" text-anchor="end" fill="${NEG}"`);
        s += txt(l + 300, 280, j ? "w₂ is exactly 0 once λ/2 ≥ 0.3" : "both shrink, neither reaches 0", `font-size="11" text-anchor="end" fill="${MUTED}"`);
      });
      $("[data-draw]").innerHTML = s;
      $("[data-vl]").textContent = fmt(lam, 2);
    }
    const redraw = stepper(root, steps, draw, { delay: 2.4 });
    $<HTMLInputElement>("[data-l]").addEventListener("input", (e) => { lam = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
