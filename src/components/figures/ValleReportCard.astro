---
// VALL-E review, Figure 7: Table 2 and Table 3 (p. 9). Left: word error rate
// against speaker similarity on LibriSpeech test-clean (lower right is
// better). AudioLM has a WER from a different ASR model and no similarity.
// Right: similarity and comparative opinion scores from listeners.
const { alt } = Astro.props;
---
<div class="blog-diagram vrc" role="region" aria-label={alt} data-vrc>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 360" role="img" aria-labelledby="vrc-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="vrc-title">VALL-E against YourTTS and others on word errors, speaker similarity and listener scores</title>
    <g data-plot></g>
    <g data-bars></g>
    <text x="20" y="352" font-size="11" fill="#5f5f66">All values from Tables 2 and 3 (p. 9). Hover a dot for its numbers.</text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-vrc]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const pts = [
      { n: "Ground truth", w: 2.2, s: 0.754, c: "#2b2b30" },
      { n: "GSLM", w: 12.4, s: 0.126, c: "#8a8a94" },
      { n: "YourTTS", w: 7.7, s: 0.337, c: "#b8722c" },
      { n: "VALL-E", w: 5.9, s: 0.58, c: "#594578" },
      { n: "VALL-E-continual", w: 3.8, s: 0.508, c: "#8a7aa8" },
    ];
    const X = (w: number) => 70 + (w / 13) * 300, Y = (s: number) => 300 - (s / 0.8) * 260;
    function draw(p: number) {
      const g = $("[data-plot]"); g.replaceChildren();
      mk(g, "text", { x: 20, y: 22, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "Words right and voice right (Table 2)");
      mk(g, "line", { x1: 70, x2: 370, y1: 300, y2: 300, stroke: "#2b2b30" }); mk(g, "line", { x1: 70, x2: 70, y1: 40, y2: 300, stroke: "#2b2b30" });
      for (let w = 0; w <= 12; w += 3) mk(g, "text", { x: X(w), y: 316, "font-size": 10, "text-anchor": "middle", fill: "#2b2b30" }, String(w));
      for (let s = 0; s <= 0.8; s += 0.2) mk(g, "text", { x: 62, y: Y(s) + 4, "font-size": 10, "text-anchor": "end", fill: "#2b2b30" }, s.toFixed(1));
      mk(g, "text", { x: 370, y: 332, "font-size": 10.5, "text-anchor": "end", fill: "#5f5f66" }, "word error rate, % (lower is better) →");
      mk(g, "text", { x: 74, y: 48, "font-size": 10.5, fill: "#5f5f66" }, "↑ speaker similarity");
      mk(g, "line", { x1: X(6), x2: X(6), y1: 292, y2: 308, stroke: "#8a8a94", "stroke-width": 3 });
      mk(g, "text", { x: X(6), y: 288, "font-size": 9.5, "text-anchor": "middle", fill: "#8a8a94" }, "AudioLM 6.0, other ASR");
      pts.forEach((d, i) => {
        const e = Math.max(0, Math.min(1, p * 1.6 - i * 0.12));
        const c = mk(g, "circle", { cx: X(d.w * e), cy: Y(d.s * e), r: 7, fill: d.c });
        mk(c, "title", {}, `${d.n}: WER ${d.w}%, similarity ${d.s}`);
        if (e >= 1) mk(g, "text", { x: X(d.w) + 10, y: Y(d.s) + 4, "font-size": 10.5, fill: d.c, "font-weight": 700 }, d.n);
      });
      if (p >= 1) {
        mk(g, "path", { d: `M${X(7.7) - 6} ${Y(0.337) - 4} L${X(5.9) + 8} ${Y(0.58) + 10}`, stroke: "#a33b3b", "stroke-width": 1.5, "stroke-dasharray": "4 3", fill: "none" });
        mk(g, "text", { x: X(7.7) + 4, y: Y(0.46), "font-size": 10.5, fill: "#a33b3b" }, "WER −1.8, similarity +0.243");
      }
      // Listener scores.
      const gb = $("[data-bars]"); gb.replaceChildren();
      mk(gb, "text", { x: 430, y: 22, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "What listeners said (Table 3, 40 speakers)");
      const bars = [["YourTTS", 3.45, 0.09, "#b8722c"], ["VALL-E", 4.38, 0.1, "#594578"], ["Ground truth", 4.5, 0.1, "#2b2b30"]] as const;
      const BX = (v: number) => 540 + (v - 1) * 42;
      mk(gb, "text", { x: 430, y: 52, "font-size": 10.5, fill: "#5f5f66" }, "Similarity score (SMOS, 1 to 5)");
      bars.forEach(([n, v, err, c], i) => {
        const y = 64 + i * 34;
        mk(gb, "text", { x: 430, y: y + 14, "font-size": 10.5, fill: "#2b2b30" }, n);
        mk(gb, "rect", { x: 540, y, width: Math.max(0, (v - 1) * 42 * p), height: 20, fill: c, "fill-opacity": 0.85 });
        mk(gb, "line", { x1: BX(v - err), x2: BX(v + err), y1: y + 10, y2: y + 10, stroke: "#2b2b30" });
        mk(gb, "text", { x: BX(5) + 4, y: y + 14, "font-size": 10.5, fill: "#2b2b30" }, `${v} ± ${err}`);
      });
      mk(gb, "text", { x: 430, y: 196, "font-size": 10.5, fill: "#5f5f66" }, "Naturalness compared with VALL-E (CMOS, −3 to +3)");
      const CX = (v: number) => 600 + v * 300;
      mk(gb, "line", { x1: CX(0), x2: CX(0), y1: 206, y2: 300, stroke: "#2b2b30" });
      [["YourTTS", -0.12, "#b8722c"], ["VALL-E", 0, "#594578"], ["Ground truth", 0.17, "#2b2b30"]].forEach(([n, v, c], i) => {
        const y = 210 + i * 30, w = (v as number) * 300 * p;
        mk(gb, "text", { x: 430, y: y + 14, "font-size": 10.5, fill: "#2b2b30" }, n as string);
        mk(gb, "rect", { x: Math.min(CX(0), CX(0) + w), y, width: Math.abs(w) || 1.5, height: 20, fill: c as string, "fill-opacity": 0.85 });
        mk(gb, "text", { x: CX(0) + (v as number) * 300 + ((v as number) < 0 ? -6 : 6), y: y + 14, "font-size": 10.5, "text-anchor": (v as number) < 0 ? "end" : "start", fill: "#2b2b30" }, `${(v as number) > 0 ? "+" : ""}${v}`);
      });
    }
    draw(1);
    setupFigure(root, () => draw(0), async (alive) => { await tween(2.2, (e) => { if (alive()) draw(e); }); draw(1); });
  });
</script>
