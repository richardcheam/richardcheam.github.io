---
// DSM review, Figure 1: words placed on the 12.5 Hz clock (Sec 3.1, p. 5).
// A word starting at s seconds puts a WORD token in frame floor(12.5 s) and
// its text in the next frame; every other cell is PAD. Six toy words with
// toy start times, one text token each.
const { alt } = Astro.props;
---
<div class="blog-diagram woc" role="region" aria-label={alt} data-woc>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 300" role="img" aria-labelledby="woc-title" class="blog-diagram-svg" font-family="Inter, sans-serif" style="touch-action: none">
    <title id="woc-title">Words dropped onto 80 millisecond frames, each marked by a WORD token</title>
    <g data-g></g>
    <text data-r1 x="20" y="250" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="272" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-woc]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const W = [{ w: "Alan", s: 0.35 }, { w: "Turing", s: 0.8 }, { w: "was", s: 1.3 }, { w: "an", s: 1.55 }, { w: "English", s: 1.7 }, { w: "mathematician", s: 2.1 }];
    const N = 34, CW = 740 / N, X = (s: number) => 20 + s * 12.5 * CW;
    let head = 99, sel = 0;
    function draw() {
      const g = $("[data-g]"); g.replaceChildren();
      mk(g, "text", { x: 20, y: 20, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "Word start times (drag a word)");
      mk(g, "line", { x1: 20, x2: 760, y1: 86, y2: 86, stroke: "#2b2b30" });
      for (let i = 0; i <= N; i += 5) mk(g, "text", { x: 20 + i * CW, y: 102, "font-size": 9.5, "text-anchor": "middle", fill: "#5f5f66" }, `${(i * 0.08).toFixed(1)} s`);
      W.forEach((w, k) => {
        const gg = mk(g, "g", { "data-k": k, style: "cursor: ew-resize" });
        mk(gg, "line", { x1: X(w.s), x2: X(w.s), y1: 50, y2: 86, stroke: k === sel ? "#a33b3b" : "#594578", "stroke-width": 2 });
        mk(gg, "text", { x: X(w.s) + 3, y: 44 + (k % 2) * 14 - 8, "font-size": 11, "font-weight": 700, fill: k === sel ? "#a33b3b" : "#594578" }, w.w);
      });
      // The grid.
      const cells: { t: string; kind: string }[] = Array.from({ length: N }, () => ({ t: "PAD", kind: "pad" }));
      W.forEach((w) => { const i = Math.floor(w.s * 12.5); if (w.s <= head) { if (i < N) cells[i] = { t: "WORD", kind: "word" }; if (i + 1 < N) cells[i + 1] = { t: w.w, kind: "text" }; } });
      mk(g, "text", { x: 20, y: 132, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "Text stream, one cell per 80 ms frame");
      cells.forEach((c, i) => {
        const x = 20 + i * CW, on = i * 0.08 <= head;
        mk(g, "rect", { x: x + 0.5, y: 142, width: CW - 1.5, height: 44, rx: 2, fill: !on ? "#f7f7f9" : c.kind === "word" ? "#a33b3b" : c.kind === "text" ? "#594578" : "#ececf1" });
        if (on && c.kind !== "pad") { const tt = mk(g, "text", { x: x + CW / 2, y: 168, "font-size": 8.5, "text-anchor": "middle", fill: "#fff", transform: `rotate(-90 ${x + CW / 2} 164)` }, c.t.length > 7 ? c.t.slice(0, 6) + "…" : c.t); void tt; }
        if (i % 5 === 0) mk(g, "text", { x: x + CW / 2, y: 200, "font-size": 9, "text-anchor": "middle", fill: "#b9b9c2" }, String(i));
      });
      if (head < 99) mk(g, "line", { x1: X(head), x2: X(head), y1: 30, y2: 190, stroke: "#a33b3b", "stroke-width": 1.5 });
      const w = W[sel], v = w.s * 12.5;
      $("[data-r1]").textContent = `${w.w}: ${w.s.toFixed(2)} × 12.5 = ${v.toFixed(3)}, floor = ${Math.floor(v)}. WORD in frame ${Math.floor(v)}, the word in frame ${Math.floor(v) + 1}.`;
      $("[data-r2]").textContent = "Red: WORD marker. Purple: the word's text. Grey: PAD. Times are toy values; the rule and the 12.5 Hz clock are the paper's.";
    }
    const svg = root.querySelector("svg")!;
    let drag = -1;
    const at = (e: PointerEvent) => { const r = svg.getBoundingClientRect(); return (((e.clientX - r.left) / r.width) * 780 - 20) / (12.5 * CW); };
    svg.addEventListener("pointerdown", (e) => { const g = (e.target as Element).closest("[data-k]"); if (!g) return; drag = +g.getAttribute("data-k")!; sel = drag; svg.setPointerCapture(e.pointerId); draw(); });
    svg.addEventListener("pointermove", (e) => { if (drag < 0) return; W[drag].s = Math.max(0, Math.min((N - 2) * 0.08, Math.round(at(e) * 100) / 100)); draw(); });
    svg.addEventListener("pointerup", () => { drag = -1; });
    draw();
    setupFigure(root, () => { head = 0; draw(); }, async (alive) => { await tween(4, (e) => { if (alive()) { head = (1 - Math.cbrt(1 - e)) * N * 0.08; draw(); } }); head = 99; draw(); });
  });
</script>
