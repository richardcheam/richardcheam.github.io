---
// Foundations, Transformer post: gradient through a scalar stack of
// F(x) = tanh(0.5x) from x = 1, plain (× F′) or residual (× (1 + F′)).
// Depth 5: 0.0229 and 2.5053. Depth 10: 0.00072 and 2.576. Linear preset
// (F = 0.5x), depth 10: 0.00098 and 57.67.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-resgrad>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 260" role="img" aria-labelledby="rg2-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rg2-title">The gradient walking back through a plain stack and a residual stack</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Depth <strong data-vd></strong></span><input class="scrub" data-d type="range" min="1" max="10" step="1" value="5" /></label>
    <div><span class="fig-panel__name">Layer</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-l="0" aria-pressed="true">tanh(0.5x)</button>
      <button type="button" class="fig-chip" data-l="1" aria-pressed="false">Linear, slope 0.5</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { stackGradient } from "../../lib/transformer";
  const show = (v: number) => (v >= 0.001 ? fmt(v, 4) : v.toExponential(2).replace("e-", " × 10^−"));
  document.querySelectorAll<HTMLElement>("[data-resgrad]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let depth = 5, linear = false;
    const steps = () => { const s = stackGradient(depth, 0.5, linear); return s.plain.map((p, i) => { const r = s.res[i]; return { say: i === 0 ? "Walk the gradient back one layer. Plain: multiply by the layer's slope F′. Residual: multiply by 1 + F′, because the shortcut adds a slope of 1." : `Layer ${i + 1}.`, math: `plain: × ${fmt(p.f, 4)} → ${show(p.g)}\nresidual: × (1 + ${fmt(r.f, 4)}) = × ${fmt(r.factor, 4)} → ${show(r.g)}` }; }); };
    function draw(k: number) {
      const s0 = stackGradient(depth, 0.5, linear), bw = Math.min(64, 600 / depth);
      let s = "";
      [["plain stack: y = F(x)", s0.plain, 30], ["residual stack: y = x + F(x)", s0.res, 140]].forEach(([title, rows, y0]) => {
        s += txt(30, (y0 as number) + 14, title as string, `font-size="12" font-weight="700" fill="${INK}"`);
        (rows as typeof s0.plain).forEach((r, i) => { const on = i <= k, x = 30 + i * (bw + 6); s += `<rect x="${x}" y="${(y0 as number) + 24}" width="${bw}" height="34" rx="5" fill="${i === k ? "#E3EFE9" : "#fff"}" stroke="${on ? JADE : "#cfd5d4"}"/>` + txt(x + bw / 2, (y0 as number) + 46, `×${fmt(r.factor, 2)}`, `font-size="${bw > 50 ? 11 : 9}" text-anchor="middle" fill="${on ? INK : "#B9C0BF"}"`) + txt(x + bw / 2, (y0 as number) + 76, on ? show(r.g) : "", `font-size="${bw > 50 ? 10.5 : 8.5}" text-anchor="middle" fill="${MUTED}"`); if ((y0 as number) > 100) s += `<path d="M${x - 3} ${(y0 as number) + 22} q ${bw / 2 + 3} -14 ${bw + 6} 0" fill="none" stroke="${GOLD}" stroke-width="1.5"/>`; });
      });
      const last = Math.min(k, depth - 1);
      if (k >= 0) s += txt(30, 250, `after ${last + 1} layer${last ? "s" : ""}: plain ${show(s0.plain[last].g)}, residual ${show(s0.res[last].g)}`, `font-size="13" font-weight="700" fill="${s0.res[last].g > 10 ? NEG : INK}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vd]").textContent = String(depth);
    }
    const redraw = stepper(root, steps, draw, { delay: 1 });
    $<HTMLInputElement>("[data-d]").addEventListener("input", (e) => { depth = +(e.target as HTMLInputElement).value; redraw(); });
    root.querySelectorAll<HTMLButtonElement>("[data-l]").forEach((b) => b.addEventListener("click", () => { linear = b.dataset.l === "1"; root.querySelectorAll("[data-l]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
