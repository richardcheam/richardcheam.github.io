---
// Foundations, Transformer post: RoPE with θ = 30°, q = (1, 0), k = (2, 1).
// The rotated dot product depends only on the gap m − n: gap 1 gives
// 2.232, gap 2 gives 1.866, gap −1 gives 1.232.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-rope>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 290" role="img" aria-labelledby="rp-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rp-title">A query and a key rotated by their positions; their dot product depends only on the gap</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Query position m <strong data-v="m"></strong></span><input class="scrub" data-k="m" type="range" min="0" max="7" step="1" value="1" /></label>
    <label><span class="fig-panel__name">Key position n <strong data-v="n"></strong></span><input class="scrub" data-k="n" type="range" min="0" max="7" step="1" value="0" /></label>
    <label><span class="fig-panel__name">Angle per position θ <strong data-v="th"></strong></span><input class="scrub" data-k="th" type="range" min="10" max="90" step="5" value="30" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { rotate } from "../../lib/transformer";
  const Q = [1, 0], K = [2, 1];
  document.querySelectorAll<HTMLElement>("[data-rope]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { m: 1, n: 0, th: 30 };
    const set = (m: number, n: number) => { p.m = m; p.n = n; $<HTMLInputElement>('[data-k="m"]').value = String(m); $<HTMLInputElement>('[data-k="n"]').value = String(n); };
    const calc = (m = p.m, n = p.n) => { const t = (p.th * Math.PI) / 180, q = rotate(Q, m * t), k = rotate(K, n * t); return { q, k, d: q[0] * k[0] + q[1] * k[1] }; };
    const v4 = (v: number[]) => `(${v.map((x) => fmt(x, 3)).join(", ")})`;
    const steps = () => [[0, 0], [1, 0], [3, 2], [5, 4], [2, 0], [0, 1]].map(([m, n]) => { const c = calc(m, n); return { say: m === 0 && n === 0 ? "No rotation: the plain dot product of q and k." : m - n === 1 ? `Gap 1 at positions (${m}, ${n}): both arrows turn, the angle between them does not, so the score is the same.` : `Gap ${m - n}.`, math: `q rotated by ${m} × ${p.th}° = ${v4(c.q)};  k rotated by ${n} × ${p.th}° = ${v4(c.k)}\ndot = ${fmt(c.q[0], 3)} × ${par(c.k[0], 3)} + ${fmt(c.q[1], 3)} × ${par(c.k[1], 3)} = ${fmt(c.d, 4)}`, enter: () => set(m, n) }; });
    function draw() {
      const c = calc(), cx = 160, cy = 150, S = 50;
      let s = `<circle cx="${cx}" cy="${cy}" r="${S * 2.236}" fill="none" stroke="#eef0f0"/><circle cx="${cx}" cy="${cy}" r="${S}" fill="none" stroke="#eef0f0"/>` + `<line x1="${cx - 125}" x2="${cx + 125}" y1="${cy}" y2="${cy}" stroke="#eef0f0"/><line x1="${cx}" x2="${cx}" y1="${cy - 125}" y2="${cy + 125}" stroke="#eef0f0"/>`;
      s += arrow(cx, cy, cx + c.k[0] * S, cy - c.k[1] * S, JADE, 3) + txt(cx + c.k[0] * S + 6, cy - c.k[1] * S, `k at ${p.n}`, `font-size="11.5" font-weight="700" fill="${JADE}"`);
      s += arrow(cx, cy, cx + c.q[0] * S, cy - c.q[1] * S, GOLD, 3) + txt(cx + c.q[0] * S + 6, cy - c.q[1] * S + 14, `q at ${p.m}`, `font-size="11.5" font-weight="700" fill="${GOLD}"`);
      s += txt(30, 22, `θ = ${p.th}° per position`, `font-size="12" font-weight="700" fill="${INK}"`);
      s += txt(340, 50, `positions (${p.m}, ${p.n}), gap ${p.m - p.n}`, `font-size="13" font-weight="700" fill="${INK}"`) + txt(340, 76, `score ${fmt(c.d, 4)}`, `font-size="16" font-weight="700" fill="${GOLD}"`);
      s += txt(340, 112, "every pair with this gap:", `font-size="11.5" fill="${MUTED}"`);
      const g = p.m - p.n; let row = 0;
      for (let n = 0; n <= 7; n++) { const m = n + g; if (m < 0 || m > 7) continue; s += txt(340 + (row % 3) * 130, 136 + Math.floor(row / 3) * 22, `(${m}, ${n}): ${fmt(calc(m, n).d, 4)}`, `font-size="12" fill="${INK}"`); row++; }
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = String(p[el.dataset.v!])));
    }
    const redraw = stepper(root, steps, draw, { delay: 2 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
  });
</script>
