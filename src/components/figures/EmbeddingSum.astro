---
// Eq 1 and Eq 2 of MoshiRAG as a grid. Each column is one 80 ms step i; each
// cell is an embedding vector, drawn as a short stack of coloured segments.
// Moshi's input h_i is the sum of three embeddings (Eq 1). Between
// i_ret + d·f_r + 1 and i_ret + d·f_r + l a fourth row, the k-th reference
// vector, joins the sum (Eq 2). Example values: i_ret = 16, d = 1.2 s
// (d·f_r = 15 frames), l = 17 (ARC-Encoder ×4 on an assumed 65-token reference).
import { svgMath } from "../../lib/svg-math";
const { alt } = Astro.props;
const IRET = 16, DF = 15, L = 17, I0 = 26, I1 = 50;
const open = IRET + DF; // window covers i in (open, open + L]
const cols = Array.from({ length: I1 - I0 + 1 }, (_, j) => I0 + j);
const X0 = 168, CW = 24;
const cx = (i: number) => X0 + (i - I0) * CW;
const rows = [
  { key: "txt", label: "Moshi text", sub: "inner monologue token", y: 46, hue: [89, 69, 120] },
  { key: "spk", label: "Moshi speech", sub: "its own audio tokens", y: 92, hue: [89, 69, 120] },
  { key: "usr", label: "user speech", sub: "your audio tokens", y: 138, hue: [95, 95, 102] },
  { key: "ref", label: "reference", sub: "h^{ref}_k, the k-th vector", y: 196, hue: [79, 93, 58] },
];
const SUMY = 262;
// Deterministic pseudo-random shades so every vector looks different.
const shade = (i: number, r: number, s: number) => 0.25 + 0.7 * Math.abs(Math.sin(i * 12.9898 + r * 78.233 + s * 3.17));
const inWin = (i: number) => i > open && i <= open + L;
---
<div class="blog-diagram es" role="region" aria-label={alt} data-es data-cfg={JSON.stringify({ IRET, DF, L, I0, I1, X0, CW })}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 352" role="img" aria-labelledby="es-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="es-title">The reference vectors join Moshi's input sum for l steps</title>
    <!-- window band -->
    <rect x={cx(open + 1) - 3} y="190" width={L * CW} height="42" rx="5" fill="#4F5D3A" fill-opacity="0.06" stroke="#4F5D3A" stroke-opacity="0.35" stroke-dasharray="3 3" />
    <text x={cx(open + 1) - 3} y="243" font-size="10" fill="#4F5D3A" set:html={svgMath(`window opens after i_{ret} + d·f_r = ${IRET} + ${DF} = ${open}`, 10)} />
    <text x={cx(open + L) + CW - 3} y="184" font-size="9.5" fill="#4F5D3A" text-anchor="end" set:html={svgMath(`l = ${L} steps`, 9.5)} />

    <g font-size="11.5" fill="#2b2b30">
      {rows.map((r) => <text x="14" y={r.y + 12}>{r.label}</text>)}
      <text x="14" y={SUMY + 12} font-weight="600" set:html={svgMath("h′_i, the input", 11.5)} />
    </g>
    <g font-size="10.5" fill="#5f5f66">
      {rows.map((r) => <text x="14" y={r.y + 24} set:html={svgMath(r.sub, 10.5)} />)}
      <text x="14" y={SUMY + 24}>what the transformer reads</text>
    </g>
    <g font-size="14" fill="#5f5f66">
      <text x="148" y="78">+</text><text x="148" y="124">+</text><text x="148" y="178">+</text><text x="148" y="250">=</text>
    </g>

    {cols.map((i) => (
      <g data-col={i}>
        {rows.slice(0, 3).map((r, ri) => (
          <g data-cell={r.key}>
            {[0, 1, 2, 3].map((s) => <rect x={cx(i) + 3} y={r.y + s * 8} width={CW - 8} height="7" rx="1" fill={`rgb(${r.hue.join(",")})`} fill-opacity={shade(i, ri, s)} />)}
          </g>
        ))}
        {inWin(i) ? (
          <g data-cell="ref">
            {[0, 1, 2, 3].map((s) => <rect x={cx(i) + 3} y={rows[3].y + s * 8} width={CW - 8} height="7" rx="1" fill="#4F5D3A" fill-opacity={shade(i, 3, s)} />)}
          </g>
        ) : (
          <rect x={cx(i) + 3} y={rows[3].y} width={CW - 8} height="31" rx="2" fill="none" stroke="#d5d5dc" stroke-dasharray="2 2" />
        )}
        <g data-sum>
          {[0, 1, 2, 3].map((s) => <rect x={cx(i) + 3} y={SUMY + s * 8} width={CW - 8} height="7" rx="1" fill={inWin(i) ? "#4F5D3A" : "#594578"} fill-opacity={0.35 + 0.6 * ((shade(i, 0, s) + shade(i, 1, s) + shade(i, 2, s) + (inWin(i) ? shade(i, 3, s) : 0)) / (inWin(i) ? 4 : 3))} />)}
        </g>
        {(i - I0) % 4 === 0 && <text x={cx(i) + CW / 2 - 1} y="304" font-size="9" text-anchor="middle" fill="#5f5f66" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">{i}</text>}
      </g>
    ))}
    <text x={X0 - 4} y="304" font-size="9" fill="#5f5f66" text-anchor="end">step i</text>
    <rect data-cursor x={cx(I1) - 1} y="38" width={CW - 4} height="262" rx="4" fill="none" stroke="#2b2b30" stroke-width="1.3" />

    <g data-readout font-size="13" fill="#2b2b30">
      <text data-line1 x="14" y="328"></text>
      <text data-line2 x="14" y="346" fill="#5f5f66" font-size="12"></text>
    </g>
  </svg>
  <label class="es__ctl">
    <span class="es__name">Step i<strong data-val>{I1}</strong></span>
    <input class="scrub" data-input type="range" min={I0} max={I1} step="1" value={I1} style={`--n: ${I1 - I0}; --p: 100%`} />
  </label>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<style>
  .es__ctl { display: block; max-width: 460px; margin-top: 0.4rem; font-size: 0.85rem; color: var(--text-secondary); }
  .es__name { display: flex; gap: 0.5rem; }
  .es__name strong { margin-left: auto; color: var(--text); font-family: var(--font-mono); font-size: 0.8rem; }
</style>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";
  import { svgMath } from "../../lib/svg-math";

  document.querySelectorAll<HTMLElement>("[data-es]").forEach((root) => {
    const c = JSON.parse(root.dataset.cfg!);
    const open = c.IRET + c.DF;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const input = $<HTMLInputElement>("[data-input]");
    const cursor = $<SVGRectElement>("[data-cursor]");
    const line1 = $<SVGTextElement>("[data-line1]");
    const line2 = $<SVGTextElement>("[data-line2]");
    const col = (i: number) => $<SVGGElement>(`[data-col="${i}"]`);
    const sum = (i: number) => col(i).querySelector<SVGGElement>("[data-sum]")!;

    function readout(i: number) {
      const k = i - open;
      if (k >= 1 && k <= c.L) {
        line1.innerHTML = svgMath(`i = ${i}:   k = i − (i_{ret} + d·f_r) = ${i} − (${c.IRET} + ${c.DF}) = ${k}`, 13);
        line2.innerHTML = svgMath(`h′_{${i}} = h_{${i}} + h^{ref}_{${k}}     (reference vector ${k} of ${c.L})`, 12);
      } else {
        line1.innerHTML = svgMath(`i = ${i}:   ${k < 1 ? `before the window (k = ${k} < 1)` : `after the window (k = ${k} > l = ${c.L})`}`, 13);
        line2.innerHTML = svgMath(`h′_{${i}} = h_{${i}}     (plain Moshi: text + own speech + your speech)`, 12);
      }
    }

    // Static view up to step i: columns after i are not computed yet.
    function show(i: number) {
      input.value = String(i);
      $("[data-val]").textContent = String(i);
      input.style.setProperty("--p", `${((i - c.I0) / (c.I1 - c.I0)) * 100}%`);
      cursor.setAttribute("x", String(c.X0 + (i - c.I0) * c.CW - 1));
      for (let j = c.I0; j <= c.I1; j++) {
        col(j).style.opacity = j <= i ? "1" : "0.18";
        sum(j).style.opacity = j <= i ? "1" : "0";
      }
      readout(i);
    }
    input.addEventListener("input", () => show(+input.value));

    // Play: for each step the input rows drop into the sum row.
    setupFigure(
      root,
      () => show(c.I0 - 1),
      async (alive) => {
        for (let i = c.I0; i <= c.I1; i++) {
          if (!alive()) return;
          show(i);
          const inWin = i > open && i <= open + c.L;
          animate(sum(i), { opacity: [0, 1], transform: ["translateY(-14px)", "translateY(0px)"] }, { duration: dur(0.22) });
          await wait(inWin || i === open ? 0.38 : 0.2);
        }
      },
    );
  });
</script>
