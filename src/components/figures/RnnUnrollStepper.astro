---
// Foundations, recurrent networks post: one tanh neuron reused for five
// steps. w_x = 1, w_h = 0.5, b = 0, inputs 1, 0.5, −1, 0, 0: hidden states
// 0.7616, 0.7068, −0.5694, −0.2772, −0.1377.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-rnnunroll>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 250" role="img" aria-labelledby="ru-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ru-title">The same neuron drawn five times, passing its memory from step to step</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Input weight w_x <strong data-v="wx"></strong></span><input class="scrub" data-k="wx" type="range" min="-2" max="2" step="0.1" value="1" /></label>
    <label><span class="fig-panel__name">Recurrent weight w_h <strong data-v="wh"></strong></span><input class="scrub" data-k="wh" type="range" min="-3" max="3" step="0.1" value="0.5" /></label>
    <label><span class="fig-panel__name">Bias b <strong data-v="b"></strong></span><input class="scrub" data-k="b" type="range" min="-1" max="1" step="0.1" value="0" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { rnnForward } from "../../lib/rnn";
  const XS = [1, 0.5, -1, 0, 0];
  document.querySelectorAll<HTMLElement>("[data-rnnunroll]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { wx: 1, wh: 0.5, b: 0 };
    const run = () => rnnForward(p.wx, p.wh, p.b, XS);
    const f4 = (v: number) => fmt(v, 4);
    const steps = () => run().flatMap((r, t) => [
      { say: `Step ${t + 1}: weigh the new input.`, math: `w_x × x${t + 1} = ${fmt(p.wx)} × ${par(XS[t])} = ${f4(p.wx * XS[t])}` },
      { say: t === 0 ? "Weigh the memory from the step before. It starts at zero." : "Weigh the memory from the step before: the same w_h at every step.", math: `w_h × h${t} = ${fmt(p.wh)} × ${par(r.hPrev, 4)} = ${f4(p.wh * r.hPrev)}` },
      { say: "Add them and the bias, then squash with tanh. The result is the new memory.", math: `z = ${f4(p.wx * XS[t])} + ${par(p.wh * r.hPrev, 4)} + ${par(p.b)} = ${f4(r.z)},   h${t + 1} = tanh(${f4(r.z)}) = ${f4(r.h)}` },
    ]);
    function draw(k: number) {
      const rs = run(), t0 = Math.floor(k / 3), sub = k % 3;
      let s = "";
      rs.forEach((r, t) => {
        const x = 70 + t * 140, on = t === t0 && k >= 0, done = t < t0 || (t === t0 && sub === 2);
        s += `<rect x="${x}" y="70" width="90" height="70" rx="10" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : INK}" stroke-width="${on ? 2.5 : 1.3}"/>`;
        s += txt(x + 45, 92, "tanh", `font-size="11" text-anchor="middle" fill="${MUTED}"`) + txt(x + 45, 118, done ? fmt(r.h, 4) : "?", `font-size="15" font-weight="700" text-anchor="middle" fill="${done ? (r.h < 0 ? NEG : INK) : "#B9C0BF"}"`);
        s += txt(x + 45, 134, `h${t + 1}`, `font-size="10.5" text-anchor="middle" fill="${MUTED}"`);
        // Input from below.
        s += arrow(x + 45, 200, x + 45, 142, on && sub === 0 ? GOLD : MUTED, on && sub === 0 ? 2.5 : 1.3) + txt(x + 45, 218, `x${t + 1} = ${fmt(XS[t])}`, `font-size="12" font-weight="700" text-anchor="middle" fill="${INK}"`) + txt(x + 52, 180, `w_x ${fmt(p.wx)}`, `font-size="10.5" fill="${GOLD}"`);
        // Memory from the left.
        s += arrow(x - 50, 105, x - 2, 105, on && sub === 1 ? GOLD : MUTED, on && sub === 1 ? 2.5 : 1.3) + txt(x - 26, 98, `w_h ${fmt(p.wh)}`, `font-size="10.5" text-anchor="middle" fill="${GOLD}"`);
      });
      s += txt(30, 109, "h0 = 0", `font-size="11" fill="${MUTED}"`);
      s += txt(30, 30, "One neuron, unrolled over five steps. The same three weights are used at every step.", `font-size="12" font-weight="700" fill="${INK}"`);
      s += txt(30, 50, `w_x = ${fmt(p.wx)}, w_h = ${fmt(p.wh)}, b = ${fmt(p.b)}`, `font-size="11.5" fill="${GOLD}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[el.dataset.v!], 1)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.1 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
  });
</script>
