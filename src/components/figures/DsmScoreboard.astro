---
// DSM review, Figure 7: results tables as dot plots. Table 1 (p. 7) short-form
// ASR average WER; Table 2 (p. 8) long-form ASR; Table 3 (p. 9) TTS English
// WER; Table 15 (p. 25) TTS ablations. Lower is better everywhere.
const { alt } = Astro.props;
const tabs = {
  asr: { name: "ASR, short clips", src: "Table 1, p. 7", unit: "average WER %", max: 20, rows: [["Whisper medium.en", 8.1, 0], ["Whisper large-v3", 7.5, 0], ["ElevenLabs Scribe", 6.9, 0], ["Canary-Flash", 6.4, 0], ["Parakeet-TDT-v2", 6.1, 0], ["Canary-Qwen-2.5B", 5.6, 0], ["Whisper medium.en, streaming", 9.0, 1], ["Whisper large-v3, streaming", 9.4, 1], ["SeamlessStreaming", 19.7, 1], ["Parakeet-TDT-v2, block streaming", 7.0, 1], ["DSM-ASR", 6.4, 1]] },
  long: { name: "ASR, long recordings", src: "Table 2, p. 8", unit: "average WER %", max: 10, rows: [["Whisper large-v2 (offline)", 9.0, 0], ["Whisper large-v3, streaming", 8.1, 1], ["Parakeet-0.6B-TDT-v2, streaming", 7.8, 1], ["DSM-ASR", 7.9, 1]] },
  tts: { name: "TTS, English WER", src: "Table 3, p. 9", unit: "average WER %", max: 4, rows: [["Orpheus", 3.51, 1], ["CSM", 3.82, 1], ["Dia", 2.79, 1], ["Chatterbox", 1.95, 1], ["DSM-TTS, turn by turn", 2.06, 1], ["DSM-TTS, long-form", 1.72, 1]] },
  abl: { name: "TTS ablations", src: "Table 15, p. 25", unit: "English WER %", max: 4, rows: [["DSM-TTS", 1.6, 1], ["No lookahead", 3.51, 1], ["Fixed padding, 4 from start", 2.86, 1], ["Fixed padding, 2 from end", 2.32, 1]] },
};
---
<div class="blog-diagram dsb" role="region" aria-label={alt} data-dsb data-tabs={JSON.stringify(tabs)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 340" role="img" aria-labelledby="dsb-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="dsb-title">DSM's results against other systems</title>
    <g data-plot></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Table</span><div class="fig-chips">
      {Object.entries(tabs).map(([k, t], i) => <button type="button" class="fig-chip" data-tab={k} aria-pressed={i === 0 ? "true" : "false"}>{t.name}</button>)}
      <button type="button" class="fig-chip" data-stream aria-pressed="false">Streaming only</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-dsb]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const T: Record<string, { name: string; src: string; unit: string; max: number; rows: (string | number)[][] }> = JSON.parse(root.dataset.tabs!);
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    let tab = "asr", streamOnly = false;
    function draw(p = 1) {
      const t = T[tab], g = $("[data-plot]"); g.replaceChildren();
      const rows = t.rows.filter((r) => !streamOnly || r[2] === 1), X = (v: number) => 260 + (v / t.max) * 440, H = Math.min(26, 280 / rows.length);
      for (let k = 0; k <= 4; k++) { const v = (t.max * k) / 4; mk(g, "line", { x1: X(v), x2: X(v), y1: 16, y2: 300, stroke: "#f2f2f5" }); mk(g, "text", { x: X(v), y: 316, "font-size": 10, "text-anchor": "middle", fill: "#2b2b30" }, String(v)); }
      mk(g, "text", { x: 700, y: 334, "font-size": 10.5, "text-anchor": "end", fill: "#5f5f66" }, `${t.unit}, lower is better (${t.src})`);
      rows.forEach(([n, v, s], i) => {
        const y = 28 + i * H, dsm = String(n).startsWith("DSM");
        mk(g, "text", { x: 20, y: y + 4, "font-size": 11, "font-weight": dsm ? 700 : 400, fill: s === 0 ? "#8a8a94" : "#2b2b30" }, `${n}${tab === "asr" && s === 0 ? " (offline)" : ""}`);
        const x = X((v as number) * p);
        mk(g, "line", { x1: X(0), x2: x, y1: y, y2: y, stroke: dsm ? "#594578" : "#d5d5dc", "stroke-width": 2 });
        mk(g, "circle", { cx: x, cy: y, r: dsm ? 7 : 5, fill: dsm ? "#594578" : s === 0 ? "#fff" : "#8a8a94", stroke: dsm ? "#594578" : "#8a8a94", "stroke-width": 2 });
        if (p >= 1) mk(g, "text", { x: x + 10, y: y + 4, "font-size": 10.5, fill: "#2b2b30" }, String(v));
      });
      root.querySelectorAll("[data-tab]").forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute("data-tab") === tab)));
      $("[data-stream]").setAttribute("aria-pressed", String(streamOnly));
    }
    const go = async () => { await tween(0.8, (e) => draw(e)); draw(1); };
    root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.addEventListener("click", () => { tab = b.dataset.tab!; go(); }));
    $("[data-stream]").addEventListener("click", () => { streamOnly = !streamOnly; go(); });
    draw();
    setupFigure(root, () => draw(0), async (alive) => { await tween(1.4, (e) => { if (alive()) draw(e); }); draw(1); });
  });
</script>
