---
const { alt } = Astro.props;
---
<div class="blog-diagram" tabindex="0" role="region" aria-label={alt} data-ang>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 52 780 248" role="img" aria-labelledby="angular-structure-title angular-structure-desc" class="blog-diagram-svg" font-family="Inter, sans-serif">
  <title id="angular-structure-title">Angular structure and the pairwise cosine distribution</title><desc id="angular-structure-desc">Three unit circles. In the first, every embedding points one way and all pairwise cosines pile up at one. In the second, embeddings spread but stay inside a narrow cone, so cosines concentrate in a high band. In the third, embeddings spread around the circle and cosines spread across the range. Schematic, not measured data.</desc>
  <circle cx="130" cy="145" r="62" fill="none" stroke="#d5d5dc" />
  <circle cx="390" cy="145" r="62" fill="none" stroke="#d5d5dc" />
  <circle cx="650" cy="145" r="62" fill="none" stroke="#d5d5dc" />

  <g data-rays stroke="#A8503A" stroke-width="1" opacity="0.45">
    <line x1="130" y1="145" x2="173" y2="100" /><line x1="130" y1="145" x2="169" y2="97" />
  </g>
  <g data-pts="130" fill="#A8503A">
    <circle cx="174" cy="101" r="4" /><circle cx="172" cy="98" r="4" /><circle cx="169" cy="96" r="4" />
    <circle cx="176" cy="104" r="4" /><circle cx="171" cy="100" r="4" />
  </g>

  <g data-rays stroke="#A8503A" stroke-width="1" opacity="0.45">
    <line x1="390" y1="145" x2="446" y2="118" /><line x1="390" y1="145" x2="412" y2="86" />
  </g>
  <g data-pts="390" fill="#A8503A">
    <circle cx="446" cy="118" r="4" /><circle cx="441" cy="107" r="4" /><circle cx="433" cy="97" r="4" />
    <circle cx="423" cy="90" r="4" /><circle cx="412" cy="86" r="4" /><circle cx="400" cy="84" r="4" />
  </g>

  <g data-rays stroke="#4F5D3A" stroke-width="1" opacity="0.45">
    <line x1="650" y1="145" x2="712" y2="145" /><line x1="650" y1="145" x2="650" y2="83" />
    <line x1="650" y1="145" x2="588" y2="145" /><line x1="650" y1="145" x2="650" y2="207" />
  </g>
  <g data-pts="650" fill="#4F5D3A">
    <circle cx="712" cy="145" r="4" /><circle cx="694" cy="101" r="4" /><circle cx="650" cy="83" r="4" />
    <circle cx="606" cy="101" r="4" /><circle cx="588" cy="145" r="4" /><circle cx="606" cy="189" r="4" />
    <circle cx="650" cy="207" r="4" /><circle cx="694" cy="189" r="4" />
  </g>

  <g fill="#111111" font-size="17">
    <text x="68" y="238">Complete collapse</text><text x="330" y="238">Cone anisotropy</text><text x="590" y="238">Angular spread</text>
  </g>

  <g stroke="#d5d5dc"><line x1="68" y1="268" x2="192" y2="268" /><line x1="328" y1="268" x2="452" y2="268" /><line x1="588" y1="268" x2="712" y2="268" /></g>
  <rect data-bar="68" x="180" y="259" width="12" height="18" fill="#A8503A" />
  <rect data-bar="328" x="416" y="259" width="36" height="18" fill="#A8503A" />
  <rect data-bar="588" x="612" y="259" width="76" height="18" fill="#4F5D3A" />
  <g fill="#5f5f66" font-size="14">
    <text x="62" y="292">−1</text><text x="186" y="292">1</text>
    <text x="322" y="292">−1</text><text x="446" y="292">1</text>
    <text x="582" y="292">−1</text><text x="706" y="292">1</text>
  </g>

  </svg>
<button type="button" class="fig-replay" data-replay>Replay</button>
</div>
<p class="blog-figure-reading">The bar is where pairwise cosines land. Retrieval ranks inside that band and nowhere else.</p>

<script>
  import { animate, dur, setupFigure } from "../../lib/figure-motion";

  // All three start spread evenly round the circle with cosines covering
  // [-1, 1]. Then the embeddings rotate into their final angles: collapse piles
  // them on one heading, the cone squeezes them into an arc, the spread case
  // stays put. Each bar narrows to where its pairwise cosines now land.
  document.querySelectorAll<HTMLElement>("[data-ang]").forEach((root) => {
    const groups = Array.from(root.querySelectorAll<SVGGElement>("[data-pts]")).map((g) => {
      const cx = +g.dataset.pts!, cy = 145, r = 62;
      const dots = Array.from(g.querySelectorAll<SVGCircleElement>("circle"));
      const end = dots.map((d) => Math.atan2(-(+d.getAttribute("cy")! - cy), +d.getAttribute("cx")! - cx));
      const start = dots.map((_, i) => (2 * Math.PI * i) / dots.length);
      // Rotate each start so it travels the short way to its end angle.
      const from = start.map((a, i) => { let d = a - end[i]; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return end[i] + d; });
      return { cx, cy, r, dots, end, from };
    });
    const bars = Array.from(root.querySelectorAll<SVGRectElement>("[data-bar]")).map((b) => ({ b, lo: +b.dataset.bar!, x: +b.getAttribute("x")!, w: +b.getAttribute("width")! }));
    const rays = Array.from(root.querySelectorAll<SVGGElement>("[data-rays]"));
    function frame(u: number) {
      for (const g of groups) g.dots.forEach((d, i) => {
        const a = g.from[i] + (g.end[i] - g.from[i]) * u;
        d.setAttribute("cx", (g.cx + g.r * Math.cos(a)).toFixed(1));
        d.setAttribute("cy", (g.cy - g.r * Math.sin(a)).toFixed(1));
      });
      for (const { b, lo, x, w } of bars) {
        b.setAttribute("x", (lo + (x - lo) * u).toFixed(1));
        b.setAttribute("width", (124 + (w - 124) * u).toFixed(1));
      }
    }
    const tween = (seconds: number, step: (u: number) => void, alive: () => boolean) =>
      new Promise<void>((res) => {
        const d = dur(seconds) * 1000;
        if (!d) { step(1); return res(); }
        const t0 = performance.now();
        const f = (now: number) => { if (!alive()) return res(); const u = Math.min(1, (now - t0) / d); step(u); u < 1 ? requestAnimationFrame(f) : res(); };
        requestAnimationFrame(f);
      });
    setupFigure(
      root,
      () => { frame(0); rays.forEach((r) => (r.style.opacity = "0")); },
      async (alive) => {
        await new Promise((r) => setTimeout(r, dur(0.6) * 1000));
        await tween(2.2, (u) => frame(u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2), alive);
        if (!alive()) return;
        frame(1);
        rays.forEach((r) => animate(r, { opacity: [0, 0.45] }, { duration: dur(0.4) }));
      },
    );
  });
</script>
