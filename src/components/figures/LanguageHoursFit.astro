---
// Whisper review, Figure 6: WER against training hours on log scales. Eight
// languages whose hours (Fig 11, p. 27) and Large V2 Fleurs WER (Table 13,
// p. 24) I read off the paper. A least-squares line is fitted live to these
// eight; the paper's fit uses every Fleurs language with training data and
// reports r^2 = 0.83, "WER halves for every 16x" (Sec 3.4, p. 7).
const { alt } = Astro.props;
const pts = [["Khmer", 1.3, 99.7], ["Kannada", 3.8, 37.0], ["Kazakh", 12, 37.7], ["Armenian", 13, 44.6], ["Icelandic", 16, 38.2], ["Croatian", 91, 13.4], ["Hungarian", 379, 17.0], ["Indonesian", 1014, 7.1]];
---
<div class="blog-diagram lhf" role="region" aria-label={alt} data-lhf data-pts={JSON.stringify(pts)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 380" role="img" aria-labelledby="lhf-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="lhf-title">Word error rate falling as training hours grow, on log scales</title>
    <g data-plot></g>
    <text data-r1 x="20" y="334" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="356" font-size="12" fill="#2b2b30"></text>
    <text data-r3 x="20" y="376" font-size="11" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Khmer training hours, what if<strong data-vh></strong></span><input class="scrub" data-h type="range" min="0.15" max="4" step="0.05" value="2.5" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-lhf]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const P: [string, number, number][] = JSON.parse(root.dataset.pts!);
    const hIn = $<HTMLInputElement>("[data-h]");
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const X = (h: number) => 70 + ((Math.log10(h) + 0.5) / 4.7) * 660, Y = (w: number) => 300 - ((Math.log10(w) - 0.5) / 1.6) * 270;
    let shown = P.length;
    function fit(n: number) {
      const xs = P.slice(0, n).map((p) => Math.log10(p[1])), ys = P.slice(0, n).map((p) => Math.log10(p[2]));
      const mx = xs.reduce((a, b) => a + b, 0) / n, my = ys.reduce((a, b) => a + b, 0) / n;
      const sxy = xs.reduce((a, x, i) => a + (x - mx) * (ys[i] - my), 0), sxx = xs.reduce((a, x) => a + (x - mx) ** 2, 0), syy = ys.reduce((a, y) => a + (y - my) ** 2, 0);
      const b = sxy / sxx, a = my - b * mx; return { a, b, r2: (sxy * sxy) / (sxx * syy), mx, my };
    }
    function draw() {
      const g = $("[data-plot]"); g.replaceChildren();
      [0.5, 1, 10, 100, 1000, 10000].forEach((h) => { mk(g, "line", { x1: X(h), x2: X(h), y1: 30, y2: 300, stroke: "#f2f2f5" }); mk(g, "text", { x: X(h), y: 316, "font-size": 10, "text-anchor": "middle", fill: "#2b2b30" }, h.toLocaleString("en")); });
      [5, 10, 20, 50, 100].forEach((w) => { mk(g, "line", { x1: 70, x2: 730, y1: Y(w), y2: Y(w), stroke: "#f2f2f5" }); mk(g, "text", { x: 62, y: Y(w) + 4, "font-size": 10, "text-anchor": "end", fill: "#2b2b30" }, `${w}%`); });
      mk(g, "text", { x: 730, y: 22, "font-size": 10.5, "text-anchor": "end", fill: "#5f5f66" }, "training hours in that language (log) →");
      mk(g, "text", { x: 74, y: 22, "font-size": 10.5, fill: "#5f5f66" }, "Fleurs WER, Large V2 (log)");
      if (shown >= 2) {
        const f = fit(shown), l = (h: number) => 10 ** (f.a + f.b * Math.log10(h));
        mk(g, "line", { x1: X(0.5), y1: Y(l(0.5)), x2: X(20000), y2: Y(l(20000)), stroke: "#594578", "stroke-width": 2 });
        const k = (h: number) => 10 ** (f.my - 0.25 * (Math.log10(h) - f.mx));
        mk(g, "line", { x1: X(0.5), y1: Y(k(0.5)), x2: X(20000), y2: Y(k(20000)), stroke: "#8a8a94", "stroke-width": 1.5, "stroke-dasharray": "5 4" });
        $("[data-r2]").textContent = `Fit on these ${shown}: slope ${f.b.toFixed(2)}, r² = ${f.r2.toFixed(2)}. The paper's rule, halving per 16×, is slope −0.25 (dashed).`;
      }
      P.slice(0, shown).forEach(([n, h, w]) => { const c = mk(g, "circle", { cx: X(h), cy: Y(w), r: n === "Khmer" ? 7 : 5, fill: n === "Khmer" ? "#a33b3b" : "#594578" }); mk(c, "title", {}, `${n}: ${h} h, ${w}% WER`); mk(g, "text", { x: X(h) + 9, y: Y(w) + 4, "font-size": 10.5, fill: n === "Khmer" ? "#a33b3b" : "#2b2b30", "font-weight": n === "Khmer" ? 700 : 400 }, n); });
      const H = 10 ** +hIn.value, pred = 99.7 * (H / 1.3) ** -0.25;
      if (H > 1.31) { mk(g, "line", { x1: X(1.3), y1: Y(99.7), x2: X(H), y2: Y(pred), stroke: "#a33b3b", "stroke-dasharray": "3 3" }); mk(g, "circle", { cx: X(H), cy: Y(pred), r: 6, fill: "none", stroke: "#a33b3b", "stroke-width": 2 }); }
      $("[data-r1]").textContent = `Khmer with ${Math.round(H).toLocaleString("en")} hours: 99.7 × (${Math.round(H)} ÷ 1.3)^−0.25 ≈ ${pred.toFixed(1)}% WER, if it followed the halving rule.`;
      $("[data-r3]").textContent = "Points from Fig 11 (p. 27) and Table 13 (p. 24). The Khmer projection is my extrapolation; languages with their own scripts tend to sit above the line (Sec 3.4, p. 7).";
      $("[data-vh]").textContent = `${Math.round(H).toLocaleString("en")} h`; hIn.style.setProperty("--p", `${(+hIn.value / 4) * 100}%`);
    }
    hIn.addEventListener("input", draw);
    draw();
    setupFigure(root, () => { shown = 0; draw(); }, async (alive) => { for (let i = 1; i <= P.length; i++) { await wait(0.35); if (!alive()) return; shown = i; draw(); } });
  });
</script>
