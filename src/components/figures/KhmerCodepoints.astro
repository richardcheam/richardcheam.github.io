---
// What a Khmer word is made of, and what each tokenizer sees. Words are real
// examples from the project's pronunciation work. The code points and UTF-8
// bytes are computed in the browser; no SentencePiece segmentation is shown,
// because that needs the project's tokenizer file.
const { alt } = Astro.props;
const words = ["រង្គ", "សម្បូណ៌", "បរទេះ"];
---
<div class="blog-diagram kc" role="region" aria-label={alt} data-kc data-words={JSON.stringify(words)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 390" role="img" aria-labelledby="kc-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="kc-title">A Khmer word as written, as code points and as bytes</title>
    <text x="24" y="28" font-size="11" letter-spacing="1" fill="#5f5f66">AS WRITTEN</text>
    <text data-word x="24" y="92" font-size="56" fill="#2b2b30" font-family="'Noto Sans Khmer', 'Khmer OS', 'Khmer Sangam MN', sans-serif"></text>
    <text data-wordnote x="300" y="70" font-size="11" fill="#5f5f66"></text>

    <text x="24" y="138" font-size="11" letter-spacing="1" fill="#5f5f66">AS UNICODE CODE POINTS, WHAT A KHMER TOKENIZER BUILDS PIECES FROM</text>
    <g data-cps transform="translate(24 150)"></g>
    <g transform="translate(24 238)" font-size="10" fill="#5f5f66">
      <rect width="10" height="10" fill="#2b2b30" fill-opacity="0.12" stroke="#2b2b30" /><text x="16" y="9">consonant</text>
      <rect x="96" width="10" height="10" fill="#594578" fill-opacity="0.15" stroke="#594578" /><text x="112" y="9">vowel sign</text>
      <rect x="196" width="10" height="10" fill="#a33b3b" fill-opacity="0.15" stroke="#a33b3b" /><text x="212" y="9">coeng ្: stacks the next consonant underneath</text>
      <rect x="470" width="10" height="10" fill="#8a6a1f" fill-opacity="0.15" stroke="#8a6a1f" /><text x="486" y="9">other sign</text>
    </g>

    <text x="24" y="284" font-size="11" letter-spacing="1" fill="#5f5f66">AS BYTES, WHAT A TOKENIZER WITH NO KHMER PIECES FALLS BACK TO</text>
    <g data-bytes transform="translate(24 296)"></g>
    <text data-bytenote x="24" y="350" font-size="11" fill="#2b2b30"></text>
    <text x="24" y="374" font-size="10.5" fill="#5f5f66">The same happens in reverse: Latin never appears in the Khmer training text, so “ipad” becomes &lt;0x69&gt;&lt;0x70&gt;&lt;0x61&gt;&lt;0x64&gt;.</text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Word</span><div class="fig-chips">
      {words.map((w, i) => <button type="button" class="fig-chip" data-w={i} aria-pressed={i === 0 ? "true" : "false"} lang="km">{w}</button>)}
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";

  const NS = "http://www.w3.org/2000/svg";
  const NOTES = ["irregular spelling, with a stacked cluster", "silent letters, irregular spelling", "read right only after respelling it as បររទេះ"];
  const kind = (cp: number) => (cp === 0x17d2 ? "coeng" : cp >= 0x1780 && cp <= 0x17b3 ? "cons" : cp >= 0x17b6 && cp <= 0x17c5 ? "vowel" : "sign");
  const INK: Record<string, string> = { cons: "#2b2b30", vowel: "#594578", coeng: "#a33b3b", sign: "#8a6a1f" };
  const el = (tag: string, a: Record<string, string | number>, t?: string) => { const e = document.createElementNS(NS, tag); Object.entries(a).forEach(([k, v]) => e.setAttribute(k, String(v))); if (t !== undefined) e.textContent = t; return e; };

  document.querySelectorAll<HTMLElement>("[data-kc]").forEach((root) => {
    const words: string[] = JSON.parse(root.dataset.words!);
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let idx = 0;
    const cells: SVGGElement[] = [], bytes: SVGGElement[] = [];
    function render() {
      const w = words[idx], cps = Array.from(w), enc = new TextEncoder().encode(w);
      $("[data-word]").textContent = w; $("[data-word]").setAttribute("lang", "km");
      $("[data-wordnote]").textContent = NOTES[idx];
      const g = $("[data-cps]"); g.replaceChildren(); cells.length = 0;
      cps.forEach((ch, i) => {
        const cp = ch.codePointAt(0)!, k = kind(cp), c = el("g", { transform: `translate(${i * 92} 0)` }) as SVGGElement;
        c.append(
          el("rect", { width: 84, height: 72, rx: 5, fill: INK[k], "fill-opacity": k === "cons" ? 0.08 : 0.12, stroke: INK[k] }),
          el("text", { x: 42, y: 40, "font-size": 30, "text-anchor": "middle", fill: INK[k], "font-family": "'Noto Sans Khmer', 'Khmer OS', 'Khmer Sangam MN', sans-serif" }, k === "cons" ? ch : `◌${ch}`),
          el("text", { x: 42, y: 62, "font-size": 10, "text-anchor": "middle", fill: "#5f5f66", "font-family": "ui-monospace, monospace" }, `U+${cp.toString(16).toUpperCase()}`),
        );
        g.append(c); cells.push(c);
      });
      const b = $("[data-bytes]"); b.replaceChildren(); bytes.length = 0;
      const bw = Math.min(30, 730 / enc.length);
      enc.forEach((v, i) => {
        const c = el("g", { transform: `translate(${i * bw} 0)` }) as SVGGElement;
        c.append(el("rect", { width: bw - 3, height: 30, rx: 3, fill: "#ececf1", stroke: "#d6d6dd" }), el("text", { x: (bw - 3) / 2, y: 19, "font-size": 8.5, "text-anchor": "middle", fill: "#5f5f66", "font-family": "ui-monospace, monospace" }, v.toString(16)));
        b.append(c); bytes.push(c);
      });
      $("[data-bytenote]").textContent = `${cps.length} code points become ${enc.length} byte tokens: 3 per Khmer character, none of which the model has a learned meaning for.`;
      root.querySelectorAll("[data-w]").forEach((o, j) => o.setAttribute("aria-pressed", String(j === idx)));
    }
    root.querySelectorAll<HTMLButtonElement>("[data-w]").forEach((btn) => btn.addEventListener("click", () => { idx = +btn.dataset.w!; render(); }));
    setupFigure(root, () => { render(); [...cells, ...bytes].forEach((c) => (c.style.opacity = "0")); }, async (alive) => {
      for (const c of cells) { if (!alive()) return; animate(c, { opacity: [0, 1] }, { duration: dur(0.3) }); await wait(0.18); }
      for (const c of bytes) { if (!alive()) return; animate(c, { opacity: [0, 1] }, { duration: dur(0.2) }); await wait(0.04); }
    });
  });
</script>
