---
// Foundations, language models post: teacher forcing on BOS the cat sat →
// the cat sat EOS. True-token probabilities 0.5, 0.25, 0.5, 0.125: losses
// 0.693, 1.386, 0.693, 2.079; running average 0.693, 1.040, 0.924, 1.213.
// Gradient on the true token's logit p − 1: −0.5, −0.75, −0.5, −0.875.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-teacher>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 290" role="img" aria-labelledby="tf2-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="tf2-title">Four positions of one sentence, each a next-token lesson with its loss</title>
    <g data-draw></g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const VOCAB = ["BOS", "the", "cat", "dog", "sat", "EOS"], INP = ["BOS", "the", "cat", "sat"], TGT = ["the", "cat", "sat", "EOS"];
  // Toy distributions: the true token gets 0.5, 0.25, 0.5, 0.125; the rest is split over the others.
  const DIST = [[0.02, 0.5, 0.18, 0.12, 0.1, 0.08], [0.02, 0.05, 0.25, 0.35, 0.18, 0.15], [0.02, 0.03, 0.05, 0.05, 0.5, 0.35], [0.02, 0.18, 0.2, 0.15, 0.325, 0.125]];
  document.querySelectorAll<HTMLElement>("[data-teacher]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const pTrue = DIST.map((d, i) => d[VOCAB.indexOf(TGT[i])]), loss = pTrue.map((p) => -Math.log(p));
    const steps = () => [
      ...INP.map((_, i) => { const avg = loss.slice(0, i + 1).reduce((a, b) => a + b, 0) / (i + 1); return { say: i === 0 ? "Position 1 sees only BOS and should predict \"the\". The future is masked." : `Position ${i + 1} sees the true prefix (teacher forcing) and should predict "${TGT[i]}".`, math: `p(${TGT[i]}) = ${fmt(pTrue[i], 3)},  loss = −ln ${fmt(pTrue[i], 3)} = ${fmt(loss[i], 3)},  gradient on its logit ${fmt(pTrue[i], 3)} − 1 = ${fmt(pTrue[i] - 1, 3)}\nrunning average loss ${fmt(avg, 3)}` }; }),
    ];
    function draw(k: number) {
      let s = "";
      INP.forEach((t, i) => {
        const x = 30 + i * 180, on = i === k;
        INP.forEach((w, j) => (s += `<rect x="${x + j * 40}" y="20" width="36" height="24" rx="4" fill="${j <= i ? (on ? TINT : "#fff") : "#eef0f0"}" stroke="${j <= i ? JADE : "#e3e7e6"}"/>` + txt(x + j * 40 + 18, 36, w, `font-size="9.5" text-anchor="middle" fill="${j <= i ? INK : "#B9C0BF"}"`)));
        s += txt(x, 64, `should predict: ${TGT[i]}`, `font-size="11.5" font-weight="700" fill="${on ? GOLD : MUTED}"`);
        DIST[i].forEach((p, v) => { const y = 76 + v * 26, tru = VOCAB[v] === TGT[i]; s += txt(x + 32, y + 14, VOCAB[v], `font-size="10" text-anchor="end" fill="${INK}"`) + `<rect x="${x + 36}" y="${y + 3}" width="${p * 200}" height="14" fill="${tru ? GOLD : JADE}" fill-opacity="${k >= i ? 0.8 : 0.15}" stroke="${tru ? INK : "none"}"/>` + txt(x + 40 + p * 200, y + 14, k >= i ? fmt(p, 3) : "", `font-size="9.5" fill="${INK}"`); });
        s += txt(x, 248, k >= i ? `loss ${fmt(loss[i], 3)}` : "", `font-size="12.5" font-weight="700" fill="${INK}"`);
      });
      if (k >= 0) s += txt(30, 280, `running average loss: ${fmt(loss.slice(0, k + 1).reduce((a, b) => a + b, 0) / (k + 1), 3)} nats`, `font-size="13" font-weight="700" fill="${GOLD}"`);
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2 });
  });
</script>
