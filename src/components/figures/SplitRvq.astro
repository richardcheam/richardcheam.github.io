---
// RVQ post, Figure 9: Mimi's split quantizer (Moshi paper, Sec 3.3.2).
// A plain VQ distilled towards WavLM gives the semantic token; a 7-level RVQ
// "in parallel" gives the acoustic tokens; the outputs are summed. A plain
// RVQ would make the acoustic stages work on the semantic stage's leftover.
// Bitrate: 12.5 frames/s x (1 + a) tokens x 11 bits.
const { alt } = Astro.props;
---
<div class="blog-diagram srv" role="region" aria-label={alt} data-srv>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 400" role="img" aria-labelledby="srv-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="srv-title">Mimi's semantic quantizer running beside a seven-stage acoustic quantizer, and the token grid they produce</title>
    <g data-flow></g>
    <circle data-p1 r="6" fill="#4F5D3A" />
    <circle data-p2 r="6" fill="#594578" />
    <text x="20" y="232" font-size="11.5" font-weight="700" fill="#2b2b30">One second of Mimi tokens: 12.5 columns, one row per codebook</text>
    <g data-grid></g>
    <text data-r1 x="20" y="372" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="392" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Quantizer</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-kind="split" aria-pressed="true">Split (Mimi)</button>
      <button type="button" class="fig-chip" data-kind="plain" aria-pressed="false">Plain RVQ, meaning in stage 1</button>
    </div></div>
    <label><span class="fig-panel__name">Acoustic stages kept<strong data-va></strong></span><input class="scrub" data-a type="range" min="0" max="7" step="1" value="7" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-srv]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const aIn = $<HTMLInputElement>("[data-a]");
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    let kind = "split";
    const stageX = (i: number) => 230 + i * 62;
    function draw(p = 1) {
      const a = +aIn.value, g = $("[data-flow]"); g.replaceChildren();
      mk(g, "rect", { x: 20, y: 80, width: 90, height: 50, rx: 6, fill: "#2b2b30" });
      mk(g, "text", { x: 65, y: 110, "font-size": 11.5, "font-weight": 700, "text-anchor": "middle", fill: "#fff" }, "frame z");
      // Semantic path.
      mk(g, "rect", { x: 150, y: 20, width: 70, height: 40, rx: 5, fill: "#4F5D3A" });
      mk(g, "text", { x: 185, y: 44, "font-size": 11, "font-weight": 700, "text-anchor": "middle", fill: "#fff" }, "VQ 1");
      mk(g, "rect", { x: 250, y: 20, width: 130, height: 40, rx: 5, fill: "none", stroke: "#4F5D3A", "stroke-dasharray": "4 3" });
      mk(g, "text", { x: 315, y: 44, "font-size": 10.5, "text-anchor": "middle", fill: "#4F5D3A" }, "≈ WavLM (cosine)");
      mk(g, "line", { x1: 220, x2: 250, y1: 40, y2: 40, stroke: "#4F5D3A", "stroke-dasharray": "3 3" });
      mk(g, "line", { x1: 110, x2: 150, y1: 95, y2: 40, stroke: "#2b2b30" });
      // Acoustic stages.
      for (let i = 0; i < 7; i++) {
        const on = i < a, x = stageX(i);
        mk(g, "rect", { x, y: 130, width: 52, height: 40, rx: 5, fill: on ? "#594578" : "#ececf1" });
        mk(g, "text", { x: x + 26, y: 154, "font-size": 10.5, "font-weight": 700, "text-anchor": "middle", fill: on ? "#fff" : "#b9b9c2" }, `RVQ ${i + 2}`);
        if (i) mk(g, "line", { x1: x - 10, x2: x, y1: 150, y2: 150, stroke: "#594578" });
      }
      if (kind === "split") mk(g, "path", { d: "M110 115 C 150 150, 180 150, 230 150", fill: "none", stroke: "#2b2b30" });
      else mk(g, "path", { d: "M185 60 C 185 120, 200 150, 230 150", fill: "none", stroke: "#a33b3b", "stroke-width": 2 });
      mk(g, "text", { x: kind === "split" ? 120 : 140, y: kind === "split" ? 166 : 100, "font-size": 10, fill: kind === "split" ? "#2b2b30" : "#a33b3b" }, kind === "split" ? "the whole frame" : "only the leftover of VQ 1");
      // Sum.
      mk(g, "circle", { cx: 710, cy: 95, r: 22, fill: "#fff", stroke: "#2b2b30", "stroke-width": 2 });
      mk(g, "text", { x: 710, y: 101, "font-size": 18, "font-weight": 700, "text-anchor": "middle", fill: "#2b2b30" }, "+");
      mk(g, "line", { x1: 220, x2: 688, y1: 40, y2: 88, stroke: "#4F5D3A", "stroke-opacity": 0.4 });
      mk(g, "line", { x1: 664, x2: 690, y1: 150, y2: 106, stroke: "#594578", "stroke-opacity": 0.4 });
      mk(g, "text", { x: 710, y: 140, "font-size": 10.5, "text-anchor": "middle", fill: "#2b2b30" }, "ẑ to decoder");
      // Particles.
      const p1 = $("[data-p1]"), p2 = $("[data-p2]");
      const s = Math.min(1, p * 2);
      p1.setAttribute("cx", String(110 + (185 - 110) * s)); p1.setAttribute("cy", String(95 + (40 - 95) * s));
      const ax = kind === "split" ? 110 + (stageX(Math.max(0, a - 1)) + 26 - 110) * p : 185 + (stageX(Math.max(0, a - 1)) + 26 - 185) * Math.max(0, p * 2 - 1);
      p2.setAttribute("cx", String(ax)); p2.setAttribute("cy", String(kind === "split" ? 115 + 35 * Math.min(1, p * 3) : p < 0.5 ? 95 + (40 - 95) * s : 150));
      p2.style.opacity = a ? "1" : "0";
      // Token grid.
      const gr = $("[data-grid]"); gr.replaceChildren();
      for (let q = 0; q < 8; q++) {
        mk(gr, "text", { x: 92, y: 256 + q * 13 + 9, "font-size": 9.5, "text-anchor": "end", fill: q === 0 ? "#4F5D3A" : "#594578" }, q === 0 ? "semantic" : `acoustic ${q}`);
        for (let c = 0; c < 13; c++) {
          const on = q === 0 || q <= a, w = c === 12 ? 24 : 50;
          mk(gr, "rect", { x: 100 + c * 52, y: 256 + q * 13, width: w, height: 11, rx: 1.5, fill: !on ? "#f2f2f5" : q === 0 ? "#4F5D3A" : "#594578", "fill-opacity": on ? 0.85 : 1 });
        }
      }
      const R = 12.5 * (1 + a) * 11;
      $("[data-r1]").textContent = `12.5 × (1 + ${a}) × 11 = ${R.toLocaleString("en")} bits per second, ${12.5 * (1 + a)} tokens per second.`;
      $("[data-r2]").textContent = kind === "split" ? "Split: the acoustic stack sees the whole frame, so it need not rebuild around a meaning-shaped first stage." : "Plain RVQ: stage 1 must carry meaning and leave a useful leftover; the paper found this cost audio quality (Sec 3.3.2).";
      $("[data-va]").textContent = String(a); aIn.style.setProperty("--p", `${(a / 7) * 100}%`);
    }
    aIn.addEventListener("input", () => draw());
    root.querySelectorAll<HTMLButtonElement>("[data-kind]").forEach((b) => b.addEventListener("click", async () => {
      kind = b.dataset.kind!; root.querySelectorAll("[data-kind]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); await tween(1.4, (e) => draw(e));
    }));
    draw();
    setupFigure(root, () => draw(0), async (alive) => { await tween(1.8, (e) => { if (alive()) draw(e); }); });
  });
</script>
