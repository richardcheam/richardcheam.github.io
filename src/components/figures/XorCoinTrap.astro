---
// DSM review, Figure 2: the coin trap (Sec 3, p. 5). Coins X_t; the answer
// is Y_t = X_t XOR X_{t+1}. With delay tau = 0 the model has not seen
// X_{t+1} when it must answer, so even a perfect model guesses (50%). With
// tau >= 1 it has, and is always right. 16 coins, seeded.
const { alt } = Astro.props;
---
<div class="blog-diagram xct" role="region" aria-label={alt} data-xct>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 260" role="img" aria-labelledby="xct-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="xct-title">Answers that depend on the next coin are guesses unless the output waits one step</title>
    <g data-g></g>
    <text data-r1 x="20" y="220" font-size="13" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="244" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Delay τ</span><div class="fig-chips">
      {[0, 1, 2].map((d) => <button type="button" class="fig-chip" data-d={d} aria-pressed={d === 0 ? "true" : "false"}>{d}</button>)}
      <button type="button" class="fig-chip" data-flip>New coins</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait } from "../../lib/figure-motion";
  import { rng } from "../../lib/flow-math";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-xct]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    let seed = 7, X: number[] = [], guesses: number[] = [], tau = 0, t = 99;
    const flip = () => { const r = rng(seed); X = Array.from({ length: 16 }, () => (r() < 0.5 ? 0 : 1)); const g = rng(seed + 100); guesses = X.map(() => (g() < 0.5 ? 0 : 1)); };
    function draw() {
      const g = $("[data-g]"); g.replaceChildren();
      const W = 44, x0 = 60;
      mk(g, "text", { x: 20, y: 52, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "X");
      mk(g, "text", { x: 20, y: 122, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "Y");
      let right = 0, n = 0;
      X.forEach((x, i) => {
        const seen = i <= Math.min(t, 15) + tau;
        mk(g, "circle", { cx: x0 + i * W + 18, cy: 48, r: 16, fill: seen ? (x ? "#594578" : "#b8722c") : "#ececf1" });
        if (seen) mk(g, "text", { x: x0 + i * W + 18, y: 53, "font-size": 13, "font-weight": 700, "text-anchor": "middle", fill: "#fff" }, String(x));
        if (i < 15 && i <= t) {
          const truth = x ^ X[i + 1], knows = tau >= 1, ans = knows ? truth : guesses[i], ok = ans === truth;
          right += ok ? 1 : 0; n++;
          mk(g, "rect", { x: x0 + i * W + 4, y: 100, width: 28, height: 30, rx: 4, fill: ok ? "#4F5D3A" : "#a33b3b", "fill-opacity": 0.85 });
          mk(g, "text", { x: x0 + i * W + 18, y: 120, "font-size": 13, "font-weight": 700, "text-anchor": "middle", fill: "#fff" }, String(ans));
          if (!knows) mk(g, "text", { x: x0 + i * W + 18, y: 146, "font-size": 9, "text-anchor": "middle", fill: "#5f5f66" }, "guess");
        }
      });
      if (t < 15) mk(g, "rect", { x: x0 + t * W - 2, y: 26, width: (tau + 1) * W, height: 112, rx: 6, fill: "none", stroke: "#2b2b30", "stroke-dasharray": "4 3" });
      mk(g, "text", { x: 20, y: 180, "font-size": 11, fill: "#5f5f66" }, "Dashed box: the coins the model has seen when it writes Y at that tick. Green: right. Red: wrong.");
      $("[data-r1]").textContent = n ? `τ = ${tau}: ${right} of ${n} answers right (${Math.round((100 * right) / n)}%).` : "";
      $("[data-r2]").textContent = tau === 0 ? "Expected 50%: each answer needs a coin that has not landed yet." : "Expected 100%: waiting one tick is enough here. Real speech needs more.";
      root.querySelectorAll("[data-d]").forEach((b) => b.setAttribute("aria-pressed", String(+b.getAttribute("data-d")! === tau)));
    }
    let token = 0;
    const run = async (alive: () => boolean) => { for (t = 0; t <= 15; t++) { if (!alive()) return; draw(); await wait(0.22); } t = 99; draw(); };
    root.querySelectorAll<HTMLButtonElement>("[data-d]").forEach((b) => b.addEventListener("click", () => { tau = +b.dataset.d!; const my = ++token; run(() => my === token); }));
    $("[data-flip]").addEventListener("click", () => { seed++; flip(); const my = ++token; run(() => my === token); });
    flip(); draw();
    setupFigure(root, () => { t = 0; draw(); }, run);
  });
</script>
