---
// Foundations, GANs post: a one-number GAN trained live (src/lib/gan.ts,
// seed 7). Real data N(3, 0.5²); forger a z + b from (1, 0); quadratic
// logistic detective. Detective rate 0.5: mean 3.031, spread 0.522 at step
// 3000. Detective rate 0.05: the spread collapses to 0.001.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-gantoy>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 280" role="img" aria-labelledby="gt-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="gt-title">A histogram of generated numbers sliding onto the real data as the GAN trains</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Training</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-play>Play</button>
      <button type="button" class="fig-chip" data-h>Run 100 steps</button>
      <button type="button" class="fig-chip" data-reset>Start over</button>
    </div></div>
    <div><span class="fig-panel__name">Detective learning rate</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-lr="0.5" aria-pressed="true">0.5</button><button type="button" class="fig-chip" data-lr="0.2" aria-pressed="false">0.2</button><button type="button" class="fig-chip" data-lr="0.05" aria-pressed="false">0.05 (slow)</button>
    </div></div>
  </div>
</div>

<script>
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, NEG, JADE } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  import { makeGan, quadDetective, realOne, D, EVAL_Z } from "../../lib/gan";
  const MAX = 3000, REAL = EVAL_Z.map((z) => 3 + 0.5 * z);
  document.querySelectorAll<HTMLElement>("[data-gantoy]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let lrD = 0.5, g = makeGan({ real: realOne, det: quadDetective(), a: 1, b: 0, lrD, lrG: 0.02 }), playing = false, raf = 0;
    const reset = () => { g = makeGan({ real: realOne, det: quadDetective(), a: 1, b: 0, lrD, lrG: 0.02 }); draw(); };
    const hist = (xs: number[], lo: number, hi: number, n: number) => { const h = Array(n).fill(0); xs.forEach((x) => { const i = Math.floor(((x - lo) / (hi - lo)) * n); if (i >= 0 && i < n) h[i]++; }); return h; };
    function draw() {
      const st = g.stats(), lo = -3, hi = 6, n = 90, hr = hist(REAL, lo, hi, n), hg = hist(st.xs, lo, hi, n), top = Math.max(...hr, ...hg, 1);
      const F = frame({ l: 40, t: 30, w: 480, h: 190, x0: lo, x1: hi, y0: 0, y1: 1 });
      let s = F.grid([-2, 0, 2, 4, 6], [0, 0.5, 1], 1);
      hr.forEach((c, i) => (s += `<rect x="${F.X(lo + (i * (hi - lo)) / n)}" y="${F.Y(c / top)}" width="${480 / n - 0.5}" height="${F.Y(0) - F.Y(c / top)}" fill="${JADE}" fill-opacity="0.45"/>`));
      hg.forEach((c, i) => (s += `<rect x="${F.X(lo + (i * (hi - lo)) / n)}" y="${F.Y(c / top)}" width="${480 / n - 0.5}" height="${F.Y(0) - F.Y(c / top)}" fill="${NEG}" fill-opacity="0.55"/>`));
      s += F.curve((x) => D(g.det, x), `stroke="${GOLD}" stroke-width="2.5"`, 300);
      s += txt(40, 18, "green: real data; red: the forger's samples; gold: the detective's D(x)", `font-size="11.5" font-weight="700" fill="${INK}"`) + txt(48, 44, "D = 1", `font-size="10" fill="${GOLD}"`);
      const rows: [string, string][] = [["step", `${g.step}`], ["a (spread knob)", fmt(g.a, 4)], ["b (centre knob)", fmt(g.b, 4)], ["sample mean", fmt(st.mean, 3)], ["sample spread", fmt(st.spread, 3)]];
      rows.forEach(([k2, v], i) => (s += txt(560, 60 + i * 26, k2, `font-size="12" fill="${MUTED}"`) + txt(690, 60 + i * 26, v, `font-size="13" font-weight="700" fill="${INK}"`)));
      s += txt(560, 210, "target: mean 3, spread 0.5", `font-size="11.5" fill="${JADE}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-play]").textContent = playing ? "Pause" : g.step >= MAX ? "Finished" : "Play";
    }
    const run = (n: number) => { for (let i = 0; i < n && g.step < MAX; i++) g.iterate(); };
    const loop = () => { run(10); draw(); if (playing && g.step < MAX) raf = requestAnimationFrame(loop); else { playing = false; draw(); } };
    const play = (on: boolean) => { playing = on && g.step < MAX; cancelAnimationFrame(raf); if (playing) raf = requestAnimationFrame(loop); draw(); };
    $("[data-play]").addEventListener("click", () => play(!playing));
    $("[data-h]").addEventListener("click", () => { play(false); run(100); draw(); });
    $("[data-reset]").addEventListener("click", () => { play(false); reset(); });
    root.querySelectorAll<HTMLButtonElement>("[data-lr]").forEach((b) => b.addEventListener("click", () => { lrD = +b.dataset.lr!; root.querySelectorAll("[data-lr]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); play(false); reset(); }));
    reset();
  });
</script>
