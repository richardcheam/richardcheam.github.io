---
// Whisper review, Figure 5: effective robustness from Table 2 (p. 6). Both
// models score 2.7 WER on LibriSpeech test-clean; pick a dataset to compare
// them elsewhere. Relative error reduction = (W_ref - W_whisper) / W_ref.
const { alt } = Astro.props;
const rows = [
  ["Artie", 24.5, 6.2], ["Common Voice", 29.9, 9.0], ["Fleurs En", 14.6, 4.4], ["Tedlium", 10.5, 4.0], ["CHiME6", 65.8, 25.5], ["VoxPopuli En", 17.9, 7.3], ["CORAAL", 35.6, 16.2], ["AMI IHM", 37.0, 16.9], ["Switchboard", 28.3, 13.8], ["CallHome", 34.8, 17.6], ["WSJ", 7.7, 3.9], ["AMI SDM1", 67.6, 36.4], ["LibriSpeech Other", 6.2, 5.2],
];
---
<div class="blog-diagram rbf" role="region" aria-label={alt} data-rbf data-rows={JSON.stringify(rows)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 360" role="img" aria-labelledby="rbf-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rbf-title">Two models equal on LibriSpeech, far apart on other datasets</title>
    <g data-plot></g>
    <g data-list></g>
    <text data-r1 x="20" y="330" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="352" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-rbf]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const R: [string, number, number][] = JSON.parse(root.dataset.rows!);
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const rer = (a: number, b: number) => (100 * (a - b)) / a;
    const meanRer = R.reduce((s, r) => s + rer(r[1], r[2]), 0) / R.length;
    const avgRef = R.reduce((s, r) => s + r[1], 0) / R.length, avgW = R.reduce((s, r) => s + r[2], 0) / R.length;
    let sel = -1, cur = [avgRef, avgW];
    const Y = (w: number) => 290 - (w / 70) * 260;
    function draw() {
      const g = $("[data-plot]"); g.replaceChildren();
      mk(g, "line", { x1: 60, x2: 60, y1: 30, y2: 290, stroke: "#2b2b30" }); mk(g, "line", { x1: 60, x2: 380, y1: 290, y2: 290, stroke: "#2b2b30" });
      for (let w = 0; w <= 70; w += 10) mk(g, "text", { x: 52, y: Y(w) + 4, "font-size": 10, "text-anchor": "end", fill: "#2b2b30" }, String(w));
      mk(g, "text", { x: 64, y: 24, "font-size": 10.5, fill: "#5f5f66" }, "WER elsewhere, %");
      mk(g, "line", { x1: 60, x2: 380, y1: Y(2.7), y2: Y(2.7), stroke: "#d5d5dc", "stroke-dasharray": "4 3" });
      mk(g, "text", { x: 380, y: Y(2.7) - 4, "font-size": 9.5, "text-anchor": "end", fill: "#8a8a94" }, "LibriSpeech clean: both 2.7");
      [[cur[0], "wav2vec 2.0 Large", "#a33b3b", 150], [cur[1], "Whisper Large V2", "#4F5D3A", 270]].forEach(([w, n, c, x]) => {
        mk(g, "rect", { x: (x as number) - 30, y: Y(w as number), width: 60, height: 290 - Y(w as number), fill: c as string, "fill-opacity": 0.8 });
        mk(g, "text", { x: x as number, y: Y(w as number) - 6, "font-size": 12, "font-weight": 700, "text-anchor": "middle", fill: c as string }, (w as number).toFixed(1));
        mk(g, "text", { x: x as number, y: 306, "font-size": 10.5, "text-anchor": "middle", fill: "#2b2b30" }, n as string);
      });
      const gl = $("[data-list]"); gl.replaceChildren();
      mk(gl, "text", { x: 420, y: 24, "font-size": 11, "font-weight": 700, fill: "#2b2b30" }, "Dataset (click)");
      mk(gl, "text", { x: 700, y: 24, "font-size": 11, "font-weight": 700, "text-anchor": "end", fill: "#2b2b30" }, "fewer errors");
      [["Average of 13", -1] as const, ...R.map((r, i) => [r[0], i] as const)].forEach(([n, i], k) => {
        const y = 42 + k * 19, v = i < 0 ? meanRer : rer(R[i][1], R[i][2]);
        const t = mk(gl, "text", { x: 420, y, "font-size": 10.5, fill: i === sel ? "#594578" : "#2b2b30", "font-weight": i === sel ? 700 : 400, style: "cursor: pointer" }, n as string);
        t.addEventListener("click", () => pick(i as number));
        mk(gl, "rect", { x: 560, y: y - 9, width: v * 1.4, height: 10, fill: "#4F5D3A", "fill-opacity": i === sel ? 0.9 : 0.35 });
        mk(gl, "text", { x: 760, y, "font-size": 10, "text-anchor": "end", fill: "#2b2b30" }, `${v.toFixed(1)}%`);
      });
      const name = sel < 0 ? "the average of 13 datasets" : R[sel][0];
      $("[data-r1]").textContent = `On ${name}: (${cur[0].toFixed(1)} − ${cur[1].toFixed(1)}) ÷ ${cur[0].toFixed(1)} = ${rer(cur[0], cur[1]).toFixed(1)}% fewer errors for Whisper.`;
      $("[data-r2]").textContent = sel < 0 ? `The paper's 55.2% is the mean of the 13 percentages (${meanRer.toFixed(1)}); the percentage of the averages is ${rer(avgRef, avgW).toFixed(1)}%. Table 2, p. 6.` : "All values from Table 2 (p. 6). Same LibriSpeech score, very different skill elsewhere.";
    }
    async function pick(i: number) {
      const from = cur.slice(), to = i < 0 ? [avgRef, avgW] : [R[i][1], R[i][2]]; sel = i;
      await tween(0.6, (e) => { cur = [from[0] + (to[0] - from[0]) * e, from[1] + (to[1] - from[1]) * e]; draw(); });
    }
    draw();
    setupFigure(root, () => { sel = -1; cur = [2.7, 2.7]; draw(); }, async (alive) => { await wait(0.5); for (const i of [1, 4, -1]) { if (!alive()) return; await pick(i); await wait(1.2); } });
  });
</script>
