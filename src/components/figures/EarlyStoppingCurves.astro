---
// Foundations, regularisation post: full-batch gradient descent (η = 0.5,
// from zero weights) on the degree 7 polynomial, run live for 200,000
// epochs. Validation error is lowest, 0.03998, at epoch 7,506 (training
// 0.055), and ends at 0.0713 while training error keeps falling to 0.022.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-early>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="es-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="es-title">Training and validation error over training, with the early-stopping point marked</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Patience (evaluations every 100 epochs) <strong data-vp></strong></span><input class="scrub" data-p type="range" min="1" max="50" step="1" value="10" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, reduce } from "../../lib/figure-motion";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, NEG, GOLD } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  import { powers, predict, mse, TRAIN_X, TRAIN_Y, VAL_X, VAL_Y } from "../../lib/poly";
  const MAX = 200000, ETA = 0.5, D = 7, X = TRAIN_X.map((x) => powers(x, D));
  document.querySelectorAll<HTMLElement>("[data-early]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let patience = 10;
    // Live training state; the log keeps every epoch up to 100, then every 100th.
    let w: number[], epoch: number, log: { e: number; tr: number; va: number }[], best: { e: number; va: number; tr: number; w: number[] };
    const reset = () => { w = Array(D + 1).fill(0); epoch = 0; log = []; best = { e: 0, va: Infinity, tr: 0, w: [...w] }; };
    const advance = (to: number) => {
      while (epoch < to) {
        const r = X.map((row, i) => row.reduce((s, x, j) => s + x * w[j], 0) - TRAIN_Y[i]);
        w = w.map((wj, j) => wj - (ETA * 2 * X.reduce((s, row, i) => s + row[j] * r[i], 0)) / 8);
        epoch++;
        const va = mse(w, VAL_X, VAL_Y);
        if (va < best.va) best = { e: epoch, va, tr: mse(w, TRAIN_X, TRAIN_Y), w: [...w] };
        if (epoch <= 100 || epoch % 100 === 0) log.push({ e: epoch, tr: mse(w, TRAIN_X, TRAIN_Y), va });
      }
    };
    // Where patience-based stopping would halt: evaluate every 100 epochs and stop
    // after `patience` evaluations without a new best.
    const patienceStop = () => {
      let bestV = Infinity, since = 0;
      for (const x of log) { if (x.e % 100 !== 0) continue; if (x.va < bestV) { bestV = x.va; since = 0; } else if (++since >= patience) return x.e; }
      return null;
    };
    function draw() {
      const lx = (e: number) => 40 + (Math.log10(Math.max(e, 1)) / Math.log10(MAX)) * 440, ly = (v: number) => 250 - (Math.min(v, 0.6) / 0.6) * 210;
      let s = txt(40, 22, "Error against epoch (log scale): degree 7 polynomial, plain gradient descent", `font-size="12" font-weight="700" fill="${INK}"`);
      [1, 10, 100, 1000, 10000, 100000].forEach((e) => (s += `<line x1="${lx(e)}" x2="${lx(e)}" y1="40" y2="250" stroke="#eef0f0"/>` + txt(lx(e), 266, e >= 1000 ? `${e / 1000}k` : String(e), `font-size="10.5" text-anchor="middle" fill="${MUTED}"`)));
      [0, 0.2, 0.4, 0.6].forEach((v) => (s += `<line x1="40" x2="480" y1="${ly(v)}" y2="${ly(v)}" stroke="#eef0f0"/>` + txt(34, ly(v) + 4, fmt(v, 1), `font-size="10.5" text-anchor="end" fill="${MUTED}"`)));
      if (log.length) {
        s += `<polyline fill="none" stroke="${INK}" stroke-width="2" points="${log.map((x) => `${lx(x.e).toFixed(1)},${ly(x.tr).toFixed(1)}`).join(" ")}"/>`;
        s += `<polyline fill="none" stroke="${NEG}" stroke-width="2" points="${log.map((x) => `${lx(x.e).toFixed(1)},${ly(x.va).toFixed(1)}`).join(" ")}"/>`;
        s += `<line x1="${lx(best.e)}" x2="${lx(best.e)}" y1="40" y2="250" stroke="${GOLD}" stroke-width="2" stroke-dasharray="4 3"/><circle cx="${lx(best.e)}" cy="${ly(best.va)}" r="6" fill="${GOLD}" stroke="#fff" stroke-width="2"/>`;
        const ps = patienceStop();
        if (ps) s += `<line x1="${lx(ps)}" x2="${lx(ps)}" y1="40" y2="250" stroke="${MUTED}" stroke-dasharray="2 3"/>` + txt(lx(ps) + 4, 52, `patience ${patience} stops here`, `font-size="10.5" fill="${MUTED}"`);
      }
      const cur = log[log.length - 1];
      s += txt(40, 290, `epoch ${epoch.toLocaleString("en")}:  training ${cur ? fmt(cur.tr, 4) : "…"},  validation ${cur ? fmt(cur.va, 4) : "…"}`, `font-size="12" font-weight="700" fill="${INK}"`);
      // Inset: the fit now, and the saved early-stopping fit.
      const F = frame({ l: 520, t: 50, w: 220, h: 150, x0: 0, x1: 1, y0: -2, y1: 2 });
      s += txt(520, 40, "The fit now (green) and at the gold epoch", `font-size="11.5" font-weight="700" fill="${INK}"`) + `<rect x="520" y="50" width="220" height="150" fill="none" stroke="#eef0f0"/>`;
      s += `<clipPath id="es-clip"><rect x="520" y="50" width="220" height="150"/></clipPath><g clip-path="url(#es-clip)">`;
      if (best.e) s += F.curve((x) => predict(best.w, x), `stroke="${GOLD}" stroke-width="2" stroke-dasharray="4 3"`, 120);
      s += F.curve((x) => predict(w, x), `stroke="${JADE}" stroke-width="2.4"`, 120) + `</g>`;
      TRAIN_X.forEach((x, i) => (s += `<circle cx="${F.X(x)}" cy="${F.Y(TRAIN_Y[i])}" r="3.5" fill="${INK}"/>`));
      VAL_X.forEach((x, i) => (s += `<circle cx="${F.X(x)}" cy="${F.Y(VAL_Y[i])}" r="3.5" fill="#fff" stroke="${NEG}" stroke-width="1.5"/>`));
      s += `<line x1="520" x2="540" y1="226" y2="226" stroke="${INK}" stroke-width="2"/>` + txt(546, 230, "training error", `font-size="11" fill="${MUTED}"`) + `<line x1="640" x2="660" y1="226" y2="226" stroke="${NEG}" stroke-width="2"/>` + txt(666, 230, "validation", `font-size="11" fill="${MUTED}"`);
      s += txt(520, 254, best.e ? `Best so far: epoch ${best.e.toLocaleString("en")}` : "", `font-size="12" font-weight="700" fill="${GOLD}"`) + txt(520, 272, best.e ? `validation ${fmt(best.va, 5)}, training ${fmt(best.tr, 4)}` : "", `font-size="11.5" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vp]").textContent = String(patience);
    }
    reset(); draw();
    // Play: sweep the epoch along the log axis, training live as it goes.
    setupFigure(root, () => { reset(); draw(); }, async (alive) => {
      await tween(12, (t) => { if (!alive()) return; advance(Math.round(10 ** (t * Math.log10(MAX)))); draw(); });
      if (alive()) { advance(MAX); draw(); }
    });
    if (reduce) { advance(MAX); draw(); }
    $<HTMLInputElement>("[data-p]").addEventListener("input", (e) => { patience = +(e.target as HTMLInputElement).value; draw(); });
  });
</script>
