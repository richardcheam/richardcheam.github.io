---
// Figure 7: a spectrogram of a synthetic "see two", built column by column.
// The window slider shows the time/pitch trade-off; the mel switch redraws the
// same sound as 80 mel bands (section 8).
const { alt } = Astro.props;
const STOPS = [5, 10, 25, 50, 100];
---
<div class="blog-diagram sg" role="region" aria-label={alt} data-sg data-stops={JSON.stringify(STOPS)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 450" role="img" aria-labelledby="sg-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="sg-title">The waveform of see two and its spectrogram</title>
    <defs><clipPath id="sg-clip"><rect data-clip x="60" y="110" width="680" height="260" /></clipPath>
      <linearGradient id="sg-bar" x1="0" x2="0" y1="1" y2="0">
        <stop offset="0" stop-color="rgb(68,1,84)" /><stop offset="0.25" stop-color="rgb(59,82,139)" /><stop offset="0.5" stop-color="rgb(33,145,140)" /><stop offset="0.75" stop-color="rgb(94,201,98)" /><stop offset="1" stop-color="rgb(253,231,37)" />
      </linearGradient></defs>
    <path data-wave d="" fill="#2b2b30" />
    <rect data-win x="60" y="18" width="0" height="74" fill="#594578" fill-opacity="0.15" stroke="#594578" />
    <g data-seg></g>
    <rect x="60" y="110" width="680" height="260" fill="#1d1d22" />
    <image data-img x="60" y="110" width="680" height="260" preserveAspectRatio="none" clip-path="url(#sg-clip)" />
    <g data-yax></g>
    <text x="60" y="388" font-size="10.5" fill="#5f5f66">0 s</text>
    <text x="740" y="388" font-size="10.5" text-anchor="end" fill="#5f5f66">1.2 s</text>
    <text x="400" y="388" font-size="10.5" text-anchor="middle" fill="#5f5f66">time →</text>
    <rect x="752" y="110" width="10" height="260" fill="url(#sg-bar)" />
    <text x="766" y="118" font-size="9" fill="#5f5f66" transform="rotate(90 766 118)">loud (0 dB) ← → quiet (−80 dB)</text>
    <text data-r1 x="60" y="414" font-size="12.5" fill="#2b2b30"></text>
    <text data-r2 x="60" y="436" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Window<strong data-vw></strong></span><input class="scrub" data-ws type="range" min="0" max="4" step="1" value="2" style="--n: 4" /></label>
    <div><span class="fig-panel__name">Pitch axis</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-axis="hz" aria-pressed="true">Hertz (201 rows at 25 ms)</button>
      <button type="button" class="fig-chip" data-axis="mel" aria-pressed="false">Mel (80 bands)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure } from "../../lib/figure-motion";
  import { fftMag, hann, hzToMel, melBank, nextPow2, ramp, seeTwo } from "../../lib/audio-math";
  const NS = "http://www.w3.org/2000/svg", SR = 16000;
  document.querySelectorAll<HTMLElement>("[data-sg]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const stops: number[] = JSON.parse(root.dataset.stops!), ws = $<HTMLInputElement>("[data-ws]");
    const { x, seg } = seeTwo(SR, 1.2), X = (s: number) => 60 + (s / 1.2) * 680;
    let axis = "hz";
    // Waveform envelope and segment labels.
    const pk = x.reduce((m, v) => Math.max(m, Math.abs(v)), 0), per = x.length / 680;
    let top = "", bot = "";
    for (let px = 0; px < 680; px++) {
      let lo = 0, hi = 0;
      for (let i = Math.floor(px * per); i < Math.floor((px + 1) * per); i++) { lo = Math.min(lo, x[i]); hi = Math.max(hi, x[i]); }
      top += `${px ? "L" : "M"}${60 + px} ${(55 - (hi / pk) * 34).toFixed(1)}`;
      bot = `L${60 + px} ${(55 - (lo / pk) * 34).toFixed(1)}` + bot;
    }
    $("[data-wave]").setAttribute("d", top + bot + "Z");
    seg.forEach((s) => { const t = document.createElementNS(NS, "text"); t.setAttribute("x", String(X((s.a + s.b) / 2))); t.setAttribute("y", "104"); t.setAttribute("font-size", "11"); t.setAttribute("font-weight", "700"); t.setAttribute("text-anchor", "middle"); t.setAttribute("fill", "#594578"); t.textContent = `"${s.label}"`; $("[data-seg]").append(t); });
    const canvas = document.createElement("canvas");
    function render() {
      const ms = stops[+ws.value], win = Math.round(SR * ms / 1000), hop = Math.max(1, Math.round(win / 4)), size = nextPow2(win), w = hann(win);
      const cols: Float64Array[] = [], frame = new Float64Array(win);
      for (let s = 0; s + win <= x.length; s += hop) { for (let i = 0; i < win; i++) frame[i] = x[s + i] * w[i]; cols.push(fftMag(frame, size)); }
      const bins = size / 2 + 1, bank = axis === "mel" ? melBank(80, bins, SR) : null;
      const rowsOf = (c: Float64Array) => bank ? bank.map((b) => b.w.reduce((a, wt, k) => a + wt * c[k] * c[k], 0)) : Array.from(c, (m) => m * m);
      const data = cols.map(rowsOf), H = data[0].length;
      const mx = Math.max(...data.map((r) => Math.max(...r)));
      canvas.width = data.length; canvas.height = H;
      const g = canvas.getContext("2d")!, img = g.createImageData(data.length, H);
      data.forEach((r, c) => r.forEach((p, k) => {
        const db = 10 * Math.log10(p / mx + 1e-12), [R, G, B] = ramp((db + 80) / 80), o = ((H - 1 - k) * data.length + c) * 4;
        img.data[o] = R; img.data[o + 1] = G; img.data[o + 2] = B; img.data[o + 3] = 255;
      }));
      g.putImageData(img, 0, 0);
      $("[data-img]").setAttribute("href", canvas.toDataURL());
      // Pitch axis labels.
      const yax = $("[data-yax]"); yax.replaceChildren();
      [0, 1000, 2000, 4000, 6000, 8000].forEach((f) => {
        const frac = axis === "mel" ? hzToMel(f) / hzToMel(8000) : f / 8000, y = 370 - frac * 260;
        const t = document.createElementNS(NS, "text"); t.setAttribute("x", "54"); t.setAttribute("y", String(y + 3)); t.setAttribute("font-size", "9.5"); t.setAttribute("text-anchor", "end"); t.setAttribute("fill", "#5f5f66");
        t.textContent = f ? `${f / 1000}k` : "0 Hz"; yax.append(t);
      });
      ws.style.setProperty("--p", `${(+ws.value / 4) * 100}%`);
      $("[data-vw]").textContent = `${ms} ms`;
      $("[data-win]").setAttribute("width", String((ms / 1200) * 680));
      $("[data-r1]").innerHTML = `${ms} ms window = <tspan font-weight="700">${win}</tspan> samples, keys every <tspan font-weight="700">${1000 / ms} Hz</tspan>, a click smeared over <tspan font-weight="700">${ms} ms</tspan>. ${axis === "mel" ? `Each column: <tspan font-weight="700">80</tspan> mel numbers.` : `Each column: <tspan font-weight="700">${Math.floor(win / 2) + 1}</tspan> numbers.`}`;
      $("[data-r2]").textContent = ms <= 10 ? "Short window: the \"t\" click is a sharp line, but the vowel's stripes melt into broad bands." : ms >= 50 ? "Long window: the vowel's stripes (one per harmonic) are sharp, but the \"t\" click smears sideways." : "25 ms: the usual compromise. Stripes are visible and the click stays narrow.";
    }
    const reveal = (t: number) => {
      $("[data-clip]").setAttribute("width", String(680 * t));
      $("[data-win]").setAttribute("x", String(60 + 680 * t - +$("[data-win]").getAttribute("width")! * t));
    };
    let auto = true;
    ws.addEventListener("input", () => { auto = false; render(); reveal(1); });
    root.querySelectorAll<HTMLButtonElement>("[data-axis]").forEach((b) => b.addEventListener("click", () => {
      axis = b.dataset.axis!; auto = false;
      root.querySelectorAll("[data-axis]").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      render(); reveal(1);
    }));
    setupFigure(root, () => { auto = true; render(); reveal(0); }, async (alive) => {
      const ms = 3.2 * 1000, t0 = performance.now();
      await new Promise<void>((done) => {
        const tick = (now: number) => {
          if (!alive() || !auto) { reveal(1); return done(); }
          const t = Math.min(1, Math.max(0, (now - t0) / ms)); reveal(t);
          t < 1 ? requestAnimationFrame(tick) : done();
        };
        requestAnimationFrame(tick);
      });
    });
    render(); reveal(1);
  });
</script>
