---
// Moshi review, Figure 4: acoustic delay patterns (Eq 4, p. 14). Rows are the
// 8 Mimi codebooks of one stream; columns are 80 ms steps. A frame is complete
// once all 8 of its tokens are in: (1 + max delay) x 80 ms. Table numbers:
// Table 5 and Table 6, p. 25.
const { alt } = Astro.props;
const presets = [
  { name: "No delay", d: [0, 0, 0, 0, 0, 0, 0, 0], note: "Transcript NLL 4.36, length 486 (Table 6)." },
  { name: "Delay 1", d: [0, 1, 1, 1, 1, 1, 1, 1], note: "Transcript NLL 4.12, length 529 (Table 6). Moshi's final setting." },
  { name: "Delay 2", d: [0, 2, 2, 2, 2, 2, 2, 2], note: "NLL 4.09 (Table 6). Perplexity 36.8 with the Depth Transformer, 135.4 with separate heads (Table 5)." },
  { name: "Staircase", d: [0, 1, 2, 3, 4, 5, 6, 7], note: "MusicGen-style. Separate heads 42.2 vs Depth Transformer 40.3 (Table 5): cheap heads cope, but it costs 640 ms." },
];
---
<div class="blog-diagram dst" role="region" aria-label={alt} data-dst data-presets={JSON.stringify(presets)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 340" role="img" aria-labelledby="dst-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="dst-title">Acoustic tokens shifted later than the semantic token, and when the first frame becomes complete</title>
    <g data-grid></g>
    <text x="20" y="276" font-size="12" fill="#2b2b30" data-r1></text>
    <text x="20" y="298" font-size="12.5" font-weight="700" fill="#2b2b30" data-r2></text>
    <text x="20" y="322" font-size="11.5" fill="#5f5f66" data-r3></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Delay pattern</span><div class="fig-chips">
      {presets.map((p, i) => <button type="button" class="fig-chip" data-pre={i} aria-pressed={i === 1 ? "true" : "false"}>{p.name}</button>)}
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-dst]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const P: { name: string; d: number[]; note: string }[] = JSON.parse(root.dataset.presets!);
    const COLS = 12, CW = 52, X0 = 120, Y0 = 34, RH = 24;
    const g = $("[data-grid]");
    const mk = (tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt) e.textContent = txt; g.append(e); return e; };
    for (let c = 0; c < COLS; c++) mk("text", { x: X0 + c * CW + CW / 2, y: 24, "font-size": 10, "text-anchor": "middle", fill: "#5f5f66" }, `step ${c + 1}`);
    for (let q = 0; q < 8; q++) mk("text", { x: X0 - 8, y: Y0 + q * RH + 16, "font-size": 10.5, "text-anchor": "end", fill: "#2b2b30" }, q === 0 ? "semantic" : `acoustic ${q}`);
    const playhead = mk("rect", { y: Y0 - 4, height: 8 * RH + 6, width: CW, fill: "#a33b3b", "fill-opacity": 0.07 });
    // One token per (frame, codebook); frame 1's tokens are highlighted.
    const toks: { el: SVGRectElement; tx: SVGTextElement; f: number; q: number }[] = [];
    for (let q = 0; q < 8; q++) for (let f = 0; f < COLS; f++) {
      const el = mk("rect", { y: Y0 + q * RH, width: CW - 6, height: RH - 5, rx: 2 }) as SVGRectElement;
      const tx = mk("text", { y: Y0 + q * RH + 13, "font-size": 9.5, "text-anchor": "middle" }, `f${f + 1}`) as SVGTextElement;
      toks.push({ el, tx, f, q });
    }
    let cur = 1, shift = P[1].d.slice(), step = COLS;
    function draw() {
      toks.forEach(({ el, tx, f, q }) => {
        const col = f + shift[q], x = X0 + col * CW + 3, vis = col < COLS, shown = col < step;
        el.setAttribute("x", String(x)); tx.setAttribute("x", String(x + (CW - 6) / 2));
        el.style.opacity = vis ? "1" : "0"; tx.style.opacity = vis ? "1" : "0";
        const first = f === 0;
        el.setAttribute("fill", !shown ? "#f5f5f8" : first ? "#a33b3b" : q === 0 ? "#4F5D3A" : "#b9b9c2");
        tx.setAttribute("fill", !shown ? "#c9c9d0" : first || q === 0 ? "#fff" : "#2b2b30");
      });
      playhead.setAttribute("x", String(X0 + Math.min(step, COLS) * CW - CW)); playhead.style.opacity = step > 0 && step <= COLS ? "1" : "0";
      const p = P[cur], mx = Math.max(...p.d);
      $("[data-r1]").textContent = `Delays per codebook: [${p.d.join(", ")}]. Frame 1 (red) is complete at step ${1 + mx}.`;
      $("[data-r2]").textContent = `Latency = (1 + ${mx}) × 80 ms = ${(1 + mx) * 80} ms`;
      $("[data-r3]").textContent = p.note;
    }
    async function choose(i: number, alive = () => true) {
      const from = shift.slice(), to = P[i].d; cur = i;
      root.querySelectorAll("[data-pre]").forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
      step = COLS;
      await tween(0.7, (e) => { if (!alive()) return; shift = from.map((v, q) => v + (to[q] - v) * e); draw(); });
      shift = to.slice(); step = 0; draw();
      for (let s = 1; s <= COLS; s++) { await wait(0.22); if (!alive()) return; step = s; draw(); }
    }
    let token = 0;
    root.querySelectorAll<HTMLButtonElement>("[data-pre]").forEach((b) => b.addEventListener("click", () => { const my = ++token; choose(+b.dataset.pre!, () => my === token); }));
    draw();
    setupFigure(root, () => { shift = P[0].d.slice(); cur = 0; step = COLS; draw(); }, async (alive) => { await wait(0.5); await choose(1, alive); });
  });
</script>
