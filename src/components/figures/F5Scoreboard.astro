---
// F5-TTS review, Figure 7: word error rates from Table 1 (p. 7), Table 2
// (p. 8) and Table 6 (p. 17). Speaker similarity (SIM-o) is written beside
// each dot. Hollow dots: numbers the authors copied from other papers.
const { alt } = Astro.props;
const tabs = {
  ls: { name: "LibriSpeech-PC", gt: 2.23, rows: [["CosyVoice", 3.59, 0.66], ["FireRedTTS", 2.69, 0.47], ["E2 TTS (32 steps)", 2.95, 0.69], ["F5-TTS (16 steps)", 2.53, 0.66], ["F5-TTS (32 steps)", 2.42, 0.66]] },
  en: { name: "Seed-TTS English", gt: 2.06, rows: [["CosyVoice", 3.39, 0.64], ["FireRedTTS", 3.82, 0.46], ["MaskGCT (reported)", 2.623, 0.717, 1], ["Seed-TTS DiT (reported)", 1.733, 0.79, 1], ["E2 TTS (32 steps)", 2.19, 0.71], ["F5-TTS (16 steps)", 1.89, 0.67], ["F5-TTS (32 steps)", 1.83, 0.67]] },
  zh: { name: "Seed-TTS Chinese", gt: 1.26, rows: [["CosyVoice", 3.1, 0.75], ["FireRedTTS", 1.51, 0.63], ["MaskGCT (reported)", 2.273, 0.774, 1], ["Seed-TTS DiT (reported)", 1.178, 0.809, 1], ["E2 TTS (32 steps)", 1.97, 0.73], ["F5-TTS (16 steps)", 1.74, 0.75], ["F5-TTS (32 steps)", 1.56, 0.76]] },
  sway: { name: "Sway off → on", gt: 0, rows: [["F5-TTS, LibriSpeech-PC", 2.84, 0.62, 0, 2.41, 0.66], ["F5-TTS, Seed-TTS English", 1.93, 0.63, 0, 1.87, 0.66], ["F5-TTS, Seed-TTS Chinese", 1.93, 0.69, 0, 1.58, 0.75], ["E2 TTS, LibriSpeech-PC", 2.95, 0.69, 0, 2.84, 0.72], ["E2 TTS, Seed-TTS English", 2.19, 0.71, 0, 1.98, 0.73], ["E2 TTS, Seed-TTS Chinese", 1.97, 0.73, 0, 1.77, 0.78]] },
};
---
<div class="blog-diagram f5s" role="region" aria-label={alt} data-f5s data-tabs={JSON.stringify(tabs)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 330" role="img" aria-labelledby="f5s-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="f5s-title">Word error rates of F5-TTS and other systems</title>
    <g data-plot></g>
    <text data-r1 x="20" y="316" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Table</span><div class="fig-chips">
      {Object.entries(tabs).map(([k, t], i) => <button type="button" class="fig-chip" data-tab={k} aria-pressed={i === 0 ? "true" : "false"}>{t.name}</button>)}
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-f5s]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const T: Record<string, { name: string; gt: number; rows: (string | number)[][] }> = JSON.parse(root.dataset.tabs!);
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    let tab = "ls";
    const X = (w: number) => 230 + (w / 4) * 480;
    function draw(p: number) {
      const t = T[tab], g = $("[data-plot]"); g.replaceChildren();
      for (let w = 0; w <= 4; w += 0.5) { mk(g, "line", { x1: X(w), x2: X(w), y1: 20, y2: 280, stroke: "#f2f2f5" }); mk(g, "text", { x: X(w), y: 296, "font-size": 10, "text-anchor": "middle", fill: "#2b2b30" }, w.toFixed(1)); }
      mk(g, "text", { x: 710, y: 14, "font-size": 10.5, "text-anchor": "end", fill: "#5f5f66" }, "word error rate, % (lower is better)");
      if (t.gt) { mk(g, "line", { x1: X(t.gt), x2: X(t.gt), y1: 20, y2: 280, stroke: "#2b2b30", "stroke-dasharray": "4 3" }); mk(g, "text", { x: X(t.gt) + 4, y: 30, "font-size": 10, fill: "#2b2b30" }, `real recordings ${t.gt}`); }
      const H = 260 / t.rows.length;
      t.rows.forEach((r, i) => {
        const [name, w, sim, hollow, w2, sim2] = r as [string, number, number, number?, number?, number?], y = 40 + i * H;
        const f5 = String(name).startsWith("F5");
        mk(g, "text", { x: 20, y: y + 4, "font-size": 11, "font-weight": f5 ? 700 : 400, fill: "#2b2b30" }, name);
        if (w2 !== undefined) {
          const cur = w + (w2 - w) * p;
          mk(g, "line", { x1: X(w), x2: X(cur), y1: y, y2: y, stroke: "#4F5D3A", "stroke-width": 2.5 });
          mk(g, "circle", { cx: X(w), cy: y, r: 6, fill: "#b9b9c2" });
          mk(g, "circle", { cx: X(cur), cy: y, r: 7, fill: "#4F5D3A" });
          if (p >= 1) mk(g, "text", { x: X(w) + 10, y: y + 4, "font-size": 10.5, fill: "#2b2b30" }, `${w} → ${w2}   SIM ${sim} → ${sim2}`);
        } else {
          const x = X(w * p);
          mk(g, "circle", { cx: x, cy: y, r: 7, fill: hollow ? "#fff" : f5 ? "#594578" : "#8a8a94", stroke: f5 ? "#594578" : "#8a8a94", "stroke-width": 2 });
          if (p >= 1) mk(g, "text", { x: x + 12, y: y + 4, "font-size": 10.5, fill: "#2b2b30" }, `${w}   SIM ${sim}`);
        }
      });
      $("[data-r1]").textContent = tab === "sway" ? "Table 6 (p. 17), midpoint solver, 32 steps, s = −1. E2 TTS was not retrained: Sway is applied only at generation." : `Table ${tab === "ls" ? "1 (p. 7)" : "2 (p. 8)"}. Averages of three seeds. Hollow dots were copied from other papers, not re-run.`;
      root.querySelectorAll("[data-tab]").forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute("data-tab") === tab)));
    }
    root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.addEventListener("click", async () => { tab = b.dataset.tab!; await tween(0.8, (e) => draw(e)); draw(1); }));
    draw(1);
    setupFigure(root, () => draw(0), async (alive) => { await tween(1.4, (e) => { if (alive()) draw(e); }); draw(1); });
  });
</script>
