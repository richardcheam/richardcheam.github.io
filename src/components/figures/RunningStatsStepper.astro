---
// Foundations, normalisation post: batch norm's running averages for
// inference. Start mean 0, variance 1; batches with means 3, 5, 4 and
// variances 1, 4, 2; momentum 0.1: running mean 0.3, 0.77, 1.093, running
// variance 1.0, 1.3, 1.37. Momentum 0.5: means 1.5, 3.25, 3.625.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-running>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 200" role="img" aria-labelledby="rn-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rn-title">A running mean creeping towards the batch means, batch by batch</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Momentum α <strong data-va></strong></span><input class="scrub" data-a type="range" min="0.05" max="1" step="0.05" value="0.1" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, NEG, JADE } from "../../lib/net-diagram";
  import { frame, txt, arrow } from "../../lib/plot";
  const BM = [3, 5, 4], BV = [1, 4, 2];
  document.querySelectorAll<HTMLElement>("[data-running]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let a = 0.1;
    const runs = () => { let m = 0, v = 1; return BM.map((bm, i) => { const pm = m, pv = v; m = (1 - a) * m + a * bm; v = (1 - a) * v + a * BV[i]; return { pm, pv, m, v }; }); };
    const steps = () => runs().map((r, i) => ({
      say: i === 0 ? `Batch 1 arrives. Keep ${fmt(100 * (1 - a))}% of the stored value and mix in ${fmt(100 * a)}% of the batch's.` : i === 2 ? "After three batches the stored mean is still far below the batch means: the early bias of an average that starts at zero. Over thousands of steps it catches up." : `Batch ${i + 1}.`,
      math: `running mean = ${fmt(1 - a)} × ${fmt(r.pm, 4)} + ${fmt(a)} × ${BM[i]} = ${fmt(r.m, 4)}\nrunning variance = ${fmt(1 - a)} × ${fmt(r.pv, 4)} + ${fmt(a)} × ${BV[i]} = ${fmt(r.v, 4)}`,
    }));
    function draw(k: number) {
      const rs = runs(), F = frame({ l: 40, t: 60, w: 680, h: 10, x0: 0, x1: 6, y0: 0, y1: 1 });
      let s = txt(40, 22, "Stored running mean (gold) against each batch's mean (dark)", `font-size="12" font-weight="700" fill="${INK}"`);
      s += `<line x1="40" x2="720" y1="80" y2="80" stroke="#cfd5d4" stroke-width="2"/>`;
      for (let v = 0; v <= 6; v++) s += `<line x1="${F.X(v)}" x2="${F.X(v)}" y1="75" y2="85" stroke="#cfd5d4"/>` + txt(F.X(v), 100, String(v), `font-size="11" text-anchor="middle" fill="${MUTED}"`);
      BM.forEach((m, i) => { if (i <= k) s += `<circle cx="${F.X(m)}" cy="80" r="6" fill="${INK}"/>` + txt(F.X(m), 64, `batch ${i + 1}`, `font-size="10.5" text-anchor="middle" fill="${INK}"`); });
      const cur = k < 0 ? 0 : rs[k].m;
      if (k >= 0) s += arrow(F.X(rs[k].pm), 120, F.X(rs[k].m), 120, GOLD, 2.5);
      s += `<circle cx="${F.X(cur)}" cy="80" r="8" fill="${GOLD}" stroke="#fff" stroke-width="2"/>`;
      s += txt(40, 150, "after batch", `font-size="11" font-weight="700" fill="${MUTED}"`) + txt(160, 150, "running mean", `font-size="11" font-weight="700" fill="${MUTED}"`) + txt(290, 150, "running variance", `font-size="11" font-weight="700" fill="${MUTED}"`);
      ["start", "1", "2", "3"].forEach((lab, i) => { if (i - 1 > k) return; const r = i ? rs[i - 1] : { m: 0, v: 1 }; s += txt(40 + i * 170, 172, `${lab}: ${fmt(r.m, 4)}`, `font-size="12" font-weight="${i - 1 === k ? 700 : 400}" fill="${INK}"`) + txt(40 + i * 170, 190, `var ${fmt(r.v, 4)}`, `font-size="11.5" fill="${MUTED}"`); });
      $("[data-draw]").innerHTML = s;
      $("[data-va]").textContent = fmt(a, 2);
    }
    const redraw = stepper(root, steps, draw, { delay: 2 });
    $<HTMLInputElement>("[data-a]").addEventListener("input", (e) => { a = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
