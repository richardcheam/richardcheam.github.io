---
// Model development, parallelism decision guide: a GPipe-style flush schedule
// (src/lib/collectives.ts gpipeSchedule), forward 1 unit and backward 2 units.
// Idle share = (p − 1)/(m + p − 1); bubble = (p − 1)/m of ideal time.
// Defaults p = 4, m = 8: idle 3/11 = 27.3%.
import { pipelineBubble } from "../../lib/collectives";
const { alt } = Astro.props;
const d = pipelineBubble({ stages: 4, microbatches: 8 });
---
<div class="blog-diagram" role="region" aria-label={alt} data-pipeline-schedule>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 250" role="img" aria-labelledby="pipe-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="pipe-title">A timeline of pipeline stages running forward and backward blocks for each microbatch, with idle gaps at the start and end</title>
    <g data-draw></g>
  </svg>
  <p class="fig-readout" data-pipe-readout aria-live="polite">4 stages, 8 microbatches: bubble = 3/8 = {(100 * d.bubbleFraction).toFixed(1)}% of ideal time; the stages are busy {(100 * d.utilization).toFixed(1)}% of the step.</p>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Pipeline stages p <strong data-v="p">4</strong></span><input class="scrub" data-k="p" type="range" min="1" max="8" step="1" value="4" /></label>
    <label><span class="fig-panel__name">Microbatches m <strong data-v="m">8</strong></span><input class="scrub" data-k="m" type="range" min="1" max="16" step="1" value="8" /></label>
  </div>
</div>

<script>
  import { gpipeSchedule, pipelineBubble } from "../../lib/collectives";
  import { INK, MUTED, JADE, GOLD, DEAD } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  document.querySelectorAll<HTMLElement>("[data-pipeline-schedule]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const v: Record<string, number> = { p: 4, m: 8 };
    function draw() {
      const { blocks, makespan } = gpipeSchedule({ stages: v.p, microbatches: v.m });
      const b = pipelineBubble({ stages: v.p, microbatches: v.m });
      const L = 86, W = 650, rowH = Math.min(36, 190 / v.p), unit = W / makespan, top = 22;
      let s = "";
      for (let st = 0; st < v.p; st++) {
        const y = top + st * rowH;
        s += `<rect x="${L}" y="${y}" width="${W}" height="${rowH - 4}" fill="${DEAD}"/>` + txt(L - 8, y + rowH / 2 + 2, `stage ${st}`, `font-size="10.5" text-anchor="end" fill="${MUTED}"`);
      }
      for (const blk of blocks) {
        const x = L + blk.start * unit, y = top + blk.stage * rowH, w = blk.duration * unit;
        s += `<rect x="${x + 0.5}" y="${y}" width="${Math.max(0.5, w - 1)}" height="${rowH - 4}" fill="${blk.kind === "F" ? JADE : GOLD}" fill-opacity="${blk.kind === "F" ? 0.75 : 0.65}"/>`;
        if (w > 16 && rowH > 14) s += txt(x + w / 2, y + rowH / 2 + 2, `${blk.kind}${blk.microbatch + 1}`, `font-size="9" text-anchor="middle" fill="#fff"`);
      }
      const yAxis = top + v.p * rowH + 14;
      s += txt(L, yAxis, "time →", `font-size="10" fill="${MUTED}"`) + txt(L + W, yAxis, `${makespan} units`, `font-size="10" text-anchor="end" fill="${MUTED}"`);
      s += txt(L, yAxis + 18, "green: forward (1 unit) · gold: backward (2 units) · grey: idle, the bubble", `font-size="10" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-pipe-readout]").textContent = v.p === 1
        ? `1 stage: no pipeline, so no bubble. ${v.m} microbatches run back to back.`
        : `${v.p} stages, ${v.m} microbatches: bubble = ${v.p - 1}/${v.m} = ${(100 * b.bubbleFraction).toFixed(1)}% of ideal time; the stages are busy ${(100 * b.utilization).toFixed(1)}% of the step.`;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = String(v[el.dataset.v!])));
    }
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { v[inp.dataset.k!] = +inp.value; draw(); }));
    draw();
  });
</script>
