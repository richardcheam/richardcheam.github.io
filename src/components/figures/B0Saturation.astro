---
const { alt } = Astro.props;
---
<div class="blog-diagram" tabindex="0" role="region" aria-label={alt} data-b0>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 52 780 258" role="img" aria-labelledby="b0-saturation-title b0-saturation-desc" class="blog-diagram-svg" font-family="Inter, sans-serif">
  <title id="b0-saturation-title">B0 output throughput and median first-token latency at 16 and 32 outstanding clients</title><desc id="b0-saturation-desc">At C16 and C32 output throughput was 1018.93 and 1021.06 tokens per second. Median first-token latency was 0.177 and 7.788 seconds. The two panels have separate units and scales.</desc>
  <text x="30" y="87" fill="#111111" font-size="17">Output rate</text><text x="30" y="108" fill="#5f5f66" font-size="14">tokens/s · axis 0–1,100</text>
  <text x="407" y="87" fill="#111111" font-size="17">Median TTFT</text><text x="407" y="108" fill="#5f5f66" font-size="14">seconds · axis 0–8</text>
  <line x1="91" y1="140" x2="91" y2="282" stroke="#5f5f66" /><line x1="463" y1="140" x2="463" y2="282" stroke="#5f5f66" />
  <g fill="#111111" font-size="15"><text x="30" y="176">C16</text><text x="30" y="246">C32</text><text x="407" y="176">C16</text><text x="407" y="246">C32</text></g>
  <rect data-bar="0" x="91" y="153" width="263" height="28" fill="#6486c9" /><rect data-bar="1" x="91" y="223" width="264" height="28" fill="#6486c9" />
  <rect data-bar="2" x="463" y="153" width="7" height="28" fill="#754a94" /><rect data-bar="3" x="463" y="223" width="263" height="28" fill="#754a94" />
  <g fill="#111111" font-size="15"><text data-val="0" x="91" y="202">1,018.93</text><text data-val="1" x="91" y="272">1,021.06</text><text data-val="2" x="463" y="202">0.177</text><text data-val="3" x="625" y="272">7.788</text></g>
  </svg>
<button type="button" class="fig-replay" data-replay>Replay</button>
</div>
<p class="blog-figure-reading">Throughput barely changed; first-output wait rose sharply at C32.</p>

<script>
  import { alongPath, animate, drawStroke, dur, hideStroke, setupFigure, wait } from "../../lib/figure-motion";

  // Doubling clients from C16 to C32: the output-rate bars grow to almost the
  // same length, then the first-token bars show where the extra load went.
  document.querySelectorAll<HTMLElement>("[data-b0]").forEach((root) => {
    const bar = (k: number) => root.querySelector<SVGRectElement>(`[data-bar="${k}"]`)!;
    const val = (k: number) => root.querySelector<SVGTextElement>(`[data-val="${k}"]`)!;
    setupFigure(root, () => {
      [0, 1, 2, 3].forEach((k) => { const b = bar(k); b.style.transformBox = "fill-box"; b.style.transformOrigin = "0% 50%"; b.style.transform = "scaleX(0)"; val(k).style.opacity = "0"; });
    }, async (alive) => {
      const grow = (k: number, s: number, delay = 0) => animate(bar(k), { transform: ["scaleX(0)", "scaleX(1)"] }, { duration: dur(s), delay: dur(delay), ease: [0.22, 1, 0.36, 1] }).then(() => animate(val(k), { opacity: [0, 1] }, { duration: dur(0.3) }));
      await Promise.all([grow(0, 1.0), grow(1, 1.0, 0.25)]);
      await wait(0.4); if (!alive()) return;
      await grow(2, 0.4);
      await grow(3, 1.3);
    });
  });
</script>
