---
// Foundations, LSTM and GRU post: plain RNN and one-unit LSTM side by side on
// the remember-the-first-input task (src/lib/rnn.ts, src/lib/lstm.ts; no
// randomness). First pass with loss below 0.01, pass 1 being the untrained
// network: RNN 8, 25, never, never for delays 5, 10, 20, 40; LSTM with
// forget bias 2: 30, 27, 31, 73; bias 1: 42, 64, 339, never.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-echolstm>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 270" role="img" aria-labelledby="el-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="el-title">A plain RNN and an LSTM training side by side to remember their first input</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Training</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-play>Train</button>
      <button type="button" class="fig-chip" data-one>One pass</button>
      <button type="button" class="fig-chip" data-reset>Start over</button>
    </div></div>
    <div><span class="fig-panel__name">Delay</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-T="5" aria-pressed="false">5</button><button type="button" class="fig-chip" data-T="10" aria-pressed="false">10</button><button type="button" class="fig-chip" data-T="20" aria-pressed="true">20</button><button type="button" class="fig-chip" data-T="40" aria-pressed="false">40</button>
    </div></div>
    <div><span class="fig-panel__name">LSTM forget bias</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-bf="0" aria-pressed="false">0</button><button type="button" class="fig-chip" data-bf="1" aria-pressed="false">1</button><button type="button" class="fig-chip" data-bf="2" aria-pressed="true">2</button>
    </div></div>
  </div>
</div>

<script>
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { echoModel } from "../../lib/rnn";
  import { echoLstm } from "../../lib/lstm";
  const MAX = 3000;
  document.querySelectorAll<HTMLElement>("[data-echolstm]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let T = 20, bf = 2, playing = false, raf = 0;
    let rnn = echoModel(T, 0.5, 0.5), lstm = echoLstm(T, bf), lr: number[] = [], ll: number[] = [], sr = -1, sl = -1;
    const reset = () => { rnn = echoModel(T, 0.5, 0.5); lstm = echoLstm(T, bf); lr = [rnn.evaluate().L]; ll = [lstm.evaluate().L]; sr = sl = -1; draw(); };
    const passes = (n: number) => { for (let i = 0; i < n && lr.length < MAX; i++) { rnn.step(); lstm.step(); const a = rnn.evaluate().L, b = lstm.evaluate().L; lr.push(a); ll.push(b); if (sr < 0 && a < 0.01) sr = lr.length; if (sl < 0 && b < 0.01) sl = ll.length; } };
    function panel(l: number, title: string, mem: number[], losses: number[], solved: number, col: string) {
      let s = txt(l, 20, title, `font-size="12.5" font-weight="700" fill="${INK}"`);
      const bw = Math.min(14, 320 / mem.length);
      mem.forEach((v, t) => { const H = Math.min(1, Math.abs(v)) * 45; s += `<rect x="${l + t * bw}" y="${v >= 0 ? 80 - H : 80}" width="${Math.max(1, bw - 1)}" height="${Math.max(1, H)}" fill="${col}"/>`; });
      s += `<line x1="${l}" x2="${l + 330}" y1="80" y2="80" stroke="#cfd5d4"/>` + txt(l, 112, `memory over ${T} steps for first input +1`, `font-size="10.5" fill="${MUTED}"`);
      const lx = (i: number) => l + (i / Math.max(50, losses.length)) * 330, ly = (v: number) => 220 - (Math.min(v, 0.5) / 0.5) * 90;
      s += `<line x1="${l}" x2="${l + 330}" y1="220" y2="220" stroke="#cfd5d4"/><line x1="${l}" x2="${l + 330}" y1="${ly(0.01)}" y2="${ly(0.01)}" stroke="${JADE}" stroke-dasharray="3 3"/>`;
      const stp = Math.max(1, Math.floor(losses.length / 300));
      s += `<polyline fill="none" stroke="${col}" stroke-width="2" points="${losses.filter((_, i) => i % stp === 0 || i === losses.length - 1).map((v, j, a) => `${lx(j === a.length - 1 ? losses.length - 1 : j * stp).toFixed(1)},${ly(v).toFixed(1)}`).join(" ")}"/>`;
      s += txt(l, 244, `pass ${losses.length}, loss ${fmt(losses[losses.length - 1], 4)}`, `font-size="12" font-weight="700" fill="${INK}"`);
      s += txt(l, 262, solved > 0 ? `learned at pass ${solved}` : losses.length >= MAX ? `never learned in ${MAX.toLocaleString("en")} passes` : "not learned yet", `font-size="12" font-weight="700" fill="${solved > 0 ? JADE : losses.length >= MAX ? NEG : MUTED}"`);
      return s;
    }
    function draw() {
      $("[data-draw]").innerHTML = panel(20, "Plain RNN (3 weights, η 0.5)", rnn.hidden(1), lr, sr, "#3E6E9E") + panel(400, `LSTM (13 weights, η 0.3, forget bias ${bf})`, lstm.cells(1), ll, sl, GOLD);
      $("[data-play]").textContent = playing ? "Pause" : lr.length >= MAX ? "Finished" : "Train";
    }
    const loop = () => { passes(6); draw(); if (playing && lr.length < MAX) raf = requestAnimationFrame(loop); else { playing = false; draw(); } };
    const play = (on: boolean) => { playing = on && lr.length < MAX; cancelAnimationFrame(raf); if (playing) raf = requestAnimationFrame(loop); draw(); };
    $("[data-play]").addEventListener("click", () => play(!playing));
    $("[data-one]").addEventListener("click", () => { play(false); passes(1); draw(); });
    $("[data-reset]").addEventListener("click", () => { play(false); reset(); });
    const pick = (attr: string, f: (v: number) => void) => root.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => b.addEventListener("click", () => { f(+b.getAttribute(attr)!); root.querySelectorAll(`[${attr}]`).forEach((o) => o.setAttribute("aria-pressed", String(o === b))); play(false); reset(); }));
    pick("data-T", (v) => (T = v)); pick("data-bf", (v) => (bf = v));
    reset();
  });
</script>
