---
// What each data filter removed, from the project report (sections 3.3, 3.4,
// 3.6, 3.8). The filters overlap and use different units, so each is drawn as
// its own exit, not as a cascade that subtracts to the final set.
const { alt } = Astro.props;
const exits = [
  { label: "Same audio, different transcripts", v: "768 rows", why: "one file cannot say two sentences" },
  { label: "Speaking rate outside 4–36 chars/s", v: "32 rows", why: "⅓ to 3× the median of 12 chars/s; fixed before counting" },
  { label: "Speaker deviated from the number text", v: "13 recordings", why: "found while checking number rules" },
  { label: "Digits without a confirmed reading", v: "1,484 recordings", why: "18,220 with digits − 16,736 verbalised" },
  { label: "Only one phrase, no place to cut", v: "125.6 h", why: "cannot split into prompt + target" },
];
---
<div class="blog-diagram df" tabindex="0" role="region" aria-label={alt} data-df>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 400" role="img" aria-labelledby="df-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="df-title">Data filters and the final training pool</title>
    <rect x="40" y="20" width="250" height="44" rx="6" fill="#2b2b30" />
    <text x="56" y="40" font-size="12" font-weight="600" fill="#fff">450,396 transcripts</text>
    <text x="56" y="56" font-size="10" fill="#d6d6dd">inventoried before any rule was written</text>
    <path d="M165 64 V344" stroke="#2b2b30" stroke-width="2" />
    <g data-flow></g>
    {exits.map((e, i) => (
      <g data-exit transform={`translate(0 ${92 + i * 52})`}>
        <path d="M165 0 H300" stroke="#a33b3b" stroke-width="1.5" stroke-dasharray="4 3" />
        <circle cx="165" cy="0" r="4" fill="#a33b3b" />
        <text x="310" y="-4" font-size="11.5" font-weight="600" fill="#2b2b30">{e.label}</text>
        <text x="310" y="12" font-size="10" fill="#5f5f66">{e.why}</text>
        <text x="740" y="-4" font-size="12" font-weight="700" text-anchor="end" fill="#a33b3b" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">− {e.v}</text>
      </g>
    ))}
    <g data-final>
      <rect x="40" y="344" width="250" height="44" rx="6" fill="#4F5D3A" />
      <text x="56" y="364" font-size="12" font-weight="600" fill="#fff">Foundation set: 854.5 h</text>
      <text x="56" y="380" font-size="10" fill="#e5ead9">350,470 recordings, all three sources</text>
      <text x="310" y="372" font-size="10" fill="#5f5f66">Filters overlap and use different units, so the exits do not add up to the gap.</text>
    </g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";

  document.querySelectorAll<HTMLElement>("[data-df]").forEach((root) => {
    const exits = Array.from(root.querySelectorAll<SVGGElement>("[data-exit]")), fin = root.querySelector<SVGGElement>("[data-final]")!;
    setupFigure(root, () => { exits.forEach((e) => (e.style.opacity = "0")); fin.style.opacity = "0"; }, async (alive) => {
      for (const e of exits) {
        if (!alive()) return;
        animate(e, { opacity: [0, 1] }, { duration: dur(0.4) });
        await wait(0.4);
      }
      animate(fin, { opacity: [0, 1] }, { duration: dur(0.5) });
    });
  });
</script>
