---
// Where HaluEval accuracy is lost (Table 8, Appendix B.2, Gemma 3 27B judge).
// Left axis: share of references that contain the right answer. Right axis:
// share of Moshi's spoken answers that do. Three conditions: ASR transcript +
// Gemma reference (the real system), ground-truth transcript + Gemma reference,
// and a ground-truth reference. Slopes are the injection loss; the vertical gap
// between the first two lines is the transcript loss.
const { alt } = Astro.props;
const rows = [
  { key: "gt", label: "perfect reference", ref: 97.2, resp: 65.1, color: "#2b2b30" },
  { key: "gttext", label: "true transcript → Gemma", ref: 57.2, resp: 50.8, color: "#4F5D3A" },
  { key: "asr", label: "ASR transcript → Gemma (MoshiRAG)", ref: 42.0, resp: 36.3, color: "#594578" },
];
const XL = 250, XR = 560, Y0 = 300, YH = 2.5; // 100 % = 250 px
const y = (v: number) => Y0 - v * YH;
---
<div class="blog-diagram al" tabindex="0" role="region" aria-label={alt} data-al>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 344" role="img" aria-labelledby="al-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="al-title">Accuracy of the reference versus the spoken answer</title>
    <g stroke="#ececf1">
      {[0, 25, 50, 75, 100].map((v) => <line x1={XL - 30} y1={y(v)} x2={XR + 30} y2={y(v)} />)}
    </g>
    <g font-size="9.5" fill="#5f5f66" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
      {[0, 25, 50, 75, 100].map((v) => <text x={XL - 36} y={y(v) + 3} text-anchor="end">{v}%</text>)}
    </g>
    <line x1={XL} y1={y(100) - 6} x2={XL} y2={Y0} stroke="#2b2b30" />
    <line x1={XR} y1={y(100) - 6} x2={XR} y2={Y0} stroke="#2b2b30" />
    <text x={XL} y={Y0 + 20} font-size="11.5" text-anchor="middle" font-weight="600" fill="#2b2b30">the reference has the answer</text>
    <text x={XR} y={Y0 + 20} font-size="11.5" text-anchor="middle" font-weight="600" fill="#2b2b30">Moshi says the answer</text>
    <text x={(XL + XR) / 2} y={Y0 + 38} font-size="10" text-anchor="middle" fill="#5f5f66">injection: reference vectors added to Moshi's input →</text>

    {rows.map((r) => (
      <g data-row={r.key}>
        <line data-slope x1={XL} y1={y(r.ref)} x2={XR} y2={y(r.resp)} stroke={r.color} stroke-width="2" />
        <circle data-a cx={XL} cy={y(r.ref)} r="4.5" fill={r.color} />
        <circle data-b cx={XR} cy={y(r.resp)} r="4.5" fill={r.color} />
        <text data-a x={XL - 10} y={y(r.ref) - 8} font-size="11" text-anchor="end" font-weight="600" fill={r.color}>{r.ref.toFixed(1)}</text>
        <text data-b x={XR + 10} y={y(r.resp) + 4} font-size="11" font-weight="600" fill={r.color}>{r.resp.toFixed(1)} <tspan font-weight="400" font-size="10">{r.label}</tspan></text>
        <text data-loss x={(XL + XR) / 2 + 6} y={(y(r.ref) + y(r.resp)) / 2 - 8} font-size="10" fill={r.color}>−{(r.ref - r.resp).toFixed(1)}</text>
      </g>
    ))}

    <!-- transcript loss: same Gemma back end, ASR text vs true text -->
    <g data-transcript>
      <path d={`M${XL - 80} ${y(57.2)} V${y(42.0)}`} stroke="#a33b3b" stroke-width="1.5" />
      <path d={`M${XL - 84} ${y(57.2)} h8 M${XL - 84} ${y(42.0)} h8`} stroke="#a33b3b" stroke-width="1.5" />
      <text x={XL - 90} y={(y(57.2) + y(42.0)) / 2 - 2} font-size="10" fill="#a33b3b" text-anchor="end">−15.2</text>
      <text x={XL - 90} y={(y(57.2) + y(42.0)) / 2 + 11} font-size="9.5" fill="#a33b3b" text-anchor="end">ASR errors</text>
    </g>
    <text x="14" y="22" font-size="10.5" fill="#5f5f66">HaluEval, 1,000 spoken questions. ASR word error rate on this set: 11.5%.</text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { animate, dur, drawStroke, hideStroke, setupFigure, wait } from "../../lib/figure-motion";

  // Each condition: its reference point lands, the slope draws across the
  // injection step, the loss appears. The transcript gap comes last.
  document.querySelectorAll<HTMLElement>("[data-al]").forEach((root) => {
    const rows = Array.from(root.querySelectorAll<SVGGElement>("[data-row]"));
    const transcript = root.querySelector<SVGGElement>("[data-transcript]")!;
    setupFigure(
      root,
      () => {
        rows.forEach((r) => {
          r.querySelectorAll<SVGElement>("[data-a],[data-b],[data-loss]").forEach((e) => (e.style.opacity = "0"));
          hideStroke(r.querySelector("[data-slope]")!);
        });
        transcript.style.opacity = "0";
      },
      async (alive) => {
        for (const r of rows) {
          if (!alive()) return;
          r.querySelectorAll<SVGElement>("[data-a]").forEach((e) => animate(e, { opacity: [0, 1] }, { duration: dur(0.3) }));
          await wait(0.25);
          await drawStroke(r.querySelector("[data-slope]")!, 0.8);
          r.querySelectorAll<SVGElement>("[data-b],[data-loss]").forEach((e) => animate(e, { opacity: [0, 1] }, { duration: dur(0.3) }));
          await wait(0.35);
        }
        if (!alive()) return;
        animate(transcript, { opacity: [0, 1] }, { duration: dur(0.4) });
      },
    );
  });
</script>
