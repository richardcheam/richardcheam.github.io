---
// Figure 9: source and filter. Harmonic spikes at multiples of F0; their
// heights follow a smooth mouth curve whose peaks are the formants
// (Peterson and Barney 1952 male averages).
const { alt } = Astro.props;
---
<div class="blog-diagram vf" role="region" aria-label={alt} data-vow>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 380" role="img" aria-labelledby="vf-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="vf-title">Harmonics of the voice under a vowel's formant curve</title>
    <text x="50" y="22" font-size="11" fill="#5f5f66">loudness of each pitch in one frame</text>
    <g data-spikes></g>
    <path data-curve d="" fill="#594578" fill-opacity="0.08" stroke="#594578" stroke-width="2" />
    <g data-flab></g>
    <line x1="50" x2="740" y1="290" y2="290" stroke="#2b2b30" />
    {[0, 500, 1000, 1500, 2000, 2500, 3000, 3500, 4000].map((f) => <text x={50 + (f / 4000) * 690} y="306" font-size="9.5" text-anchor="middle" fill="#5f5f66">{f}</text>)}
    <text x="740" y="322" font-size="10" text-anchor="end" fill="#5f5f66">Hz</text>
    <text data-r1 x="50" y="348" font-size="12.5" fill="#2b2b30"></text>
    <text data-r2 x="50" y="370" font-size="12.5" fill="#594578"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Pitch, F0<strong data-v0></strong></span><input class="scrub" data-f0 type="range" min="80" max="300" step="5" value="120" /></label>
    <div><span class="fig-panel__name">Vowel</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-v="ee" aria-pressed="true">"ee" (heed)</button>
      <button type="button" class="fig-chip" data-v="ah" aria-pressed="false">"ah" (hod)</button>
      <button type="button" class="fig-chip" data-v="oo" aria-pressed="false">"oo" (who'd)</button>
      <button type="button" class="fig-chip" data-listen>▶ Listen</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";
  import { formantGain, VOWELS } from "../../lib/audio-math";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-vow]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const f0In = $<HTMLInputElement>("[data-f0]");
    const X = (f: number) => 50 + (f / 4000) * 690;
    const Y = (g: number) => { const db = Math.max(-40, 20 * Math.log10(g)); return 290 - ((db + 40) / 40) * 240; };
    let fs = [...VOWELS.ee], name = "ee";
    const mk = (tag: string, at: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in at) e.setAttribute(k, String(at[k])); if (txt) e.textContent = txt; return e; };
    function draw() {
      const f0 = +f0In.value;
      f0In.style.setProperty("--p", `${((f0 - 80) / 220) * 100}%`);
      let d = `M50 290`;
      for (let px = 0; px <= 690; px += 2) d += `L${50 + px} ${Y(formantGain((px / 690) * 4000, fs)).toFixed(1)}`;
      $("[data-curve]").setAttribute("d", d + "L740 290Z");
      const sp = $("[data-spikes]"); sp.replaceChildren();
      for (let h = 1; h * f0 <= 4000; h++) sp.append(mk("line", { x1: X(h * f0), x2: X(h * f0), y1: 290, y2: Y(formantGain(h * f0, fs)), stroke: "#2b2b30", "stroke-width": 2 }));
      const fl = $("[data-flab]"); fl.replaceChildren();
      fs.slice(0, 2).forEach((F, i) => fl.append(mk("text", { x: X(F), y: Y(formantGain(F, fs)) - 8, "font-size": 11, "font-weight": 700, "text-anchor": "middle", fill: "#594578" }, `F${i + 1}`)));
      $("[data-v0]").textContent = `${f0} Hz`;
      $("[data-r1]").innerHTML = `Buzz: F0 = <tspan font-weight="700">${f0} Hz</tspan>, so harmonics sit at ${f0}, ${2 * f0}, ${3 * f0}, … Hz (black lines).`;
      $("[data-r2]").innerHTML = `Mouth shape "${name}": F1 ≈ <tspan font-weight="700">${Math.round(fs[0]).toLocaleString("en")} Hz</tspan>, F2 ≈ <tspan font-weight="700">${Math.round(fs[1]).toLocaleString("en")} Hz</tspan> (purple curve).`;
    }
    let auto = true;
    async function setVowel(v: string) {
      name = v;
      root.querySelectorAll("[data-v]").forEach((b) => b.setAttribute("aria-pressed", String((b as HTMLElement).dataset.v === v)));
      const from = [...fs], to = VOWELS[v];
      await tween(0.45, (t) => { fs = from.map((f, i) => f + (to[i] - f) * t); draw(); });
    }
    root.querySelectorAll<HTMLButtonElement>("[data-v]").forEach((b) => b.addEventListener("click", () => { auto = false; setVowel(b.dataset.v!); }));
    f0In.addEventListener("input", () => { auto = false; draw(); });
    let ctx: AudioContext | null = null;
    $("[data-listen]").addEventListener("click", () => {
      ctx ??= new AudioContext();
      const t = ctx.currentTime, osc = ctx.createOscillator(), out = ctx.createGain();
      osc.type = "sawtooth"; osc.frequency.value = +f0In.value;
      out.gain.setValueAtTime(0, t); out.gain.linearRampToValueAtTime(0.35, t + 0.05); out.gain.setValueAtTime(0.35, t + 0.9); out.gain.linearRampToValueAtTime(0, t + 1);
      fs.forEach((F, i) => {
        const bp = ctx!.createBiquadFilter(), g = ctx!.createGain();
        bp.type = "bandpass"; bp.frequency.value = F; bp.Q.value = F / [90, 110, 150][i]; g.gain.value = [1, 0.55, 0.4][i];
        osc.connect(bp); bp.connect(g); g.connect(out);
      });
      out.connect(ctx.destination); osc.start(t); osc.stop(t + 1.05);
    });
    setupFigure(root, () => { auto = true; fs = [...VOWELS.ee]; name = "ee"; f0In.value = "120"; root.querySelectorAll("[data-v]").forEach((b) => b.setAttribute("aria-pressed", String((b as HTMLElement).dataset.v === "ee"))); draw(); }, async (alive) => {
      await wait(1.2);
      for (const v of ["oo", "ah", "ee"]) { if (!alive() || !auto) return; await setVowel(v); await wait(1.4); }
      if (!alive() || !auto) return;
      await tween(1.2, (t) => { if (alive() && auto) { f0In.value = String(Math.round((120 + 120 * t) / 5) * 5); draw(); } });
    });
    draw();
  });
</script>
