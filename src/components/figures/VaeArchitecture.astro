---
// Foundations, autoencoders post: the whole VAE from input to output, on the
// post's trained glyph model (src/lib/glyphs.ts): 5 × 5 image → encoder
// (25 → 16 → 4) → μ and σ → z = μ + σε → decoder (2 → 16 → 25) → image,
// with the reconstruction and KL losses; and the generating path, where z is
// drawn from the standard normal and only the decoder runs.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-vae-arch>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 340" role="img" aria-labelledby="va2-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="va2-title">A VAE: image, encoder, mean and spread, sampled code, decoder, rebuilt image and losses</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Path</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-mode="train" aria-pressed="true">Training</button>
      <button type="button" class="fig-chip" data-mode="gen" aria-pressed="false">Generating</button>
    </div></div>
    <div><span class="fig-panel__name">Input glyph (training)</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-g="0" aria-pressed="true">Vertical bar</button>
      <button type="button" class="fig-chip" data-g="3" aria-pressed="false">Horizontal bar</button>
      <button type="button" class="fig-chip" data-g="6" aria-pressed="false">Ring</button>
      <button type="button" class="fig-chip" data-g="9" aria-pressed="false">Cross</button>
    </div></div>
    <div><span class="fig-panel__name">Random draw</span><div class="fig-chips"><button type="button" class="fig-chip" data-eps>New ε</button></div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, NEG, JADE, GOLD, TINT, DEAD } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { GLYPHS, NAMES, codes, sigmas, decode, decodeHidden, nearest, glyphSvg } from "../../lib/glyphs";
  import { gaussStream } from "../../lib/diffusion";
  const EPS = (() => { const g = gaussStream(12); return Array.from({ length: 40 }, () => [g(), g()]); })();
  const CODES = codes("vae"), SIG = sigmas();
  const v2 = (v: number[], d = 3) => `(${v.map((x) => fmt(x, d)).join(", ")})`;
  document.querySelectorAll<HTMLElement>("[data-vae-arch]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let mode: "train" | "gen" = "train", gi = 0, ei = 0;
    const calc = () => {
      const x = GLYPHS[gi], mu = CODES[gi], sd = SIG[gi], eps = EPS[ei];
      const z = mode === "train" ? mu.map((m, j) => m + sd[j] * eps[j]) : eps;
      const h = decodeHidden("vae", z), y = decode("vae", z);
      const rec = -x.reduce((s, v, k) => s + (v ? Math.log(y[k]) : Math.log(1 - y[k])), 0);
      const kl = 0.5 * mu.reduce((s, m, j) => s + m * m + sd[j] ** 2 - 1 - Math.log(sd[j] ** 2), 0);
      return { x, mu, sd, eps, z, h, y, rec, kl, near: nearest(y) };
    };
    const steps = () => { const C = calc(); return mode === "train" ? [
      { say: `The input is a 5 × 5 image of a ${NAMES[gi]}: 25 pixel values, 1 for ink and 0 for blank.`, math: "x: 25 numbers" },
      { say: "The encoder (25 → 16 → 4) does not output one code. It outputs a little cloud: a centre μ and a spread σ for each of the 2 latent numbers. (Its last two outputs are log-variances; σ = e^(½ × log-variance).)", math: `μ = ${v2(C.mu)}\nσ = ${v2(C.sd)}` },
      { say: "Draw ε from a standard bell curve (mean 0, spread 1). This random draw is the only noise in the whole model.", math: `ε = ${v2(C.eps)}` },
      { say: "The reparameterisation trick: z = μ + σ × ε. The code is a random point inside the cloud, but the gradient can still reach μ and σ.", math: `z₁ = ${fmt(C.mu[0], 3)} + ${fmt(C.sd[0], 3)} × ${par(C.eps[0], 3)} = ${fmt(C.z[0], 3)}\nz₂ = ${fmt(C.mu[1], 3)} + ${fmt(C.sd[1], 3)} × ${par(C.eps[1], 3)} = ${fmt(C.z[1], 3)}` },
      { say: "The decoder's first layer turns the 2-number code into 16 hidden values (tanh, between −1 and 1).", math: `h = tanh(W₃ z + b₃): 16 numbers, e.g. ${C.h.slice(0, 4).map((v) => fmt(v, 2)).join(", ")}, …` },
      { say: "Its second layer turns those 16 values into 25 pixel probabilities (sigmoid, between 0 and 1): the rebuilt image x̂.", math: `x̂ = sigmoid(W₄ h + b₄): 25 numbers; darkest pixel ${fmt(Math.max(...C.y), 3)}, palest ${fmt(Math.min(...C.y), 3)}` },
      { say: "Reconstruction loss: how far x̂ is from x, pixel by pixel. Each pixel is a yes-or-no guess, so we use cross-entropy, added over the 25 pixels.", math: `−Σ [x ln x̂ + (1 − x) ln(1 − x̂)] = ${fmt(C.rec, 3)}` },
      { say: "KL loss: how far this cloud is from the standard bell curve. It pulls μ toward 0 and σ toward 1, so the codes fill one shared region.", math: `½ Σ (μ² + σ² − 1 − ln σ²) = ${fmt(C.kl, 3)}` },
      { say: "Training adds the two and sends the gradient back: through the decoder, through z = μ + σε to μ and σ, and into the encoder. Both networks learn together.", math: `loss = ${fmt(C.rec, 3)} + ${fmt(C.kl, 3)} = ${fmt(C.rec + C.kl, 3)}` },
    ] : [
      { say: "To make something new, throw the encoder away. There is no input image.", math: "only the decoder is used" },
      { say: "Draw z straight from the standard bell curve. The KL loss made this region full of codes, so a random z lands somewhere meaningful.", math: `z = ε = ${v2(C.z)}` },
      { say: "The decoder's first layer: 2 numbers → 16 hidden values.", math: `16 numbers, e.g. ${C.h.slice(0, 4).map((v) => fmt(v, 2)).join(", ")}, …` },
      { say: "Its second layer: 16 → 25 pixels. A new image, decoded from a random point.", math: `nearest training glyph: ${NAMES[C.near.i]}, squared distance ${fmt(C.near.d, 3)}` },
    ]; };
    function trap(x1: number, x2: number, yc: number, hl: number, hr: number, on: boolean, dead: boolean, label: string, sub: string) {
      return `<path d="M${x1},${yc - hl / 2} L${x2},${yc - hr / 2} L${x2},${yc + hr / 2} L${x1},${yc + hl / 2} Z" fill="${dead ? DEAD : on ? TINT : "#fff"}" stroke="${dead ? "#cfd5d4" : INK}" stroke-width="${on ? 2 : 1}"/>` + txt((x1 + x2) / 2, yc - 4, label, `font-size="11.5" font-weight="700" text-anchor="middle" fill="${dead ? "#B9C0BF" : INK}"`) + txt((x1 + x2) / 2, yc + 12, sub, `font-size="10" text-anchor="middle" fill="${dead ? "#B9C0BF" : MUTED}"`);
    }
    function draw(k: number) {
      const C = calc(), T = mode === "train";
      // Map each stage to the step that reveals it, per mode.
      const at = T ? { x: 0, enc: 1, eps: 2, z: 3, d1: 4, d2: 5, rec: 6, kl: 7, back: 8 } : { x: 99, enc: 99, eps: 1, z: 1, d1: 2, d2: 3, rec: 99, kl: 99, back: 99 };
      const Y = 130;
      let s = "";
      // Input.
      s += txt(20, 40, "input x", `font-size="11" font-weight="700" fill="${T ? INK : "#B9C0BF"}"`) + txt(20, 54, "5 × 5 = 25", `font-size="10" fill="${MUTED}"`);
      s += T ? glyphSvg(C.x, 20, Y - 45, 18) : `<rect x="20" y="${Y - 45}" width="90" height="90" fill="${DEAD}"/>` + txt(65, Y + 4, "none", `font-size="11" text-anchor="middle" fill="#B9C0BF"`);
      // Encoder.
      s += trap(124, 196, Y, 110, 50, k === at.enc, !T, "encoder", "25 → 16 → 4");
      s += arrow(112, Y, 122, Y, T && k >= at.enc ? INK : "#cfd5d4", 1.2);
      // μ and σ.
      const show = (key: keyof typeof at) => k >= at[key];
      s += txt(214, Y - 34, "μ", `font-size="12" font-weight="700" fill="${T ? JADE : "#B9C0BF"}"`) + txt(214, Y + 22, "σ", `font-size="12" font-weight="700" fill="${T ? NEG : "#B9C0BF"}"`);
      [0, 1].forEach((j) => { s += `<rect x="${226 + j * 42}" y="${Y - 48}" width="40" height="22" rx="4" fill="#fff" stroke="${T ? JADE : "#cfd5d4"}"/>` + txt(246 + j * 42, Y - 33, T && show("enc") ? fmt(C.mu[j], 2) : "", `font-size="10.5" text-anchor="middle" fill="${INK}"`); s += `<rect x="${226 + j * 42}" y="${Y + 8}" width="40" height="22" rx="4" fill="#fff" stroke="${T ? NEG : "#cfd5d4"}"/>` + txt(246 + j * 42, Y + 23, T && show("enc") ? fmt(C.sd[j], 2) : "", `font-size="10.5" text-anchor="middle" fill="${INK}"`); });
      // ε.
      s += txt(226, Y + 62, "ε ~ N(0, 1)", `font-size="10.5" fill="${MUTED}"`);
      [0, 1].forEach((j) => (s += `<rect x="${226 + j * 42}" y="${Y + 68}" width="40" height="22" rx="4" fill="${k === at.eps ? TINT : "#fff"}" stroke="${GOLD}"/>` + txt(246 + j * 42, Y + 83, show("eps") ? fmt(C.eps[j], 2) : "", `font-size="10.5" text-anchor="middle" fill="${INK}"`)));
      // Latent plane.
      const L = 336, Tp = 44, S = 140, X = (v: number) => L + ((v + 2.5) / 5) * S, Yp = (v: number) => Tp + ((2.5 - v) / 5) * S;
      s += txt(L, 34, "code space z (2 numbers)", `font-size="11" font-weight="700" fill="${INK}"`);
      s += `<rect x="${L}" y="${Tp}" width="${S}" height="${S}" fill="#fafafa" stroke="#e3e7e6"/><line x1="${X(0)}" x2="${X(0)}" y1="${Tp}" y2="${Tp + S}" stroke="#e3e7e6"/><line x1="${L}" x2="${L + S}" y1="${Yp(0)}" y2="${Yp(0)}" stroke="#e3e7e6"/>`;
      if (!T) s += `<circle cx="${X(0)}" cy="${Yp(0)}" r="${S / 5}" fill="${GOLD}" fill-opacity="0.08" stroke="${GOLD}" stroke-dasharray="3 3"/>`;
      CODES.forEach((c) => (s += `<circle cx="${X(c[0])}" cy="${Yp(c[1])}" r="2.5" fill="${MUTED}" fill-opacity="0.5"/>`));
      if (T && show("enc")) s += `<ellipse cx="${X(C.mu[0])}" cy="${Yp(C.mu[1])}" rx="${(C.sd[0] / 5) * S}" ry="${(C.sd[1] / 5) * S}" fill="${JADE}" fill-opacity="0.15" stroke="${JADE}"/><circle cx="${X(C.mu[0])}" cy="${Yp(C.mu[1])}" r="3" fill="${JADE}"/>`;
      if (show("z")) s += `<circle cx="${X(C.z[0])}" cy="${Yp(C.z[1])}" r="5.5" fill="${GOLD}" stroke="#fff" stroke-width="1.5"/>` + txt(L + 5, Tp + 13, `z = ${v2(C.z, 2)}`, `font-size="10.5" font-weight="700" fill="${GOLD}"`);
      s += txt(L, Tp + S + 13, "grey: the 12 training codes (3 per shape, overlapping)", `font-size="9.5" fill="${MUTED}"`) + txt(L, Tp + S + 25, T ? "green: this glyph's cloud" : "dashed: where N(0, 1) mostly lands", `font-size="9.5" fill="${MUTED}"`);
      s += arrow(316, Y, 332, Y, show("z") ? INK : "#cfd5d4", 1.2);
      // Decoder with hidden strip.
      s += trap(500, 570, Y, 50, 110, k === at.d1 || k === at.d2, false, "decoder", "2 → 16 → 25");
      s += arrow(480, Y, 498, Y, show("d1") ? INK : "#cfd5d4", 1.2);
      if (show("d1")) C.h.forEach((v, j) => (s += `<rect x="${500 + j * 4.4}" y="${Y + 62}" width="4.2" height="14" fill="${v >= 0 ? JADE : NEG}" fill-opacity="${0.15 + 0.8 * Math.abs(v)}"/>`)) ;
      if (show("d1")) s += txt(500, Y + 90, "16 hidden values", `font-size="9.5" fill="${MUTED}"`);
      // Output.
      s += txt(600, 40, "output x̂", `font-size="11" font-weight="700" fill="${INK}"`) + txt(600, 54, "25 pixels", `font-size="10" fill="${MUTED}"`);
      s += show("d2") ? glyphSvg(C.y, 600, Y - 45, 18) : `<rect x="600" y="${Y - 45}" width="90" height="90" fill="#fff" stroke="#e3e7e6"/>`;
      s += arrow(572, Y, 596, Y, show("d2") ? INK : "#cfd5d4", 1.2);
      // Losses.
      if (T) {
        s += txt(20, 272, "losses", `font-size="11" font-weight="700" fill="${INK}"`);
        s += txt(20, 292, show("rec") ? `reconstruction (x̂ vs x): ${fmt(C.rec, 3)}` : "reconstruction (x̂ vs x): …", `font-size="12" fill="${k === at.rec ? GOLD : INK}"`);
        s += txt(20, 312, show("kl") ? `KL (cloud vs N(0, 1)): ${fmt(C.kl, 3)}` : "KL (cloud vs N(0, 1)): …", `font-size="12" fill="${k === at.kl ? GOLD : INK}"`);
        if (show("back")) s += txt(20, 332, `total ${fmt(C.rec + C.kl, 3)}  ← gradient flows back through decoder, z, μ and σ, into the encoder`, `font-size="12" font-weight="700" fill="${NEG}"`) + arrow(590, 246, 200, 246, NEG, 1.8) + txt(395, 240, "gradient", `font-size="10" text-anchor="middle" fill="${NEG}"`);
      } else if (show("d2")) s += txt(600, 252, `looks most like: ${NAMES[C.near.i]}`, `font-size="11.5" font-weight="700" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 2.6 });
    const press = (sel: string, b: Element) => root.querySelectorAll(sel).forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
    root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) => b.addEventListener("click", () => { mode = b.dataset.mode as "train" | "gen"; press("[data-mode]", b); root.querySelector<HTMLButtonElement>("[data-sp-reset]")?.click(); redraw(); }));
    root.querySelectorAll<HTMLButtonElement>("[data-g]").forEach((b) => b.addEventListener("click", () => { gi = +b.dataset.g!; press("[data-g]", b); redraw(); }));
    $("[data-eps]").addEventListener("click", () => { ei = (ei + 1) % EPS.length; redraw(); });
  });
</script>
