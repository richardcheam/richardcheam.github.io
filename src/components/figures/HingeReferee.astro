---
// SoundStream review, Figure 2: the hinge losses of Eq 1 and 2 (p. 6) for one
// judge and one time step. Judge: max(0, 1 - D(real)) + max(0, 1 + D(fake)).
// Generator: max(0, 1 - D(fake)). Defaults 0.4 and -0.2 give 0.6, 0.8, 1.4, 1.2.
const { alt } = Astro.props;
---
<div class="blog-diagram hr" role="region" aria-label={alt} data-hr>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 300" role="img" aria-labelledby="hr-title" class="blog-diagram-svg" font-family="Inter, sans-serif" style="touch-action: none">
    <title id="hr-title">A judge's scores for a real and a decoded clip, and the hinge losses they produce</title>
    <text x="40" y="24" font-size="11.5" font-weight="700" fill="#2b2b30">The judge's score (drag the two tokens)</text>
    <g data-axis></g>
    <g data-bars></g>
    <g data-tok></g>
    <text data-r1 x="40" y="214" font-size="12.5" fill="#2b2b30"></text>
    <text data-r2 x="40" y="236" font-size="12.5" fill="#2b2b30"></text>
    <text data-r3 x="40" y="262" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r4 x="40" y="286" font-size="11.5" fill="#5f5f66"></text>
  </svg>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-hr]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const X = (v: number) => 390 + v * 110, inv = (px: number) => (px - 390) / 110;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const ax = $("[data-axis]");
    mk(ax, "line", { x1: X(-3), x2: X(3), y1: 110, y2: 110, stroke: "#2b2b30" });
    for (let v = -3; v <= 3; v++) mk(ax, "text", { x: X(v), y: 128, "font-size": 10.5, "text-anchor": "middle", fill: "#2b2b30" }, String(v));
    mk(ax, "line", { x1: X(1), x2: X(1), y1: 40, y2: 180, stroke: "#4F5D3A", "stroke-dasharray": "4 3" });
    mk(ax, "line", { x1: X(-1), x2: X(-1), y1: 40, y2: 180, stroke: "#a33b3b", "stroke-dasharray": "4 3" });
    mk(ax, "text", { x: X(1) + 4, y: 50, "font-size": 10.5, fill: "#4F5D3A" }, "+1: “surely real”");
    mk(ax, "text", { x: X(-1) - 4, y: 50, "font-size": 10.5, "text-anchor": "end", fill: "#a33b3b" }, "“surely fake”: −1");
    let real = 0.4, fake = -0.2;
    function draw() {
      const gb = $("[data-bars]"), gt = $("[data-tok]"); gb.replaceChildren(); gt.replaceChildren();
      const lr = Math.max(0, 1 - real), lf = Math.max(0, 1 + fake), lg = Math.max(0, 1 - fake);
      if (lr > 0) mk(gb, "rect", { x: X(real), y: 76, width: X(1) - X(real), height: 12, fill: "#4F5D3A", "fill-opacity": 0.35 });
      if (lf > 0) mk(gb, "rect", { x: X(-1), y: 132, width: X(fake) - X(-1), height: 12, fill: "#a33b3b", "fill-opacity": 0.35 });
      if (lg > 0) mk(gb, "rect", { x: X(fake), y: 152, width: X(1) - X(fake), height: 8, fill: "#594578", "fill-opacity": 0.3 });
      const tok = (v: number, y: number, col: string, lab: string, k: string) => { const g = mk(gt, "g", { "data-k": k, style: "cursor: ew-resize" }); mk(g, "circle", { cx: X(v), cy: y, r: 11, fill: col }); mk(g, "text", { x: X(v), y: y + 4, "font-size": 10, "font-weight": 700, "text-anchor": "middle", fill: "#fff" }, lab); };
      tok(real, 82, "#4F5D3A", "real", "r"); tok(fake, 138, "#a33b3b", "fake", "f");
      mk(gt, "text", { x: X(fake), y: 176, "font-size": 10, "text-anchor": "middle", fill: "#594578" }, lg > 0 ? "generator wants it pushed right" : "generator satisfied");
      const f = (v: number) => (v >= 0 ? v.toFixed(2) : `(${v.toFixed(2)})`);
      $("[data-r1]").textContent = `Judge, real clip: max(0, 1 − ${f(real)}) = ${lr.toFixed(2)}${lr === 0 ? "   (past +1: no more push)" : ""}`;
      $("[data-r2]").textContent = `Judge, fake clip: max(0, 1 + ${f(fake)}) = ${lf.toFixed(2)}${lf === 0 ? "   (past −1: no more push)" : ""}`;
      $("[data-r3]").textContent = `Judge loss ${(lr + lf).toFixed(2)};  generator loss max(0, 1 − ${f(fake)}) = ${lg.toFixed(2)}`;
      $("[data-r4]").textContent = "Green bar: what the judge still owes on the real clip. Red: on the fake. Purple: how far the generator wants the fake to move.";
    }
    const svg = root.querySelector("svg")!;
    let drag = "";
    const at = (e: PointerEvent) => Math.max(-3, Math.min(3, Math.round(inv(((e.clientX - svg.getBoundingClientRect().left) / svg.getBoundingClientRect().width) * 780) * 10) / 10));
    svg.addEventListener("pointerdown", (e) => { const g = (e.target as Element).closest("[data-k]"); if (!g) return; drag = g.getAttribute("data-k")!; svg.setPointerCapture(e.pointerId); });
    svg.addEventListener("pointermove", (e) => { if (!drag) return; if (drag === "r") real = at(e); else fake = at(e); draw(); });
    svg.addEventListener("pointerup", () => { drag = ""; });
    draw();
    setupFigure(root, () => { real = 0.4; fake = -0.2; draw(); }, async (alive) => {
      await tween(1.4, (e) => { if (alive()) { fake = -0.2 - 1.6 * e; draw(); } });
      await tween(1.4, (e) => { if (alive()) { fake = -1.8 + 1.6 * e; draw(); } });
    });
  });
</script>
