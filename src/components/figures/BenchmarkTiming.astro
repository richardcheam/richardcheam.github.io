---
const { alt } = Astro.props;
---
<div class="blog-diagram" tabindex="0" role="region" aria-label={alt} data-bt>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 52 780 188" role="img" aria-labelledby="benchmark-timing-title benchmark-timing-desc" class="blog-diagram-svg" font-family="Inter, sans-serif">
  <title id="benchmark-timing-title">Conceptual output timeline</title><desc id="benchmark-timing-desc">Submission to first output is time to first token. The later span is post-first-output time. Streaming chunks may contain more than one token.</desc>
  <line data-axis x1="55" y1="113" x2="725" y2="113" stroke="#111111" stroke-width="2" />
  <g data-events fill="#111111"><circle cx="55" cy="113" r="6" /><circle cx="350" cy="113" r="6" /><circle cx="526" cy="113" r="6" /><circle cx="725" cy="113" r="6" /></g>
  <g data-event-labels fill="#111111" font-size="15"><text x="55" y="89">Submit</text><text x="320" y="89">First output</text><text x="482" y="89">Later chunk</text><text x="693" y="89">End</text></g>
  <path data-span="0" d="M55 145 V160 H350 V145" fill="none" stroke="#754a94" stroke-width="2" /><path data-span="1" d="M350 182 V197 H725 V182" fill="none" stroke="#754a94" stroke-width="2" />
  <g fill="#4F5D3A" font-size="15"><text data-span-label="0" x="135" y="180">TTFT</text><text data-span-label="1" x="449" y="219">Post-first-output time</text></g>
  <line data-cursor x1="0" y1="72" x2="0" y2="205" stroke="#754a94" stroke-width="1" stroke-dasharray="3 3" opacity="0" />
</svg>
<button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { alongPath, animate, drawStroke, dur, hideStroke, setupFigure, wait } from "../../lib/figure-motion";

  // One request plays out in time: a cursor runs from submit to end, each event
  // lands as it is reached, and the two waits are measured while they elapse.
  document.querySelectorAll<HTMLElement>("[data-bt]").forEach((root) => {
    const axis = root.querySelector<SVGLineElement>("[data-axis]")!;
    const events = Array.from(root.querySelectorAll<SVGCircleElement>("[data-events] circle"));
    const labels = Array.from(root.querySelectorAll<SVGTextElement>("[data-event-labels] text"));
    const spans = [0, 1].map((k) => root.querySelector<SVGPathElement>(`[data-span="${k}"]`)!);
    const spanLabels = [0, 1].map((k) => root.querySelector<SVGTextElement>(`[data-span-label="${k}"]`)!);
    const cursor = root.querySelector<SVGLineElement>("[data-cursor]")!;
    const xs = [55, 350, 526, 725], T = 3.2, at = (x: number) => ((x - 55) / 670) * T;
    setupFigure(root, () => {
      hideStroke(axis); spans.forEach(hideStroke);
      [...events, ...labels, ...spanLabels].forEach((e) => (e.style.opacity = "0"));
      cursor.style.opacity = "0";
    }, async (alive) => {
      cursor.style.opacity = "1";
      animate(cursor, { transform: ["translateX(55px)", "translateX(725px)"] }, { duration: dur(T), ease: "linear" });
      drawStroke(axis, T, "linear");
      xs.forEach((x, i) => {
        animate(events[i], { opacity: [0, 1] }, { duration: dur(0.2), delay: dur(at(x)) });
        animate(labels[i], { opacity: [0, 1] }, { duration: dur(0.3), delay: dur(at(x)) });
      });
      animate(spans[0], { strokeDashoffset: [1, 0] }, { duration: dur(at(350)), ease: "linear" });
      animate(spanLabels[0], { opacity: [0, 1] }, { duration: dur(0.3), delay: dur(at(350)) });
      animate(spans[1], { strokeDashoffset: [1, 0] }, { duration: dur(T - at(350)), delay: dur(at(350)), ease: "linear" });
      animate(spanLabels[1], { opacity: [0, 1] }, { duration: dur(0.3), delay: dur(T) });
      await wait(T + 0.3);
      if (!alive()) return;
      animate(cursor, { opacity: [1, 0] }, { duration: dur(0.3) });
    });
  });
</script>
