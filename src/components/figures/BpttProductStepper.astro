---
// Foundations, recurrent networks post: the gradient from step 5 back to step
// 1 is a product of factors w_h × (1 − h_t²). Defaults (w_x 1, w_h 0.5):
// 0.2502, 0.0845, 0.0390, 0.0191. Explode (0.01, 1.5): 5.0437. Saturate
// (1, 3): 0.00001.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-bptt>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 250" role="img" aria-labelledby="bp-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="bp-title">Hidden states with backward arrows; each link multiplies the gradient by one factor</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Preset</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-pre="1,0.5" aria-pressed="true">Shrink (w_x 1, w_h 0.5)</button>
      <button type="button" class="fig-chip" data-pre="0.01,1.5" aria-pressed="false">Explode (w_x 0.01, w_h 1.5)</button>
      <button type="button" class="fig-chip" data-pre="1,3" aria-pressed="false">Saturate (w_x 1, w_h 3)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { rnnForward } from "../../lib/rnn";
  const XS = [1, 0.5, -1, 0, 0];
  const show = (v: number) => (Math.abs(v) >= 0.001 ? fmt(v, 4) : v.toExponential(1).replace("e-", " × 10^−").replace(/^-/, "−").replace(/^-/, "−"));
  document.querySelectorAll<HTMLElement>("[data-bptt]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let wx = 1, wh = 0.5;
    const calc = () => { const hs = rnnForward(wx, wh, 0, XS).map((r) => r.h); const f = [1, 2, 3, 4].map((t) => wh * (1 - hs[t] ** 2)); const prod: number[] = []; f.reduce((p, v) => (prod.push(p * v), p * v), 1); return { hs, f, prod }; };
    const steps = () => { const c = calc(); return c.f.map((v, i) => ({ say: i === 0 ? "Link from step 2 back to step 1: multiply by w_h, then by the slope of tanh at step 2, which is 1 − h₂²." : `Next link, step ${i + 2} back to step ${i + 1}. Multiply it into the running product.`, math: `factor = ${fmt(wh)} × (1 − ${c.hs[i + 1] < 0 ? `(${fmt(c.hs[i + 1], 4)})` : fmt(c.hs[i + 1], 4)}²) = ${fmt(wh)} × ${fmt(1 - c.hs[i + 1] ** 2, 4)} = ${fmt(v, 4)}\nproduct so far = ${show(c.prod[i])}` })); };
    function draw(k: number) {
      const c = calc(), X = (t: number) => 90 + t * 150;
      let s = txt(30, 22, `How much a nudge at step 1 still matters at step 5 (w_x = ${fmt(wx)}, w_h = ${fmt(wh)})`, `font-size="12" font-weight="700" fill="${INK}"`);
      c.hs.forEach((h, t) => (s += `<circle cx="${X(t)}" cy="80" r="28" fill="${k >= 0 && (t === k + 1 || t === k) ? TINT : "#fff"}" stroke="${INK}"/>` + txt(X(t), 76, `h${t + 1}`, `font-size="10.5" text-anchor="middle" fill="${MUTED}"`) + txt(X(t), 94, fmt(h, 4), `font-size="12.5" font-weight="700" text-anchor="middle" fill="${INK}"`)));
      c.f.forEach((v, i) => { const on = i <= k; s += arrow(X(i + 1) - 32, 80, X(i) + 32, 80, on ? GOLD : "#cfd5d4", on ? 2.5 : 1.2) + txt((X(i) + X(i + 1)) / 2, 66, on ? `× ${fmt(v, 4)}` : "", `font-size="11.5" font-weight="700" text-anchor="middle" fill="${GOLD}"`); });
      // Running product on a log bar from 10^−5 to 10^5.
      const lx = (v: number) => 90 + ((Math.log10(Math.max(1e-5, Math.min(1e5, v))) + 5) / 10) * 600;
      s += `<line x1="90" x2="690" y1="170" y2="170" stroke="#cfd5d4" stroke-width="2"/>`;
      [1e-5, 1e-3, 0.1, 1, 10, 1e3, 1e5].forEach((v) => (s += `<line x1="${lx(v)}" x2="${lx(v)}" y1="164" y2="176" stroke="${v === 1 ? INK : "#cfd5d4"}"/>` + txt(lx(v), 192, v >= 1 ? fmt(v) : `10^${Math.round(Math.log10(v))}`, `font-size="10" text-anchor="middle" fill="${MUTED}"`)));
      const cur = k >= 0 ? c.prod[k] : 1;
      s += `<circle cx="${lx(cur)}" cy="170" r="9" fill="${cur < 1 ? JADE : NEG}" stroke="#fff" stroke-width="2"/>` + txt(90, 150, "running product (log scale): the gradient that reaches step 1", `font-size="11" fill="${MUTED}"`);
      s += txt(90, 226, k >= 0 ? `after ${k + 1} link${k ? "s" : ""}: ${show(cur)}${k === 3 ? (cur < 1 ? ", the gradient has shrunk" : ", the gradient has grown") : ""}` : "", `font-size="13" font-weight="700" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    root.querySelectorAll<HTMLButtonElement>("[data-pre]").forEach((b) => b.addEventListener("click", () => { [wx, wh] = b.dataset.pre!.split(",").map(Number); root.querySelectorAll("[data-pre]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
