<text x="110" y="288" fill="#111111" font-size="17">Decorrelated</text>
<text x="110" y="310" fill="#5f5f66" font-size="14">off-diagonals near zero</text>
<text x="450" y="288" fill="#111111" font-size="17">Redundant</text>
<text x="450" y="310" fill="#5f5f66" font-size="14">features duplicating each other</text>
</svg>
<button type="button" class="fig-replay" data-replay>Replay</button>
</div>
<p class="blog-figure-reading">Diagonal is a feature’s variance; off-diagonal is variation two features share</p>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";

  // Covariance is filled in as it is computed: the diagonal first (each
  // feature's own variance), then each off-diagonal pair (j, k) and (k, j)
  // together, because C is symmetric. Left stays quiet off the diagonal;
  // right lights up wherever features duplicate each other.
  document.querySelectorAll<HTMLElement>("[data-cov]").forEach((root) => {
    const cells = Array.from(root.querySelectorAll<SVGRectElement>("[data-cell]"));
    const at = (side: string, r: number, c: number) => cells.find((e) => e.dataset.cell === side && +e.dataset.r! === r && +e.dataset.c! === c)!;
    const show = (els: SVGRectElement[], s = 0.3) => Promise.all(els.map((e) => animate(e, { opacity: [0.12, 1] }, { duration: dur(s) })));
    setupFigure(
      root,
      () => cells.forEach((e) => (e.style.opacity = "0.12")),
      async (alive) => {
        for (let i = 0; i < 5; i++) {
          await show([at("L", i, i), at("R", i, i)], 0.25);
          if (!alive()) return;
        }
        await wait(0.2);
        for (let j = 0; j < 5; j++) {
          for (let k = j + 1; k < 5; k++) {
            if (!alive()) return;
            show([at("L", j, k), at("L", k, j), at("R", j, k), at("R", k, j)], 0.22);
            await wait(0.09);
          }
        }
      },
    );
  });
</script>
