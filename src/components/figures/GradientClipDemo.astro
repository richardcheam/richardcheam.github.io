---
// Foundations, recurrent networks post: clip by norm. g = (3, 4), c = 1:
// length 5, scale 0.2, clipped (0.6, 0.8). (6, 8) with c = 5: (3, 4).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-clip>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="gc-title" class="blog-diagram-svg" font-family="Inter, sans-serif" style="touch-action: none">
    <title id="gc-title">A gradient arrow shortened onto a circle of chosen radius, keeping its direction</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Threshold c <strong data-vc></strong></span><input class="scrub" data-c type="range" min="0.5" max="10" step="0.5" value="1" /></label>
    <div><span class="fig-panel__name">Presets</span><div class="fig-chips"><button type="button" class="fig-chip" data-pre="3,4,1">(3, 4), c = 1</button><button type="button" class="fig-chip" data-pre="6,8,5">(6, 8), c = 5</button><button type="button" class="fig-chip" data-pre="0.3,0.4,1">(0.3, 0.4), c = 1</button></div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  document.querySelectorAll<HTMLElement>("[data-clip]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let g = [3, 4], c = 1;
    const calc = () => { const L = Math.hypot(...g), sc = Math.min(1, c / L); return { L, sc, out: g.map((v) => v * sc) }; };
    const steps = () => { const k = calc(); return [
      { say: "Measure the gradient's length.", math: `|g| = √(${par(g[0])}² + ${par(g[1])}²) = ${fmt(k.L, 4)}` },
      { say: k.sc < 1 ? "It is longer than the threshold, so scale it down to exactly the threshold." : "It is already within the threshold, so leave it alone.", math: `scale = min(1, ${fmt(c)} / ${fmt(k.L, 4)}) = ${fmt(k.sc, 4)}` },
      { say: "Multiply every number by the scale. The direction does not change.", math: `clipped = (${fmt(g[0])} × ${fmt(k.sc, 4)}, ${fmt(g[1])} × ${fmt(k.sc, 4)}) = (${k.out.map((v) => fmt(v, 4)).join(", ")})` },
    ]; };
    const S = 13, cx = 200, cy = 150;
    function draw(k: number) {
      const r = calc();
      let s = `<line x1="${cx - 135}" x2="${cx + 135}" y1="${cy}" y2="${cy}" stroke="#eef0f0"/><line x1="${cx}" x2="${cx}" y1="${cy - 135}" y2="${cy + 135}" stroke="#eef0f0"/>`;
      s += `<circle cx="${cx}" cy="${cy}" r="${c * S}" fill="${GOLD}" fill-opacity="0.08" stroke="${GOLD}" stroke-dasharray="4 3"/>` + txt(cx + c * S * 0.72 + 4, cy + c * S * 0.72 + 14, `c = ${fmt(c)}`, `font-size="10.5" fill="${GOLD}"`);
      s += arrow(cx, cy, cx + g[0] * S, cy - g[1] * S, NEG, 2.5) + `<circle data-tip cx="${cx + g[0] * S}" cy="${cy - g[1] * S}" r="11" fill="${NEG}" fill-opacity="0.2" style="cursor:grab"/>`;
      if (k >= 2) s += arrow(cx, cy, cx + r.out[0] * S, cy - r.out[1] * S, GOLD, 3.2);
      s += txt(cx - 135, 20, "Drag the red tip. Gold: the clipped gradient.", `font-size="11" fill="${MUTED}"`);
      const rows: [string, string, number][] = [["raw gradient", `(${g.map((v) => fmt(v, 2)).join(", ")})`, -1], ["length", fmt(r.L, 4), 0], ["scale", fmt(r.sc, 4), 1], ["clipped", `(${r.out.map((v) => fmt(v, 4)).join(", ")})`, 2]];
      rows.forEach(([n, v, at], i) => (s += txt(420, 70 + i * 36, n, `font-size="12" fill="${MUTED}"`) + txt(540, 70 + i * 36, k >= at ? v : "…", `font-size="14" font-weight="700" fill="${i === 3 ? GOLD : INK}"`)));
      $("[data-draw]").innerHTML = s;
      $("[data-vc]").textContent = fmt(c);
    }
    const redraw = stepper(root, steps, draw, { delay: 1.6 });
    $<HTMLInputElement>("[data-c]").addEventListener("input", (e) => { c = +(e.target as HTMLInputElement).value; redraw(); });
    root.querySelectorAll<HTMLButtonElement>("[data-pre]").forEach((b) => b.addEventListener("click", () => { const v = b.dataset.pre!.split(",").map(Number); g = v.slice(0, 2); c = v[2]; $<HTMLInputElement>("[data-c]").value = String(c); redraw(); }));
    const svg = root.querySelector("svg")!; let drag = false;
    svg.addEventListener("pointerdown", (e) => { if ((e.target as Element).hasAttribute("data-tip")) { drag = true; svg.setPointerCapture(e.pointerId); } });
    svg.addEventListener("pointermove", (e) => { if (!drag) return; const r = svg.getBoundingClientRect(), px = ((e.clientX - r.left) / r.width) * 760, py = ((e.clientY - r.top) / r.height) * 300; g = [Math.round(((px - cx) / S) * 10) / 10, Math.round(((cy - py) / S) * 10) / 10].map((v) => Math.max(-10, Math.min(10, v))); redraw(); });
    svg.addEventListener("pointerup", () => (drag = false));
  });
</script>
