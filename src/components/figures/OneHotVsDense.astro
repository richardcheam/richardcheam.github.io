---
// Foundations, embeddings post: distances between four words as one-hot
// vectors (every pair √2 = 1.414) and as hand-picked 3-number vectors
// (cat–dog 0.173, cat–car 1.281). Pick two words; steps work the distance.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-onehot>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 270" role="img" aria-labelledby="oh-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="oh-title">Four words as one-hot vectors and as dense vectors, with the distance between two of them</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Compare (pick two)</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-w="0" aria-pressed="true">cat</button>
      <button type="button" class="fig-chip" data-w="1" aria-pressed="true">dog</button>
      <button type="button" class="fig-chip" data-w="2" aria-pressed="false">car</button>
      <button type="button" class="fig-chip" data-w="3" aria-pressed="false">bus</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, GOLD, TINT, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const W = ["cat", "dog", "car", "bus"];
  const ONE = W.map((_, i) => W.map((_, j) => (i === j ? 1 : 0)));
  const DENSE = [[0.9, 0.8, 0.1], [0.8, 0.9, 0.2], [0.1, 0.2, 0.9], [0.2, 0.1, 0.8]];
  const dist = (a: number[], b: number[]) => Math.sqrt(a.reduce((s, x, i) => s + (x - b[i]) ** 2, 0));
  const r = (v: number) => fmt(Math.round(v * 1000) / 1000, 3);
  document.querySelectorAll<HTMLElement>("[data-onehot]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let pick = [0, 1];
    const work = (A: number[][]) => { const a = A[pick[0]], b = A[pick[1]], d = a.map((x, i) => x - b[i]), sq = d.map((x) => x * x), sum = sq.reduce((s, x) => s + x, 0); return { d, sq, sum, dist: Math.sqrt(sum) }; };
    const steps = () => {
      const o = work(ONE), n = work(DENSE), pair = `${W[pick[0]]} − ${W[pick[1]]}`;
      return [
        { say: `Subtract ${pair}, slot by slot, in both encodings.`, math: `one-hot: (${o.d.map(r).join(", ")})\ndense: (${n.d.map(r).join(", ")})` },
        { say: "Square each difference.", math: `one-hot: ${o.sq.map(r).join(", ")}\ndense: ${n.sq.map(r).join(", ")}` },
        { say: "Add the squares.", math: `one-hot: ${o.sq.map(r).join(" + ")} = ${r(o.sum)}\ndense: ${n.sq.map(r).join(" + ")} = ${r(n.sum)}` },
        { say: "Take the square root: the straight-line distance. One-hot gives the same answer for every pair; dense vectors can put related words close.", math: `one-hot: √${r(o.sum)} = ${r(o.dist)}\ndense: √${r(n.sum)} = ${r(n.dist)}` },
      ];
    };
    function table(l: number, title: string, A: number[][], k: number) {
      let s = txt(l, 22, title, `font-size="12" font-weight="700" fill="${INK}"`);
      W.forEach((w, i) => {
        const y = 48 + i * 22, on = pick.includes(i);
        s += txt(l, y, w, `font-size="12" font-weight="${on ? 700 : 400}" fill="${on ? INK : MUTED}"`) + txt(l + 40, y, `(${A[i].map((x) => fmt(x, 1)).join(", ")})`, `font-size="12" fill="${on ? INK : MUTED}"`);
      });
      // Distance grid.
      s += txt(l, 160, "distance between every pair", `font-size="11" fill="${MUTED}"`);
      W.forEach((w, i) => { s += txt(l + 70 + i * 62, 180, w, `font-size="10.5" text-anchor="middle" fill="${MUTED}"`); s += txt(l, 198 + i * 18, w, `font-size="10.5" fill="${MUTED}"`); });
      W.forEach((_, i) => W.forEach((_, j) => {
        const v = dist(A[i], A[j]), hit = (i === pick[0] && j === pick[1]) || (i === pick[1] && j === pick[0]);
        if (hit && k >= 3) s += `<rect x="${l + 46 + j * 62}" y="${186 + i * 18}" width="48" height="16" rx="3" fill="${TINT}"/>`;
        s += txt(l + 70 + j * 62, 198 + i * 18, i === j ? "0" : r(v), `font-size="11" text-anchor="middle" font-weight="${hit ? 700 : 400}" fill="${i === j ? "#B9C0BF" : v < 0.5 ? JADE : INK}"`);
      }));
      return s;
    }
    function draw(k: number) {
      $("[data-draw]").innerHTML = table(30, "One-hot vectors (4 slots)", ONE, k) + table(420, "Dense vectors (3 numbers, chosen by hand)", DENSE, k);
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    root.querySelectorAll<HTMLButtonElement>("[data-w]").forEach((b) => b.addEventListener("click", () => {
      const i = +b.dataset.w!; if (pick.includes(i)) return;
      pick = [pick[1], i];
      root.querySelectorAll<HTMLElement>("[data-w]").forEach((o) => o.setAttribute("aria-pressed", String(pick.includes(+o.dataset.w!))));
      redraw();
    }));
  });
</script>
