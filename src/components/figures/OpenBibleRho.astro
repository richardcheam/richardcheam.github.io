---
// OpenBibleTTS Table 3 (arXiv 2606.09553, p. 7): Spearman rho between each
// automatic metric and native-speaker MOS, per language. WER is lower-is-better,
// so its rho is negated here: right of zero means "agrees with listeners" for
// both metrics. Values are the paper's, to two decimals.
const { alt } = Astro.props;
const rows = [
  ["Haitian Creole", -0.66, 0.94], ["Hausa", -0.71, 0.66], ["Hindi", -0.94, 0.26], ["Oromo", -0.94, -0.61],
  ["Shona", -0.60, -0.03], ["Swahili", -0.77, 0.71], ["Telugu", -0.71, 0.54], ["Turkish", -0.83, 0.26],
  ["Vietnamese", -0.49, 0.89], ["Yoruba", -0.89, -0.09],
] as const;
const X0 = 200, W = 420, Y0 = 60, RH = 25;
const sx = (v: number) => X0 + ((v + 1) / 2) * W;
---
<div class="blog-diagram ob" tabindex="0" role="region" aria-label={alt} data-ob>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 350" role="img" aria-labelledby="ob-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ob-title">Agreement of WER and UTMOSv2 with native MOS in ten languages</title>
    <rect x={sx(0.7)} y={Y0 - 14} width={sx(1) - sx(0.7)} height={rows.length * RH + 8} fill="#4F5D3A" fill-opacity="0.07" />
    <rect x={sx(-1)} y={Y0 - 14} width={sx(0) - sx(-1)} height={rows.length * RH + 8} fill="#a33b3b" fill-opacity="0.05" />
    <g stroke="#ececf1">{[-1, -0.5, 0, 0.5, 1].map((v) => <line x1={sx(v)} x2={sx(v)} y1={Y0 - 14} y2={Y0 + rows.length * RH - 6} />)}</g>
    <line x1={sx(0)} x2={sx(0)} y1={Y0 - 14} y2={Y0 + rows.length * RH - 6} stroke="#2b2b30" />
    <line x1={sx(0.7)} x2={sx(0.7)} y1={Y0 - 14} y2={Y0 + rows.length * RH - 6} stroke="#4F5D3A" stroke-dasharray="4 3" />
    <text x={sx(0.85)} y={Y0 - 22} font-size="10" text-anchor="middle" fill="#4F5D3A">strong, ≥ 0.7</text>
    <text x={sx(-0.5)} y={Y0 - 22} font-size="10" text-anchor="middle" fill="#a33b3b">points the wrong way</text>
    <g font-size="9.5" fill="#5f5f66" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">{[-1, -0.5, 0, 0.5, 1].map((v) => <text x={sx(v)} y={Y0 + rows.length * RH + 10} text-anchor="middle">{v}</text>)}</g>
    <text x={sx(0)} y={Y0 + rows.length * RH + 28} font-size="10.5" text-anchor="middle" fill="#2b2b30">agreement with native MOS (Spearman ρ; WER sign flipped)</text>
    {rows.map(([lang, w, u], i) => (
      <g data-row transform={`translate(0 ${Y0 + i * RH})`}>
        <text x={X0 - 14} y="4" font-size="11.5" text-anchor="end" fill="#2b2b30">{lang}</text>
        <line x1={sx(-w)} x2={sx(u)} y1="0" y2="0" stroke="#d6d6dd" />
        <circle data-dot cx={sx(-w)} r="5.5" fill="#2b2b30" />
        <circle data-dot cx={sx(u)} r="5.5" fill={u < 0 ? "#a33b3b" : "#594578"} />
      </g>
    ))}
    <g transform="translate(650 70)">
      <circle r="5.5" fill="#2b2b30" /><text x="12" y="4" font-size="11" fill="#2b2b30">WER</text>
      <circle cy="24" r="5.5" fill="#594578" /><text x="12" y="28" font-size="11" fill="#594578">UTMOSv2</text>
      <text y="66" font-size="10.5" fill="#5f5f66">strong agreement:</text>
      <text y="84" font-size="11" fill="#2b2b30">WER  7 of 10</text>
      <text y="100" font-size="11" fill="#594578">UTMOSv2  3 of 10</text>
    </g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<style>
  [data-dot] { transform-box: fill-box; transform-origin: center; }
</style>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";

  document.querySelectorAll<HTMLElement>("[data-ob]").forEach((root) => {
    const rows = Array.from(root.querySelectorAll<SVGGElement>("[data-row]"));
    setupFigure(root, () => rows.forEach((r) => (r.style.opacity = "0")), async (alive) => {
      for (const r of rows) {
        if (!alive()) return;
        animate(r, { opacity: [0, 1] }, { duration: dur(0.3) });
        r.querySelectorAll("[data-dot]").forEach((d) => animate(d, { scale: [0, 1] }, { duration: dur(0.35) }));
        await wait(0.16);
      }
    });
  });
</script>
