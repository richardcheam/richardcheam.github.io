---
// Foundations, language models post: the chain rule on "the cat sat" with
// P(the) 0.2, P(cat | the) 0.1, P(sat | the cat) 0.5: product 0.01.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-chain>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 220" role="img" aria-labelledby="ch-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ch-title">A sentence scored as a chain of next-word probabilities</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">P(the) <strong data-v="0"></strong></span><input class="scrub" data-i="0" type="range" min="0.01" max="1" step="0.01" value="0.2" /></label>
    <label><span class="fig-panel__name">P(cat | the) <strong data-v="1"></strong></span><input class="scrub" data-i="1" type="range" min="0.01" max="1" step="0.01" value="0.1" /></label>
    <label><span class="fig-panel__name">P(sat | the cat) <strong data-v="2"></strong></span><input class="scrub" data-i="2" type="range" min="0.01" max="1" step="0.01" value="0.5" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const W = ["the", "cat", "sat"], LBL = ["P(the)", "P(cat | the)", "P(sat | the cat)"];
  document.querySelectorAll<HTMLElement>("[data-chain]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p = [0.2, 0.1, 0.5];
    const prods = () => { const out: number[] = []; p.reduce((a, v) => (out.push(a * v), a * v), 1); return out; };
    const steps = () => { const pr = prods(); return [
      ...W.map((w, i) => ({ say: i === 0 ? "Start with the chance of the first word." : `Multiply by the chance of "${w}" given everything before it.`, math: `${LBL[i]} = ${fmt(p[i])};  product = ${fmt(i ? pr[i - 1] : 1, 4)} × ${fmt(p[i])} = ${fmt(pr[i], 4)}` })),
      { say: "The same thing with logarithms: the product of probabilities becomes a sum of logs, which avoids tiny numbers.", math: `${p.map((v) => `ln ${fmt(v)}`).join(" + ")} = ${p.map((v, i) => (i ? `− ${fmt(-Math.log(v), 3)}` : fmt(Math.log(v), 3))).join(" ")} = ${fmt(p.reduce((a, v) => a + Math.log(v), 0), 3)};  e^that = ${fmt(pr[2], 4)}` },
    ]; };
    function draw(k: number) {
      const pr = prods();
      let s = "";
      W.forEach((w, i) => {
        const x = 70 + i * 200, on = i === k, ctx = k >= 0 && i < k && k < 3;
        s += `<rect x="${x}" y="30" width="140" height="44" rx="8" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : ctx ? GOLD : INK}" stroke-width="${on || ctx ? 2.5 : 1.2}"/>` + txt(x + 70, 58, w, `font-size="16" font-weight="700" text-anchor="middle" fill="${INK}"`);
        s += `<rect x="${x}" y="90" width="140" height="14" fill="#eef0f0"/><rect x="${x}" y="90" width="${140 * p[i]}" height="14" fill="${JADE}" fill-opacity="${k >= i ? 0.85 : 0.25}"/>` + txt(x + 70, 124, `${LBL[i]} = ${fmt(p[i])}`, `font-size="11.5" text-anchor="middle" fill="${MUTED}"`);
      });
      s += txt(70, 170, "running product:", `font-size="12" fill="${MUTED}"`) + txt(70, 196, ["1", ...pr.map((v) => fmt(v, 4))].slice(0, Math.min(k, 2) + 2).join("  →  "), `font-size="16" font-weight="700" fill="${GOLD}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[+el.dataset.v!], 2)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    root.querySelectorAll<HTMLInputElement>("[data-i]").forEach((inp) => inp.addEventListener("input", () => { p[+inp.dataset.i!] = +inp.value; redraw(); }));
  });
</script>
