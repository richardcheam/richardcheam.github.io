---
// Foundations, embeddings post: skip-gram with negative sampling trained live
// on eight words (seed 42, η 0.1, 2 negatives, 2-D vectors). The first pair
// (cat, milk) with negatives ball and fuel gives g = −0.4857, 0.5084,
// 0.5069. cos(cat, dog) 0.605 → 0.999 and cos(cat, car) 0.922 → 0.091 by
// epoch 50. Training code in src/lib/skipgram.ts.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-skipgram>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 330" role="img" aria-labelledby="sg-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="sg-title">Eight word vectors moving as skip-gram training pulls neighbours together and pushes random words apart</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Training</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-one>Step one pair</button>
      <button type="button" class="fig-chip" data-epoch>Run one epoch</button>
      <button type="button" class="fig-chip" data-play>Play</button>
      <button type="button" class="fig-chip" data-reset>Start over</button>
    </div></div>
    <label><span class="fig-panel__name">Learning rate η <strong data-ve></strong></span><input class="scrub" data-eta type="range" min="0.02" max="0.5" step="0.02" value="0.1" /></label>
    <div><span class="fig-panel__name">Negatives per pair</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-k="1" aria-pressed="false">1</button>
      <button type="button" class="fig-chip" data-k="2" aria-pressed="true">2</button>
      <button type="button" class="fig-chip" data-k="4" aria-pressed="false">4</button>
    </div></div>
  </div>
</div>

<script>
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, NEG, GOLD } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { makeModel, VOCAB, cos, type PairLog } from "../../lib/skipgram";
  import { reduce } from "../../lib/figure-motion";
  const MAX = 300, ANIMAL = new Set([0, 1, 2, 3]);
  document.querySelectorAll<HTMLElement>("[data-skipgram]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let eta = 0.1, k = 2, m = makeModel(42, eta, k), last: PairLog | null = null, playing = false, raf = 0, hist: number[][] = [];
    let scale = 1;
    const snap = () => [cos(m.v[0], m.v[1]), cos(m.v[0], m.v[4]), cos(m.v[4], m.v[5])];
    const reset = () => { m = makeModel(42, eta, k); last = null; hist = [snap()]; scale = 1; draw(); };
    const steps = (n: number) => { for (let i = 0; i < n && m.epoch < MAX; i++) { const before = m.epoch; last = m.step(); if (m.epoch > before) hist.push(snap()); } };
    function draw() {
      // Smoothly widen the view as the vectors grow.
      const ext = Math.max(0.6, ...m.v.flat().map(Math.abs)) * 1.15; scale += (ext - scale) * 0.2; if (scale < ext) scale = Math.max(scale, ext * 0.95);
      const cx = 170, cy = 170, R = 140, X = (v: number) => cx + (v / scale) * R, Y = (v: number) => cy - (v / scale) * R;
      let s = `<rect x="${cx - R}" y="${cy - R}" width="${2 * R}" height="${2 * R}" fill="none" stroke="#eef0f0"/><line x1="${cx - R}" x2="${cx + R}" y1="${cy}" y2="${cy}" stroke="#e3e7e6"/><line x1="${cx}" x2="${cx}" y1="${cy - R}" y2="${cy + R}" stroke="#e3e7e6"/>`;
      s += txt(30, 18, `Word vectors after epoch ${m.epoch}, pair ${m.pair} of 16`, `font-size="12" font-weight="700" fill="${INK}"`);
      if (last) {
        const w = m.v[last.w];
        last.rows.forEach((r) => { const t = m.u[r.t]; s += `<line x1="${X(w[0])}" y1="${Y(w[1])}" x2="${X(t[0])}" y2="${Y(t[1])}" stroke="${r.label ? JADE : NEG}" stroke-width="1.5" stroke-dasharray="${r.label ? "" : "4 3"}"/><circle cx="${X(t[0])}" cy="${Y(t[1])}" r="5" fill="none" stroke="${r.label ? JADE : NEG}" stroke-width="1.5"/>`; });
      }
      m.v.forEach((p, i) => (s += `<circle cx="${X(p[0])}" cy="${Y(p[1])}" r="6" fill="${ANIMAL.has(i) ? "#C9637F" : "#3E6E9E"}"/>` + txt(X(p[0]) + 8, Y(p[1]) - 6, VOCAB[i], `font-size="11.5" font-weight="${last && i === last.w ? 700 : 400}" fill="${INK}"`)));
      s += txt(30, 326, "filled: word vectors; hollow: the context vectors used in the last pair", `font-size="10.5" fill="${MUTED}"`);
      // The last pair's arithmetic.
      s += txt(350, 18, last ? `Last pair: ${VOCAB[last.w]} next to ${VOCAB[last.c]}` : "Press Step one pair, or Play.", `font-size="12" font-weight="700" fill="${INK}"`);
      last?.rows.forEach((r, i) => {
        const y = 42 + i * 20;
        s += txt(350, y, `${r.label ? "true " : "random"} ${VOCAB[r.t]}: v·u = ${fmt(r.d, 4)}, p = ${fmt(r.p, 4)}, g = ${fmt(r.g, 4)}`, `font-size="11.5" fill="${r.label ? JADE : NEG}"`);
      });
      // Cosine history.
      const lx = (e: number) => 350 + (e / MAX) * 380, ly = (v: number) => 290 - ((v + 1) / 2) * 150;
      s += txt(350, 132, "cosine similarity over epochs", `font-size="11.5" font-weight="700" fill="${INK}"`);
      [-1, 0, 1].forEach((v) => (s += `<line x1="350" x2="730" y1="${ly(v)}" y2="${ly(v)}" stroke="#eef0f0"/>` + txt(344, ly(v) + 4, String(v), `font-size="10" text-anchor="end" fill="${MUTED}"`)));
      const names = ["cat, dog", "cat, car", "car, bus"], cols = ["#C9637F", GOLD, "#3E6E9E"];
      [0, 1, 2].forEach((j) => {
        s += `<polyline fill="none" stroke="${cols[j]}" stroke-width="2" points="${hist.map((h, e) => `${lx(e).toFixed(1)},${ly(h[j]).toFixed(1)}`).join(" ")}"/>`;
        s += txt(350 + j * 128, 316, `${names[j]}: ${fmt(hist[hist.length - 1][j], 3)}`, `font-size="11.5" font-weight="700" fill="${cols[j]}"`);
      });
      $("[data-draw]").innerHTML = s;
      $("[data-ve]").textContent = fmt(eta, 2);
      $("[data-play]").textContent = playing ? "Pause" : m.epoch >= MAX ? "Finished" : "Play";
    }
    const loop = () => { steps(16); draw(); if (playing && m.epoch < MAX) raf = requestAnimationFrame(loop); else { playing = false; draw(); } };
    const play = (on: boolean) => { playing = on && m.epoch < MAX; cancelAnimationFrame(raf); if (playing) raf = requestAnimationFrame(loop); draw(); };
    $("[data-play]").addEventListener("click", () => play(!playing));
    $("[data-one]").addEventListener("click", () => { play(false); steps(1); draw(); });
    $("[data-epoch]").addEventListener("click", () => { play(false); steps(16 - m.pair); draw(); });
    $("[data-reset]").addEventListener("click", () => { play(false); reset(); });
    $<HTMLInputElement>("[data-eta]").addEventListener("input", (e) => { eta = +(e.target as HTMLInputElement).value; play(false); reset(); });
    root.querySelectorAll<HTMLButtonElement>("[data-k]").forEach((b) => b.addEventListener("click", () => { k = +b.dataset.k!; root.querySelectorAll("[data-k]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); play(false); reset(); }));
    reset();
    if (reduce) { steps(MAX * 16); draw(); }
  });
</script>
