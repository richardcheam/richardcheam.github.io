---
// Figure 4: Theorem 2 as a dice game. Two-point data {-2, +2}, OT path,
// sigma_min = 0, t = 0.5, x = 0. Conditional targets are +4 and -4, the
// marginal target is 0. For network output v: FM loss v^2, CFM loss
// ((v-4)^2 + (v+4)^2) / 2 = v^2 + 16; both gradients equal 2v on average.
const { alt } = Astro.props;
---
<div class="blog-diagram cg" role="region" aria-label={alt} data-cg>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 380" role="img" aria-labelledby="cg-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="cg-title">Per-example gradients averaging out to the flow matching gradient</title>
    <text x="40" y="24" font-size="11.5" font-weight="700" fill="#2b2b30">Each lesson: pick one data point, grade the network against that point's velocity</text>
    <text data-last x="40" y="48" font-size="12.5" fill="#2b2b30"></text>
    <line x1="40" x2="740" y1="200" y2="200" stroke="#2b2b30" />
    <g data-ticks></g>
    <g data-dots></g>
    <line data-fm x1="0" x2="0" y1="70" y2="214" stroke="#4F5D3A" stroke-width="2.5" />
    <text data-fmt y="66" font-size="11" font-weight="700" text-anchor="middle" fill="#4F5D3A"></text>
    <path data-mean d="" fill="#a33b3b" />
    <text data-meant y="240" font-size="11" font-weight="700" text-anchor="middle" fill="#a33b3b"></text>
    <text x="740" y="256" font-size="10.5" text-anchor="end" fill="#5f5f66">gradient of one lesson's loss</text>
    <text x="40" y="290" font-size="11.5" font-weight="700" fill="#2b2b30">Loss at this spot</text>
    <rect x="160" y="300" height="16" fill="#4F5D3A" data-bfm />
    <rect x="160" y="326" height="16" fill="#a33b3b" fill-opacity="0.75" data-bcfm />
    <text x="40" y="313" font-size="11.5" fill="#2b2b30">FM (true target)</text>
    <text x="40" y="339" font-size="11.5" fill="#2b2b30">CFM (one example)</text>
    <text data-tfm y="313" font-size="11.5" font-weight="700" fill="#2b2b30"></text>
    <text data-tcfm y="339" font-size="11.5" font-weight="700" fill="#2b2b30"></text>
    <text data-gap x="40" y="368" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Network output v<strong data-vv></strong></span><input class="scrub" data-v type="range" min="-5" max="5" step="0.5" value="1" /></label>
    <div><span class="fig-panel__name">Lessons</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-one>1 lesson</button>
      <button type="button" class="fig-chip" data-hundred>100 lessons</button>
      <button type="button" class="fig-chip" data-reset>Reset</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait, reduce } from "../../lib/figure-motion";
  import { rng } from "../../lib/flow-math";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-cg]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const vIn = $<HTMLInputElement>("[data-v]");
    const G = (g: number) => 390 + g * 17;
    for (let g = -20; g <= 20; g += 5) {
      const l = document.createElementNS(NS, "text"); l.setAttribute("x", String(G(g))); l.setAttribute("y", "216"); l.setAttribute("font-size", "10.5"); l.setAttribute("text-anchor", "middle"); l.setAttribute("fill", "#2b2b30"); l.textContent = String(g); $("[data-ticks]").append(l);
    }
    let draws: number[] = [], r = rng(3);
    const v = () => +vIn.value;
    function draw() {
      const vv = v(), gp = 2 * (vv - 4), gn = 2 * (vv + 4), fm = 2 * vv;
      const g = $("[data-dots]"); g.replaceChildren();
      let np = 0, nn = 0;
      draws.forEach((u) => {
        const k = u > 0 ? np++ : nn++, c = document.createElementNS(NS, "circle");
        c.setAttribute("cx", String(G(u > 0 ? gp : gn) + ((k % 6) - 2.5) * 7)); c.setAttribute("cy", String(192 - Math.floor(k / 6) * 7)); c.setAttribute("r", "3");
        c.setAttribute("fill", u > 0 ? "#4F5D3A" : "#594578"); c.setAttribute("fill-opacity", "0.8"); g.append(c);
      });
      const f = $("[data-fm]"); f.setAttribute("x1", String(G(fm))); f.setAttribute("x2", String(G(fm)));
      const ft = $("[data-fmt]"); ft.setAttribute("x", String(G(fm))); ft.textContent = `FM gradient 2v = ${fm.toFixed(1)}`;
      const mean = draws.length ? draws.reduce((s, u) => s + 2 * (vv - u), 0) / draws.length : NaN;
      const mp = $("[data-mean]"), mt = $("[data-meant]");
      if (draws.length) { mp.setAttribute("d", `M${G(mean)} 203 l-7 12 h14 z`); mt.setAttribute("x", String(G(mean))); mt.textContent = `average of ${draws.length}: ${mean.toFixed(2)}`; }
      else { mp.setAttribute("d", ""); mt.textContent = ""; }
      const last = draws[draws.length - 1];
      $("[data-last]").textContent = last === undefined ? "Press “1 lesson”. Green dots: the drawn point was +2 (target +4). Purple: −2 (target −4)."
        : `Last lesson drew ${last > 0 ? "+2" : "−2"}: target ${last > 0 ? "+4" : "−4"}, gradient 2 × (${vv} − (${last})) = ${(2 * (vv - last)).toFixed(1)}`;
      const lf = vv * vv, lc = ((vv - 4) ** 2 + (vv + 4) ** 2) / 2, sc = 10;
      $("[data-bfm]").setAttribute("width", String(lf * sc)); $("[data-bcfm]").setAttribute("width", String(lc * sc));
      const tf = $("[data-tfm]"); tf.setAttribute("x", String(166 + lf * sc)); tf.textContent = lf.toFixed(2);
      const tc = $("[data-tcfm]"); tc.setAttribute("x", String(166 + lc * sc)); tc.textContent = lc.toFixed(2);
      $("[data-gap]").textContent = `The gap is ${(lc - lf).toFixed(0)} for every v: it never changes which way to step.`;
      $("[data-vv]").textContent = vv.toFixed(1);
      vIn.style.setProperty("--p", `${((vv + 5) / 10) * 100}%`);
    }
    const one = () => { draws.push(r() < 0.5 ? 4 : -4); if (draws.length > 200) draws.shift(); draw(); };
    let token = 0;
    const many = async (n: number, my: number) => { for (let i = 0; i < n; i++) { if (my !== token) return; one(); await wait(0.02); } };
    $("[data-one]").addEventListener("click", () => { token++; one(); });
    $("[data-hundred]").addEventListener("click", () => { many(100, ++token); });
    $("[data-reset]").addEventListener("click", () => { token++; draws = []; r = rng(3); draw(); });
    vIn.addEventListener("input", draw);
    if (reduce) for (let i = 0; i < 60; i++) one();
    draw();
    setupFigure(root, () => { token++; draws = []; r = rng(3); draw(); }, async (alive) => {
      for (let i = 0; i < 60; i++) { if (!alive()) return; one(); await wait(0.05); }
    });
  });
</script>
