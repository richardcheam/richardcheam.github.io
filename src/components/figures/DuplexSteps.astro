---
// Moshi's token layout over time (schematic): one column per 80 ms step, three
// rows (user audio, Moshi's inner-monologue text, Moshi's audio). Moshi's audio
// trails its text by one step (the acoustic delay). When the user talks over
// Moshi, its audio row turns to silence within two steps; no turn token exists.
const { alt } = Astro.props;
const STEPS = 20, X0 = 116, W = 32;
const userE = [0.6, 0.8, 0.7, 0.9, 0.5, 0, 0, 0, 0, 0, 0, 0, 0.7, 0.9, 0.8, 0.6, 0, 0, 0, 0];
const text = ["·", "·", "·", "·", "·", "·", "The", "train", "leaves", "at", "nine", ",", "and", "·", "·", "·", "·", "Sure", "·", "·"];
const moshiE = [0, 0, 0, 0, 0, 0, 0, 0.6, 0.8, 0.7, 0.9, 0.6, 0.5, 0.3, 0, 0, 0, 0, 0.7, 0.6];
const cx = (i: number) => X0 + i * W;
---
<div class="blog-diagram" tabindex="0" role="region" aria-label={alt} data-ds>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 262" role="img" aria-labelledby="ds-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ds-title">Moshi's parallel streams over time</title>
    <rect data-read x={X0 - 4} y="34" width="0" height="182" rx="6" fill="#594578" fill-opacity="0.05" />
    <g font-size="11.5" fill="#2b2b30">
      <text x="16" y="72">your audio</text>
      <text x="16" y="132">Moshi text</text>
      <text x="16" y="186">Moshi audio</text>
    </g>
    <g font-size="9.5" fill="#5f5f66"><text x="16" y="84">from the mic</text><text x="16" y="144">inner monologue</text><text x="16" y="198">to the speaker</text></g>
    {Array.from({ length: STEPS }, (_, i) => (
      <g data-col={i}>
        <rect x={cx(i)} y={76 - Math.max(userE[i], 0.04) * 36} width={W - 6} height={Math.max(userE[i], 0.04) * 36} rx="2" fill="#5f5f66" fill-opacity={userE[i] ? 0.55 : 0.2} />
        <text x={cx(i) + (W - 6) / 2} y="134" font-size={text[i].length > 4 ? 9.5 : 11} text-anchor="middle" fill={text[i] === "·" ? "#b5b5bd" : "#594578"} font-weight={text[i] === "·" ? 400 : 600}>{text[i]}</text>
        <rect x={cx(i)} y={190 - Math.max(moshiE[i], 0.04) * 36} width={W - 6} height={Math.max(moshiE[i], 0.04) * 36} rx="2" fill="#594578" fill-opacity={moshiE[i] ? 0.75 : 0.2} />
      </g>
    ))}
    <line x1={X0} y1="226" x2={cx(STEPS) - 6} y2="226" stroke="#d5d5dc" />
    <g font-size="9.5" fill="#5f5f66" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
      {[0, 5, 10, 15, 20].map((s) => <text x={cx(s)} y="240" text-anchor={s === 20 ? "end" : "start"}>{s * 80} ms</text>)}
    </g>
    <rect data-cursor x={cx(STEPS - 1) - 3} y="36" width={W} height="178" rx="5" fill="none" stroke="#2b2b30" stroke-width="1.2" />
    <g data-notes font-size="10.5">
      <text data-note="7" x={cx(7) - 2} y="28" fill="#594578">audio trails its text by one step</text>
      <text data-note="12" x={cx(12) - 2} y="14" fill="#a33b3b">you talk over Moshi</text>
      <text data-note="14" x={cx(13) - 2} y="256" fill="#a33b3b">silent within two steps, no turn token</text>
    </g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";

  // The cursor advances one 80 ms step at a time. At each step the model has
  // read every earlier column (shaded) and fills the current one.
  const STEPS = 20, X0 = 116, W = 32;
  document.querySelectorAll<HTMLElement>("[data-ds]").forEach((root) => {
    const cols = Array.from({ length: STEPS }, (_, i) => root.querySelector<SVGGElement>(`[data-col="${i}"]`)!);
    const cursor = root.querySelector<SVGRectElement>("[data-cursor]")!;
    const read = root.querySelector<SVGRectElement>("[data-read]")!;
    const notes = Array.from(root.querySelectorAll<SVGTextElement>("[data-note]"));
    setupFigure(
      root,
      () => {
        cols.forEach((c) => (c.style.opacity = "0"));
        notes.forEach((n) => (n.style.opacity = "0"));
        cursor.style.transform = `translateX(${-(STEPS - 1) * W}px)`;
        read.setAttribute("width", "0");
      },
      async (alive) => {
        for (let i = 0; i < STEPS; i++) {
          if (!alive()) return;
          cursor.style.transform = `translateX(${(i - (STEPS - 1)) * W}px)`;
          read.setAttribute("width", String(i * W));
          animate(cols[i], { opacity: [0, 1], transform: ["translateY(4px)", "translateY(0px)"] }, { duration: dur(0.22) });
          const note = notes.find((n) => +n.dataset.note! === i);
          if (note) animate(note, { opacity: [0, 1] }, { duration: dur(0.3) });
          await wait(i >= 6 && i <= 15 ? 0.42 : 0.24);
        }
        read.setAttribute("width", String(STEPS * W));
      },
    );
  });
</script>
