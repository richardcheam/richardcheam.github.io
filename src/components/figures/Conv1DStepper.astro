---
// Foundations, convolutions post: a 3-tap kernel sliding along six inputs.
// x = (1, 2, 0, 3, 1, 2), w = (1, 0, −1): y = 1, −1, −1, 1. Flipping the
// kernel (true convolution) gives −1, 1, 1, −1.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-conv1>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 230" role="img" aria-labelledby="c1-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="c1-title">A three-number kernel sliding along a six-number signal, one output per position</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Input x (click a cell to change it)</span><div class="fig-chips" data-xs></div></div>
    <div><span class="fig-panel__name">Kernel w</span><div class="fig-chips" data-ws></div></div>
    <div><span class="fig-panel__name">Mode</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-flip="0" aria-pressed="true">Deep learning (no flip)</button>
      <button type="button" class="fig-chip" data-flip="1" aria-pressed="false">True convolution (flip)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { conv1d, clean } from "../../lib/conv";
  document.querySelectorAll<HTMLElement>("[data-conv1]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const x = [1, 2, 0, 3, 1, 2], w0 = [1, 0, -1];
    let flip = false;
    const w = () => (flip ? [...w0].reverse() : w0);
    const res = () => conv1d(x, w());
    const steps = () => res().out.map((y, n) => ({
      say: n === 0 ? `Lay the kernel under the first three inputs, multiply the pairs that line up, and add.${flip ? " The kernel is flipped first, as mathematicians define convolution." : ""}` : "Slide the kernel one position and repeat.",
      math: `y[${n}] = ${w().map((v, j) => `${par(v)} × ${par(x[n + j])}`).join(" + ")} = ${fmt(clean(y))}`,
    }));
    function draw(k: number) {
      const r = res(), cx = (i: number) => 90 + i * 84;
      let s = txt(30, 50, "input x", `font-size="11.5" fill="${MUTED}"`) + txt(30, 120, flip ? "flipped kernel" : "kernel w", `font-size="11.5" fill="${MUTED}"`) + txt(30, 190, "output y", `font-size="11.5" fill="${MUTED}"`);
      x.forEach((v, i) => {
        const on = k >= 0 && i >= k && i < k + 3;
        s += `<rect x="${cx(i) + 30}" y="28" width="64" height="36" rx="5" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : "#cfd5d4"}" stroke-width="${on ? 2.5 : 1}"/>` + txt(cx(i) + 62, 52, fmt(v), `font-size="15" font-weight="700" text-anchor="middle" fill="${INK}"`) + txt(cx(i) + 62, 20, `x[${i}]`, `font-size="10" text-anchor="middle" fill="${MUTED}"`);
      });
      const off = Math.max(0, k);
      w().forEach((v, j) => {
        const i = off + j;
        s += `<line x1="${cx(i) + 62}" y1="64" x2="${cx(i) + 62}" y2="98" stroke="${GOLD}" stroke-dasharray="3 3" stroke-opacity="${k >= 0 ? 1 : 0.3}"/>`;
        s += `<rect x="${cx(i) + 38}" y="98" width="48" height="34" rx="5" fill="#FBF3E0" stroke="${GOLD}" stroke-width="2"/>` + txt(cx(i) + 62, 121, fmt(v), `font-size="14" font-weight="700" text-anchor="middle" fill="${v < 0 ? NEG : INK}"`);
        if (k >= 0) s += txt(cx(i) + 62, 152, `${fmt(v * x[i])}`, `font-size="11" text-anchor="middle" fill="${GOLD}"`);
      });
      r.out.forEach((y, n) => {
        const done = n <= k, now = n === k;
        s += `<rect x="${cx(n + 1) + 30}" y="168" width="64" height="36" rx="5" fill="${now ? TINT : "#fff"}" stroke="${now ? JADE : "#cfd5d4"}" stroke-width="${now ? 2.5 : 1}"/>` + txt(cx(n + 1) + 62, 192, done ? fmt(clean(y)) : "?", `font-size="15" font-weight="700" text-anchor="middle" fill="${done ? INK : "#B9C0BF"}"`);
      });
      s += txt(30, 224, `${x.length} inputs, kernel of 3: ${x.length} − 3 + 1 = ${r.out.length} positions where the kernel fits.`, `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-xs]").innerHTML = x.map((v, i) => `<button type="button" class="fig-chip" data-xi="${i}">${fmt(v)}</button>`).join("");
      $("[data-ws]").innerHTML = w0.map((v, i) => `<button type="button" class="fig-chip" data-wi="${i}">${fmt(v)}</button>`).join("");
    }
    const redraw = stepper(root, steps, draw, { delay: 1.6 });
    // Clicking a cell cycles its value: inputs from −3 to 5, weights from −1 to 1 in halves.
    root.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.dataset.xi) { const i = +t.dataset.xi; x[i] = x[i] >= 5 ? -3 : x[i] + 1; redraw(); }
      if (t.dataset.wi) { const i = +t.dataset.wi; w0[i] = w0[i] >= 1 ? -1 : w0[i] + 0.5; redraw(); }
    });
    root.querySelectorAll<HTMLButtonElement>("[data-flip]").forEach((b) => b.addEventListener("click", () => { flip = b.dataset.flip === "1"; root.querySelectorAll("[data-flip]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
