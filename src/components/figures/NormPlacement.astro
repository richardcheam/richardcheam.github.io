---
// Foundations, normalisation post: where the norm sits in a residual block.
// Post-norm: x → sublayer → add → norm. Pre-norm: the branch is normalised
// before the sublayer, and the main path is never touched. Diagram only.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-place>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="np-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="np-title">Post-norm and pre-norm residual blocks with a dot passing through each operation</title>
    <g data-draw></g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { INK, MUTED, JADE, GOLD, TINT, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  // Box positions for each block: [label, x, y]; the dot visits them in order.
  const POST: [string, number, number][] = [["input x", 190, 268], ["sublayer", 260, 190], ["add: x + sublayer(x)", 190, 120], ["norm", 190, 50]];
  const PRE: [string, number, number][] = [["input x", 570, 268], ["norm", 640, 205], ["sublayer", 640, 145], ["add: x + sublayer(norm(x))", 570, 70]];
  const SAY = [
    ["The same input arrives at both blocks.", ""],
    ["Post-norm: the sublayer reads the raw input.", "Pre-norm: only the branch is normalised before the sublayer reads it."],
    ["The sublayer's output is added back to the input.", "The sublayer runs on normalised numbers."],
    ["Then everything, main path included, is normalised. Every block rescales the highway.", "Its output is added to the untouched input. The main path is a clean chain of additions, which keeps gradients well behaved."],
  ];
  document.querySelectorAll<HTMLElement>("[data-place]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const steps = () => SAY.map(([a, b]) => ({ say: b ? `${a} ${b}` : a }));
    const box = ([label, x, y]: [string, number, number], on: boolean, wide = false) => {
      const w = wide ? 210 : 120;
      return `<rect x="${x - w / 2}" y="${y - 16}" width="${w}" height="32" rx="7" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : INK}" stroke-width="${on ? 2.5 : 1.3}"/>` + txt(x, y + 5, label, `font-size="12" text-anchor="middle" font-weight="${on ? 700 : 400}" fill="${label === "norm" ? GOLD : INK}"`);
    };
    function draw(k: number) {
      let s = txt(190, 20, "Post-norm (original Transformer)", `font-size="12.5" font-weight="700" text-anchor="middle" fill="${INK}"`) + txt(570, 20, "Pre-norm (most modern models)", `font-size="12.5" font-weight="700" text-anchor="middle" fill="${INK}"`);
      // Post-norm wiring: main path straight up, branch out to the sublayer and back.
      s += arrow(190, 252, 190, 138, MUTED, 1.5) + `<path d="M190 236 H260 V206" fill="none" stroke="${MUTED}" stroke-width="1.5"/>` + arrow(260, 174, 214, 132, MUTED, 1.5) + arrow(190, 104, 190, 68, MUTED, 1.5);
      // Pre-norm wiring.
      s += arrow(570, 252, 570, 88, NEG, 2) + `<path d="M570 236 H640 V221" fill="none" stroke="${MUTED}" stroke-width="1.5"/>` + arrow(640, 189, 640, 163, MUTED, 1.5) + arrow(640, 129, 594, 82, MUTED, 1.5);
      s += txt(520, 170, "main path", `font-size="10.5" fill="${NEG}" text-anchor="end"`) + txt(520, 184, "never normalised", `font-size="10.5" fill="${NEG}" text-anchor="end"`);
      POST.forEach((b, i) => (s += box(b, i === k, i === 2)));
      PRE.forEach((b, i) => (s += box(b, i === k, i === 3)));
      if (k >= 0) { const a = POST[k], b = PRE[k]; s += `<circle cx="${a[1] - (k === 2 ? 115 : 70)}" cy="${a[2]}" r="7" fill="${GOLD}"/><circle cx="${b[1] - (k === 3 ? 115 : 70)}" cy="${b[2]}" r="7" fill="${GOLD}"/>`; }
      s += txt(380, 296, "A pre-norm stack adds one final norm before the output, since nothing else normalises the main path.", `font-size="11" text-anchor="middle" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2.2 });
  });
</script>
