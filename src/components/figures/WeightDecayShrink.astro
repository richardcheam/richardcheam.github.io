---
// Foundations, regularisation post: one weight-decay step split into a
// shrink and a gradient step. Defaults w = 2, gradient 0.5, η = 0.1,
// λ = 0.1: shrink to 1.98, step to 1.93, against 1.95 without decay. Ten
// steps with gradient 0 from 2 give 1.809.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-decay>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 180" role="img" aria-labelledby="wd-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="wd-title">A weight on a number line: first shrunk towards zero, then moved by its gradient</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Weight w <strong data-v="w"></strong></span><input class="scrub" data-k="w" type="range" min="-3" max="3" step="0.1" value="2" /></label>
    <label><span class="fig-panel__name">Data gradient <strong data-v="g"></strong></span><input class="scrub" data-k="g" type="range" min="-2" max="2" step="0.1" value="0.5" /></label>
    <label><span class="fig-panel__name">Learning rate η <strong data-v="eta"></strong></span><input class="scrub" data-k="eta" type="range" min="0.01" max="1" step="0.01" value="0.1" /></label>
    <label><span class="fig-panel__name">Strength λ <strong data-v="lam"></strong></span><input class="scrub" data-k="lam" type="range" min="0" max="2" step="0.05" value="0.1" /></label>
    <div><span class="fig-panel__name">Repeat with the same gradient</span><div class="fig-chips"><button type="button" class="fig-chip" data-run>Run 10 steps</button></div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, NEG, JADE } from "../../lib/net-diagram";
  import { frame, txt, arrow } from "../../lib/plot";
  document.querySelectorAll<HTMLElement>("[data-decay]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { w: 2, g: 0.5, eta: 0.1, lam: 0.1 };
    let trail: number[] = [];
    const calc = () => { const f = 1 - p.eta * p.lam, sh = f * p.w, gs = p.eta * p.g; return { f, sh, gs, nw: sh - gs, plain: p.w - gs }; };
    const steps = () => {
      const c = calc();
      return [
        { say: "First the shrink: multiply the weight by a number just below 1. Every weight loses the same fraction, so big weights lose the most.", math: `shrink factor = 1 − η × λ = 1 − ${fmt(p.eta)} × ${fmt(p.lam)} = ${fmt(c.f, 4)}\nshrunk w = ${fmt(c.f, 4)} × ${par(p.w)} = ${fmt(c.sh, 4)}` },
        { say: "Then the ordinary gradient step, exactly as without weight decay.", math: `gradient step = η × gradient = ${fmt(p.eta)} × ${par(p.g)} = ${fmt(c.gs, 4)}` },
        { say: "Put them together. The grey marker shows where plain gradient descent would have landed; the gap is η λ w.", math: `new w = ${fmt(c.sh, 4)} − ${par(c.gs, 4)} = ${fmt(c.nw, 4)}   (without decay: ${fmt(p.w)} − ${par(c.gs, 4)} = ${fmt(c.plain, 4)})` },
      ];
    };
    function draw(k: number) {
      const c = calc(), F = frame({ l: 40, t: 60, w: 680, h: 40, x0: -3, x1: 3, y0: 0, y1: 1 }), y = 100;
      let s = `<line x1="40" x2="720" y1="${y}" y2="${y}" stroke="#cfd5d4" stroke-width="2"/>`;
      for (let v = -3; v <= 3; v++) s += `<line x1="${F.X(v)}" x2="${F.X(v)}" y1="${y - 5}" y2="${y + 5}" stroke="#cfd5d4"/>` + txt(F.X(v), y + 22, fmt(v), `font-size="11" text-anchor="middle" fill="${v === 0 ? INK : MUTED}" font-weight="${v === 0 ? 700 : 400}"`);
      trail.forEach((v, i) => (s += `<circle cx="${F.X(v)}" cy="${y}" r="3" fill="${JADE}" fill-opacity="${0.3 + (0.6 * i) / Math.max(1, trail.length)}"/>`));
      s += `<circle cx="${F.X(p.w)}" cy="${y}" r="8" fill="${k >= 2 ? "#fff" : INK}" stroke="${INK}" stroke-width="2"/>` + txt(F.X(p.w), y - 16, `w = ${fmt(p.w)}`, `font-size="12" text-anchor="middle" font-weight="700" fill="${INK}"`);
      if (k >= 0) s += arrow(F.X(p.w), y - 38, F.X(c.sh), y - 38, JADE, 2.5) + txt((F.X(p.w) + F.X(c.sh)) / 2, y - 46, `shrink ${fmt(c.sh - p.w, 4)}`, `font-size="11" text-anchor="middle" fill="${JADE}" font-weight="700"`);
      if (k >= 1) s += arrow(F.X(c.sh), y + 38, F.X(c.nw), y + 38, GOLD, 2.5) + txt((F.X(c.sh) + F.X(c.nw)) / 2, y + 56, `gradient step ${fmt(-c.gs, 4)}`, `font-size="11" text-anchor="middle" fill="${GOLD}" font-weight="700"`);
      if (k >= 2) s += `<circle cx="${F.X(c.plain)}" cy="${y}" r="6" fill="#B9C0BF"/><circle cx="${F.X(c.nw)}" cy="${y}" r="8" fill="${GOLD}" stroke="#fff" stroke-width="2"/>` + txt(F.X(c.nw), 30, `new w = ${fmt(c.nw, 4)}`, `font-size="12.5" text-anchor="middle" font-weight="700" fill="${INK}"`);
      if (trail.length) s += txt(40, 172, `After ${trail.length} steps with gradient ${fmt(p.g)}: w = ${fmt(trail[trail.length - 1], 4)}`, `font-size="12" fill="${NEG}" font-weight="700"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[el.dataset.v!], 2)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.8 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; trail = []; redraw(); }));
    $("[data-run]").addEventListener("click", () => {
      let w = p.w; trail = [w];
      for (let i = 0; i < 10; i++) { w = (1 - p.eta * p.lam) * w - p.eta * p.g; trail.push(w); }
      trail = trail.slice(1); redraw();
    });
  });
</script>
