---
// Foundations, GANs post: real N(0, 1), forger N(μ, 1), best detective
// D*(x) = p_data / (p_data + p_g). μ = 2: D*(0) = 0.881, D*(1) = 0.5,
// D*(2) = 0.119. Jensen-Shannon divergence by numeric integration: μ 0 → 0,
// 1 → 0.111, 2 → 0.337, 4 → 0.633, 8 → 0.693.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-judge>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 280" role="img" aria-labelledby="oj-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="oj-title">Real and generated bell curves with the best possible detective between them</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Forger's centre μ <strong data-vm></strong></span><input class="scrub" data-m type="range" min="-4" max="8" step="0.1" value="2" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, NEG, JADE } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  const pdf = (x: number, m: number) => Math.exp(-((x - m) ** 2) / 2) / Math.sqrt(2 * Math.PI);
  const jsd = (m: number) => { let s = 0; const N = 4000, a = -12, b = 14, dx = (b - a) / N; for (let i = 0; i < N; i++) { const x = a + (i + 0.5) * dx, p = pdf(x, 0), q = pdf(x, m), mid = (p + q) / 2; if (p > 1e-300) s += 0.5 * p * Math.log(p / mid) * dx; if (q > 1e-300) s += 0.5 * q * Math.log(q / mid) * dx; } return s; };
  document.querySelectorAll<HTMLElement>("[data-judge]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let mu = 2;
    const setM = (v: number) => { mu = v; $<HTMLInputElement>("[data-m]").value = String(v); };
    const steps = () => [
      ...[0, 1, 2, 3].map((x) => ({ say: x === 1 && mu === 2 ? "Halfway between the two curves both are equally likely, so the best detective shrugs: 0.5." : `At x = ${x}: the fraction of samples landing here that are real.`, math: `D*(${x}) = ${fmt(pdf(x, 0), 4)} / (${fmt(pdf(x, 0), 4)} + ${fmt(pdf(x, mu), 4)}) = ${fmt(pdf(x, 0) / (pdf(x, 0) + pdf(x, mu)), 3)}`, enter: () => setM(2) })),
      ...[0, 1, 4, 8].map((m) => ({ say: m === 0 ? "A perfect forger: the curves coincide, the best detective says 0.5 everywhere, and JSD is 0." : m === 8 ? "No overlap at all: JSD sits at its ceiling, log 2 = 0.693. Moving the forger closer barely changes it: no signal." : `Forger centred at ${m}.`, math: `JSD = ${fmt(jsd(m), 3)},  V(D*, G) = 2 × JSD − log 4 = ${fmt(2 * jsd(m) - Math.log(4), 3)}`, enter: () => setM(m) })),
    ];
    function draw() {
      const F = frame({ l: 50, t: 30, w: 460, h: 200, x0: -4, x1: 9, y0: 0, y1: 1.05 });
      let s = F.grid([-4, -2, 0, 2, 4, 6, 8], [0, 0.5, 1], 1);
      s += F.curve((x) => pdf(x, 0) * 2, `stroke="${JADE}" stroke-width="2.5"`, 300) + F.curve((x) => pdf(x, mu) * 2, `stroke="${NEG}" stroke-width="2.5"`, 300) + F.curve((x) => pdf(x, 0) / (pdf(x, 0) + pdf(x, mu) + 1e-300), `stroke="${GOLD}" stroke-width="3"`, 400);
      s += txt(50, 18, "green: real data; red: the forger (both scaled ×2); gold: the best detective D*", `font-size="11.5" font-weight="700" fill="${INK}"`);
      const j = jsd(mu);
      s += txt(540, 70, `forger centre ${fmt(mu, 1)}`, `font-size="13" font-weight="700" fill="${INK}"`) + txt(540, 100, `JSD ${fmt(j, 3)}`, `font-size="15" font-weight="700" fill="${GOLD}"`) + txt(540, 124, `ceiling log 2 = 0.693`, `font-size="11" fill="${MUTED}"`) + txt(540, 150, `V(D*, G) = ${fmt(2 * j - Math.log(4), 3)}`, `font-size="12.5" fill="${INK}"`) + txt(540, 172, "best possible: −log 4 = −1.386", `font-size="11" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vm]").textContent = fmt(mu, 1);
    }
    const redraw = stepper(root, steps, draw, { delay: 2 });
    $<HTMLInputElement>("[data-m]").addEventListener("input", (e) => { mu = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
