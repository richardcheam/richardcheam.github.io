---
// Foundations, recurrent networks post: the whole RNN from input to output on
// a character task, "hell" → "ello", with a trained 3-unit hidden state
// (src/lib/charseq.ts). The two "l" inputs get different predictions (l,
// then o) because the hidden state differs. Losses are all below 0.005.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-rnn-arch>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 380" role="img" aria-labelledby="ra-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ra-title">An RNN unrolled over four characters, from one-hot inputs through hidden states to next-character probabilities</title>
    <g data-draw></g>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, NEG, JADE, GOLD, TINT } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  import { VOCAB, INPUT, TARGET, rnnRun } from "../../lib/charseq";
  const v3 = (v: number[], d = 2) => `(${v.map((x) => fmt(x, d)).join(", ")})`;
  const RUN = rnnRun();
  // Greedy generation from "h": feed each pick back in.
  const GEN = (() => { let s = "h"; for (let t = 0; t < 4; t++) { const r = rnnRun(s, s.padEnd(s.length, "o")); const p = r[r.length - 1].p; s += VOCAB[p.indexOf(Math.max(...p))]; } return s; })();
  const COLX = (t: number) => 196 + t * 150;
  document.querySelectorAll<HTMLElement>("[data-rnn-arch]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const steps = () => [
      { say: "The input is the word \"hell\", read one character at a time. Each character becomes a one-hot vector: four numbers (for h, e, l, o) with a 1 in its own place.", math: `h → (1, 0, 0, 0),  e → (0, 1, 0, 0),  l → (0, 0, 1, 0)\nThe job at every step: predict the next character. Targets: "${TARGET}".` },
      ...RUN.flatMap((s, t) => [
        { say: t === 0 ? `Step 1 reads "h". The memory from before is all zeros. Mix the input and the old memory with two weight matrices, add a bias, and squash with tanh: that is the new hidden state, 3 numbers.` : t === 3 ? `Step 4 reads "l" again, the same input as step 3. But the old memory is different, so the new hidden state is different too.` : `Step ${t + 1} reads "${INPUT[t]}". Same weights as before; only the input and the memory have changed.`,
          math: `W_x x = the "${INPUT[t]}" column of W_x = ${v3(s.wx, 1)}\nW_h h_prev = ${v3(s.wh)}  (h_prev = ${v3(s.hPrev)})\nsum + b = ${v3(s.pre)}  →  h = tanh(…) = ${v3(s.h, 3)}` },
        { say: t === 3 ? `So the prediction changes: after "hell" the model says "o", where after "hel" it said "l". Nothing but the hidden state tells the two "l"s apart.` : `Read the hidden state out as one score per character (logits), turn the scores into probabilities with softmax, and score the target "${TARGET[t]}".`,
          math: `logits W_y h + c = ${VOCAB.map((c, i) => `${c} ${fmt(s.z[i], 2)}`).join(", ")}\nsoftmax = ${VOCAB.map((c, i) => `${c} ${fmt(s.p[i], 3)}`).join(", ")}\nloss = −ln p(${TARGET[t]}) = −ln ${fmt(s.p[s.y], 4)} = ${fmt(s.loss, 4)}` },
      ]),
      { say: "Training: average the four losses, then backpropagation through time sends the gradient back along every arrow, through all four copies of the same weights.", math: `L = (${RUN.map((s) => fmt(s.loss, 4)).join(" + ")}) / 4 = ${fmt(RUN.reduce((a, s) => a + s.loss, 0) / 4, 4)}` },
      { say: `Generating: start from "h", pick the most likely next character, and feed it back in as the next input. The trained model writes "${GEN}".`, math: `h → ${[...GEN.slice(1)].join(" → ")}` },
    ];
    function draw(k: number) {
      // Which time step is complete: hidden shown from step 1 + 2t, output from 2 + 2t.
      const hDone = (t: number) => k >= 1 + 2 * t, pDone = (t: number) => k >= 2 + 2 * t, cur = k >= 1 && k <= 8 ? Math.floor((k - 1) / 2) : -1;
      let s = "";
      [["next character", "probabilities", 76], ["hidden state h", "3 numbers", 204], ["input x", "one-hot", 312]].forEach(([a, b, y]) => (s += txt(10, y as number, a as string, `font-size="10.5" font-weight="700" fill="${MUTED}"`) + txt(10, (y as number) + 14, b as string, `font-size="10" fill="${MUTED}"`)));
      RUN.forEach((st, t) => {
        const cx = COLX(t), on = t === cur;
        if (on) s += `<rect x="${cx - 66}" y="18" width="132" height="350" rx="10" fill="${TINT}" fill-opacity="0.55"/>`;
        // Input one-hot.
        s += txt(cx, 296, `"${INPUT[t]}"`, `font-size="14" font-weight="700" text-anchor="middle" fill="${INK}"`);
        VOCAB.forEach((c, i) => (s += `<rect x="${cx - 46 + i * 23}" y="306" width="21" height="21" rx="3" fill="${i === st.x ? INK : "#fff"}" stroke="#cfd5d4"/>` + txt(cx - 35.5 + i * 23, 342, c, `font-size="9.5" text-anchor="middle" fill="${MUTED}"`)));
        s += arrow(cx, 282, cx, 232, k >= 1 + 2 * t ? INK : "#cfd5d4", 1.5) + txt(cx + 6, 262, "W_x", `font-size="10" fill="${MUTED}"`);
        // Hidden state.
        st.h.forEach((v, i) => { const show = hDone(t); s += `<rect x="${cx - 60 + i * 40}" y="188" width="38" height="40" rx="5" fill="${show ? (v >= 0 ? JADE : NEG) : "#fff"}" fill-opacity="${show ? 0.15 + 0.6 * Math.abs(v) : 1}" stroke="${INK}" stroke-width="1"/>` + txt(cx - 41 + i * 40, 213, show ? fmt(v, 2) : "", `font-size="10.5" font-weight="700" text-anchor="middle" fill="${INK}"`); });
        if (t > 0) s += arrow(COLX(t - 1) + 62, 208, cx - 62, 208, hDone(t) ? GOLD : "#cfd5d4", 2) + txt((COLX(t - 1) + cx) / 2, 200, "W_h", `font-size="10" text-anchor="middle" fill="${GOLD}"`);
        else s += txt(cx - 60, 248, "h₀ = 0", `font-size="10" fill="${MUTED}"`);
        s += arrow(cx, 186, cx, 140, pDone(t) ? INK : "#cfd5d4", 1.5) + txt(cx + 6, 168, "W_y", `font-size="10" fill="${MUTED}"`);
        // Output probabilities.
        VOCAB.forEach((c, i) => { const y = 34 + i * 24, w = pDone(t) ? st.p[i] * 70 : 0, tgt = i === st.y; s += txt(cx - 50, y + 12, c, `font-size="11" font-weight="${tgt ? 700 : 400}" text-anchor="end" fill="${tgt ? GOLD : INK}"`) + `<rect x="${cx - 44}" y="${y + 1}" width="70" height="15" fill="#f1f3f3"/><rect x="${cx - 44}" y="${y + 1}" width="${w}" height="15" fill="${tgt ? GOLD : JADE}" fill-opacity="0.85"/>` + (pDone(t) ? txt(cx + 30, y + 12, fmt(st.p[i], 3), `font-size="9.5" fill="${INK}"`) : ""); });
        s += txt(cx, 26, `target "${TARGET[t]}"`, `font-size="10.5" text-anchor="middle" fill="${GOLD}"`);
      });
      if (k >= 9) s += txt(380, 376, `average loss ${fmt(RUN.reduce((a, q) => a + q.loss, 0) / 4, 4)}`, `font-size="12" font-weight="700" text-anchor="middle" fill="${GOLD}"`);
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2.6 });
  });
</script>
