---
// DSM review, Figure 4: DSM-TTS's streams (Sec 3.3, p. 6; Fig 3, p. 5). The
// action stream says when the next word should be fed; the main text stream
// then gets that word, the lookahead stream the word two ahead (l = 2); audio
// starts after the delay (tau = 5 frames, as in Fig 3). The action timing here
// is scripted, not produced by a trained model.
const { alt } = Astro.props;
---
<div class="blog-diagram asp" role="region" aria-label={alt} data-asp>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 290" role="img" aria-labelledby="asp-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="asp-title">Action, text, lookahead and audio streams of a streaming text-to-speech model, frame by frame</title>
    <g data-g></g>
    <text data-r1 x="20" y="250" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="272" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Word timing</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-m="act" aria-pressed="true">Chosen by the action stream</button>
      <button type="button" class="fig-chip" data-m="fix" aria-pressed="false">Fixed gap of 4 frames</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-asp]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const WORDS = ["Hello,", "world,", "how", "are", "you?"], N = 26, TAU = 5, CW = 640 / N;
    let mode = "act", t = 99;
    const fires = () => (mode === "act" ? [0, 4, 9, 11, 13] : [0, 5, 10, 15, 20]);
    function draw() {
      const g = $("[data-g]"), F = fires(); g.replaceChildren();
      const rows = ["action (out)", "text (in)", "lookahead (in)", "audio (out)"];
      rows.forEach((r, k) => mk(g, "text", { x: 20, y: 40 + k * 44, "font-size": 11, "font-weight": 700, fill: "#2b2b30" }, r));
      for (let f = 0; f < N; f++) {
        const x = 120 + f * CW, on = f <= t, wi = F.indexOf(f), fedIdx = F.indexOf(f - 1);
        // action
        mk(g, "rect", { x, y: 24, width: CW - 2, height: 26, rx: 2, fill: !on ? "#f7f7f9" : wi >= 0 ? "#a33b3b" : "#ececf1" });
        if (on && wi >= 0) mk(g, "text", { x: x + CW / 2 - 1, y: 41, "font-size": 8, "text-anchor": "middle", fill: "#fff" }, "WORD");
        // main text and lookahead
        [["#594578", fedIdx], ["#35588a", fedIdx >= 0 ? fedIdx + 2 : -1]].forEach(([c, idx], k) => {
          const y = 68 + k * 44, has = on && (idx as number) >= 0 && (idx as number) < WORDS.length;
          mk(g, "rect", { x, y, width: CW - 2, height: 26, rx: 2, fill: !on ? "#f7f7f9" : has ? (c as string) : "#ececf1" });
          if (has) mk(g, "text", { x: x + 2, y: y - 4, "font-size": 9.5, fill: c as string, "font-weight": 700 }, WORDS[idx as number]);
        });
        // audio
        mk(g, "rect", { x, y: 156, width: CW - 2, height: 26, rx: 2, fill: !on ? "#f7f7f9" : f >= TAU ? "#4F5D3A" : "#ececf1", "fill-opacity": f >= TAU ? 0.8 : 1 });
      }
      mk(g, "line", { x1: 120 + TAU * CW - 1, x2: 120 + TAU * CW - 1, y1: 150, y2: 188, stroke: "#a33b3b", "stroke-dasharray": "3 3" });
      mk(g, "text", { x: 122 + TAU * CW, y: 202, "font-size": 10, fill: "#a33b3b" }, `audio starts after τ = ${TAU} frames (${TAU * 80} ms)`);
      const fed = F.filter((f) => f < Math.min(t, N)).length, audio = Math.max(0, Math.min(t, N - 1) - TAU + 1);
      $("[data-r1]").textContent = t >= N ? `Frames ${N}: ${WORDS.length} words fed, ${N - TAU} frames of audio.` : `Frame ${Math.min(t, N - 1)}: ${fed} words fed, ${audio} frames of audio so far.`;
      $("[data-r2]").textContent = mode === "act" ? "The model chooses its own pauses. Real effect of a fixed gap instead: English WER 1.60% → 2.86% (Table 15, p. 25)." : "Fixed gaps ignore rhythm: in the paper, English WER rose from 1.60% to 2.86% and speaker similarity fell (Table 15, p. 25).";
      root.querySelectorAll("[data-m]").forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute("data-m") === mode)));
    }
    const run = async (alive: () => boolean) => { for (t = 0; t <= N; t++) { if (!alive()) return; draw(); await wait(0.18); } t = 99; draw(); };
    let token = 0;
    root.querySelectorAll<HTMLButtonElement>("[data-m]").forEach((b) => b.addEventListener("click", () => { mode = b.dataset.m!; const my = ++token; run(() => my === token); }));
    draw();
    setupFigure(root, () => { t = 0; draw(); }, run);
  });
</script>
