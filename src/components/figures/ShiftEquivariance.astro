---
// Foundations, convolutions post: shift the step signal and the edge-kernel
// output shifts with it. Shift 0: 0, 3, 3, 0, −3, −3. Shift +1:
// 0, 0, 3, 3, 0, −3. With stride 2 a shift of 1 is not a whole output step.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-equiv>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 270" role="img" aria-labelledby="eq-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="eq-title">A signal shifted right and its convolution output shifting right with it</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Shift the input <strong data-vs></strong></span><input class="scrub" data-s type="range" min="-2" max="2" step="1" value="0" /></label>
    <div><span class="fig-panel__name">Stride</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-st="1" aria-pressed="true">1</button>
      <button type="button" class="fig-chip" data-st="2" aria-pressed="false">2 (same padding)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { conv1d } from "../../lib/conv";
  const BASE = [0, 0, 0, 3, 3, 3, 0, 0], W = [-1, 0, 1];
  document.querySelectorAll<HTMLElement>("[data-equiv]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let shift = 0, stride = 1;
    const setShift = (v: number) => { shift = v; $<HTMLInputElement>("[data-s]").value = String(v); };
    const shifted = (sh: number) => BASE.map((_, i) => BASE[i - sh] ?? 0);
    const run = (sh: number) => conv1d(shifted(sh), W, stride === 1 ? {} : { pl: 1, pr: 1, s: 2 }).out;
    const steps = () => [
      { say: "The step signal and its edge-kernel output: positive at the rising edge, negative at the falling one.", math: `output: ${run(0).map((v) => fmt(v)).join(", ")}`, enter: () => setShift(0) },
      { say: stride === 1 ? "Shift the input right by one. The output is the same pattern, also moved right by one: the kernel did not need to relearn anything." : "With stride 2, a shift of one input is half an output step, so the output pattern changes instead of simply moving.", math: `output: ${run(1).map((v) => fmt(v)).join(", ")}   (outline: before the shift)`, enter: () => setShift(1) },
      { say: "Shift by two: the pattern moves by two.", math: `output: ${run(2).map((v) => fmt(v)).join(", ")}`, enter: () => setShift(2) },
    ];
    function draw() {
      const xs = shifted(shift), out = run(shift), ghost = run(0), bx = (i: number, n: number) => 70 + i * (640 / n);
      let s = txt(30, 20, `Input, shifted by ${shift}`, `font-size="12" font-weight="700" fill="${INK}"`) + `<line x1="60" x2="720" y1="100" y2="100" stroke="#cfd5d4"/>`;
      xs.forEach((v, i) => (s += `<rect x="${bx(i, 8)}" y="${100 - v * 22}" width="64" height="${v * 22}" fill="${JADE}" fill-opacity="0.5"/>`));
      const n = out.length, off = stride === 1 ? 1 : 0;
      s += txt(30, 140, `Edge-kernel output, stride ${stride}`, `font-size="12" font-weight="700" fill="${INK}"`) + `<line x1="60" x2="720" y1="200" y2="200" stroke="#cfd5d4"/>`;
      const W2 = stride === 1 ? 640 / 8 : 640 / 4;
      ghost.forEach((v, i) => (s += `<rect x="${70 + (i + off) * W2}" y="${Math.min(200, 200 - v * 14)}" width="${W2 - 16}" height="${Math.abs(v * 14)}" fill="none" stroke="${MUTED}" stroke-dasharray="4 3"/>`));
      out.forEach((v, i) => (s += `<rect x="${70 + (i + off) * W2 + 4}" y="${Math.min(200, 200 - v * 14)}" width="${W2 - 24}" height="${Math.abs(v * 14)}" fill="${v >= 0 ? JADE : NEG}" fill-opacity="0.85"/>` + txt(70 + (i + off) * W2 + (W2 - 16) / 2, v >= 0 ? 218 : 196 - Math.abs(v * 14), fmt(v), `font-size="11.5" font-weight="700" text-anchor="middle" fill="${INK}"`)));
      s += txt(30, 256, "Dashed outline: the output before shifting. Zeros enter at the edge as the signal moves.", `font-size="11" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vs]").textContent = String(shift);
    }
    const redraw = stepper(root, steps, draw, { delay: 2.2 });
    $<HTMLInputElement>("[data-s]").addEventListener("input", (e) => { shift = +(e.target as HTMLInputElement).value; redraw(); });
    root.querySelectorAll<HTMLButtonElement>("[data-st]").forEach((b) => b.addEventListener("click", () => { stride = +b.dataset.st!; root.querySelectorAll("[data-st]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
