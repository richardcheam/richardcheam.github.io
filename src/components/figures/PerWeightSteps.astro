---
// Foundations, optimisers post: plain descent (η 0.2) and RMSProp (η 0.3,
// β 0.9) on the bowl w₁² + 4w₂² and on the long valley 0.1w₁² + 4w₂².
// RMSProp's path is identical on both; plain descent's is not. After 3
// steps on the long valley: plain (3.539, −0.216) loss 1.439, RMSProp
// (2.011, 0.000) loss 0.405. Effective step η / √s at step 1: bowl
// (0.1186, 0.1186), long valley (1.186, 0.1186).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-perweight>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 330" role="img" aria-labelledby="pw-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="pw-title">Plain descent and RMSProp on a round bowl and a long valley, with each weight's effective step size</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Right-hand valley: w₁ term × <strong data-va></strong></span><input class="scrub" data-a type="range" min="0.02" max="1" step="0.02" value="0.1" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE } from "../../lib/net-diagram";
  import { frame, txt, bowlContours, OPT_COL } from "../../lib/plot";
  import { run, bowl, type Vec } from "../../lib/optimisers";
  const N = 12;
  const vf = (v: Vec) => `(${v.map((x) => fmt(x, 4)).join(", ")})`;
  document.querySelectorAll<HTMLElement>("[data-perweight]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let a2 = 0.1;
    const lands = () => [1, a2].map((a) => { const B = bowl(a, 4); return { a, B, pl: run("plain", B.grad, [4, 1], { eta: 0.2 }, N), rm: run("rmsprop", B.grad, [4, 1], { eta: 0.3, beta: 0.9 }, N) }; });
    const steps = () => {
      const [, R] = lands();
      return Array.from({ length: N }, (_, i) => {
        const p = R.pl[i], r = R.rm[i], es = r.state.s.map((s) => 0.3 / Math.sqrt(s));
        return {
          say: i === 0 ? `On the right-hand valley the w₁ slope is ${fmt(1 / a2, 2)} times flatter. Plain descent uses η = 0.2 for both weights; RMSProp divides each weight's step by its own typical gradient size, √s.` : `Step ${i + 1} on the right-hand valley.`,
          math: `plain: g = ${vf(p.g)}, step = 0.2 × g = ${vf(p.step)}, new ${vf(p.next)}, loss ${fmt(R.B.L(p.next), 4)}\nRMSProp: g = ${vf(r.g)}, s = ${vf(r.state.s)}\n  effective step size η / √s = ${vf(es)}, step = ${vf(r.step)}, new ${vf(r.next)}, loss ${fmt(R.B.L(r.next), 4)}`,
        };
      });
    };
    function draw(k: number) {
      const n = k + 1, L = lands();
      let s = "";
      L.forEach(({ a, B, pl, rm }, j) => {
        const l = 30 + j * 380, F = frame({ l, t: 34, w: 300, h: 150, x0: -5, x1: 5, y0: -2.5, y1: 2.5 });
        s += `<clipPath id="pw-c${j}"><rect x="${l}" y="34" width="300" height="150"/></clipPath>` + F.grid([-4, 0, 4], [-2, 0, 2], 0);
        s += txt(l, 22, j ? `Long valley ${fmt(a, 2)}w₁² + 4w₂²` : "Bowl w₁² + 4w₂²", `font-size="12" font-weight="700" fill="${INK}"`);
        s += `<g clip-path="url(#pw-c${j})">${bowlContours(F, a, 4, [0.25, 1, 2.5, 5, 10, 20], JADE)}`;
        ([["plain", pl], ["rmsprop", rm]] as const).forEach(([kd, r]) => {
          const pts = [[4, 1], ...r.slice(0, n).map((x) => x.next)];
          s += `<polyline fill="none" stroke="${OPT_COL[kd]}" stroke-width="2.2" points="${pts.map((p) => `${F.X(p[0]).toFixed(1)},${F.Y(p[1]).toFixed(1)}`).join(" ")}"/>`;
          const p = pts[pts.length - 1]; s += `<circle cx="${F.X(p[0])}" cy="${F.Y(p[1])}" r="5" fill="${OPT_COL[kd]}" stroke="#fff" stroke-width="1.5"/>`;
        });
        s += `</g>`;
        // Effective step size per weight: plain is η for both; RMSProp is η / √s.
        const es = n ? rm[n - 1].state.s.map((v) => 0.3 / Math.sqrt(v)) : [0, 0], bx = (v: number) => Math.min(150, v * 100);
        s += txt(l, 222, "Effective step size per unit of slope", `font-size="11" font-weight="700" fill="${MUTED}"`);
        [["plain", [0.2, 0.2]], ["rmsprop", es]].forEach(([kd, vals], r) => {
          (vals as number[]).forEach((v, w) => {
            const y = 236 + r * 40 + w * 16;
            s += txt(l, y + 9, `${r ? "RMSProp" : "plain"} w${w ? "₂" : "₁"}`, `font-size="10.5" fill="${MUTED}"`);
            s += `<rect x="${l + 80}" y="${y}" width="${bx(v)}" height="11" fill="${OPT_COL[kd as "plain" | "rmsprop"]}" fill-opacity="0.8"/>` + txt(l + 86 + bx(v), y + 9, n || !r ? fmt(v, 4) : "after step 1", `font-size="10.5" fill="${INK}"`);
          });
        });
        s += txt(l + 150, 196, `plain loss ${fmt(B.L(n ? pl[n - 1].next : [4, 1]), 3)}, RMSProp ${fmt(B.L(n ? rm[n - 1].next : [4, 1]), 3)}`, `font-size="11" text-anchor="middle" fill="${INK}"`);
      });
      s += `<rect x="340" y="40" width="12" height="4" fill="${OPT_COL.plain}"/>` + txt(340, 58, "plain", `font-size="10.5" fill="${INK}"`) + `<rect x="340" y="70" width="12" height="4" fill="${OPT_COL.rmsprop}"/>` + txt(340, 88, "RMSProp", `font-size="10.5" fill="${INK}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-va]").textContent = fmt(a2, 2);
    }
    const redraw = stepper(root, steps, draw, { delay: 1.5 });
    $<HTMLInputElement>("[data-a]").addEventListener("input", (e) => { a2 = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
