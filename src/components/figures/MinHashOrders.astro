---
// Model development, "Building a pre-training corpus": why a minhash agrees
// with probability equal to the Jaccard similarity. Two sentences become word
// pairs, the pairs merge into one union of 7 (3 shared), a random order picks
// each sentence's lowest-ranked pair, and 112 orders split into 14 buckets of
// 8 show why a pair this different is not flagged. Matches
// scripts/course/p2_corpus.py (J = 3/7).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-minhash-orders>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 345" role="img" aria-labelledby="mho-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="mho-title">Word pairs of two near-duplicate sentences, random orders over their union, and 112 minhash comparisons grouped into 14 buckets</title>
    <g data-draw></g>
  </svg>
  <noscript><p>"the cat sat on the mat" and "the cat sat on a mat" share 3 of their 7 distinct word pairs, so their Jaccard similarity is 3/7. Under a random order of the 7 pairs, the two sentences have the same lowest-ranked pair exactly when that pair is one of the 3 shared ones, which happens with probability 3/7.</p></noscript>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { INK, MUTED, JADE, GOLD, NEG, TINT, DEAD } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const A = ["the", "cat", "sat", "on", "the", "mat"], B = ["the", "cat", "sat", "on", "a", "mat"];
  // The union of word pairs: 3 shared, 2 only in A, 2 only in B.
  const UNION = ["the cat", "cat sat", "sat on", "on the", "the mat", "on a", "a mat"];
  const IN: ("S" | "A" | "B")[] = ["S", "S", "S", "A", "A", "B", "B"];
  const A_POS = [0, 1, 2, 3, 4], B_POS = [0, 1, 2, 5, 6];
  // Three hand-picked orders: the first-ranked pair is shared, only in A, only in B.
  const ORDERS = [[3, 5, 1, 4, 7, 2, 6], [4, 2, 6, 1, 5, 7, 3], [2, 6, 4, 7, 3, 1, 5]];
  // 112 random orders from a fixed seed: agreement means the lowest-ranked pair is shared.
  let seed = 7;
  const rand = () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  const AGREE = Array.from({ length: 112 }, () => { const r = UNION.map(() => rand()); return IN[r.indexOf(Math.min(...r))] === "S"; });
  const N_AGREE = AGREE.filter(Boolean).length;
  const COL = { S: JADE, A: "#3E6E9E", B: GOLD } as const;
  const FILL = { S: TINT, A: "#E2EAF3", B: "#F4EAD2" } as const;
  const CW = 92, CX = (p: number) => 23 + p * 102;
  document.querySelectorAll<HTMLElement>("[data-minhash-orders]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const steps = () => [
      { say: "Two sentences that differ in one word. Are they near-duplicates? First, describe each by the set of its overlapping word pairs.", math: "A = the cat sat on the mat, B = the cat sat on a mat" },
      { say: "Each six-word sentence has five word pairs. Three of them are the same in both sentences.", math: "A: 5 pairs, B: 5 pairs" },
      { say: "Merge the two sets. The union has 7 distinct pairs, 3 of them shared. The Jaccard similarity is shared over union.", math: "J = |A ∩ B| / |A ∪ B| = 3 / 7 ≈ 0.43" },
      { say: "A random hash function puts the 7 pairs in a random order. Each sentence's minhash is its lowest-ranked pair. Here rank 1 is a shared pair, so both sentences pick it: the minhashes agree.", math: "A's minimum = B's minimum = sat on" },
      { say: "A new hash, a new order. Rank 1 is 'on the', which only A has, so A picks it while B picks its own lowest pair: they disagree.", math: "A: on the, B: cat sat" },
      { say: "Rank 1 is now 'on a', which only B has: they disagree again. The minhashes agree exactly when the overall first pair is a shared one.", math: "P(minhashes agree) = 3 shared / 7 in the union = J" },
      { say: `Repeat with 112 hash functions, as FineWeb does. The fraction that agree estimates the similarity: here ${N_AGREE} of 112.`, math: `${N_AGREE} / 112 ≈ ${(N_AGREE / 112).toFixed(2)}, close to 3/7 ≈ 0.43` },
      { say: "Split the 112 minhashes into 14 buckets of 8. Two documents become duplicate candidates only if all 8 agree in at least one bucket. No bucket does here, so this pair, which shares fewer than half its pairs, is not flagged.", math: "matched if some bucket has 8 of 8 agreeing" },
    ];
    function draw(k: number) {
      let s = "";
      // Sentences.
      [A, B].forEach((w, r) => {
        s += txt(23, 26 + r * 22, r === 0 ? "A" : "B", `font-size="12" font-weight="700" fill="${r === 0 ? COL.A : COL.B}"`);
        s += txt(42, 26 + r * 22, w.join(" "), `font-size="13" fill="${INK}"`);
      });
      s += txt(216, 26, "← one word differs", `font-size="10.5" fill="${MUTED}"`);
      // Word-pair chips: A's five, then B's five. Before the union they sit in two rows; after, shared chips coincide.
      if (k >= 1) {
        const chip = (pos: number, label: string, r: number) => {
          const kind = IN[pos];
          const x = k >= 2 ? CX(pos) : CX((r === 0 ? A_POS : B_POS).indexOf(pos));
          const y = k >= 2 ? 150 : 70 + r * 44;
          return `<rect x="${x}" y="${y}" width="${CW}" height="30" rx="6" fill="${FILL[kind]}" stroke="${COL[kind]}" stroke-width="1.4"/>` + txt(x + CW / 2, y + 19, label, `font-size="12" text-anchor="middle" fill="${INK}" font-weight="600"`);
        };
        A_POS.forEach((p) => (s += chip(p, UNION[p], 0)));
        B_POS.forEach((p) => (s += chip(p, UNION[p], 1)));
        if (k === 1) { s += txt(CX(5) + 6, 89, "A's pairs", `font-size="11" fill="${COL.A}"`); s += txt(CX(5) + 6, 133, "B's pairs", `font-size="11" fill="${COL.B}"`); }
      }
      if (k >= 2) {
        s += txt(CX(0), 198, "in both", `font-size="11" fill="${JADE}" font-weight="700"`);
        s += txt(CX(3), 198, "only in A", `font-size="11" fill="${COL.A}" font-weight="700"`);
        s += txt(CX(5), 198, "only in B", `font-size="11" fill="${COL.B}" font-weight="700"`);
        s += txt(CX(6) + CW, 26, "union of both sets: 7 pairs", `font-size="11" text-anchor="end" fill="${MUTED}"`);
      }
      // A random order: rank badges above the union, then each sentence's minimum.
      if (k >= 3 && k <= 5) {
        const ord = ORDERS[k - 3];
        ord.forEach((rank, p) => {
          s += `<circle cx="${CX(p) + CW / 2}" cy="${110}" r="12" fill="${rank === 1 ? INK : "#fff"}" stroke="${INK}" stroke-opacity="0.4"/>` + txt(CX(p) + CW / 2, 114, String(rank), `font-size="11.5" text-anchor="middle" font-weight="700" fill="${rank === 1 ? "#fff" : INK}"`);
        });
        const minOf = (pos: number[]) => pos.reduce((m, p) => (ord[p] < ord[m] ? p : m), pos[0]);
        const a = minOf(A_POS), b = minOf(B_POS), agree = a === b;
        s += txt(CX(a) + CW / 2, 222, "▲ A's minhash", `font-size="11" text-anchor="middle" fill="${COL.A}" font-weight="700"`);
        s += txt(CX(b) + CW / 2, agree ? 238 : 222, "▲ B's minhash", `font-size="11" text-anchor="middle" fill="${COL.B}" font-weight="700"`);
        s += txt(CX(6) + CW, 260, agree ? "agree" : "disagree", `font-size="13" text-anchor="end" font-weight="700" fill="${agree ? JADE : NEG}"`);
      }
      // 112 minhash comparisons: 14 buckets (columns) of 8 (rows).
      if (k >= 6) {
        const gx = 23, gy = 268, cw = k >= 7 ? 46 : 40, cell = 9.5;
        for (let b = 0; b < 14; b++) {
          const all = AGREE.slice(b * 8, b * 8 + 8).every(Boolean);
          if (k >= 7) s += `<rect x="${gx + b * cw - 4}" y="${gy - 4}" width="${2 * (cell + 2) + 6}" height="${4 * (cell + 2) + 6}" rx="4" fill="none" stroke="${all ? JADE : "#C8CFCE"}" stroke-dasharray="${all ? "" : "3 3"}"/>`;
          for (let i = 0; i < 8; i++) {
            const ok = AGREE[b * 8 + i];
            s += `<rect x="${gx + b * cw + (i % 2) * (cell + 2)}" y="${gy + Math.floor(i / 2) * (cell + 2)}" width="${cell}" height="${cell}" rx="2" fill="${ok ? JADE : DEAD}" stroke="${ok ? JADE : "#C8CFCE"}"/>`;
          }
        }
        s += txt(23, 336, k >= 7 ? "14 buckets × 8 minhashes · filled = agree · no bucket has all 8 → not a duplicate candidate" : `112 minhashes · filled = agree (${N_AGREE} of 112)`, `font-size="11" fill="${MUTED}"`);
      }
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2.8 });
  });
</script>
