---
// Foundations, diffusion post: 200 seeded particles (seed 14) walked from
// noise to data with the exact toy denoiser. Mean distance to the nearest of
// ±1: DDPM 5 steps 0.031, DDIM 5 steps 0.034, 20 or 100 steps below 0.001.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-particles>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 290" role="img" aria-labelledby="rp3-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rp3-title">Particles moving from a bell curve of noise to two points, with 5, 20 and 100 steps</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Sampler</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-s="ddpm" aria-pressed="true">DDPM (random)</button>
      <button type="button" class="fig-chip" data-s="ddim" aria-pressed="false">DDIM (deterministic)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, NEG, JADE } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { sampleParticles } from "../../lib/diffusion";
  const NS = [5, 20, 100], SHOW = 60;
  document.querySelectorAll<HTMLElement>("[data-particles]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let ddim = false, prog = 1;
    let runs = NS.map((N) => sampleParticles(200, N, ddim));
    function draw() {
      let s = txt(30, 18, "Time runs left to right: noise at t = 1, data at t = 0. Lines: 60 of the 200 particles.", `font-size="11.5" font-weight="700" fill="${INK}"`);
      NS.forEach((N, j) => {
        const l = 30 + j * 245, w = 220, Y = (x: number) => 150 - Math.max(-2.8, Math.min(2.8, x)) * 40, upto = Math.round(prog * N);
        s += `<rect x="${l}" y="38" width="${w}" height="224" fill="#fafafa" stroke="#eef0f0"/><line x1="${l}" x2="${l + w}" y1="${Y(1)}" y2="${Y(1)}" stroke="${JADE}" stroke-dasharray="3 3"/><line x1="${l}" x2="${l + w}" y1="${Y(-1)}" y2="${Y(-1)}" stroke="${JADE}" stroke-dasharray="3 3"/>`;
        runs[j].slice(0, SHOW).forEach((p) => (s += `<polyline fill="none" stroke="${p[p.length - 1] > 0 ? NEG : "#3E6E9E"}" stroke-opacity="0.35" stroke-width="1" points="${p.slice(0, upto + 1).map((x, k) => `${(l + (k / N) * w).toFixed(1)},${Y(x).toFixed(1)}`).join(" ")}"/>`));
        const ends = runs[j].map((p) => p[Math.min(upto, N)]), miss = ends.reduce((a, x) => a + Math.min(Math.abs(x - 1), Math.abs(x + 1)), 0) / 200, pos = ends.filter((x) => x > 0).length / 200;
        s += txt(l, 32 + 248, `${N} steps: miss ${upto === N ? fmt(miss, 4) : "…"}, above 0: ${upto === N ? `${fmt(100 * pos, 1)}%` : "…"}`, `font-size="11.5" font-weight="700" fill="${INK}"`);
      });
      $("[data-draw]").innerHTML = s;
    }
    setupFigure(root, () => { prog = 0; draw(); }, async (alive) => { await tween(5, (e) => { if (alive()) { prog = e; draw(); } }); });
    root.querySelectorAll<HTMLButtonElement>("[data-s]").forEach((b) => b.addEventListener("click", () => { ddim = b.dataset.s === "ddim"; root.querySelectorAll("[data-s]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); runs = NS.map((N) => sampleParticles(200, N, ddim)); prog = 1; draw(); }));
    draw();
  });
</script>
