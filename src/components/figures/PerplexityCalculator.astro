---
// Foundations, language models post: perplexity from four next-token
// probabilities. 0.5, 0.25, 0.5, 0.125: H = 1.213 nats (1.75 bits), PPL
// 3.36. All 0.25: PPL 4. All 0.9: PPL 1.11.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-ppl>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 230" role="img" aria-labelledby="pp-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="pp-title">Surprise of each correct token and the perplexity it adds up to</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Token 1 <strong data-v="0"></strong></span><input class="scrub" data-i="0" type="range" min="0.01" max="1" step="0.005" value="0.5" /></label>
    <label><span class="fig-panel__name">Token 2 <strong data-v="1"></strong></span><input class="scrub" data-i="1" type="range" min="0.01" max="1" step="0.005" value="0.25" /></label>
    <label><span class="fig-panel__name">Token 3 <strong data-v="2"></strong></span><input class="scrub" data-i="2" type="range" min="0.01" max="1" step="0.005" value="0.5" /></label>
    <label><span class="fig-panel__name">Token 4 <strong data-v="3"></strong></span><input class="scrub" data-i="3" type="range" min="0.01" max="1" step="0.005" value="0.125" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  document.querySelectorAll<HTMLElement>("[data-ppl]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p = [0.5, 0.25, 0.5, 0.125];
    const H = () => p.reduce((s, v) => s - Math.log(v), 0) / 4;
    const steps = () => [
      ...p.map((v, i) => ({ say: i === 0 ? "Each token's surprise is minus the log of the probability the model gave the token that actually came." : `Token ${i + 1}.`, math: `−ln ${fmt(v, 3)} = ${fmt(-Math.log(v), 3)} nats  (${fmt(-Math.log2(v), 3)} ${Math.abs(-Math.log2(v) - 1) < 1e-9 ? "bit" : "bits"})` })),
      { say: "Average the surprises: the cross-entropy per token.", math: `H = (${p.map((v) => fmt(-Math.log(v), 3)).join(" + ")}) / 4 = ${fmt(H(), 3)} nats = ${fmt(H() / Math.LN2, 3)} bits` },
      { say: "Perplexity turns that back into a number of choices: e to the average surprise.", math: `PPL = e^${fmt(H(), 3)} = ${fmt(Math.exp(H()), 2)}` },
    ];
    function draw(k: number) {
      let s = "";
      p.forEach((v, i) => { const sur = -Math.log(v), x = 50 + i * 120, h = Math.min(4.6, sur) * 30; s += `<rect x="${x}" y="${170 - h}" width="70" height="${h}" fill="${JADE}" fill-opacity="${k >= i ? 0.75 : 0.15}"/>` + txt(x + 35, 188, `p = ${fmt(v, 3)}`, `font-size="11" text-anchor="middle" fill="${MUTED}"`) + txt(x + 35, 162 - h, k >= i ? fmt(sur, 3) : "", `font-size="12" font-weight="700" text-anchor="middle" fill="${INK}"`); });
      s += txt(50, 22, "surprise −ln p of each correct token", `font-size="12" font-weight="700" fill="${INK}"`);
      const ppl = Math.exp(H());
      s += txt(560, 70, k >= 4 ? `H = ${fmt(H(), 3)} nats` : "H = …", `font-size="14" font-weight="700" fill="${INK}"`) + txt(560, 100, k >= 5 ? `perplexity ${fmt(ppl, 2)}` : "perplexity …", `font-size="18" font-weight="700" fill="${GOLD}"`);
      s += txt(560, 130, k >= 5 ? `as unsure as a fair choice` : "", `font-size="11.5" fill="${MUTED}"`) + txt(560, 148, k >= 5 ? `among about ${fmt(ppl, 1)} tokens` : "", `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[+el.dataset.v!], 3)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.6 });
    root.querySelectorAll<HTMLInputElement>("[data-i]").forEach((inp) => inp.addEventListener("input", () => { p[+inp.dataset.i!] = +inp.value; redraw(); }));
  });
</script>
