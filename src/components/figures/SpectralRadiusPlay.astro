---
// Foundations, recurrent networks post: repeated multiplication by
// [[a, c], [c, a]], whose stretches are a + c along (1, 1) and a − c along
// (1, −1). a = 0.6, c = 0.2: lengths 0.6325, 0.4665, 0.3649, 0.2902,
// 0.2318. a = 1.2, c = 0.3: length 40.78 after ten steps.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-spectral>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="sr-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="sr-title">An arrow repeatedly multiplied by a matrix, turning towards its strongest stretch</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Diagonal a <strong data-v="a"></strong></span><input class="scrub" data-k="a" type="range" min="0" max="1.5" step="0.05" value="0.6" /></label>
    <label><span class="fig-panel__name">Off-diagonal c <strong data-v="c"></strong></span><input class="scrub" data-k="c" type="range" min="-0.5" max="0.5" step="0.05" value="0.2" /></label>
    <div><span class="fig-panel__name">Preset</span><div class="fig-chips"><button type="button" class="fig-chip" data-pre="0.6,0.2">Shrinks (0.6, 0.2)</button><button type="button" class="fig-chip" data-pre="1.2,0.3">Explodes (1.2, 0.3)</button></div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, JADE, NEG } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  const N = 10;
  document.querySelectorAll<HTMLElement>("[data-spectral]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { a: 0.6, c: 0.2 };
    const path = () => { const vs = [[1, 0]]; for (let i = 0; i < N; i++) { const [x, y] = vs[i]; vs.push([p.a * x + p.c * y, p.c * x + p.a * y]); } return vs; };
    const v4 = (v: number[]) => `(${v.map((x) => fmt(x, 4)).join(", ")})`;
    const steps = () => { const vs = path(); return vs.slice(1).map((v, i) => { const [x, y] = vs[i]; return { say: i === 0 ? `Multiply (1, 0) by the matrix. Its stretches are ${fmt(p.a + p.c, 2)} along (1, 1) and ${fmt(p.a - p.c, 2)} along (1, −1).` : `Multiply again (${i + 1} times).`, math: `(${fmt(p.a)} × ${par(x, 4)} + ${fmt(p.c)} × ${par(y, 4)}, ${fmt(p.c)} × ${par(x, 4)} + ${fmt(p.a)} × ${par(y, 4)}) = ${v4(v)},  length ${fmt(Math.hypot(...v), 4)}` }; }); };
    function draw(k: number) {
      const vs = path().slice(0, k + 2), maxL = Math.max(1.2, ...vs.map((v) => Math.hypot(...v))), S = 120 / maxL, cx = 200, cy = 150;
      let s = `<line x1="${cx - 140}" x2="${cx + 140}" y1="${cy}" y2="${cy}" stroke="#eef0f0"/><line x1="${cx}" x2="${cx}" y1="${cy - 140}" y2="${cy + 140}" stroke="#eef0f0"/>`;
      s += `<line x1="${cx - 130}" y1="${cy + 130}" x2="${cx + 130}" y2="${cy - 130}" stroke="${GOLD}" stroke-dasharray="4 4" stroke-opacity="0.6"/>` + txt(cx + 132, cy - 132, `stretch ${fmt(p.a + p.c, 2)}`, `font-size="10.5" fill="${GOLD}"`);
      s += `<line x1="${cx - 130}" y1="${cy - 130}" x2="${cx + 130}" y2="${cy + 130}" stroke="${MUTED}" stroke-dasharray="4 4" stroke-opacity="0.5"/>` + txt(cx + 132, cy + 140, `stretch ${fmt(p.a - p.c, 2)}`, `font-size="10.5" fill="${MUTED}"`);
      vs.forEach((v, i) => (s += arrow(cx, cy, cx + v[0] * S, cy - v[1] * S, i === vs.length - 1 ? (Math.hypot(...v) > 1 ? NEG : JADE) : "#cfd5d4", i === vs.length - 1 ? 2.8 : 1.3)));
      s += txt(cx - 140, 20, `scale: ${fmt(maxL, 2)} = edge of the box`, `font-size="10.5" fill="${MUTED}"`);
      s += txt(400, 40, "Length after each multiplication", `font-size="12" font-weight="700" fill="${INK}"`);
      path().slice(1, k + 2).forEach((v, i) => (s += txt(400 + Math.floor(i / 5) * 170, 66 + (i % 5) * 22, `${i + 1}: ${fmt(Math.hypot(...v), 4)}`, `font-size="12" fill="${INK}" font-weight="${i === k ? 700 : 400}"`)));
      const rho = Math.max(Math.abs(p.a + p.c), Math.abs(p.a - p.c));
      s += txt(400, 210, `largest stretch (spectral radius) = ${fmt(rho, 2)}`, `font-size="12.5" font-weight="700" fill="${rho > 1 ? NEG : JADE}"`) + txt(400, 230, rho > 1 ? "above 1: the arrow grows without limit" : rho < 1 ? "below 1: the arrow shrinks towards zero" : "exactly 1: the length settles", `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[el.dataset.v!], 2)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.2 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
    root.querySelectorAll<HTMLButtonElement>("[data-pre]").forEach((b) => b.addEventListener("click", () => { [p.a, p.c] = b.dataset.pre!.split(",").map(Number); root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((i) => (i.value = String(p[i.dataset.k!]))); redraw(); }));
  });
</script>
