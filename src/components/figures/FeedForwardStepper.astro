---
// Foundations, Transformer post: a feed-forward network of width 4 on
// x = (1, −1). Hidden sums 1, −1, 0, −1.5; ReLU output (1, 0); GELU output
// (0.942, −0.259). With the last bias at 2.5 under ReLU: (0.5, 0.5).
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-ffn>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 260" role="img" aria-labelledby="ff-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ff-title">Two numbers widened to four hidden units, activated, and narrowed back to two</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">x₁ <strong data-v="x1"></strong></span><input class="scrub" data-k="x1" type="range" min="-2" max="2" step="0.1" value="1" /></label>
    <label><span class="fig-panel__name">x₂ <strong data-v="x2"></strong></span><input class="scrub" data-k="x2" type="range" min="-2" max="2" step="0.1" value="-1" /></label>
    <label><span class="fig-panel__name">Last hidden bias <strong data-v="b4"></strong></span><input class="scrub" data-k="b4" type="range" min="-2" max="3" step="0.5" value="0.5" /></label>
    <div><span class="fig-panel__name">Activation</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-a="relu" aria-pressed="true">ReLU</button>
      <button type="button" class="fig-chip" data-a="gelu" aria-pressed="false">GELU</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { gelu } from "../../lib/transformer";
  const W1 = [[1, 0, 1, -1], [0, 1, 1, 1]], W2 = [[1, 0], [0, 1], [0.5, 0.5], [-1, 1]];
  document.querySelectorAll<HTMLElement>("[data-ffn]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { x1: 1, x2: -1, b4: 0.5 };
    let act: "relu" | "gelu" = "relu";
    const calc = () => { const x = [p.x1, p.x2], b = [0, 0, 0, p.b4]; const z = [0, 1, 2, 3].map((u) => x[0] * W1[0][u] + x[1] * W1[1][u] + b[u]); const a = z.map((v) => (act === "relu" ? Math.max(0, v) : gelu(v))); const o = [0, 1].map((c) => a.reduce((s, v, u) => s + v * W2[u][c], 0)); return { x, b, z, a, o }; };
    const f3 = (v: number) => fmt(v, 3);
    const steps = () => { const c = calc(); return [
      ...[0, 1, 2, 3].map((u) => ({ say: `Hidden unit ${u + 1}: a weighted sum of the two inputs plus its bias.`, math: `${par(W1[0][u])} × ${par(c.x[0])} + ${par(W1[1][u])} × ${par(c.x[1])} + ${par(c.b[u])} = ${f3(c.z[u])}` })),
      { say: act === "relu" ? "ReLU keeps positives and zeros out the rest." : "GELU multiplies each value by a soft 'how positive is it' switch: negatives leak a little.", math: `${act === "relu" ? "ReLU" : "GELU"}(${c.z.map(f3).join(", ")}) = (${c.a.map(f3).join(", ")})` },
      ...[0, 1].map((cc) => ({ say: `Output ${cc + 1}: narrow back down with the second matrix.`, math: `${c.a.map((v, u) => `${f3(v)} × ${par(W2[u][cc])}`).join(" + ")} = ${f3(c.o[cc])}` })),
    ]; };
    function draw(k: number) {
      const c = calc(), iy = (i: number) => 90 + i * 70, hy = (u: number) => 40 + u * 54, oy = (i: number) => 90 + i * 70;
      let s = "";
      c.x.forEach((v, i) => (s += `<circle cx="80" cy="${iy(i)}" r="22" fill="#fff" stroke="${INK}"/>` + txt(80, iy(i) + 5, fmt(v, 2), `font-size="13" font-weight="700" text-anchor="middle" fill="${INK}"`)));
      [0, 1, 2, 3].forEach((u) => {
        const on = k === u;
        [0, 1].forEach((i) => (s += `<line x1="102" y1="${iy(i)}" x2="298" y2="${hy(u)}" stroke="${W1[i][u] >= 0 ? JADE : NEG}" stroke-opacity="${on ? 0.9 : 0.25}" stroke-width="${on ? 2.5 : 1}"/>`));
        s += `<rect x="300" y="${hy(u) - 18}" width="90" height="36" rx="6" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : INK}"/>` + txt(345, hy(u) + 5, k >= u ? f3(c.z[u]) : "?", `font-size="12" font-weight="700" text-anchor="middle" fill="${INK}"`);
        s += `<rect x="420" y="${hy(u) - 18}" width="90" height="36" rx="6" fill="${k === 4 ? TINT : "#fff"}" stroke="${k >= 4 ? GOLD : "#cfd5d4"}"/>` + txt(465, hy(u) + 5, k >= 4 ? f3(c.a[u]) : "?", `font-size="12" font-weight="700" text-anchor="middle" fill="${INK}"`);
        [0, 1].forEach((o) => (s += `<line x1="510" y1="${hy(u)}" x2="618" y2="${oy(o)}" stroke="${W2[u][o] >= 0 ? JADE : NEG}" stroke-opacity="${k === 5 + o ? 0.9 : 0.2}" stroke-width="${k === 5 + o ? 2.5 : 1}"/>`));
      });
      c.o.forEach((v, o) => (s += `<circle cx="640" cy="${oy(o)}" r="22" fill="${k === 5 + o ? TINT : "#fff"}" stroke="${INK}"/>` + txt(640, oy(o) + 5, k >= 5 + o ? f3(v) : "?", `font-size="12" font-weight="700" text-anchor="middle" fill="${INK}"`)));
      s += txt(80, 22, "input (d = 2)", `font-size="11" text-anchor="middle" fill="${MUTED}"`) + txt(345, 18, "hidden sums", `font-size="11" text-anchor="middle" fill="${MUTED}"`) + txt(465, 18, act === "relu" ? "after ReLU" : "after GELU", `font-size="11" text-anchor="middle" fill="${MUTED}"`) + txt(640, 50, "output", `font-size="11" text-anchor="middle" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = fmt(p[el.dataset.v!], 1)));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.3 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
    root.querySelectorAll<HTMLButtonElement>("[data-a]").forEach((b) => b.addEventListener("click", () => { act = b.dataset.a as "relu" | "gelu"; root.querySelectorAll("[data-a]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
