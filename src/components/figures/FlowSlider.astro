---
// A straight flow-matching path x_t = (1 - t) x0 + t x1 on a [-1, 1] square,
// with a draggable t. Any start and target inside the square work.
interface Props {
  start: [number, number];
  target: [number, number];
  alt: string;
}
const { start, target, alt } = Astro.props;
const v = [target[0] - start[0], target[1] - start[1]];
const speed = Math.hypot(v[0], v[1]);
// 150 px per unit on x and 100 px per unit on y; the arrow uses the same scale so it stays parallel to the path.
const px = (p: number) => 210 + 150 * p;
const py = (a: number) => 130 - 100 * a;
const arrow = [0.25 * 150 * v[0], -0.25 * 100 * v[1]];
const fmt = (n: number, d = 2) => (n < -0.004 ? "−" : "") + Math.abs(n).toFixed(d);
const at = (t: number) => [(1 - t) * start[0] + t * target[0], (1 - t) * start[1] + t * target[1]];
const mid = at(0.5);
---
<div class="blog-diagram" tabindex="0" role="region" aria-label={alt} data-flow-slider data-start={JSON.stringify(start)} data-target={JSON.stringify(target)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 260" role="img" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title>Two-dimensional flow matching example</title>
    <desc>{`A plane from minus one to one on both axes. The noise point (${fmt(start[0], 1)}, ${fmt(start[1], 1)}) joins the target (${fmt(target[0], 1)}, ${fmt(target[1], 1)}) by a straight line, and a point moves along it as t changes.`}</desc>
    <defs><marker id="flow-slider-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="#594578" stroke-width="1.6" /></marker></defs>
    <rect x="60" y="30" width="300" height="200" fill="none" stroke="#ececf1" />
    <line x1="60" y1="130" x2="360" y2="130" stroke="#d5d5dc" /><line x1="210" y1="30" x2="210" y2="230" stroke="#d5d5dc" />
    <g font-size="11" fill="#5f5f66"><text x="52" y="248">−1</text><text x="206" y="248">0</text><text x="352" y="248">1</text><text x="36" y="34">1</text><text x="30" y="234">−1</text><text x="280" y="248">pitch →</text><text x="20" y="90" transform="rotate(-90 20 90)">amplitude →</text></g>
    <line x1={px(start[0])} y1={py(start[1])} x2={px(target[0])} y2={py(target[1])} stroke="#594578" stroke-width="2" stroke-dasharray="5 4" stroke-opacity="0.5" />
    <line data-travel x1={px(start[0])} y1={py(start[1])} x2={px(mid[0])} y2={py(mid[1])} stroke="#594578" stroke-width="2.4" />
    <circle cx={px(start[0])} cy={py(start[1])} r="6" fill="#d5d5dc" stroke="#5f5f66" /><circle cx={px(target[0])} cy={py(target[1])} r="6" fill="#4F5D3A" />
    <g font-size="13"><text x={px(start[0]) + 10} y={py(start[1]) + 4} fill="#5f5f66">{`x₀ = (${fmt(start[0], 1)}, ${fmt(start[1], 1)})`}</text><text x={px(target[0]) - 94} y={py(target[1]) + 22} fill="#4F5D3A">{`x₁ = (${fmt(target[0], 1)}, ${fmt(target[1], 1)})`}</text></g>
    <g font-size="13" fill="#2b2b30">
      <text x="420" y="50" fill="#5f5f66" letter-spacing="1" font-size="12">VELOCITY, SAME AT EVERY t</text>
      <text x="420" y="74">{`v = x₁ − x₀ = (${fmt(v[0], 1)}, ${fmt(v[1], 1)})`}</text>
      <text x="420" y="98" fill="#5f5f66">{`speed ‖v‖ ≈ ${speed.toFixed(3)}`}</text>
      <text x="420" y="140" fill="#5f5f66" letter-spacing="1" font-size="12">POSITION</text>
      {[0, 0.5, 1].map((t, i) => <text x="420" y={164 + 24 * i}>{`t = ${t.toFixed(1)} → (${fmt(at(t)[0])}, ${fmt(at(t)[1])})`}</text>)}
      <text data-live x="420" y="244" fill="#594578" font-weight="600">{`t = 0.50 → (${fmt(mid[0])}, ${fmt(mid[1])})`}</text>
    </g>
    <line data-arrow x1={px(mid[0])} y1={py(mid[1])} x2={px(mid[0]) + arrow[0]} y2={py(mid[1]) + arrow[1]} stroke="#594578" stroke-width="2.4" marker-end="url(#flow-slider-arrow)" />
    <circle data-dot cx={px(mid[0])} cy={py(mid[1])} r="6" fill="#594578" />
    <text data-dot-label x={px(mid[0]) + 10} y={py(mid[1]) - 6} fill="#594578" font-size="13">xₜ</text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>
<p class="blog-figure-reading"><label>t = <strong data-t>0.50</strong><input class="scrub" data-range type="range" min="0" max="1" step="0.01" value="0.5" style="--n: 4" /><span class="scrub-scale" aria-hidden="true"><span>0</span><span>0.25</span><span>0.5</span><span>0.75</span><span>1</span></span></label></p>
<p class="blog-figure-reading">The dashed line is the whole trajectory. The arrow is the velocity scaled by 0.25 so it fits; as you drag, it keeps the same length and direction.</p>
<script is:inline>
  (function () {
    document.querySelectorAll("[data-flow-slider]:not([data-ready])").forEach(function (root) {
      root.setAttribute("data-ready", "");
      var reading = root.nextElementSibling;
      var range = reading.querySelector("[data-range]");
      var x0 = JSON.parse(root.dataset.start), x1 = JSON.parse(root.dataset.target);
      var ax = 0.25 * 150 * (x1[0] - x0[0]), ay = -0.25 * 100 * (x1[1] - x0[1]);
      function px(p) { return 210 + 150 * p; }
      function py(a) { return 130 - 100 * a; }
      function fmt(n) { return (n < -0.004 ? "−" : "") + Math.abs(n).toFixed(2); }
      function set(sel, attrs) { var el = root.querySelector(sel); for (var k in attrs) el.setAttribute(k, attrs[k]); }
      function draw() {
        var t = +range.value;
        var p = (1 - t) * x0[0] + t * x1[0], a = (1 - t) * x0[1] + t * x1[1];
        var cx = px(p), cy = py(a);
        set("[data-travel]", { x2: cx, y2: cy });
        set("[data-dot]", { cx: cx, cy: cy });
        set("[data-arrow]", { x1: cx, y1: cy, x2: cx + ax, y2: cy + ay });
        set("[data-dot-label]", { x: cx + 10, y: cy - 6 });
        root.querySelector("[data-live]").textContent = "t = " + t.toFixed(2) + " → (" + fmt(p) + ", " + fmt(a) + ")";
        reading.querySelector("[data-t]").textContent = t.toFixed(2);
        range.style.setProperty("--p", `${t * 100}%`);
      }
      range.addEventListener("input", draw);
      draw();

      // Sweep t from 0 to 1 once on view (and on Replay), then settle at 0.5.
      // Any touch on the slider stops the sweep.
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var sweeping = 0;
      function sweep() {
        var my = ++sweeping, start = performance.now();
        function frame(now) {
          if (my !== sweeping) return;
          var e = (now - start) / 1000, t;
          if (e < 2.4) t = e / 2.4;
          else if (e < 3.2) { var k = (e - 2.4) / 0.8; t = 1 - 0.5 * (1 - Math.pow(1 - k, 3)); }
          else { range.value = "0.5"; draw(); return; }
          range.value = String(Math.round(t * 100) / 100);
          draw();
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
      range.addEventListener("pointerdown", function () { sweeping++; });
      range.addEventListener("keydown", function () { sweeping++; });
      root.querySelector("[data-replay]").addEventListener("click", function () { if (reduce) { range.value = "0.5"; draw(); } else sweep(); });
      if (!reduce && "IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); sweep(); }
        }, { threshold: 0.55 });
        io.observe(root);
      }
    });
  })();
</script>
