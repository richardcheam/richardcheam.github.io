---
// The whole Khmer fine-tuning recipe as one line of stations. A token for
// "one recording" travels the line; each station shows one real number from
// the project report.
const { alt } = Astro.props;
const stations = [
  { k: "Licensed audio", v: "3 sources", s: "about 855 hours" },
  { k: "Normalise text", v: "450,396", s: "transcripts" },
  { k: "Read numbers", v: "16,736", s: "of 18,220 verbalised" },
  { k: "Quality control", v: "800", s: "rows rejected" },
  { k: "Split", v: "1% · 1%", s: "dev · sealed test" },
  { k: "Align & cut", v: "60/60", s: "cuts heard clean" },
  { k: "Tokenizer", v: "4,000", s: "Khmer pieces" },
  { k: "Fine-tune", v: "316 M", s: "weights trained" },
  { k: "Pick checkpoint", v: "200", s: "dev sentences, CER" },
];
const X0 = 50, DX = 85, Y = 92;
---
<div class="blog-diagram kr" tabindex="0" role="region" aria-label={alt} data-kr>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 240" role="img" aria-labelledby="kr-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="kr-title">Nine stages from licensed audio to a selected checkpoint</title>
    <line x1={X0} y1={Y} x2={X0 + DX * 8} y2={Y} stroke="#d6d6dd" stroke-width="2" />
    <line data-track x1={X0} y1={Y} x2={X0 + DX * 8} y2={Y} stroke="#594578" stroke-width="2" />
    {stations.map((s, i) => (
      <g data-st transform={`translate(${X0 + i * DX} ${Y})`}>
        <text y="-34" font-size="10.5" font-weight="600" text-anchor="middle" fill="#2b2b30">{s.k.split(" ")[0]}</text>
        <text y="-21" font-size="10.5" font-weight="600" text-anchor="middle" fill="#2b2b30">{s.k.split(" ").slice(1).join(" ")}</text>
        <circle data-dot r="9" fill="#fff" stroke="#d6d6dd" stroke-width="2" />
        <text data-n y="5" font-size="9" text-anchor="middle" fill="#5f5f66" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">{i + 1}</text>
        <text data-v y="36" font-size="13" font-weight="700" text-anchor="middle" fill="#2b2b30">{s.v}</text>
        <text data-s y="52" font-size="9.5" text-anchor="middle" fill="#5f5f66">{s.s.length > 14 ? s.s.slice(0, s.s.lastIndexOf(" ", 14) > 0 ? s.s.lastIndexOf(" ", 14) : s.s.indexOf(" ")) : s.s}</text>
        <text data-s y="64" font-size="9.5" text-anchor="middle" fill="#5f5f66">{s.s.length > 14 ? s.s.slice((s.s.lastIndexOf(" ", 14) > 0 ? s.s.lastIndexOf(" ", 14) : s.s.indexOf(" ")) + 1) : ""}</text>
      </g>
    ))}
    <g data-token transform={`translate(${X0} ${Y})`}><rect x="-7" y="-7" width="14" height="14" rx="3" fill="#594578" /></g>
    <text x="24" y="205" font-size="10.5" fill="#5f5f66">Data work is seven of the nine stations. The trainer itself is upstream's, unmodified, with a project config.</text>
  </svg>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";

  document.querySelectorAll<HTMLElement>("[data-kr]").forEach((root) => {
    const st = Array.from(root.querySelectorAll<SVGGElement>("[data-st]"));
    const token = root.querySelector<SVGGElement>("[data-token]")!, track = root.querySelector<SVGLineElement>("[data-track]")!;
    const X0 = 50, DX = 85, Y = 92;
    const light = (i: number, on: boolean) => {
      const g = st[i];
      g.querySelector("[data-dot]")!.setAttribute("stroke", on ? "#594578" : "#d6d6dd");
      g.querySelector("[data-dot]")!.setAttribute("fill", on ? "#594578" : "#fff");
      g.querySelector("[data-n]")!.setAttribute("fill", on ? "#fff" : "#5f5f66");
      g.querySelectorAll<SVGElement>("[data-v],[data-s]").forEach((e) => (e.style.opacity = on ? "1" : "0.15"));
    };
    const at = (x: number) => { token.setAttribute("transform", `translate(${x} ${Y})`); track.setAttribute("x2", String(x)); };
    setupFigure(root, () => { st.forEach((_, i) => light(i, false)); at(X0); }, async (alive) => {
      light(0, true);
      for (let i = 1; i < st.length; i++) {
        if (!alive()) return;
        const a = X0 + (i - 1) * DX;
        await tween(0.45, (t) => at(a + DX * t));
        light(i, true);
        await wait(0.15);
      }
    });
  });
</script>
