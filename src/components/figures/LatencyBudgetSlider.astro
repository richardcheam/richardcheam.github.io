---
// SoundStream review, Figure 5: Table III (p. 9). At a fixed 6 kbps, longer
// frames mean fewer frames per second and more bits per frame. Frame length
// M / 24 ms; bits per frame 6000 / (24000 / M); quantizers of 10 bits.
// RTF and ViSQOL as printed; the paper prints 7.5 ms for M = 160, where
// 160 / 24 = 6.7 ms.
const { alt } = Astro.props;
const rows = [
  { st: [1, 4, 5, 8], printed: "7.5 ms", nq: 4, enc: "1.6×", dec: "1.5×", vq: "4.01 ± 0.02" },
  { st: [2, 4, 5, 8], printed: "13 ms", nq: 8, enc: "2.4×", dec: "2.3×", vq: "4.01 ± 0.03" },
  { st: [4, 4, 5, 8], printed: "26 ms", nq: 16, enc: "4.1×", dec: "4.0×", vq: "4.01 ± 0.03" },
];
---
<div class="blog-diagram lbs" role="region" aria-label={alt} data-lbs data-rows={JSON.stringify(rows)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 330" role="img" aria-labelledby="lbs-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="lbs-title">The same bitrate split into short frames with few bits or long frames with many</title>
    <text x="20" y="22" font-size="11.5" font-weight="700" fill="#2b2b30">80 ms of audio at 6 kbps: one box per frame, one block per 10-bit quantizer</text>
    <g data-tl></g>
    <text data-r1 x="20" y="236" font-size="13" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="258" font-size="12" fill="#2b2b30"></text>
    <text data-r3 x="20" y="280" font-size="12" fill="#2b2b30"></text>
    <text data-r4 x="20" y="304" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Strides</span><div class="fig-chips">
      {rows.map((r, i) => <button type="button" class="fig-chip" data-row={i} aria-pressed={i === 1 ? "true" : "false"}>({r.st.join(", ")})</button>)}
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-lbs]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const R: { st: number[]; printed: string; nq: number; enc: string; dec: string; vq: string }[] = JSON.parse(root.dataset.rows!);
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    let sel = 1, fill = 1;
    function draw() {
      const r = R[sel], M = r.st.reduce((a, b) => a * b, 1), ms = M / 24, fps = 24000 / M, bits = 6000 / fps, nq = bits / 10;
      const g = $("[data-tl]"); g.replaceChildren();
      const X = (t: number) => 20 + (t / 80) * 740;
      for (let t = 0; t <= 80; t += 10) mk(g, "text", { x: X(t), y: 196, "font-size": 10, "text-anchor": "middle", fill: "#5f5f66" }, `${t} ms`);
      const frames = Math.floor(80 / ms + 1e-9);
      for (let f = 0; f < frames; f++) {
        const x = X(f * ms) + 2, w = X((f + 1) * ms) - X(f * ms) - 4;
        mk(g, "rect", { x, y: 40, width: w, height: 136, rx: 4, fill: "#f5f5f8", stroke: "#b9b9c2" });
        const lit = Math.round(nq * fill);
        for (let q = 0; q < nq; q++) mk(g, "rect", { x: x + 4, y: 170 - (q + 1) * 8, width: w - 8, height: 6.5, rx: 1, fill: q < lit ? "#594578" : "#ececf1" });
      }
      $("[data-r1]").textContent = `M = ${M}: frames of ${ms.toFixed(1)} ms, ${fps} a second, ${bits} bits each = ${nq} quantizers of 10 bits`;
      $("[data-r2]").textContent = `Real-time factor: encoder ${r.enc}, decoder ${r.dec}. ViSQOL ${r.vq} (Table III, p. 9).`;
      $("[data-r3]").textContent = sel === 0 ? `Printed latency ${r.printed}; 160 ÷ 24 = 6.7 ms, so the printed value looks rounded or measured differently.` : `Printed latency ${r.printed}; ${M} ÷ 24 = ${ms.toFixed(1)} ms.`;
      $("[data-r4]").textContent = "Same quality in all three: the delay is a choice. Longer frames run faster but make you wait longer.";
      root.querySelectorAll("[data-row]").forEach((b, i) => b.setAttribute("aria-pressed", String(i === sel)));
    }
    const pick = async (i: number, alive = () => true) => { sel = i; fill = 0; draw(); await tween(0.8, (e) => { if (alive()) { fill = e; draw(); } }); };
    root.querySelectorAll<HTMLButtonElement>("[data-row]").forEach((b) => b.addEventListener("click", () => pick(+b.dataset.row!)));
    draw();
    setupFigure(root, () => { sel = 0; fill = 0; draw(); }, async (alive) => { for (const i of [0, 1, 2, 1]) { if (!alive()) return; await pick(i, alive); await wait(1.1); } });
  });
</script>
