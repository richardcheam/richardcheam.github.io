---
// Foundations, language models post: bigram counts on three sentences.
// P(cat | the) = 2/3; "the cat sat" scores 1/3; "the dog ran" scores 0.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-bigram>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="bg-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="bg-title">A tiny corpus counted into a grid of word pairs, then turned into probabilities</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Score a sentence</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-s="the cat sat" aria-pressed="true">the cat sat</button>
      <button type="button" class="fig-chip" data-s="the dog sat" aria-pressed="false">the dog sat</button>
      <button type="button" class="fig-chip" data-s="the cat ran" aria-pressed="false">the cat ran</button>
      <button type="button" class="fig-chip" data-s="the dog ran" aria-pressed="false">the dog ran</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE, NEG } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const SENT = ["the cat sat", "the dog sat", "the cat ran"].map((s) => ["BOS", ...s.split(" "), "EOS"]);
  const PAIRS = SENT.flatMap((s) => s.slice(0, -1).map((w, i) => [w, s[i + 1]]));
  const ROWS = ["BOS", "the", "cat", "dog", "sat", "ran"], COLS = ["the", "cat", "dog", "sat", "ran", "EOS"];
  document.querySelectorAll<HTMLElement>("[data-bigram]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let sent = "the cat sat";
    const counts = (n: number) => { const c: Record<string, number> = {}; PAIRS.slice(0, n).forEach(([a, b]) => (c[`${a} ${b}`] = (c[`${a} ${b}`] ?? 0) + 1)); return c; };
    const full = counts(PAIRS.length), rowTot = (r: string) => COLS.reduce((s, c) => s + (full[`${r} ${c}`] ?? 0), 0);
    const P = (a: string, b: string) => (full[`${a} ${b}`] ?? 0) / (rowTot(a) || 1);
    const score = () => { const w = ["BOS", ...sent.split(" "), "EOS"]; const f = w.slice(0, -1).map((a, i) => ({ a, b: w[i + 1], p: P(a, w[i + 1]) })); return { f, total: f.reduce((s, x) => s * x.p, 1) }; };
    const steps = () => [
      ...PAIRS.map(([a, b], i) => ({ say: i === 0 ? "Walk through the corpus one neighbouring pair at a time, ticking the grid." : `Pair ${i + 1}.`, math: `+1 to (${a}, ${b})` })),
      { say: "Divide each row by its total: the share of times each word followed.", math: `P(cat | the) = ${full["the cat"]} / ${rowTot("the")} = ${fmt(P("the", "cat"), 3)},  P(dog | the) = ${full["the dog"]} / ${rowTot("the")} = ${fmt(P("the", "dog"), 3)}` },
      { say: `Score "${sent}" with the chain rule.${score().total === 0 ? " One pair never appeared, so the model calls a sensible sentence impossible." : ""}`, math: `${score().f.map((x) => fmt(x.p, 3)).join(" × ")} = ${fmt(score().total, 3)}` },
    ];
    function draw(k: number) {
      const n = Math.min(PAIRS.length, k + 1), c = counts(n), probs = k >= PAIRS.length;
      let s = "";
      let start = 0;
      SENT.forEach((sw, si) => { let x = 30; sw.forEach((w, wi) => { const inPair = k >= 0 && k < PAIRS.length && (k === start + wi || k === start + wi - 1); s += txt(x, 30 + si * 22, w, `font-size="12.5" font-weight="${inPair ? 700 : 400}" fill="${inPair ? GOLD : INK}"`); x += w.length * 8 + 14; }); start += sw.length - 1; });
      s += txt(330, 22, probs ? "P(next | previous)" : "counts", `font-size="12" font-weight="700" fill="${INK}"`);
      COLS.forEach((cname, j) => (s += txt(400 + j * 58, 46, cname, `font-size="10.5" text-anchor="middle" fill="${MUTED}"`)));
      const sc = score(), used = new Set(sc.f.map((x) => `${x.a} ${x.b}`));
      ROWS.forEach((r, i) => {
        s += txt(330, 74 + i * 30, r, `font-size="11.5" fill="${MUTED}"`);
        COLS.forEach((cname, j) => {
          const key = `${r} ${cname}`, v = c[key] ?? 0, hot = k >= 0 && k < PAIRS.length && PAIRS[k][0] === r && PAIRS[k][1] === cname, scoring = k > PAIRS.length && used.has(key);
          const val = probs ? (full[key] ? fmt(P(r, cname), 3) : "0") : v ? String(v) : "";
          s += `<rect x="${372 + j * 58}" y="${58 + i * 30}" width="54" height="26" rx="4" fill="${hot ? TINT : scoring ? (full[key] ? "#E3EFE9" : "#F6DCD5") : "#fff"}" stroke="${scoring ? (full[key] ? JADE : NEG) : "#e3e7e6"}"/>` + txt(399 + j * 58, 75 + i * 30, val, `font-size="11.5" font-weight="700" text-anchor="middle" fill="${val === "0" ? "#B9C0BF" : INK}"`);
        });
      });
      if (k > PAIRS.length) s += txt(30, 270, `"${sent}": ${sc.f.map((x) => fmt(x.p, 3)).join(" × ")} = ${fmt(sc.total, 3)}`, `font-size="14" font-weight="700" fill="${sc.total ? INK : NEG}"`);
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 0.8 });
    root.querySelectorAll<HTMLButtonElement>("[data-s]").forEach((b) => b.addEventListener("click", () => { sent = b.dataset.s!; root.querySelectorAll("[data-s]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
