---
// Foundations, optimisers post: plain descent, momentum, RMSProp and Adam
// from (4, 1) on the bowl w₁² + 4w₂² or the long valley 0.1w₁² + 4w₂².
// Defaults η 0.2 / 0.05 (β 0.9) / 0.3 (β 0.9) / 0.5 (0.9, 0.999). Losses at
// step 10, bowl: 0.0007, 6.61, 0.215, 0.301; long valley: 0.707, 1.685,
// 0.022, 0.147. All numbers come from src/lib/optimisers.ts.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-race4>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 300" role="img" aria-labelledby="or-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="or-title">Four optimisers walking the same landscape, with their loss over time</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Show the arithmetic of</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-sel="plain" aria-pressed="false">Plain</button>
      <button type="button" class="fig-chip" data-sel="momentum" aria-pressed="false">Momentum</button>
      <button type="button" class="fig-chip" data-sel="rmsprop" aria-pressed="false">RMSProp</button>
      <button type="button" class="fig-chip" data-sel="adam" aria-pressed="true">Adam</button>
    </div></div>
    <div><span class="fig-panel__name">Landscape</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-land="1" aria-pressed="true">Bowl w₁² + 4w₂²</button>
      <button type="button" class="fig-chip" data-land="0.1" aria-pressed="false">Long valley 0.1w₁² + 4w₂²</button>
    </div></div>
    <div><span class="fig-panel__name">Schedule</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-cos aria-pressed="false">Cosine decay over 60 steps</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, JADE } from "../../lib/net-diagram";
  import { frame, txt, bowlContours, OPT_COL, OPT_NAME } from "../../lib/plot";
  import { run, bowl, type Kind, type StepLog, type Vec } from "../../lib/optimisers";
  const KINDS: Kind[] = ["plain", "momentum", "rmsprop", "adam"];
  const OPTS = { plain: { eta: 0.2 }, momentum: { eta: 0.05, beta: 0.9 }, rmsprop: { eta: 0.3, beta: 0.9 }, adam: { eta: 0.5, beta1: 0.9, beta2: 0.999 } };
  const N = 60;
  const vf = (v: Vec, d = 4) => `(${v.map((x) => fmt(x, d)).join(", ")})`;
  document.querySelectorAll<HTMLElement>("[data-race4]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let sel: Kind = "adam", a = 1, cos = false;
    const runs = () => {
      const B = bowl(a, 4), sched = (k: Kind) => (t: number) => OPTS[k].eta * (cos ? 0.5 * (1 + Math.cos((Math.PI * t) / N)) : 1);
      return { B, r: Object.fromEntries(KINDS.map((k) => [k, run(k, B.grad, [4, 1], OPTS[k], N, sched(k))])) as Record<Kind, StepLog[]> };
    };
    const explain = (k: Kind, s: StepLog, prev: StepLog | undefined, L: number) => {
      const g = `g = (2 × ${fmt(a)} × ${par(s.w[0], 4)}, 8 × ${par(s.w[1], 4)}) = ${vf(s.g)}`;
      const end = `new w = ${vf(s.w)} − ${vf(s.step)} = ${vf(s.next)}, loss ${fmt(L, 4)}`;
      const z = [0, 0];
      if (k === "plain") return `${g}\nstep = η × g = ${vf(s.step)}\n${end}`;
      if (k === "momentum") return `${g}\nv = 0.9 × ${vf(prev?.state.v ?? z)} + g = ${vf(s.state.v)}\nstep = η × v = ${vf(s.step)}\n${end}`;
      if (k === "rmsprop") return `${g}\ns = 0.9 × ${vf(prev?.state.s ?? z)} + 0.1 × g² = ${vf(s.state.s)}, √s = ${vf(s.state.s.map(Math.sqrt))}\nstep = η × g / √s = ${vf(s.step)}\n${end}`;
      return `${g}\nm = 0.9 × ${vf(prev?.state.m ?? z)} + 0.1 × g = ${vf(s.state.m)};  v = 0.999 × ${vf(prev?.state.v ?? z)} + 0.001 × g² = ${vf(s.state.v, 6)}\nm̂ = m / ${fmt(s.state.c[0], 6)} = ${vf(s.state.mh)};  v̂ = v / ${fmt(s.state.c[1], 6)} = ${vf(s.state.vh)}\nstep = η × m̂ / √v̂ = ${vf(s.step)}\n${end}`;
    };
    const steps = () => {
      const { B, r } = runs();
      return Array.from({ length: N }, (_, i) => ({
        say: i === 0 ? `All four take their first step from (4, 1). Below: ${OPT_NAME[sel]}'s arithmetic.` : i === 9 ? `Step 10. ${a === 1 ? "On this round bowl, tuned plain descent is already at the bottom." : "On the long valley, RMSProp and Adam are far ahead: their steps do not care how flat a direction is."}` : `Step ${i + 1}: ${OPT_NAME[sel]}.`,
        math: explain(sel, r[sel][i], r[sel][i - 1], B.L(r[sel][i].next)),
      }));
    };
    function draw(k: number) {
      const { B, r } = runs(), n = k + 1;
      const F = frame({ l: 30, t: 30, w: 400, h: 200, x0: -5, x1: 5, y0: -2.5, y1: 2.5 });
      let s = `<clipPath id="or-clip"><rect x="30" y="30" width="400" height="200"/></clipPath>` + F.grid([-4, -2, 0, 2, 4], [-2, 0, 2], 0);
      s += `<g clip-path="url(#or-clip)">${bowlContours(F, a, 4, [0.25, 1, 2.5, 5, 10, 20, 40], JADE)}`;
      KINDS.forEach((kd) => {
        const pts = [[4, 1], ...r[kd].slice(0, n).map((x) => x.next)];
        s += `<polyline fill="none" stroke="${OPT_COL[kd]}" stroke-width="${kd === sel ? 2.6 : 1.4}" stroke-opacity="${kd === sel ? 1 : 0.6}" points="${pts.map((p) => `${F.X(p[0]).toFixed(1)},${F.Y(p[1]).toFixed(1)}`).join(" ")}"/>`;
        const p = pts[pts.length - 1]; s += `<circle cx="${F.X(p[0])}" cy="${F.Y(p[1])}" r="${kd === sel ? 6 : 4.5}" fill="${OPT_COL[kd]}" stroke="#fff" stroke-width="1.5"/>`;
      });
      s += `</g>` + txt(30, 18, `${a === 1 ? "Bowl w₁² + 4w₂²" : "Long valley 0.1w₁² + 4w₂²"}, all starting at (4, 1)`, `font-size="12" font-weight="700" fill="${INK}"`);
      // Loss over steps on a log scale.
      const lx = (t: number) => 490 + (t / N) * 250, ly = (v: number) => 230 - ((Math.log10(Math.max(v, 1e-4)) + 4) / 5.5) * 200;
      s += txt(490, 18, "Loss after each step (log scale)", `font-size="12" font-weight="700" fill="${INK}"`);
      [10, 1, 0.01, 0.0001].forEach((v) => (s += `<line x1="490" x2="740" y1="${ly(v)}" y2="${ly(v)}" stroke="#eef0f0"/>` + txt(484, ly(v) + 4, fmt(v, 4), `font-size="10" text-anchor="end" fill="${MUTED}"`)));
      [0, 20, 40, 60].forEach((t) => (s += txt(lx(t), 246, String(t), `font-size="10" text-anchor="middle" fill="${MUTED}"`)));
      s += `<line x1="${lx(n)}" x2="${lx(n)}" y1="30" y2="230" stroke="${MUTED}" stroke-dasharray="3 3"/>`;
      KINDS.forEach((kd, j) => {
        const ls = [B.L([4, 1]), ...r[kd].map((x) => B.L(x.next))];
        s += `<polyline fill="none" stroke="${OPT_COL[kd]}" stroke-width="${kd === sel ? 2.4 : 1.3}" points="${ls.slice(0, n + 1).map((v, t) => `${lx(t).toFixed(1)},${ly(v).toFixed(1)}`).join(" ")}"/>`;
        s += `<rect x="${30 + j * 105}" y="262" width="12" height="4" fill="${OPT_COL[kd]}"/>` + txt(46 + j * 105, 268, OPT_NAME[kd], `font-size="11.5" font-weight="${kd === sel ? 700 : 400}" fill="${INK}"`);
        s += txt(46 + j * 105, 286, `loss ${fmt(ls[n], 4)}`, `font-size="11" fill="${MUTED}"`);
      });
      s += txt(490, 286, `η: plain 0.2, momentum 0.05, RMSProp 0.3, Adam 0.5${cos ? ", all with cosine decay" : ""}`, `font-size="10.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
    }
    const redraw = stepper(root, steps, draw, { delay: 0.55 });
    const pick = (attr: string, f: (v: string) => void) => root.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => b.addEventListener("click", () => { root.querySelectorAll(`[${attr}]`).forEach((o) => o.setAttribute("aria-pressed", String(o === b))); f(b.getAttribute(attr)!); redraw(); }));
    pick("data-sel", (v) => (sel = v as Kind)); pick("data-land", (v) => (a = +v));
    $<HTMLButtonElement>("[data-cos]").addEventListener("click", (e) => { cos = !cos; (e.currentTarget as HTMLElement).setAttribute("aria-pressed", String(cos)); redraw(); });
  });
</script>
