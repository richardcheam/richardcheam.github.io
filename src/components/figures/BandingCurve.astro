---
// Model development, "Building a pre-training corpus": how 14 buckets of 8
// minhashes turn similarity s into a match probability, built one factor at a
// time and read off at s = 0.75 (0.75, 0.100, 0.228, 0.772). FineWeb App. E.1
// reports 56%, 77%, 92% and 98.8% at s = 0.7, 0.75, 0.8, 0.85; values match
// scripts/course/p2_corpus.py.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-banding-curve>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 330" role="img" aria-labelledby="bc-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="bc-title">Probability that two documents are matched as duplicates against their similarity, built from one hash, one bucket of eight, and fourteen buckets</title>
    <g data-draw></g>
  </svg>
  <noscript><p>At similarity 0.75 one minhash agrees with probability 0.75, all eight in a bucket with probability about 0.100, none of fourteen buckets with probability about 0.228, so the pair is matched with probability about 0.77. The curve rises steeply around 0.72: about 5% at 0.5 and 98.8% at 0.85.</p></noscript>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { INK, MUTED, JADE, GOLD, NEG } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  const R = 8, B = 14, S0 = 0.75;
  const CURVES = [
    { f: (s: number) => s, label: "s", say: "one minhash agrees", col: MUTED },
    { f: (s: number) => s ** R, label: "s⁸", say: "all 8 in one bucket agree", col: "#3E6E9E" },
    { f: (s: number) => (1 - s ** R) ** B, label: "(1 − s⁸)¹⁴", say: "no bucket of 14 agrees", col: NEG },
    { f: (s: number) => 1 - (1 - s ** R) ** B, label: "1 − (1 − s⁸)¹⁴", say: "matched: some bucket agrees", col: JADE },
  ];
  const pct = (v: number) => (v >= 0.95 ? `${(v * 100).toFixed(1)}%` : `${Math.round(v * 100)}%`);
  document.querySelectorAll<HTMLElement>("[data-banding-curve]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const F = frame({ l: 62, t: 22, w: 400, h: 250, x0: 0, x1: 1, y0: 0, y1: 1 });
    const steps = () => [
      { say: "Take two documents with similarity s. One minhash agrees with probability s, the result from the previous figure. Follow s = 0.75.", math: "P(one minhash agrees) = s = 0.75" },
      { say: "A bucket needs all 8 of its minhashes to agree. They are independent, so multiply: agreement in one bucket is rare unless s is high.", math: "P(bucket agrees) = s⁸ = 0.75⁸ ≈ 0.100" },
      { say: "The pair is missed only if every one of the 14 buckets fails.", math: "P(no bucket agrees) = (1 − s⁸)¹⁴ ≈ 0.900¹⁴ ≈ 0.228" },
      { say: "So the pair is matched with the complement. At s = 0.75 that is about 77%.", math: "P(matched) = 1 − (1 − s⁸)¹⁴ ≈ 1 − 0.228 ≈ 0.77" },
      { say: "Read the whole curve: pairs below about 0.5 are almost never matched, pairs above 0.85 almost always. The curve is steepest near 0.72 (shaded): that is where the threshold effectively lies.", math: "s = 0.5 → 5%,  s = 0.7 → 56%,  s = 0.85 → 98.8%" },
    ];
    function draw(k: number) {
      let s = F.grid([0, 0.25, 0.5, 0.75, 1], [0, 0.25, 0.5, 0.75, 1], 2);
      s += txt(F.X(0.5), 306, "similarity s of the two documents", `font-size="11.5" text-anchor="middle" fill="${MUTED}"`);
      s += `<text x="16" y="${F.Y(0.5)}" font-size="11.5" text-anchor="middle" fill="${MUTED}" transform="rotate(-90 16 ${F.Y(0.5)})">probability</text>`;
      const shown = k >= 4 ? 3 : k;
      // Every curve is always drawn, in the same order, so steps glide; future curves are invisible.
      CURVES.forEach((c, i) => {
        const op = i > shown || k < 0 ? 0 : i === shown || (k >= 4 && i === 3) ? 1 : 0.28;
        s += F.curve(c.f, `stroke="${c.col}" stroke-width="${i === 3 ? 3 : 2}" stroke-opacity="${op}"`);
      });
      if (k >= 4) {
        const t = (1 / B) ** (1 / R);
        s += `<rect x="${F.X(0.62)}" y="${F.Y(1)}" width="${F.X(0.82) - F.X(0.62)}" height="${F.Y(0) - F.Y(1)}" fill="${JADE}" fill-opacity="0.07"/>`;
        s += `<line x1="${F.X(t)}" x2="${F.X(t)}" y1="${F.Y(0)}" y2="${F.Y(1)}" stroke="${JADE}" stroke-dasharray="4 4"/>`;
        // Label offsets keep each reading clear of the curve: right of the low point, left of the others.
        ([[0.5, 10, 4, "start"], [0.7, -10, 4, "end"], [0.85, -10, 14, "end"]] as const).forEach(([v, dx, dy, anchor]) => { const p = CURVES[3].f(v); s += `<circle cx="${F.X(v)}" cy="${F.Y(p)}" r="5" fill="#fff" stroke="${JADE}" stroke-width="2"/>` + txt(F.X(v) + dx, F.Y(p) + dy, `${pct(p)} at ${v}`, `font-size="11" font-weight="700" fill="${JADE}" text-anchor="${anchor}" paint-order="stroke" stroke="#fff" stroke-width="3"`); });
      }
      // The reading at s = 0.75 for the current factor.
      if (k >= 0 && k <= 3) {
        const v = CURVES[k].f(S0);
        s += `<line x1="${F.X(S0)}" x2="${F.X(S0)}" y1="${F.Y(0)}" y2="${F.Y(v)}" stroke="${GOLD}" stroke-dasharray="3 3"/><line x1="${F.X(0)}" x2="${F.X(S0)}" y1="${F.Y(v)}" y2="${F.Y(v)}" stroke="${GOLD}" stroke-dasharray="3 3"/>`;
        s += `<circle cx="${F.X(S0)}" cy="${F.Y(v)}" r="5.5" fill="${CURVES[k].col}"/>`;
      }
      // Legend and readout.
      const L = 500;
      CURVES.forEach((c, i) => {
        const on = k >= 0 && (i <= shown);
        const y = 44 + i * 52;
        s += `<line x1="${L}" x2="${L + 24}" y1="${y - 4}" y2="${y - 4}" stroke="${c.col}" stroke-width="${i === 3 ? 3 : 2}" stroke-opacity="${on ? 1 : 0.15}"/>`;
        s += txt(L + 32, y, c.label, `font-size="13" font-weight="700" fill="${on ? INK : "#B9C0BF"}"`);
        s += txt(L + 32, y + 17, c.say, `font-size="11" fill="${on ? MUTED : "#C8CFCE"}"`);
        if (on && k <= 3) s += txt(748, y, `${CURVES[i].f(S0).toFixed(3)}`, `font-size="12.5" text-anchor="end" font-weight="700" fill="${c.col}"`);
      });
      if (k >= 0 && k <= 3) s += txt(748, 254, "at s = 0.75", `font-size="11" text-anchor="end" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
    }
    stepper(root, steps, draw, { delay: 2.6 });
  });
</script>
