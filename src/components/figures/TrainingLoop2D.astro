---
// Figure 7: the conditional flow matching recipe (Eq 23, sigma_min = 0.01)
// training a real network in the page. MLP: input (x, y, t), two hidden
// layers of 64 SiLU units, output a 2-D velocity; Adam, batch 256, up to
// 3000 steps, on the 8-point ring. The loss floor is the average squared gap
// between the per-example target and the true marginal velocity (Eq 8),
// estimated from 10,000 samples.
const { alt } = Astro.props;
const steps = [
  "Take a batch of real data points <i>x</i><sub>1</sub>.",
  "Draw noise <i>x</i><sub>0</sub> and a random time <i>t</i> for each.",
  "Mix them: <i>x</i><sub><i>t</i></sub> = (1 − 0.99<i>t</i>) <i>x</i><sub>0</sub> + <i>t x</i><sub>1</sub>.",
  "Ask the network for its velocity at (<i>x</i><sub><i>t</i></sub>, <i>t</i>).",
  "Score the squared miss against <i>x</i><sub>1</sub> − 0.99 <i>x</i><sub>0</sub>, and nudge the weights.",
];
---
<div class="blog-diagram tl" role="region" aria-label={alt} data-tl>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 400" role="img" aria-labelledby="tl-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="tl-title">A small network learning velocities by conditional flow matching, with its loss curve</title>
    <text x="20" y="20" font-size="11.5" font-weight="700" fill="#2b2b30">16 examples from the current batch</text>
    <rect x="20" y="30" width="340" height="340" fill="none" stroke="#ececf1" />
    <g data-ring></g>
    <g data-batch></g>
    <g data-samples></g>
    <text x="20" y="390" font-size="10.5" fill="#4F5D3A">green: target velocity</text>
    <text x="160" y="390" font-size="10.5" fill="#594578">purple: the network's guess</text>
    <text x="400" y="20" font-size="11.5" font-weight="700" fill="#2b2b30">Loss while training</text>
    <rect x="430" y="30" width="330" height="300" fill="none" stroke="#ececf1" />
    <g data-yt></g>
    <line data-floor x1="430" x2="760" stroke="#a33b3b" stroke-dasharray="5 4" />
    <text data-floort x="756" font-size="10.5" text-anchor="end" fill="#a33b3b"></text>
    <path data-curve d="" fill="none" stroke="#2b2b30" stroke-width="1.8" />
    <text x="430" y="346" font-size="10.5" fill="#5f5f66">0</text>
    <text x="760" y="346" font-size="10.5" text-anchor="end" fill="#5f5f66">3000 steps</text>
    <text data-st x="430" y="370" font-size="12" fill="#2b2b30"></text>
    <text data-st2 x="430" y="390" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <ol class="tl__steps">
    {steps.map((s, i) => <li data-li={i} set:html={s} />)}
  </ol>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Training</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-train>Train</button>
      <button type="button" class="fig-chip" data-one>One step, slowly</button>
      <button type="button" class="fig-chip" data-sample>Generate with it</button>
      <button type="button" class="fig-chip" data-reset>Reset</button>
    </div></div>
    <div><span class="fig-panel__name">Learning rate</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-lr="0.001" aria-pressed="true">0.001</button>
      <button type="button" class="fig-chip" data-lr="0.003" aria-pressed="false">0.003</button>
    </div></div>
  </div>
</div>

<style>
  .tl__steps { margin: 0.6rem 0 0.4rem 1.4rem; font-size: 0.86rem; line-height: 1.5; }
  .tl__steps li { padding: 0 0.3rem; border-radius: 3px; transition: background-color 0.2s; }
  .tl__steps li.is-on { background: rgba(163, 59, 59, 0.12); }
</style>

<script>
  import { wait } from "../../lib/figure-motion";
  import { rng, gauss, marginal, RING, SIGMA_MIN, type Vec } from "../../lib/flow-math";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-tl]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const X = (v: number) => 190 + v * 30, Y = (v: number) => 200 - v * 30;
    RING.forEach((c) => { const e = document.createElementNS(NS, "circle"); e.setAttribute("cx", String(X(c[0]))); e.setAttribute("cy", String(Y(c[1]))); e.setAttribute("r", "10"); e.setAttribute("fill", "#ececf1"); $("[data-ring]").append(e); });
    const H = 64, B = 256, MAX = 3000, K = 1 - SIGMA_MIN;
    // Parameters: W1 (3 x H), b1, W2 (H x H), b2, W3 (H x 2), b3, in one array.
    const sizes = [3 * H, H, H * H, H, H * 2, 2], offs: number[] = []; let n = 0; sizes.forEach((s) => { offs.push(n); n += s; });
    let w = new Float64Array(n), m = new Float64Array(n), v2 = new Float64Array(n), step = 0, lr = 0.001, losses: number[] = [];
    let g = gauss(1), u = rng(2);
    function init() {
      const gi = gauss(5);
      w = new Float64Array(n); m = new Float64Array(n); v2 = new Float64Array(n); step = 0; losses = []; g = gauss(1); u = rng(2);
      const fan = [3, 1, H, 1, H, 1];
      sizes.forEach((s, i) => { if (i % 2 === 0) for (let j = 0; j < s; j++) w[offs[i] + j] = gi() * Math.sqrt(2 / fan[i]); });
    }
    const silu = (z: number) => z / (1 + Math.exp(-z)), dsilu = (z: number) => { const s = 1 / (1 + Math.exp(-z)); return s * (1 + z * (1 - s)); };
    function forward(inp: number[]) {
      const [W1, b1, W2, b2, W3, b3] = offs;
      const z1 = new Float64Array(H), a1 = new Float64Array(H), z2 = new Float64Array(H), a2 = new Float64Array(H);
      for (let j = 0; j < H; j++) { let s = w[b1 + j]; for (let i = 0; i < 3; i++) s += inp[i] * w[W1 + i * H + j]; z1[j] = s; a1[j] = silu(s); }
      for (let j = 0; j < H; j++) { let s = w[b2 + j]; for (let i = 0; i < H; i++) s += a1[i] * w[W2 + i * H + j]; z2[j] = s; a2[j] = silu(s); }
      const out = [w[b3], w[b3 + 1]];
      for (let i = 0; i < H; i++) { out[0] += a2[i] * w[W3 + i * 2]; out[1] += a2[i] * w[W3 + i * 2 + 1]; }
      return { z1, a1, z2, a2, out };
    }
    const net = (x: Vec, t: number) => forward([x[0], x[1], t]).out;
    type Ex = { x0: Vec; x1: Vec; t: number; xt: Vec; target: Vec };
    const sample = (): Ex => {
      const x1 = RING[Math.floor(u() * 8)], x0: Vec = [g(), g()], t = u();
      const xt: Vec = [(1 - K * t) * x0[0] + t * x1[0], (1 - K * t) * x0[1] + t * x1[1]];
      return { x0, x1, t, xt, target: [x1[0] - K * x0[0], x1[1] - K * x0[1]] };
    };
    let shown: Ex[] = [];
    function trainStep() {
      const grad = new Float64Array(n), [W1, b1, W2, b2, W3, b3] = offs; let loss = 0;
      const batch = Array.from({ length: B }, sample); shown = batch.slice(0, 16);
      for (const ex of batch) {
        const inp = [ex.xt[0], ex.xt[1], ex.t], f = forward(inp);
        const e0 = f.out[0] - ex.target[0], e1 = f.out[1] - ex.target[1]; loss += e0 * e0 + e1 * e1;
        const d0 = (2 * e0) / B, d1 = (2 * e1) / B;
        grad[b3] += d0; grad[b3 + 1] += d1;
        const da2 = new Float64Array(H);
        for (let i = 0; i < H; i++) { grad[W3 + i * 2] += f.a2[i] * d0; grad[W3 + i * 2 + 1] += f.a2[i] * d1; da2[i] = w[W3 + i * 2] * d0 + w[W3 + i * 2 + 1] * d1; }
        const dz2 = da2.map((d, j) => d * dsilu(f.z2[j])), da1 = new Float64Array(H);
        for (let j = 0; j < H; j++) { grad[b2 + j] += dz2[j]; }
        for (let i = 0; i < H; i++) { let s = 0; const ai = f.a1[i], row = W2 + i * H; for (let j = 0; j < H; j++) { grad[row + j] += ai * dz2[j]; s += w[row + j] * dz2[j]; } da1[i] = s; }
        for (let j = 0; j < H; j++) { const dz = da1[j] * dsilu(f.z1[j]); grad[b1 + j] += dz; for (let i = 0; i < 3; i++) grad[W1 + i * H + j] += inp[i] * dz; }
      }
      step++;
      const b1c = 1 - 0.9 ** step, b2c = 1 - 0.999 ** step;
      for (let i = 0; i < n; i++) { m[i] = 0.9 * m[i] + 0.1 * grad[i]; v2[i] = 0.999 * v2[i] + 0.001 * grad[i] * grad[i]; w[i] -= (lr * (m[i] / b1c)) / (Math.sqrt(v2[i] / b2c) + 1e-8); }
      losses.push(loss / B);
    }
    // Loss floor: E || per-example target - marginal velocity ||^2, 10,000 samples.
    let floor = 0; { const keep = [g, u]; g = gauss(99); u = rng(98); for (let i = 0; i < 10000; i++) { const ex = sample(), mu = marginal("ot", ex.t, ex.xt).u; floor += (ex.target[0] - mu[0]) ** 2 + (ex.target[1] - mu[1]) ** 2; } floor /= 10000; [g, u] = keep; }
    const YMAX = 24, LX = (s: number) => 430 + (s / MAX) * 330, LY = (l: number) => 330 - (Math.min(l, YMAX) / YMAX) * 300;
    [0, 6, 12, 18, 24].forEach((l) => { const e = document.createElementNS(NS, "text"); e.setAttribute("x", "424"); e.setAttribute("y", String(LY(l) + 4)); e.setAttribute("font-size", "10"); e.setAttribute("text-anchor", "end"); e.setAttribute("fill", "#5f5f66"); e.textContent = String(l); $("[data-yt]").append(e); });
    $("[data-floor]").setAttribute("y1", String(LY(floor))); $("[data-floor]").setAttribute("y2", String(LY(floor)));
    const ft = $("[data-floort]"); ft.setAttribute("y", String(LY(floor) + 15)); ft.textContent = `floor ${floor.toFixed(2)}: the spread of the targets`;
    const arrow = (gp: Element, p: Vec, d: Vec, col: string) => { const l = document.createElementNS(NS, "line"); l.setAttribute("x1", String(X(p[0]))); l.setAttribute("y1", String(Y(p[1]))); l.setAttribute("x2", String(X(p[0] + d[0] * 0.18))); l.setAttribute("y2", String(Y(p[1] + d[1] * 0.18))); l.setAttribute("stroke", col); l.setAttribute("stroke-width", "1.8"); gp.append(l); };
    function draw(stage = 5) {
      const gb = $("[data-batch]"); gb.replaceChildren();
      shown.forEach((ex) => {
        if (stage >= 1) { const l = document.createElementNS(NS, "line"); l.setAttribute("x1", String(X(ex.x0[0]))); l.setAttribute("y1", String(Y(ex.x0[1]))); l.setAttribute("x2", String(X(ex.x1[0]))); l.setAttribute("y2", String(Y(ex.x1[1]))); l.setAttribute("stroke", "#b9b9c2"); l.setAttribute("stroke-width", "0.8"); gb.append(l); }
        if (stage >= 2) { const c = document.createElementNS(NS, "circle"); c.setAttribute("cx", String(X(ex.xt[0]))); c.setAttribute("cy", String(Y(ex.xt[1]))); c.setAttribute("r", "3"); c.setAttribute("fill", "#2b2b30"); gb.append(c); }
        if (stage >= 3) arrow(gb, ex.xt, net(ex.xt, ex.t) as Vec, "#594578");
        if (stage >= 4) arrow(gb, ex.xt, ex.target, "#4F5D3A");
      });
      const sm: number[] = []; let e = losses[0] ?? 0; losses.forEach((l) => { e = 0.95 * e + 0.05 * l; sm.push(e); });
      $("[data-curve]").setAttribute("d", sm.map((l, i) => `${i ? "L" : "M"}${LX(i + 1).toFixed(1)} ${LY(l).toFixed(1)}`).join(""));
      $("[data-st]").textContent = step ? `Step ${step}: loss ${sm[sm.length - 1].toFixed(2)} (floor ${floor.toFixed(2)})` : "Press Train. The network starts knowing nothing.";
      $("[data-st2]").textContent = step > 800 ? "The loss stops at the floor by design: no network can beat it." : "Each step uses 256 fresh examples and no ODE solver.";
    }
    const lis = [...root.querySelectorAll<HTMLElement>("[data-li]")];
    const mark = (i: number) => lis.forEach((l, j) => l.classList.toggle("is-on", j === i));
    let running = false, token = 0;
    async function train() {
      running = true; const my = ++token; $("[data-train]").textContent = "Pause"; mark(-1);
      while (running && my === token && step < MAX) { for (let k = 0; k < 4 && step < MAX; k++) trainStep(); draw(); $("[data-samples]").replaceChildren(); await new Promise(requestAnimationFrame); }
      running = false; $("[data-train]").textContent = step >= MAX ? "Done" : "Train";
    }
    $("[data-train]").addEventListener("click", () => { if (running) { running = false; token++; $("[data-train]").textContent = "Train"; } else train(); });
    $("[data-one]").addEventListener("click", async () => {
      running = false; const my = ++token; $("[data-train]").textContent = "Train"; $("[data-samples]").replaceChildren();
      shown = Array.from({ length: 16 }, sample);
      for (let s = 0; s < 5; s++) { if (my !== token) return; mark(s); draw(s); await wait(0.9); }
      trainStep(); draw(); mark(-1);
    });
    $("[data-sample]").addEventListener("click", async () => {
      running = false; const my = ++token; $("[data-train]").textContent = "Train"; $("[data-batch]").replaceChildren();
      const gs = gauss(17), pts: Vec[] = Array.from({ length: 300 }, () => [gs(), gs()]), gp = $("[data-samples]"); gp.replaceChildren();
      const dots = pts.map(() => { const c = document.createElementNS(NS, "circle"); c.setAttribute("r", "2.2"); c.setAttribute("fill", "#594578"); gp.append(c); return c; });
      const N = 20;
      for (let k = 0; k <= N; k++) {
        if (my !== token) return;
        dots.forEach((c, i) => { c.setAttribute("cx", X(pts[i][0]).toFixed(1)); c.setAttribute("cy", Y(pts[i][1]).toFixed(1)); });
        if (k === N) break;
        pts.forEach((p, i) => { const vv = net(p, k / N); pts[i] = [p[0] + vv[0] / N, p[1] + vv[1] / N]; });
        await wait(0.08);
      }
      $("[data-st2]").textContent = step < 300 ? "Too little training: the grains do not reach the ring yet." : "300 new grains, 20 Euler steps with the trained network.";
    });
    $("[data-reset]").addEventListener("click", () => { running = false; token++; init(); shown = Array.from({ length: 16 }, sample); $("[data-samples]").replaceChildren(); $("[data-train]").textContent = "Train"; draw(); });
    root.querySelectorAll<HTMLButtonElement>("[data-lr]").forEach((b) => b.addEventListener("click", () => {
      lr = +b.dataset.lr!; root.querySelectorAll("[data-lr]").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
    }));
    init(); shown = Array.from({ length: 16 }, sample); draw();
  });
</script>
