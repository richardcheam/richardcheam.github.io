---
// Khmer script post, Figure 5: a sentence with no visible spaces. "Show
// hidden" marks zero-width spaces (U+200B). "Find words" runs a greedy
// longest-match segmenter with a four-word toy dictionary over the text with
// the zero-width spaces removed. Sentence: "I love the Khmer language".
const { alt } = Astro.props;
---
<div class="blog-diagram nsr" role="region" aria-label={alt} data-nsr>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 290" role="img" aria-labelledby="nsr-title" class="blog-diagram-svg" font-family="Inter, 'Noto Sans Khmer', 'Khmer Sangam MN', sans-serif">
    <title id="nsr-title">A Khmer sentence with hidden word breaks, and a simple segmenter finding the words</title>
    <g data-line></g>
    <text data-r1 x="20" y="236" font-size="12.5" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="258" font-size="12" fill="#2b2b30"></text>
    <text data-r3 x="20" y="280" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Do</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-show aria-pressed="false">Show hidden characters</button>
      <button type="button" class="fig-chip" data-seg>Find words</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-nsr]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const WORDS = [["ខ្ញុំ", "I"], ["ស្រលាញ់", "love"], ["ភាសា", "language"], ["ខ្មែរ", "Khmer"]];
    const SENT = WORDS.map((w) => w[0]).join("​"), PLAIN = SENT.replace(/​/g, "");
    // Greedy longest match over code points.
    const segment = (s: string) => { const out: string[] = []; let i = 0; const cp = [...s]; while (i < cp.length) { let best = 1; for (const [w] of WORDS) { const n = [...w].length; if (cp.slice(i, i + n).join("") === w && n > best) best = n; } out.push(cp.slice(i, i + best).join("")); i += best; } return out; };
    const SEG = segment(PLAIN);
    let show = false, found = 0;
    function draw() {
      const g = $("[data-line]"); g.replaceChildren();
      mk(g, "text", { x: 20, y: 22, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "On screen");
      mk(g, "text", { x: 20, y: 90, "font-size": 48, fill: "#2b2b30" }, PLAIN);
      if (show) {
        // Approximate the position of each hidden break with a measuring text.
        let x = 20;
        WORDS.forEach(([w], i) => {
          const t = mk(g, "text", { x, y: 90, "font-size": 48, fill: "none" }, w) as SVGTextElement, wd = t.getComputedTextLength(); t.remove();
          x += wd;
          if (i < WORDS.length - 1) { mk(g, "line", { x1: x, x2: x, y1: 36, y2: 104, stroke: "#a33b3b", "stroke-width": 2, "stroke-dasharray": "3 3" }); mk(g, "text", { x, y: 32, "font-size": 9.5, "text-anchor": "middle", fill: "#a33b3b" }, "U+200B"); }
        });
      }
      mk(g, "text", { x: 20, y: 140, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "Words found by longest match");
      let x = 20;
      SEG.slice(0, found).forEach((w) => {
        const t = mk(g, "text", { x: x + 8, y: 186, "font-size": 28, fill: "#2b2b30" }, w) as SVGTextElement, wd = t.getComputedTextLength() + 16;
        mk(g, "rect", { x, y: 152, width: wd, height: 46, rx: 6, fill: "none", stroke: "#594578", "stroke-width": 2 });
        const gl = WORDS.find((q) => q[0] === w)?.[1] ?? "?";
        mk(g, "text", { x: x + wd / 2, y: 214, "font-size": 10.5, "text-anchor": "middle", fill: "#594578" }, gl);
        x += wd + 10;
      });
      const n1 = [...SENT].length, n2 = [...PLAIN].length;
      $("[data-r1]").textContent = `With the hidden breaks: ${n1} code points. Without: ${n2}. Both look identical on screen.`;
      $("[data-r2]").textContent = found ? `Toy dictionary: ${WORDS.map((w) => w[0]).join(", ")}. Greedy longest match takes the longest dictionary word at each position.` : "Press Find words.";
      $("[data-r3]").textContent = "Real segmenters use large dictionaries or trained models; this four-word dictionary only shows the idea.";
    }
    $("[data-show]").addEventListener("click", (e) => { show = !show; (e.currentTarget as Element).setAttribute("aria-pressed", String(show)); draw(); });
    const run = async (alive: () => boolean) => { found = 0; draw(); for (let i = 1; i <= SEG.length; i++) { await wait(0.6); if (!alive()) return; found = i; draw(); } };
    let token = 0;
    $("[data-seg]").addEventListener("click", () => { const my = ++token; run(() => my === token); });
    found = SEG.length; draw();
    setupFigure(root, () => { found = 0; draw(); }, run);
  });
</script>
