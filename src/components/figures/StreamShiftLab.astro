---
// DSM review, Figure 3: delay against ambiguity, a toy. Each of eight words
// becomes unambiguous a few frames after it starts (its "clue offset", toy
// values). With delay tau frames, a word is written with confidence if its
// clue arrived within tau; latency is 80 ms per frame of delay.
const { alt } = Astro.props;
---
<div class="blog-diagram ssl" role="region" aria-label={alt} data-ssl>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 260" role="img" aria-labelledby="ssl-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ssl-title">A longer delay lets more words be written after their clue has arrived</title>
    <g data-g></g>
    <text data-r1 x="20" y="214" font-size="13" font-weight="700" fill="#2b2b30"></text>
    <text data-r2 x="20" y="238" font-size="11.5" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Delay τ in frames<strong data-vt></strong></span><input class="scrub" data-t type="range" min="0" max="12" step="1" value="2" /></label>
  </div>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-ssl]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const tIn = $<HTMLInputElement>("[data-t]");
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const WORDS = ["the", "meeting", "with", "Siobhan", "is", "at", "four", "thirty"], CLUE = [0, 0, 1, 3, 0, 6, 2, 10];
    function draw() {
      const tau = +tIn.value, g = $("[data-g]"); g.replaceChildren();
      mk(g, "text", { x: 20, y: 20, "font-size": 11.5, "font-weight": 700, fill: "#2b2b30" }, "Each word, and how many frames after it starts until it is clear");
      let ok = 0;
      WORDS.forEach((w, i) => {
        const x = 20 + i * 92, good = CLUE[i] <= tau; if (good) ok++;
        mk(g, "rect", { x, y: 34, width: 84, height: 54, rx: 6, fill: good ? "#4F5D3A" : "#b8722c", "fill-opacity": good ? 0.85 : 0.35 });
        mk(g, "text", { x: x + 42, y: 60, "font-size": 13, "font-weight": 700, "text-anchor": "middle", fill: good ? "#fff" : "#2b2b30" }, good ? w : `${w}?`);
        mk(g, "text", { x: x + 42, y: 78, "font-size": 10, "text-anchor": "middle", fill: good ? "#fff" : "#2b2b30" }, `clue +${CLUE[i]}`);
        // Clue bar: how far ahead the model must look.
        mk(g, "rect", { x, y: 100, width: Math.max(2, CLUE[i] * 7), height: 10, fill: "#594578", "fill-opacity": 0.6 });
        mk(g, "line", { x1: x + tau * 7, x2: x + tau * 7, y1: 96, y2: 114, stroke: "#a33b3b", "stroke-width": 2 });
      });
      mk(g, "text", { x: 20, y: 136, "font-size": 10.5, fill: "#5f5f66" }, "Purple bar: frames until the word is clear. Red tick: how far the delay lets the model look.");
      mk(g, "text", { x: 20, y: 170, "font-size": 18, "font-weight": 700, fill: "#594578", "font-family": "ui-monospace, monospace" }, `${ok}/8 sure,  ${tau * 80} ms behind`);
      $("[data-r1]").textContent = tau === 0 ? "No delay: only words that are clear the instant they start." : `Delay ${tau} frames = ${tau} × 80 ms = ${tau * 80} ms behind the speaker.`;
      $("[data-r2]").textContent = "Toy clue offsets, not a model of real WER. DSM-ASR's default delay is 2.5 s, about 31 frames (Sec 4.3, p. 8).";
      $("[data-vt]").textContent = String(tau); tIn.style.setProperty("--p", `${(tau / 12) * 100}%`);
    }
    tIn.addEventListener("input", draw);
    draw();
  });
</script>
