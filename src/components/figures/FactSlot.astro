---
// MoshiRAG's timing race on one exchange, on Moshi's 80 ms clock. Moshi starts
// replying at t = 0 and emits <ret>. The paper's "retrieval delay" runs from
// <ret> and includes the 0.5 s ASR wait (Sec 3.1, 3.3.3). The reference then
// streams in one vector per frame for l frames (Eq 2), and should be in before
// the keyword, 3.1 s after the reply starts (Table 1). l comes from an assumed
// 65-token reference (50 words, Table 15 cap) at each encoder's compression.
// The sentence is illustrative.
import { svgMath } from "../../lib/svg-math";
const { alt } = Astro.props;
const T0 = -1.5, T1 = 4.0, X0 = 120, PX = 116, F = 0.08;
const x = (t: number) => X0 + (t - T0) * PX;
const ASR = 0.5, KD = 3.1, LLM = 0.9;
const encoders = [
  { key: "t5", label: "T5, uncompressed", l: 65 },
  { key: "arc4", label: "ARC-Encoder ×4", l: 17 },
  { key: "arc8", label: "ARC-Encoder ×8", l: 9 },
];
const lead = [
  { t: 0.0, w: "Oh," },
  { t: 0.42, w: "the" },
  { t: 0.68, w: "Eiffel" },
  { t: 1.12, w: "Tower!" },
  { t: 1.72, w: "It" },
  { t: 1.9, w: "opened" },
  { t: 2.42, w: "back" },
  { t: 2.74, w: "in" },
];
function wave(t0: number, t1: number, y: number, seed: number, amp = 9) {
  let d = "";
  const n = Math.round((t1 - t0) * 30);
  for (let i = 0; i <= n; i++) {
    const t = t0 + ((t1 - t0) * i) / n;
    const env = 0.35 + 0.65 * Math.abs(Math.sin(seed + i * 0.37)) * Math.sin((Math.PI * i) / n) ** 0.4;
    const a = (2 + amp * Math.abs(Math.sin(seed * 3 + i * 1.3))) * env;
    d += `${i ? "L" : "M"}${x(t).toFixed(1)} ${(y + (i % 2 ? a : -a)).toFixed(1)} `;
  }
  return d.trim();
}
const frames = Array.from({ length: Math.floor((T1 - T0) / F) + 1 }, (_, i) => T0 + i * F);
const MAXL = 65;
---
<div class="blog-diagram fs" role="region" aria-label={alt} data-fs data-cfg={JSON.stringify({ T0, T1, X0, PX, F, ASR, KD, encoders })}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 330" role="img" aria-labelledby="fs-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="fs-title">Asynchronous retrieval racing the keyword</title>
    <defs>
      <clipPath id="fs-clip"><rect data-clip x={x(T0)} y="0" width={x(T1) - x(T0)} height="330" /></clipPath>
      <clipPath id="fs-frame"><rect x={x(T0)} y="0" width={x(T1) - x(T0)} height="330" /></clipPath>
      <marker id="fs-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L8 4 L0 8 z" fill="#594578" /></marker>
    </defs>

    <!-- 80 ms frame grid: the clock everything runs on -->
    <g stroke="#ececf1">
      {frames.map((t) => <line x1={x(t)} y1="44" x2={x(t)} y2="270" />)}
    </g>
    <line x1={x(0)} y1="30" x2={x(0)} y2="274" stroke="#2b2b30" stroke-width="1" stroke-dasharray="2 3" />
    <text x={x(0) + 4} y="36" font-size="10" fill="#2b2b30">you stop · Moshi starts (TTFAT 0.0 s)</text>

    <g font-size="11.5" fill="#2b2b30">
      <text x="14" y="76">you</text>
      <text x="14" y="128">Moshi text</text>
      <text x="14" y="184">Moshi audio</text>
      <text x="14" y="240">back end</text>
    </g>
    <g font-size="9.5" fill="#5f5f66">
      <text x="14" y="88">the question</text>
      <text x="14" y="140">inner monologue</text>
      <text x="14" y="196">what you hear</text>
      <text x="14" y="252">text only, off the clock</text>
    </g>

    <g clip-path="url(#fs-clip)">
      <path d={wave(T0 + 0.05, -0.04, 76, 1.3)} fill="none" stroke="#5f5f66" stroke-width="1.5" stroke-linejoin="round" />
      <text x={x(-1.4)} y="58" font-size="12" fill="#5f5f66" font-style="italic">"When did the Eiffel Tower open?"</text>
      <path d={wave(0.06, T1 - 0.1, 182, 2.1, 11)} fill="none" stroke="#594578" stroke-width="1.5" stroke-linejoin="round" />
      <g font-size="12" fill="#594578">
        {lead.map((l) => <text data-tok={l.t} x={x(l.t) + 2} y="130">{l.w}</text>)}
      </g>
      <g data-tok="0">
        <rect x={x(0) - 1} y="98" width="36" height="16" rx="3" fill="#2b2b30" />
        <text x={x(0) + 17} y="110" font-size="10" fill="#fff" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">&lt;ret&gt;</text>
      </g>
    </g>

    <!-- back end: ASR wait then the LLM or search call -->
    <g data-backend>
      <rect data-bar="asr" x={x(0)} y="226" width={ASR * PX} height="22" fill="#ececf1" stroke="#d5d5dc" />
      <text x={x(ASR / 2)} y="241" font-size="10" text-anchor="middle" fill="#5f5f66">ASR 0.5 s</text>
      <rect data-bar="llm" x={x(ASR)} y="226" width={LLM * PX} height="22" fill="#594578" fill-opacity="0.16" stroke="#594578" stroke-opacity="0.6" />
      <text data-lab="llm" x={x(ASR + LLM / 2)} y="241" font-size="10" text-anchor="middle" fill="#594578">LLM {LLM.toFixed(1)} s</text>
      <path data-drop d={`M${x(ASR + LLM)} 224 V160`} stroke="#594578" stroke-width="1.4" marker-end="url(#fs-arrow)" fill="none" />
    </g>
    <!-- reference markers measured from <ret> -->
    <g font-size="9" fill="#5f5f66">
      <line x1={x(1.5)} y1="254" x2={x(1.5)} y2="266" stroke="#5f5f66" />
      <text x={x(1.5) - 3} y="264" text-anchor="end">accuracy falls past 1.5 s</text>
      <line x1={x(2.0)} y1="254" x2={x(2.0)} y2="266" stroke="#5f5f66" />
      <text x={x(2.0) + 3} y="264">2 s target</text>
    </g>

    <!-- the reference streams in, one vector per 80 ms frame -->
    <g clip-path="url(#fs-frame)" data-vecs>
      {Array.from({ length: MAXL }, (_, k) => (
        <rect data-vec={k} x={x(ASR + LLM + k * F) + 1} y="146" width={F * PX - 2} height="10" rx="1.5" fill="#594578" />
      ))}
    </g>
    <text data-inject-lab x={x(ASR + LLM + 17 * F) + 6} y="155" font-size="11" fill="#594578" set:html={svgMath("h_i + h^{ref}_k, one per frame", 11)} />

    <!-- the keyword -->
    <line x1={x(KD)} y1="48" x2={x(KD)} y2="270" stroke="#a33b3b" stroke-width="1.2" stroke-dasharray="4 3" />
    <text x={x(KD) + 4} y="56" font-size="10" fill="#a33b3b">keyword · 3.1 s</text>
    <g data-key>
      <rect data-keybox x={x(KD) + 4} y="114" width="44" height="22" rx="4" fill="#4F5D3A" fill-opacity="0.14" stroke="#4F5D3A" />
      <text data-keyword x={x(KD) + 26} y="130" font-size="13" font-weight="700" text-anchor="middle" fill="#4F5D3A">1889</text>
    </g>

    <!-- axis -->
    <line x1={x(T0)} y1="274" x2={x(T1)} y2="274" stroke="#d5d5dc" />
    <g font-size="9.5" fill="#5f5f66" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
      {[-1, 0, 1, 2, 3, 4].map((t) => <text x={x(t)} y="288" text-anchor="middle">{t > 0 ? `+${t}` : t} s</text>)}
    </g>
    <text x={x(T1)} y="302" font-size="9.5" fill="#5f5f66" text-anchor="end">grid lines = 80 ms frames (12.5 Hz)</text>
    <text data-verdict x={x(T0)} y="322" font-size="13" font-weight="600" fill="#4F5D3A"></text>
  </svg>
  <div class="fs__controls">
    <label class="fs__ctl">
      <span class="fs__name">Back-end call (LLM or search)<strong data-val>{LLM.toFixed(1)} s</strong></span>
      <input class="scrub" data-input type="range" min="0.1" max="3.0" step="0.1" value={LLM} style={`--n: 29; --p: ${((LLM - 0.1) / 2.9) * 100}%`} />
    </label>
    <div class="fs__chips" role="group" aria-label="Reference encoder">
      <span class="fs__name">Reference encoder, 65-token reference</span>
      <div>
        {encoders.map((e) => <button type="button" class="fs__chip" data-enc={e.key} aria-pressed={e.key === "arc4" ? "true" : "false"}>{e.label} <span>{e.l} frames</span></button>)}
      </div>
    </div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<style>
  .fs__controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.5rem 2rem; margin-top: 0.4rem; font-size: 0.85rem; color: var(--text-secondary); }
  .fs__ctl { display: block; }
  .fs__name { display: flex; gap: 0.5rem; margin-bottom: 0.35rem; }
  .fs__name strong { margin-left: auto; color: var(--text); font-family: var(--font-mono); font-size: 0.8rem; }
  .fs__chips > div { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .fs__chip { padding: 0.25rem 0.55rem; border: 1px solid var(--border-strong); border-radius: 4px; background: transparent; color: var(--text-secondary); font: inherit; font-size: 0.78rem; cursor: pointer; }
  .fs__chip span { font-family: var(--font-mono); font-size: 0.72rem; opacity: 0.75; }
  .fs__chip[aria-pressed="true"] { border-color: #594578; color: var(--text); box-shadow: inset 0 -2px 0 #594578; }
  @media (max-width: 760px) { .fs__controls { grid-template-columns: 1fr; } }
</style>

<script>
  import { animate, dur, reduce, setupFigure, wait } from "../../lib/figure-motion";

  document.querySelectorAll<HTMLElement>("[data-fs]").forEach((root) => {
    const c = JSON.parse(root.dataset.cfg!);
    const x = (t: number) => c.X0 + (t - c.T0) * c.PX;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const input = $<HTMLInputElement>("[data-input]");
    const bar = (k: string) => $<SVGRectElement>(`[data-bar="${k}"]`);
    const toks = Array.from(root.querySelectorAll<SVGElement>("[data-tok]"));
    const vecs = Array.from(root.querySelectorAll<SVGRectElement>("[data-vec]"));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-enc]"));
    const clip = $<SVGRectElement>("[data-clip]");
    const injectLab = $<SVGTextElement>("[data-inject-lab]");
    const drop = $<SVGPathElement>("[data-drop]");
    const key = $<SVGGElement>("[data-key]");
    const keybox = $<SVGRectElement>("[data-keybox]");
    const keyword = $<SVGTextElement>("[data-keyword]");
    const verdict = $<SVGTextElement>("[data-verdict]");
    let enc = c.encoders[1];

    const llm = () => +input.value;
    const arrive = () => c.ASR + llm();
    // How many reference vectors are in before the keyword.
    const before = () => Math.max(0, Math.min(enc.l, Math.floor((c.KD - arrive()) / c.F + 1e-9)));

    function layout() {
      const r = llm(), a = arrive(), n = before();
      $("[data-val]").textContent = `${r.toFixed(1)} s`;
      input.style.setProperty("--p", `${((r - 0.1) / 2.9) * 100}%`);
      bar("llm").setAttribute("width", String(r * c.PX));
      const lab = $("[data-lab=llm]");
      lab.setAttribute("x", String(x(c.ASR + r / 2)));
      lab.textContent = r >= 0.4 ? `LLM ${r.toFixed(1)} s` : "";
      drop.setAttribute("d", `M${x(a)} 224 V160`);
      vecs.forEach((v, k) => {
        v.setAttribute("x", String(x(a + k * c.F) + 1));
        v.style.display = k < enc.l ? "" : "none";
        v.setAttribute("fill", k < n ? "#594578" : "#a33b3b");
        v.setAttribute("fill-opacity", k < n ? "0.85" : "0.35");
      });
      injectLab.setAttribute("x", String(Math.min(x(a + enc.l * c.F) + 6, x(c.T1) - 150)));
      const state = n === enc.l ? "full" : n > 0 ? "part" : "late";
      const ink = state === "full" ? "#4F5D3A" : state === "part" ? "#8a6a1f" : "#a33b3b";
      keybox.setAttribute("stroke", ink); keybox.setAttribute("fill", ink);
      keybox.setAttribute("stroke-dasharray", state === "full" ? "" : "3 2");
      keyword.setAttribute("fill", ink);
      keyword.textContent = state === "late" ? "?" : "1889";
      verdict.setAttribute("fill", ink);
      verdict.textContent =
        state === "full" ? `Retrieval delay ${a.toFixed(1)} s. All ${enc.l} vectors are in ${(c.KD - a - enc.l * c.F).toFixed(2)} s before the keyword.`
        : state === "part" ? `Retrieval delay ${a.toFixed(1)} s. Only ${n} of ${enc.l} vectors are in when the keyword is due.`
        : `Retrieval delay ${a.toFixed(1)} s. The reference arrives after the keyword was due.`;
    }

    const at = (t: number) => {
      clip.setAttribute("width", String(Math.max(0, x(t) - x(c.T0))));
      toks.forEach((el) => (el.style.opacity = +el.dataset.tok! <= t ? "1" : "0"));
      const grow = (k: string, start: number, len: number) => bar(k).setAttribute("width", String(Math.max(0, Math.min(len, t - start)) * c.PX));
      grow("asr", 0, c.ASR); grow("llm", c.ASR, llm());
      const a = arrive();
      drop.style.opacity = t >= a ? "1" : "0";
      injectLab.style.opacity = t >= a ? "1" : "0";
      vecs.forEach((v, k) => (v.style.opacity = t >= a + k * c.F ? "1" : "0"));
      key.style.opacity = t >= c.KD ? "1" : "0";
    };
    const settle = () => { layout(); at(c.T1); verdict.style.opacity = "1"; };

    input.addEventListener("input", settle);
    chips.forEach((b) => b.addEventListener("click", () => {
      enc = c.encoders.find((e: { key: string }) => e.key === b.dataset.enc);
      chips.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      settle();
    }));

    // Play: the clock advances one 80 ms frame at a time. Words appear as Moshi
    // says them, the back end runs beside them, and vectors drip in per frame.
    setupFigure(
      root,
      () => { layout(); at(c.T0); verdict.style.opacity = "0"; },
      async (alive) => {
        for (let t = c.T0; t <= c.T1 + 1e-4; t += c.F) {
          if (!alive()) return;
          at(t);
          await wait(t < 0 ? 0.03 : 0.065);
        }
        settle();
        animate(verdict, { opacity: [0, 1] }, { duration: dur(0.4) });
      },
    );
    if (reduce) settle();
  });
</script>
