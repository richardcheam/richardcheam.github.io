---
const { alt } = Astro.props;
---
<div class="blog-diagram" tabindex="0" role="region" aria-label={alt} data-emb>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 52 780 248" role="img" aria-labelledby="embedding-matrix-title embedding-matrix-desc" class="blog-diagram-svg" font-family="Inter, sans-serif">
<title id="embedding-matrix-title">The embedding matrix</title><desc id="embedding-matrix-desc">A grid with one row per input clip and one column per embedding dimension. A highlighted row is a single clip's embedding vector. A highlighted column is one feature read across every clip.</desc>
<rect data-row x="200" y="108" width="400" height="28" fill="#4F5D3A" opacity="0.18" />
<rect data-col x="360" y="80" width="80" height="140" fill="#A8503A" opacity="0.18" />
<rect x="200" y="80" width="400" height="140" fill="none" stroke="#5f5f66" />
<line x1="200" y1="108" x2="600" y2="108" stroke="#d5d5dc" />
<line x1="200" y1="136" x2="600" y2="136" stroke="#d5d5dc" />
<line x1="200" y1="164" x2="600" y2="164" stroke="#d5d5dc" />
<line x1="200" y1="192" x2="600" y2="192" stroke="#d5d5dc" />
<line x1="280" y1="80" x2="280" y2="220" stroke="#d5d5dc" />
<line x1="360" y1="80" x2="360" y2="220" stroke="#d5d5dc" />
<line x1="440" y1="80" x2="440" y2="220" stroke="#d5d5dc" />
<line x1="520" y1="80" x2="520" y2="220" stroke="#d5d5dc" />
<text x="240" y="70" fill="#5f5f66" font-size="14" text-anchor="middle">dim 1</text>
<text x="320" y="70" fill="#5f5f66" font-size="14" text-anchor="middle">dim 2</text>
<text x="400" y="70" fill="#5f5f66" font-size="14" text-anchor="middle">dim 3</text>
<text x="480" y="70" fill="#5f5f66" font-size="14" text-anchor="middle">⋯</text>
<text x="560" y="70" fill="#5f5f66" font-size="14" text-anchor="middle">dim 256</text>
<text x="192" y="98" fill="#5f5f66" font-size="14" text-anchor="end">clip 00001</text>
<text x="192" y="126" fill="#5f5f66" font-size="14" text-anchor="end">clip 00002</text>
<text x="192" y="154" fill="#5f5f66" font-size="14" text-anchor="end">clip 00003</text>
<text x="192" y="182" fill="#5f5f66" font-size="14" text-anchor="end">⋮</text>
<text x="192" y="210" fill="#5f5f66" font-size="14" text-anchor="end">clip 10000</text>
<rect data-key-row x="200" y="246" width="11" height="11" fill="#4F5D3A" opacity="0.5" />
<text data-key-row x="220" y="256" fill="#111111" font-size="15">a row is one clip, described by 256 numbers</text>
<rect data-key-col x="200" y="272" width="11" height="11" fill="#A8503A" opacity="0.5" />
<text data-key-col x="220" y="282" fill="#111111" font-size="15">a column is one feature, measured across 10,000 clips</text>
</svg>
<button type="button" class="fig-replay" data-replay>Replay</button>
</div>
<p class="blog-figure-reading">Rows answer “what is this clip?”. Columns answer “what does this feature respond to?”</p>
<p class="blog-figure-reading">Same numbers, two readings. Rank questions live in the row view, correlation questions in the column view.</p>

<script>
  import { animate, dur, setupFigure, wait } from "../../lib/figure-motion";

  // Two readings of one matrix: the row band reads clip by clip (what is this
  // input?), then the column band sweeps feature by feature (what does this
  // coordinate respond to?). Each settles where the figure labels it.
  document.querySelectorAll<HTMLElement>("[data-emb]").forEach((root) => {
    const row = root.querySelector<SVGRectElement>("[data-row]")!;
    const col = root.querySelector<SVGRectElement>("[data-col]")!;
    const keyRow = Array.from(root.querySelectorAll<SVGElement>("[data-key-row]"));
    const keyCol = Array.from(root.querySelectorAll<SVGElement>("[data-key-col]"));
    const move = (el: SVGElement, from: string, to: string, s: number) =>
      animate(el, { transform: [from, to] }, { duration: dur(s), ease: [0.65, 0, 0.35, 1] });
    setupFigure(
      root,
      () => {
        row.style.opacity = "0"; col.style.opacity = "0";
        [...keyRow, ...keyCol].forEach((k) => (k.style.opacity = "0"));
        row.style.transform = "translateY(-28px)"; col.style.transform = "translateX(-160px)";
      },
      async (alive) => {
        row.style.opacity = "0.18";
        keyRow.forEach((k) => animate(k, { opacity: [0, 1] }, { duration: dur(0.4) }));
        // Read down the clips: rows 1, 2, 3, back to 2.
        for (const [a, b] of [[-28, 0], [0, 28], [28, 0]]) {
          await move(row, `translateY(${a}px)`, `translateY(${b}px)`, 0.45);
          if (!alive()) return;
          await wait(0.15);
        }
        col.style.opacity = "0.18";
        keyCol.forEach((k) => animate(k, { opacity: [0, 1] }, { duration: dur(0.4) }));
        // Sweep across features: dims 1, 2, 3.
        for (const [a, b] of [[-160, -80], [-80, 0]]) {
          await move(col, `translateX(${a}px)`, `translateX(${b}px)`, 0.45);
          if (!alive()) return;
          await wait(0.15);
        }
      },
    );
  });
</script>
