---
// Foundations, convolutions post: two input channels, two output channels,
// kernel size 2. Inputs (1, 2, 3) and (0, 1, −1). Output channel 1
// (kernels (1, 1), (1, −1), bias 0): 2, 7. Output channel 2 (kernels
// (0, 1), (2, 0), bias 1): 3, 6. 2 × 2 × 2 + 2 = 10 parameters.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-multich>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 250" role="img" aria-labelledby="mc-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="mc-title">Two input channels each convolved with their own kernel and summed into each output channel</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Bias of output channel 2 <strong data-vb></strong></span><input class="scrub" data-b type="range" min="-2" max="2" step="1" value="1" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, GOLD, TINT, JADE } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  const X = [[1, 2, 3], [0, 1, -1]];
  document.querySelectorAll<HTMLElement>("[data-multich]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const W = [[[1, 1], [1, -1]], [[0, 1], [2, 0]]], B = [0, 1];
    const part = (o: number, c: number, n: number) => W[o][c].reduce((s, w, j) => s + w * X[c][n + j], 0);
    const y = (o: number, n: number) => part(o, 0, n) + part(o, 1, n) + B[o];
    const steps = () => [0, 1].flatMap((o) => [0, 1].map((n) => ({
      say: `Output channel ${o + 1}, position ${n}: slide this channel's own kernel over each input channel, then add the two partial sums and the bias.`,
      math: `channel 1: ${W[o][0].map((w, j) => `${par(w)} × ${par(X[0][n + j])}`).join(" + ")} = ${fmt(part(o, 0, n))}\nchannel 2: ${W[o][1].map((w, j) => `${par(w)} × ${par(X[1][n + j])}`).join(" + ")} = ${fmt(part(o, 1, n))}\ny = ${fmt(part(o, 0, n))} + ${par(part(o, 1, n))} + ${par(B[o])} = ${fmt(y(o, n))}`,
    })));
    function draw(k: number) {
      const o0 = Math.floor(k / 2), n0 = k % 2;
      let s = "";
      X.forEach((row, c) => {
        s += txt(30, 46 + c * 56, `input channel ${c + 1}`, `font-size="11" fill="${MUTED}"`);
        row.forEach((v, i) => { const on = k >= 0 && i >= n0 && i < n0 + 2; s += `<rect x="${140 + i * 52}" y="${26 + c * 56}" width="46" height="32" rx="4" fill="${on ? TINT : "#fff"}" stroke="${on ? JADE : "#cfd5d4"}" stroke-width="${on ? 2.5 : 1}"/>` + txt(163 + i * 52, 47 + c * 56, fmt(v), `font-size="14" font-weight="700" text-anchor="middle" fill="${INK}"`); });
      });
      [0, 1].forEach((o) => {
        const l = 340 + o * 210, on = o === o0;
        s += txt(l, 22, `output channel ${o + 1}`, `font-size="12" font-weight="700" fill="${on ? INK : MUTED}"`);
        [0, 1].forEach((c) => (s += txt(l, 48 + c * 56, `kernel on ch ${c + 1}: (${W[o][c].map((v) => fmt(v)).join(", ")})`, `font-size="11.5" fill="${on ? GOLD : MUTED}" font-weight="${on ? 700 : 400}"`)));
        s += txt(l, 150, `bias ${fmt(B[o])}`, `font-size="11.5" fill="${MUTED}"`);
        [0, 1].forEach((n) => {
          const i = o * 2 + n, done = i <= k, now = i === k;
          s += `<rect x="${l + n * 60}" y="166" width="52" height="34" rx="4" fill="${now ? TINT : "#fff"}" stroke="${now ? JADE : "#cfd5d4"}" stroke-width="${now ? 2.5 : 1}"/>` + txt(l + n * 60 + 26, 188, done ? fmt(y(o, n)) : "?", `font-size="14" font-weight="700" text-anchor="middle" fill="${done ? INK : "#B9C0BF"}"`);
        });
      });
      s += txt(30, 236, `Parameters: 2 output channels × 2 input channels × kernel 2 + 2 biases = ${2 * 2 * 2 + 2}`, `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-vb]").textContent = fmt(B[1]);
    }
    const redraw = stepper(root, steps, draw, { delay: 2 });
    $<HTMLInputElement>("[data-b]").addEventListener("input", (e) => { B[1] = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
