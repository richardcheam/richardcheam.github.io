---
// Foundations, convolutions post: padding, stride and dilation, and the
// output-length rule ⌊(L + 2p − d(k − 1) − 1)/s⌋ + 1. Defaults L = 10, k = 3,
// p = 1, s = 2, d = 2: 4 outputs; output 0 reads padded positions 0, 2, 4.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-shape>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 220" role="img" aria-labelledby="cs-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="cs-title">Which inputs each output reads, for chosen padding, stride and dilation</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Input length L <strong data-v="L"></strong></span><input class="scrub" data-k="L" type="range" min="4" max="16" step="1" value="10" /></label>
    <label><span class="fig-panel__name">Kernel size k <strong data-v="k"></strong></span><input class="scrub" data-k="k" type="range" min="1" max="5" step="1" value="3" /></label>
    <label><span class="fig-panel__name">Padding p (each side) <strong data-v="p"></strong></span><input class="scrub" data-k="p" type="range" min="0" max="3" step="1" value="1" /></label>
    <label><span class="fig-panel__name">Stride s <strong data-v="s"></strong></span><input class="scrub" data-k="s" type="range" min="1" max="4" step="1" value="2" /></label>
    <label><span class="fig-panel__name">Dilation d <strong data-v="d"></strong></span><input class="scrub" data-k="d" type="range" min="1" max="3" step="1" value="2" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { INK, MUTED, GOLD, TINT, JADE } from "../../lib/net-diagram";
  import { txt } from "../../lib/plot";
  import { outLen } from "../../lib/conv";
  document.querySelectorAll<HTMLElement>("[data-shape]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const p: Record<string, number> = { L: 10, k: 3, p: 1, s: 2, d: 2 };
    const n = () => outLen(p.L, p.k, p.p, p.s, p.d);
    const formula = () => { const top = p.L + 2 * p.p - p.d * (p.k - 1) - 1; return `L_out = ⌊(${p.L} + 2 × ${p.p} − ${p.d} × (${p.k} − 1) − 1) / ${p.s}⌋ + 1 = ⌊${top} / ${p.s}⌋ + 1 = ${n()}`; };
    const taps = (o: number) => Array.from({ length: p.k }, (_, j) => o * p.s + j * p.d);
    const steps = () => Math.max(0, n()) ? Array.from({ length: n() }, (_, o) => ({ say: o === 0 ? `Output 0 reads padded positions ${taps(0).join(", ")}: taps ${p.d} apart (dilation), starting at 0.` : `Jump ${p.s} along (stride) for output ${o}.`, math: `output ${o} reads ${taps(o).join(", ")}\n${formula()}` })) : [{ say: "The kernel's span is longer than the padded input: no output fits.", math: formula() }];
    function draw(k: number) {
      const P = p.L + 2 * p.p, cw = Math.min(42, 680 / P), x0 = 40, cx = (i: number) => x0 + i * cw;
      let s = txt(40, 20, `Padded input: ${p.p} zero${p.p === 1 ? "" : "s"} each side, ${P} cells`, `font-size="12" font-weight="700" fill="${INK}"`);
      const active = k >= 0 && k < n() ? taps(k) : [];
      for (let i = 0; i < P; i++) {
        const pad = i < p.p || i >= p.p + p.L, on = active.includes(i);
        s += `<rect x="${cx(i)}" y="36" width="${cw - 3}" height="30" rx="3" fill="${on ? TINT : pad ? "#f1f2f2" : "#fff"}" stroke="${on ? JADE : "#cfd5d4"}" stroke-width="${on ? 2.5 : 1}" stroke-dasharray="${pad ? "3 2" : ""}"/>` + txt(cx(i) + (cw - 3) / 2, 56, pad ? "0" : `x${i - p.p}`, `font-size="10" text-anchor="middle" fill="${pad ? MUTED : INK}"`);
      }
      const N = Math.max(0, n()), ow = Math.min(60, 680 / Math.max(1, N));
      for (let o = 0; o < N; o++) {
        const ox = 40 + o * ow, on = o === k;
        if (on) taps(o).forEach((t) => (s += `<line x1="${cx(t) + (cw - 3) / 2}" y1="66" x2="${ox + (ow - 6) / 2}" y2="124" stroke="${GOLD}" stroke-width="1.8"/>`));
        s += `<rect x="${ox}" y="124" width="${ow - 6}" height="30" rx="3" fill="${on ? TINT : o < k ? "#fff" : "#fafafa"}" stroke="${on ? JADE : "#cfd5d4"}"/>` + txt(ox + (ow - 6) / 2, 144, `y${o}`, `font-size="10.5" text-anchor="middle" fill="${o <= k ? INK : MUTED}"`);
      }
      if (!N) s += txt(40, 144, "kernel does not fit", `font-size="12" fill="#B5533C" font-weight="700"`);
      s += txt(40, 186, formula(), `font-size="13" font-weight="700" fill="${INK}"`) + txt(40, 206, `span of the kernel = d(k − 1) + 1 = ${p.d * (p.k - 1) + 1}`, `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      root.querySelectorAll<HTMLElement>("[data-v]").forEach((el) => (el.textContent = String(p[el.dataset.v!])));
    }
    const redraw = stepper(root, steps, draw, { delay: 1.4 });
    root.querySelectorAll<HTMLInputElement>("[data-k]").forEach((inp) => inp.addEventListener("input", () => { p[inp.dataset.k!] = +inp.value; redraw(); }));
  });
</script>
