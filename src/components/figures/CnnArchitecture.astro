---
// Foundations, convolutions post: a whole tiny CNN, 6 × 6 image → two 3 × 3
// filters (vertical and horizontal line detectors) → ReLU → 2 × 2 max pool →
// flatten (8) → dense (2 logits, 0.25 × each map's pooled sum) → softmax.
// A vertical bar gives logits 3 and 0, P(vertical) 0.953, wherever it sits.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-cnn-arch>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 340" role="img" aria-labelledby="ca-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="ca-title">A tiny convolutional network classifying a 6 by 6 image as a vertical or horizontal line</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Input image</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-img="v2" aria-pressed="true">Vertical bar</button>
      <button type="button" class="fig-chip" data-img="v4" aria-pressed="false">Same bar, moved</button>
      <button type="button" class="fig-chip" data-img="h" aria-pressed="false">Horizontal bar</button>
      <button type="button" class="fig-chip" data-img="plus" aria-pressed="false">Plus sign</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt, par } from "../../lib/tiny-net";
  import { INK, MUTED, NEG, JADE, GOLD, TINT } from "../../lib/net-diagram";
  import { txt, arrow } from "../../lib/plot";
  const N = 6;
  const IMGS: Record<string, number[][]> = {
    v2: Array.from({ length: N }, () => Array.from({ length: N }, (_, c) => +(c === 2))),
    v4: Array.from({ length: N }, () => Array.from({ length: N }, (_, c) => +(c === 4))),
    h: Array.from({ length: N }, (_, r) => Array.from({ length: N }, () => +(r === 3))),
    plus: Array.from({ length: N }, (_, r) => Array.from({ length: N }, (_, c) => +(r === 2 || c === 2))),
  };
  const KV = [[-1, 2, -1], [-1, 2, -1], [-1, 2, -1]], KH = [[-1, -1, -1], [2, 2, 2], [-1, -1, -1]];
  const conv = (x: number[][], k: number[][]) => Array.from({ length: N - 2 }, (_, r) => Array.from({ length: N - 2 }, (_, c) => k.reduce((s, row, i) => s + row.reduce((a, w, j) => a + w * x[r + i][c + j], 0), 0)));
  const relu = (m: number[][]) => m.map((r) => r.map((v) => Math.max(0, v)));
  const pool = (m: number[][]) => [0, 1].map((r) => [0, 1].map((c) => Math.max(m[2 * r][2 * c], m[2 * r][2 * c + 1], m[2 * r + 1][2 * c], m[2 * r + 1][2 * c + 1])));
  document.querySelectorAll<HTMLElement>("[data-cnn-arch]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let key = "v2";
    // The convolve and pool steps sweep their window cell by cell.
    let sweep = 99, sweepTok = 0, redraw = () => {};
    const startSweep = (n: number, seconds: number) => { const my = ++sweepTok; sweep = 0; const t0 = performance.now(); const f = (now: number) => { if (my !== sweepTok) return; const s2 = Math.min(n, Math.floor((now - t0) / ((seconds * 1000) / n)) + 1); if (s2 !== sweep) { sweep = s2; redraw(); } if (s2 < n) requestAnimationFrame(f); }; requestAnimationFrame(f); };
    const stopSweep = () => { sweepTok++; sweep = 99; };
    const calc = () => {
      const x = IMGS[key], cv = conv(x, KV), ch = conv(x, KH), rv = relu(cv), rh = relu(ch), pv = pool(rv), ph = pool(rh), flat = [...pv.flat(), ...ph.flat()];
      const zV = 0.25 * pv.flat().reduce((a, b) => a + b, 0), zH = 0.25 * ph.flat().reduce((a, b) => a + b, 0), eV = Math.exp(zV), eH = Math.exp(zH);
      // The window to spell out: the one with the largest response for each filter.
      const best = (m: number[][]) => { let b = [0, 0]; m.forEach((r, i) => r.forEach((v, j) => { if (v > m[b[0]][b[1]]) b = [i, j]; })); return b; };
      return { x, cv, ch, rv, rh, pv, ph, flat, zV, zH, pV: eV / (eV + eH), pH: eH / (eV + eH), bv: best(cv), bh: best(ch) };
    };
    const winMath = (x: number[][], k: number[][], [r, c]: number[]) => { const terms: string[] = []; k.forEach((row, i) => row.forEach((w, j) => { if (x[r + i][c + j]) terms.push(`${par(w)} × 1`); })); return `${terms.length ? terms.join(" + ") : "every pixel under it is 0"} = ${fmt(k.reduce((s, row, i) => s + row.reduce((a, w, j) => a + w * x[r + i][c + j], 0), 0))}`; };
    const steps = () => { const C = calc(); return [
      { say: "The input is a 6 × 6 image: 36 pixels, 1 where there is ink and 0 elsewhere.", math: "shape 6 × 6 × 1 (height × width × channels)" },
      { say: "Filter 1 is a 3 × 3 vertical-line detector: +2 down the middle column, −1 on both sides. Slide it over every 3 × 3 window; each window gives one number. The highlighted window shows one sum.", math: `window at row ${C.bv[0] + 1}, column ${C.bv[1] + 1}: ${winMath(C.x, KV, C.bv)}\n6 − 3 + 1 = 4 positions each way → a 4 × 4 map` },
      { say: "Filter 2 is the same idea turned sideways: a horizontal-line detector. It makes a second 4 × 4 map from the same image.", math: `window at row ${C.bh[0] + 1}, column ${C.bh[1] + 1}: ${winMath(C.x, KH, C.bh)}\nshape now 4 × 4 × 2 (one channel per filter)` },
      { say: "ReLU sets every negative number to zero: only \"I found my pattern here\" survives.", math: "ReLU(v) = max(0, v);  shape stays 4 × 4 × 2" },
      { say: "Max pooling keeps the largest value in each 2 × 2 block. The map shrinks to 2 × 2, and a small shift of the pattern barely changes it.", math: `vertical map → ${JSON.stringify(C.pv)},  horizontal map → ${JSON.stringify(C.ph)}\nshape 2 × 2 × 2` },
      { say: "Flatten lays the 8 numbers out in one row, ready for an ordinary dense layer.", math: `(${C.flat.join(", ")})` },
      { say: "The dense layer gives one score per class. Here its weights are simple: 0.25 on every number from its own filter's map, 0 on the other map.", math: `vertical score = 0.25 × (${C.pv.flat().join(" + ")}) = ${fmt(C.zV, 2)}\nhorizontal score = 0.25 × (${C.ph.flat().join(" + ")}) = ${fmt(C.zH, 2)}` },
      { say: key === "plus" ? "Softmax turns the scores into probabilities. The plus sign has both lines, so the network cannot choose: 50/50." : key === "v4" ? "Softmax gives the same answer as for the first bar: the filters slide, so moving the bar does not matter." : "Softmax turns the two scores into probabilities.", math: `P(vertical) = e^${fmt(C.zV, 2)} / (e^${fmt(C.zV, 2)} + e^${fmt(C.zH, 2)}) = ${fmt(C.pV, 3)},  P(horizontal) = ${fmt(C.pH, 3)}` },
    ].map((st, i) => ({ ...st, enter: i === 1 || i === 2 ? () => startSweep(16, 1.8) : i === 4 ? () => startSweep(4, 1.2) : stopSweep })); };
    function grid(m: number[][], x: number, y: number, cs: number, showAll: boolean, hi?: number[], hiSize = 1, col = JADE, limit = 99) {
      let s = "";
      m.forEach((row, r) => row.forEach((v, c) => { const show = showAll && r * row.length + c < limit, pos = v > 0, a = show ? Math.min(1, Math.abs(v) / 6) : 0; s += `<rect x="${x + c * cs}" y="${y + r * cs}" width="${cs - 1}" height="${cs - 1}" fill="${show ? (pos ? col : NEG) : "#fff"}" fill-opacity="${show ? 0.12 + 0.75 * a : 1}" stroke="#d9dedd" stroke-width="0.6"/>` + (show && cs >= 18 ? txt(x + c * cs + cs / 2 - 0.5, y + r * cs + cs / 2 + 3.5, fmt(v), `font-size="${cs >= 22 ? 10.5 : 9}" text-anchor="middle" fill="${INK}"`) : ""); }));
      if (hi) s += `<rect x="${x + hi[1] * cs - 1}" y="${y + hi[0] * cs - 1}" width="${hiSize * cs + 1}" height="${hiSize * cs + 1}" fill="none" stroke="${GOLD}" stroke-width="2.5"/>`;
      return s;
    }
    function draw(k: number) {
      const C = calc();
      const sweeping = (k === 1 || k === 2) && sweep < 16, at = [Math.floor((sweep - 1) / 4), (sweep - 1) % 4];
      const winV = k === 1 && sweeping ? at : C.bv, winH = k === 2 && sweeping ? at : C.bh;
      let s = "";
      const head = (x: number, l: string, shape: string, on: boolean) => txt(x, 18, l, `font-size="11" font-weight="700" fill="${on ? JADE : MUTED}"`) + txt(x, 32, shape, `font-size="10" fill="${MUTED}"`);
      // Input image (ink drawn dark).
      s += head(14, "input", "6 × 6", k === 0);
      C.x.forEach((row, r) => row.forEach((v, c) => (s += `<rect x="${14 + c * 17}" y="${50 + r * 17}" width="16" height="16" fill="${v ? INK : "#fff"}" stroke="#d9dedd" stroke-width="0.6"/>`)));
      if (k === 1) s += `<rect x="${14 + winV[1] * 17 - 1}" y="${50 + winV[0] * 17 - 1}" width="52" height="52" fill="none" stroke="${GOLD}" stroke-width="2.5"/>`;
      if (k === 2) s += `<rect x="${14 + winH[1] * 17 - 1}" y="${50 + winH[0] * 17 - 1}" width="52" height="52" fill="none" stroke="${GOLD}" stroke-width="2.5"/>`;
      // Kernels.
      [[KV, "vertical filter", 1], [KH, "horizontal filter", 2]].forEach(([K, l, at], i) => { const y = 180 + i * 78; s += txt(14, y - 6, l as string, `font-size="10" fill="${k === at ? GOLD : MUTED}"`); (K as number[][]).forEach((row, r) => row.forEach((w, c) => (s += `<rect x="${14 + c * 19}" y="${y + r * 19}" width="18" height="18" fill="${w > 0 ? JADE : NEG}" fill-opacity="0.25"/>` + txt(23 + c * 19, y + r * 19 + 13, fmt(w), `font-size="9.5" text-anchor="middle" fill="${INK}"`)))); });
      // Conv maps.
      s += head(140, "convolve", "4 × 4 × 2", k === 1 || k === 2);
      s += grid(C.cv, 140, 50, 22, k >= 1, k === 1 ? winV : undefined, 1, JADE, k === 1 ? sweep : 99) + grid(C.ch, 140, 190, 22, k >= 2, k === 2 ? winH : undefined, 1, "#3E6E9E", k === 2 ? sweep : 99);
      s += arrow(122, 100, 136, 100, k >= 1 ? INK : "#cfd5d4", 1.2);
      // ReLU.
      s += head(258, "ReLU", "4 × 4 × 2", k === 3);
      const poolAt = k === 4 && sweep < 4 ? [2 * Math.floor((sweep - 1) / 2), 2 * ((sweep - 1) % 2)] : undefined;
      s += grid(C.rv, 258, 50, 22, k >= 3, poolAt, 2) + grid(C.rh, 258, 190, 22, k >= 3, poolAt, 2, "#3E6E9E");
      s += arrow(232, 100, 254, 100, k >= 3 ? INK : "#cfd5d4", 1.2) + arrow(232, 240, 254, 240, k >= 3 ? INK : "#cfd5d4", 1.2);
      // Pool.
      s += head(376, "max pool", "2 × 2 × 2", k === 4);
      s += grid(C.pv, 376, 72, 26, k >= 4, undefined, 1, JADE, k === 4 ? sweep : 99) + grid(C.ph, 376, 212, 26, k >= 4, undefined, 1, "#3E6E9E", k === 4 ? sweep : 99);
      s += arrow(350, 100, 372, 100, k >= 4 ? INK : "#cfd5d4", 1.2) + arrow(350, 240, 372, 240, k >= 4 ? INK : "#cfd5d4", 1.2);
      // Flatten.
      s += head(460, "flatten", "8", k === 5);
      C.flat.forEach((v, i) => (s += `<rect x="460" y="${50 + i * 26}" width="34" height="24" rx="3" fill="${k >= 5 && v > 0 ? (i < 4 ? JADE : "#3E6E9E") : "#fff"}" fill-opacity="${k >= 5 && v > 0 ? 0.6 : 1}" stroke="#cfd5d4"/>` + txt(477, 66 + i * 26, k >= 5 ? String(v) : "", `font-size="10.5" text-anchor="middle" fill="${INK}"`)));
      s += arrow(434, 150, 456, 150, k >= 5 ? INK : "#cfd5d4", 1.2);
      // Dense lines.
      if (k >= 6) C.flat.forEach((_, i) => (s += `<line x1="494" y1="${62 + i * 26}" x2="560" y2="${i < 4 ? 120 : 200}" stroke="${i < 4 ? JADE : "#3E6E9E"}" stroke-opacity="0.45"/>`));
      s += head(560, "dense", "2 scores", k === 6);
      [["vertical", C.zV, 120, C.pV], ["horizontal", C.zH, 200, C.pH]].forEach(([l, z, y, p]) => {
        s += `<circle cx="572" cy="${y}" r="13" fill="${k >= 6 ? TINT : "#fff"}" stroke="${INK}"/>` + txt(572, (y as number) + 4, k >= 6 ? fmt(z as number, 2) : "", `font-size="10" text-anchor="middle" font-weight="700" fill="${INK}"`);
        s += txt(596, (y as number) - 18, l as string, `font-size="10.5" fill="${MUTED}"`) + `<rect x="596" y="${(y as number) - 10}" width="120" height="20" fill="#f1f3f3"/><rect x="596" y="${(y as number) - 10}" width="${k >= 7 ? 120 * (p as number) : 0}" height="20" fill="${GOLD}" fill-opacity="0.85"/>` + txt(722, (y as number) + 5, k >= 7 ? fmt(p as number, 3) : "", `font-size="11" font-weight="700" fill="${INK}"`);
      });
      s += head(650, "softmax", "2 probabilities", k === 7);
      $("[data-draw]").innerHTML = s;
    }
    redraw = stepper(root, steps, draw, { delay: 2.8 });
    root.querySelectorAll<HTMLButtonElement>("[data-img]").forEach((b) => b.addEventListener("click", () => { key = b.dataset.img!; root.querySelectorAll("[data-img]").forEach((o) => o.setAttribute("aria-pressed", String(o === b))); redraw(); }));
  });
</script>
