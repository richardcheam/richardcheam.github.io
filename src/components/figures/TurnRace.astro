---
// Moshi review, Figure 1: a cascade against Moshi on one 6-second exchange.
// Cascade stage times (ASR 0.3 s, LLM 0.6 s, TTS 0.4 s) and the end-of-speech
// wait are illustrative. Moshi's reaction time, 160 ms, is the paper's
// theoretical latency (Abstract, p. 1).
const { alt } = Astro.props;
---
<div class="blog-diagram trc" role="region" aria-label={alt} data-trc>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 330" role="img" aria-labelledby="trc-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="trc-title">A cascade and Moshi answering the same question, with an optional interruption</title>
    <g data-grid></g>
    <text x="20" y="62" font-size="11.5" font-weight="700" fill="#2b2b30">You</text>
    <text x="20" y="128" font-size="11.5" font-weight="700" fill="#2b2b30">Cascade</text>
    <text x="20" y="214" font-size="11.5" font-weight="700" fill="#2b2b30">Moshi</text>
    <g data-user></g>
    <g data-casc></g>
    <g data-moshi></g>
    <line data-head y1="30" y2="250" stroke="#a33b3b" stroke-width="1.5" />
    <text data-r1 x="20" y="284" font-size="12" fill="#2b2b30"></text>
    <text data-r2 x="20" y="304" font-size="12" font-weight="700" fill="#2b2b30"></text>
    <text data-r3 x="20" y="324" font-size="11" fill="#5f5f66"></text>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Cascade waits for silence<strong data-vw></strong></span><input class="scrub" data-w type="range" min="0.2" max="1.5" step="0.1" value="0.5" /></label>
    <div><span class="fig-panel__name">You</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-int aria-pressed="false">Interrupt at 2.4 s</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-trc]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const X = (s: number) => 110 + s * 108, wIn = $<HTMLInputElement>("[data-w]");
    const el = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt) e.textContent = txt; g.append(e); return e; };
    for (let s = 0; s <= 6; s++) { el($("[data-grid]"), "line", { x1: X(s), x2: X(s), y1: 30, y2: 250, stroke: "#ececf1" }); el($("[data-grid]"), "text", { x: X(s), y: 22, "font-size": 10.5, "text-anchor": "middle", fill: "#5f5f66" }, `${s} s`); }
    let inter = false;
    const block = (g: Element, a: number, b: number, y: number, h: number, fill: string, label: string, crossed = false, op = 1) => {
      if (b <= a) return;
      el(g, "rect", { x: X(a), y, width: X(b) - X(a), height: h, fill, "fill-opacity": 0.85 * op, rx: 2 });
      if (X(b) - X(a) > 24) el(g, "text", { x: (X(a) + X(b)) / 2, y: y + h / 2 + 4, "font-size": 10, "text-anchor": "middle", fill: "#fff" }, label);
      if (crossed) el(g, "line", { x1: X(a), x2: X(b), y1: y + h / 2, y2: y + h / 2, stroke: "#a33b3b", "stroke-width": 2 });
    };
    function plan() {
      const w = +wIn.value, q1 = [0.2, 1.9], q2 = [2.4, 3.6], end = inter ? q2[1] : q1[1];
      // Cascade: wait for silence, then ASR, LLM, TTS in turn. An interruption
      // during the pipeline throws that work away and restarts after you stop.
      const stages = (t0: number) => [["wait", t0, t0 + w, "#b9b9c2"], ["ASR", t0 + w, t0 + w + 0.3, "#35588a"], ["LLM", t0 + w + 0.3, t0 + w + 0.9, "#594578"], ["TTS", t0 + w + 0.9, t0 + w + 1.3, "#8a3f6e"]] as [string, number, number, string][];
      const first = stages(q1[1]), firstReply = q1[1] + w + 1.3;
      const casc: { st: [string, number, number, string][]; crossed: boolean }[] = [];
      let cascReply = firstReply;
      if (inter && q2[0] < firstReply) {
        casc.push({ st: first.map(([n, a, b, c]) => [n, a, Math.min(b, q2[0]), c] as [string, number, number, string]).filter((s) => s[1] < q2[0]), crossed: true });
        casc.push({ st: stages(q2[1]), crossed: false }); cascReply = q2[1] + w + 1.3;
      } else casc.push({ st: first, crossed: false });
      const mReply1 = q1[1] + 0.16, mStop = q2[0] + 0.16, mReply2 = q2[1] + 0.16;
      return { w, q1, q2, end, casc, cascReply, mReply1, mStop, mReply2 };
    }
    function draw(now: number) {
      const p = plan();
      for (const k of ["user", "casc", "moshi"]) $(`[data-${k}]`).replaceChildren();
      const clip = (a: number, b: number) => [a, Math.min(b, now)] as const;
      block($("[data-user]"), ...clip(p.q1[0], p.q1[1]), 44, 28, "#2b2b30", "What's the tallest mountain?");
      if (inter) block($("[data-user]"), ...clip(p.q2[0], p.q2[1]), 44, 28, "#2b2b30", "…the second tallest?");
      p.casc.forEach((c) => c.st.forEach(([n, a, b, col]) => block($("[data-casc]"), ...clip(a, b), 100, 40, col, n, c.crossed, c.crossed ? 0.5 : 1)));
      block($("[data-casc]"), ...clip(p.cascReply, 6), 100, 40, "#4F5D3A", "speaks");
      // Moshi: an 80 ms tick strip that never stops, plus its speech.
      const g = $("[data-moshi]");
      for (let t = 0; t < Math.min(now, 6); t += 0.08) el(g, "rect", { x: X(t), y: 232, width: 108 * 0.08 - 1.5, height: 6, fill: "#ececf1" });
      if (inter) { block(g, ...clip(p.mReply1, p.mStop), 186, 40, "#4F5D3A", "speaks", false, 0.55); block(g, ...clip(p.mReply2, 6), 186, 40, "#4F5D3A", "speaks"); }
      else block(g, ...clip(p.mReply1, 6), 186, 40, "#4F5D3A", "speaks");
      const head = $("[data-head]"); head.setAttribute("x1", String(X(Math.min(now, 6)))); head.setAttribute("x2", String(X(Math.min(now, 6))));
      const fin = now >= 6;
      $("[data-r1]").textContent = fin ? `You stop at ${p.end.toFixed(1)} s. Moshi answers ${0.16.toFixed(2)} s later; the cascade ${(p.cascReply - p.end).toFixed(1)} s later.` : "";
      $("[data-r2]").textContent = fin ? (inter ? (p.casc.length > 1 ? "Interrupted mid-pipeline, the cascade throws its work away and starts over. Moshi just goes quiet." : "The cascade had already answered; Moshi goes quiet the moment you cut in.") : "Moshi hears and speaks on the same 80 ms clock (grey ticks), so it never waits for a turn.") : "";
      $("[data-r3]").textContent = "Cascade stage times and the silence wait are illustrative; Moshi's 160 ms is its theoretical latency (Abstract, p. 1).";
      $("[data-vw]").textContent = `${p.w.toFixed(1)} s`;
      wIn.style.setProperty("--p", `${((p.w - 0.2) / 1.3) * 100}%`);
    }
    wIn.addEventListener("input", () => draw(6));
    $("[data-int]").addEventListener("click", (e) => { inter = !inter; (e.currentTarget as Element).setAttribute("aria-pressed", String(inter)); draw(6); });
    draw(6);
    setupFigure(root, () => draw(0), async (alive) => { await tween(5, (e) => { if (alive()) draw(6 * (1 - Math.cbrt(1 - e))); }); });
  });
</script>
