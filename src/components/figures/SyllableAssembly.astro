---
// Khmer script post, Figure 1: a syllable assembling from its stored code
// points. Each code point lifts off the stored list and flies to the place the
// font draws it (centre, under, left, right, above). Positions are a
// hand-written table per word, not real font shaping; the finished word at the
// end is drawn by your font.
const { alt } = Astro.props;
const words = {
  khmer: { text: "ខ្មែរ", parts: [["1781", "KHA", "ខ", "base"], ["17D2", "COENG", "◌្", "join"], ["1798", "MO", "◌្ម", "under"], ["17C2", "VOWEL SIGN AE", "◌ែ", "left"], ["179A", "RO", "រ", "right"]] },
  kra: { text: "ក្រ", parts: [["1780", "KA", "ក", "base"], ["17D2", "COENG", "◌្", "join"], ["179A", "RO", "◌្រ", "leftunder"]] },
  srei: { text: "ស្រី", parts: [["179F", "SA", "ស", "base"], ["17D2", "COENG", "◌្", "join"], ["179A", "RO", "◌្រ", "leftunder"], ["17B8", "VOWEL SIGN II", "◌ី", "above"]] },
};
---
<div class="blog-diagram sya" role="region" aria-label={alt} data-sya data-words={JSON.stringify(words)}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 380" role="img" aria-labelledby="sya-title" class="blog-diagram-svg" font-family="Inter, 'Noto Sans Khmer', 'Khmer Sangam MN', sans-serif">
    <title id="sya-title">Code points of a Khmer word moving from stored order to their drawn positions</title>
    <text x="20" y="22" font-size="11.5" font-weight="700" fill="#2b2b30">Where the font draws each piece</text>
    <rect x="200" y="40" width="240" height="190" rx="8" fill="#f7f7f9" stroke="#ececf1" />
    <g data-slots></g>
    <g data-fly></g>
    <text data-word x="610" y="170" font-size="84" text-anchor="middle" fill="#2b2b30" opacity="0"></text>
    <text data-wl x="610" y="210" font-size="11" text-anchor="middle" fill="#5f5f66"></text>
    <text x="20" y="262" font-size="11.5" font-weight="700" fill="#2b2b30">What is stored, in order</text>
    <g data-list></g>
    <text data-r1 x="20" y="366" font-size="12" fill="#2b2b30"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Word</span><div class="fig-chips">
      <button type="button" class="fig-chip" data-w="khmer" aria-pressed="true">ខ្មែរ (Khmer)</button>
      <button type="button" class="fig-chip" data-w="kra" aria-pressed="false">ក្រ</button>
      <button type="button" class="fig-chip" data-w="srei" aria-pressed="false">ស្រី (woman)</button>
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";
  const NS = "http://www.w3.org/2000/svg";
  document.querySelectorAll<HTMLElement>("[data-sya]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const W: Record<string, { text: string; parts: string[][] }> = JSON.parse(root.dataset.words!);
    const mk = (g: Element, tag: string, a: Record<string, string | number>, txt?: string) => { const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, String(a[k])); if (txt !== undefined) e.textContent = txt; g.append(e); return e; };
    const SLOT: Record<string, [number, number, string]> = { base: [320, 130, "centre"], join: [400, 196, "invisible joiner"], under: [300, 178, "under"], left: [240, 130, "left"], leftunder: [250, 178, "left, under"], right: [400, 130, "right"], above: [320, 72, "above"] };
    const COL: Record<string, string> = { base: "#594578", join: "#8a8a94", under: "#35588a", left: "#a33b3b", leftunder: "#35588a", right: "#4F5D3A", above: "#b8722c" };
    let word = "khmer", landed = 99;
    const listPos = (i: number, n: number) => [20 + i * (740 / n) + 740 / n / 2, 300];
    function draw(flyIdx = -1, e = 0) {
      const w = W[word], n = w.parts.length;
      const gs = $("[data-slots]"); gs.replaceChildren();
      w.parts.forEach(([, , , pos]) => { const [x, y, lab] = SLOT[pos]; mk(gs, "text", { x, y: y + 30, "font-size": 9.5, "text-anchor": "middle", fill: "#b9b9c2" }, lab); });
      const gl = $("[data-list]"), gf = $("[data-fly]"); gl.replaceChildren(); gf.replaceChildren();
      w.parts.forEach(([cp, name, glyph, pos], i) => {
        const [lx, ly] = listPos(i, n), bw = Math.min(140, 740 / n - 10);
        mk(gl, "rect", { x: lx - bw / 2, y: ly - 26, width: bw, height: 56, rx: 6, fill: i < landed || i === flyIdx ? "#f2f2f5" : COL[pos], "fill-opacity": i < landed || i === flyIdx ? 1 : 0.15, stroke: COL[pos] });
        mk(gl, "text", { x: lx, y: ly - 6, "font-size": 11, "font-weight": 700, "text-anchor": "middle", fill: "#2b2b30" }, `${i + 1}. U+${cp}`);
        mk(gl, "text", { x: lx, y: ly + 12, "font-size": 10, "text-anchor": "middle", fill: "#5f5f66" }, name);
        // The flying piece: from its list slot to its drawn place.
        if (i < landed || i === flyIdx) {
          const [sx, sy] = SLOT[pos], t = i === flyIdx ? e : 1, x = lx + (sx - lx) * t, y = ly - 30 + (sy - (ly - 30)) * t;
          mk(gf, "text", { x, y: y + 14, "font-size": 40, "text-anchor": "middle", fill: COL[pos] }, glyph);
        }
      });
      const wd = $("[data-word]"); wd.textContent = w.text; wd.setAttribute("opacity", landed >= n ? "1" : "0");
      $("[data-wl]").textContent = landed >= n ? "drawn by your font" : "";
      $("[data-r1]").textContent = `${n} code points, ${3 * n} UTF-8 bytes, one word on screen. Stored order follows speech: consonants first, the vowel sign after them.`;
      root.querySelectorAll("[data-w]").forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute("data-w") === word)));
    }
    async function play(alive: () => boolean) {
      landed = 0; draw();
      for (let i = 0; i < W[word].parts.length; i++) { await wait(0.35); if (!alive()) return; await tween(0.8, (e) => { if (alive()) draw(i, e); }); landed = i + 1; draw(); }
    }
    let token = 0;
    root.querySelectorAll<HTMLButtonElement>("[data-w]").forEach((b) => b.addEventListener("click", () => { word = b.dataset.w!; const my = ++token; play(() => my === token); }));
    draw();
    setupFigure(root, () => { landed = 0; draw(); }, play);
  });
</script>
