---
// The speaking-rate check: characters in the transcript divided by seconds of
// audio. Thresholds 4 and 36 chars/s are a third and three times the corpus
// median of 12 (report §3.4). The three clips are illustrative.
const { alt } = Astro.props;
const X0 = 40, W = 700, MAX = 52;
const sx = (r: number) => X0 + (r / MAX) * W;
const clips = [
  { name: "A normal clip", chars: 36, sec: 3, why: "36 characters in 3 s = 12 per second: an ordinary reading pace", c: "#4F5D3A" },
  { name: "Too fast", chars: 150, sec: 3, why: "150 characters in 3 s = 50 per second: nobody speaks that fast. The text belongs to a longer clip.", c: "#a33b3b" },
  { name: "Too slow", chars: 6, sec: 3, why: "6 characters in 3 s = 2 per second: most of the audio has no text, so the transcript is cut short.", c: "#a33b3b" },
];
---
<div class="blog-diagram rc" role="region" aria-label={alt} data-rc data-cfg={JSON.stringify({ X0, W, MAX })}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 250" role="img" aria-labelledby="rc-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="rc-title">Speaking rate of three clips against the accepted range</title>
    <rect x={sx(4)} y="70" width={sx(36) - sx(4)} height="44" fill="#4F5D3A" fill-opacity="0.08" />
    <line x1={X0} x2={X0 + W} y1="114" y2="114" stroke="#2b2b30" />
    {[0, 4, 12, 24, 36, 48].map((r) => (
      <g>
        <line x1={sx(r)} x2={sx(r)} y1="114" y2="120" stroke="#2b2b30" />
        <text x={sx(r)} y="134" font-size="10.5" text-anchor="middle" fill="#2b2b30" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight={[4, 12, 36].includes(r) ? 700 : 400}>{r}</text>
      </g>
    ))}
    <text x={X0 + W} y="152" font-size="10.5" text-anchor="end" fill="#5f5f66">characters per second of audio</text>
    <line x1={sx(12)} x2={sx(12)} y1="64" y2="72" stroke="#4F5D3A" />
    <text x={sx(12)} y="58" font-size="10.5" text-anchor="middle" fill="#4F5D3A">median 12</text>
    <text x={sx(4)} y="36" font-size="10.5" text-anchor="middle" fill="#2b2b30"><tspan font-weight="700">4</tspan> = 12 ÷ 3</text>
    <text x={sx(36)} y="36" font-size="10.5" text-anchor="middle" fill="#2b2b30"><tspan font-weight="700">36</tspan> = 12 × 3</text>
    <text x={(sx(4) + sx(36)) / 2} y="92" font-size="11" font-weight="600" text-anchor="middle" fill="#4F5D3A">kept</text>
    <g data-dot><circle cy="102" r="7" /><text data-tag y="84" font-size="10.5" font-weight="700" text-anchor="middle"></text></g>
    <text data-why x="40" y="190" font-size="12.5" fill="#2b2b30"></text>
    <text data-verdict x="40" y="214" font-size="12" font-weight="700"></text>
  </svg>
  <div class="fig-panel">
    <div><span class="fig-panel__name">Try a clip</span><div class="fig-chips">
      {clips.map((c, i) => <button type="button" class="fig-chip" data-clip={i} aria-pressed={i === 0 ? "true" : "false"}>{c.name}</button>)}
    </div></div>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { setupFigure, tween, wait } from "../../lib/figure-motion";

  document.querySelectorAll<HTMLElement>("[data-rc]").forEach((root) => {
    const c = JSON.parse(root.dataset.cfg!);
    const clips = [
      { chars: 36, sec: 3, why: "36 characters in 3 seconds = 12 per second: an ordinary reading pace." },
      { chars: 150, sec: 3, why: "150 characters in 3 seconds = 50 per second: nobody reads that fast. The text belongs to a longer clip." },
      { chars: 6, sec: 3, why: "6 characters in 3 seconds = 2 per second: most of the audio has no text. The transcript is cut short." },
    ];
    const sx = (r: number) => c.X0 + (Math.min(r, c.MAX) / c.MAX) * c.W;
    const dot = root.querySelector<SVGGElement>("[data-dot]")!, tag = root.querySelector("[data-tag]")!;
    let cur = 12, pick = 0;
    function place(r: number) {
      cur = r;
      const ok = r >= 4 && r <= 36, col = ok ? "#4F5D3A" : "#a33b3b";
      dot.querySelector("circle")!.setAttribute("cx", String(sx(r))); dot.querySelector("circle")!.setAttribute("fill", col);
      tag.setAttribute("x", String(sx(r))); tag.setAttribute("fill", col); tag.textContent = r.toFixed(0);
    }
    function verdict() {
      const k = clips[pick], r = k.chars / k.sec, ok = r >= 4 && r <= 36;
      root.querySelector("[data-why]")!.textContent = k.why;
      const v = root.querySelector("[data-verdict]")!;
      v.setAttribute("fill", ok ? "#4F5D3A" : "#a33b3b");
      v.textContent = ok ? "Kept." : "Rejected: the text and the audio do not belong together.";
    }
    async function go(i: number) {
      pick = i;
      root.querySelectorAll("[data-clip]").forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
      root.querySelector("[data-why]")!.textContent = ""; root.querySelector("[data-verdict]")!.textContent = "";
      const from = cur, to = clips[i].chars / clips[i].sec;
      await tween(0.7, (t) => place(from + (to - from) * t));
      verdict();
    }
    root.querySelectorAll<HTMLButtonElement>("[data-clip]").forEach((b) => b.addEventListener("click", () => go(+b.dataset.clip!)));
    setupFigure(root, () => { place(12); pick = 0; verdict(); }, async (alive) => {
      for (const i of [1, 2, 0]) { if (!alive()) return; await go(i); await wait(1.6); }
    });
  });
</script>
