---
// Foundations, optimisers post: loss after K steps on (w − 3)² from w = 0 is
// 9(1 − 2η)^(2K). With K = 5: η 0.001 → 8.82, 0.01 → 7.35, 0.1 → 0.966,
// 0.3 → 0.0009, 0.5 → 0, 0.9 → 0.966, 1.0 → 9, 1.1 → 55.7.
const { alt } = Astro.props;
---
<div class="blog-diagram" role="region" aria-label={alt} data-sweep>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 290" role="img" aria-labelledby="sw-title" class="blog-diagram-svg" font-family="Inter, sans-serif">
    <title id="sw-title">Loss after a few steps against the learning rate, from too small through just right to too big</title>
    <g data-draw></g>
  </svg>
  <div class="fig-panel">
    <label><span class="fig-panel__name">Learning rate η <strong data-ve></strong></span><input class="scrub" data-e type="range" min="-3" max="0.08" step="0.01" value="-1" /></label>
    <label><span class="fig-panel__name">Steps K <strong data-vk></strong></span><input class="scrub" data-kk type="range" min="1" max="20" step="1" value="5" /></label>
  </div>
  <button type="button" class="fig-replay" data-replay>Replay</button>
</div>

<script>
  import { stepper } from "../../lib/stepper";
  import { fmt } from "../../lib/tiny-net";
  import { INK, MUTED, JADE, NEG, GOLD } from "../../lib/net-diagram";
  import { frame, txt } from "../../lib/plot";
  document.querySelectorAll<HTMLElement>("[data-sweep]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let eta = 0.1, K = 5;
    const loss = (e: number) => 9 * (1 - 2 * e) ** (2 * K);
    const setEta = (e: number) => { eta = e; $<HTMLInputElement>("[data-e]").value = String(Math.log10(e)); };
    const sweep = [[0.001, "Far too small: after five steps the loss has barely moved from 9."], [0.01, "Still too small: the flat stretch on the left."], [0.1, "Learning properly now."], [0.3, "Near the bottom of the dip: fast, safe progress."], [0.5, "On this perfect bowl, one step lands exactly. Real landscapes never allow this."], [0.9, "Past the dip: steps overshoot, and the loss is back up."], [1, "The cliff edge: it bounces between 0 and 6 forever."], [1.1, "Over the edge: every step makes it worse."]] as const;
    const steps = () => sweep.map(([e, say]) => ({ say, math: `factor 1 − 2η = 1 − 2 × ${fmt(e)} = ${fmt(1 - 2 * e)}\nloss after ${K} steps = 9 × (${fmt(1 - 2 * e)})^${2 * K} = ${fmt(9 * (1 - 2 * e) ** (2 * K), 4)}`, enter: () => setEta(e) }));
    function draw() {
      const lx = (e: number) => 50 + ((Math.log10(e) + 3) / 3.08) * 420, ly = (v: number) => 236 - ((Math.log10(Math.max(v, 1e-6)) + 6) / 8.5) * 200;
      let s = txt(50, 18, `Loss after ${K} steps on (w − 3)² from w = 0, against η (both axes logarithmic)`, `font-size="12" font-weight="700" fill="${INK}"`);
      [0.001, 0.01, 0.1, 1].forEach((e) => (s += `<line x1="${lx(e)}" x2="${lx(e)}" y1="30" y2="236" stroke="#eef0f0"/>` + txt(lx(e), 252, fmt(e), `font-size="10.5" text-anchor="middle" fill="${MUTED}"`)));
      [100, 1, 0.01, 0.0001, 0.000001].forEach((v) => (s += `<line x1="50" x2="470" y1="${ly(v)}" y2="${ly(v)}" stroke="#eef0f0"/>` + txt(44, ly(v) + 4, v >= 1 ? fmt(v) : `1e${Math.round(Math.log10(v))}`, `font-size="10.5" text-anchor="end" fill="${MUTED}"`)));
      const pts: string[] = [];
      for (let i = 0; i <= 400; i++) { const e = 10 ** (-3 + (3.08 * i) / 400); pts.push(`${lx(e).toFixed(1)},${Math.max(30, ly(loss(e))).toFixed(1)}`); }
      s += `<polyline fill="none" stroke="${JADE}" stroke-width="2.5" points="${pts.join(" ")}"/>`;
      s += txt(lx(0.003), 60, "too small", `font-size="11" text-anchor="middle" fill="${MUTED}"`) + txt(lx(0.4), 270, "just right", `font-size="11" text-anchor="middle" fill="${GOLD}" font-weight="700"`) + txt(lx(1.1), 44, "too big", `font-size="11" text-anchor="end" fill="${NEG}"`);
      const L = loss(eta);
      s += `<circle cx="${lx(eta)}" cy="${Math.max(30, ly(L))}" r="7" fill="${INK}" stroke="#fff" stroke-width="2"/>`;
      // Inset: the K-step path on the parabola.
      const ix = (w: number) => 520 + ((w + 3) / 12) * 220, iy = (v: number) => 220 - Math.min(v, 36) / 36 * 160;
      s += txt(520, 46, `The path for η = ${fmt(eta, 3)}`, `font-size="12" font-weight="700" fill="${INK}"`);
      const par: string[] = []; for (let i = 0; i <= 120; i++) { const w = -3 + i / 10; par.push(`${ix(w).toFixed(1)},${iy((w - 3) ** 2).toFixed(1)}`); }
      s += `<polyline fill="none" stroke="#cfd5d4" stroke-width="2" points="${par.join(" ")}"/>`;
      let w = 0; const path = [w]; for (let i = 0; i < K; i++) { w = w - eta * 2 * (w - 3); path.push(w); }
      const vis = path.filter((x) => x >= -3 && x <= 9);
      s += `<polyline fill="none" stroke="${GOLD}" stroke-width="1.5" points="${vis.map((x) => `${ix(x).toFixed(1)},${iy((x - 3) ** 2).toFixed(1)}`).join(" ")}"/>` + vis.map((x, i) => `<circle cx="${ix(x)}" cy="${iy((x - 3) ** 2)}" r="${i === vis.length - 1 ? 5 : 3}" fill="${GOLD}"/>`).join("");
      s += txt(520, 246, `loss after ${K} steps: ${fmt(L, 4)}`, `font-size="12.5" font-weight="700" fill="${INK}"`) + txt(520, 264, `w after ${K} steps: ${fmt(path[K], 4)}${vis.length < path.length ? " (off the chart)" : ""}`, `font-size="11.5" fill="${MUTED}"`);
      $("[data-draw]").innerHTML = s;
      $("[data-ve]").textContent = fmt(eta, 3); $("[data-vk]").textContent = String(K);
    }
    const redraw = stepper(root, steps, draw, { delay: 2 });
    $<HTMLInputElement>("[data-e]").addEventListener("input", (e) => { eta = Math.round(10 ** +(e.target as HTMLInputElement).value * 1000) / 1000; redraw(); });
    $<HTMLInputElement>("[data-kk]").addEventListener("input", (e) => { K = +(e.target as HTMLInputElement).value; redraw(); });
  });
</script>
